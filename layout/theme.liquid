<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {{ 'base.css'                  | asset_url | stylesheet_tag }}
    {{ 'theme.css'                 | asset_url | stylesheet_tag }}
    {{ 'quick-view.css'            | asset_url | stylesheet_tag }}
    {{ 'cart-drawer.css'           | asset_url | stylesheet_tag }}
    {{ 'cart-recommendations.css'  | asset_url | stylesheet_tag }}
    {{ 'article-card.css'          | asset_url | stylesheet_tag }}
    {{ 'product-card.css'          | asset_url | stylesheet_tag }}
    {{ 'collection-layout.css'     | asset_url | stylesheet_tag }}
    {{ 'compare-bar.css'           | asset_url | stylesheet_tag }}
    {{ 'section-accordion.css'     | asset_url | stylesheet_tag }}
    {{ 'related-products.css'      | asset_url | stylesheet_tag }}

    {% render 'css-variables' %}

    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'meta-tags' %}

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png"
            href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    {{ content_for_header }}

    <!-- HARDCODED AGGRESSIVE STICKY -->
    <style>
      #header-group-wrapper {
        position: sticky !important;
        top: 0 !important;
        z-index: 2147483647 !important;
        width: 100% !important;
        background: var(--hdr-bg, #ffffff) !important;
      }

      #header-group-sticky-spacer {
        height: var(--hdr-height-desktop, 68px);
      }

      @media (max-width: 1023px) {
        #header-group-sticky-spacer {
          height: var(--hdr-height-tablet, 64px);
        }
      }
      @media (max-width: 599px) {
        #header-group-sticky-spacer {
          height: var(--hdr-height-mobile, 56px);
        }
      }

      /* Force main header to play nice */
      #main-header {
        position: relative !important;
        z-index: 10 !important;
      }

      /* Kill traps from sections */
      main .shopify-section,
      .shopify-section {
        overflow: visible !important;
      }
    </style>
  </head>

  <body class="{{ settings.theme_preset | default: 'ecombio' }}" data-header-layout="{{ settings.header_layout }}">

    <div id="header-group-wrapper">
      {% sections 'header-group' %}
    </div>
    <div id="header-group-sticky-spacer"></div>

    <main role="main">
      {{ content_for_layout }}
    </main>

    <footer role="contentinfo">
      <div class="page-width--footer">
        {% sections 'footer-group' %}
      </div>
    </footer>

    {{- 'base.js'               | asset_url | script_tag }}
    {{- 'theme.js'              | asset_url | script_tag }}
    {{- 'countdown-timer.js'    | asset_url | script_tag }}
    {{- 'copy-to-clipboard.js'  | asset_url | script_tag }}
    {{- 'collection-filters.js' | asset_url | script_tag }}
    {{- 'product-card.js'       | asset_url | script_tag }}

    {% render 'compare-bar' %}
    {% section 'cart-drawer' %}
    {% section 'quick-view' %}
    {% section 'newsletter-popup' %}

    <script src="{{ 'cart-drawer.js'          | asset_url }}" defer></script>
    <script src="{{ 'cart-recommendations.js' | asset_url }}" defer></script>
    <script src="{{ 'quick-view.js'           | asset_url }}" defer></script>

  </body>
</html>