{%- assign sorted_collections = collections | sort: 'title' -%}

<div class="collections-carousel">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="collections-carousel__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="collections-carousel__wrap">
      <button type="button" class="collections-carousel__arrow" onclick="this.nextElementSibling.scrollBy({left:-220,behavior:'smooth'})" aria-label="Previous">‹</button>

      <ul class="collections-carousel__track">
        {%- for collection in sorted_collections -%}
          <li class="collections-carousel__slide">
            <a href="{{ collection.url }}">
              <div class="collections-carousel__image">
                {%- if collection.featured_image -%}
                  <img src="{{ collection.featured_image | image_url: width: 500 }}" alt="{{ collection.title | escape }}" loading="lazy" width="500" height="500">
                {%- else -%}
                  {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <p class="collections-carousel__title">{{ collection.title }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      <button type="button" class="collections-carousel__arrow" onclick="this.previousElementSibling.scrollBy({left:220,behavior:'smooth'})" aria-label="Next">›</button>
    </div>

  </div>
</div>

<style>
  .collections-carousel { padding: 40px 0; }
  .collections-carousel__heading { margin: 0 0 20px; }
  .collections-carousel__wrap { display: flex; align-items: center; gap: 10px; }
  .collections-carousel__track { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; list-style: none; margin: 0; padding: 0; }
  .collections-carousel__slide { flex: 0 0 200px; scroll-snap-align: start; }
  .collections-carousel__slide a { text-decoration: none; color: inherit; display: block; }
  .collections-carousel__image { aspect-ratio: 1 / 1; overflow: hidden; border-radius: 6px; }
  .collections-carousel__image img, .collections-carousel__image svg { width: 100%; height: 100%; object-fit: cover; }
  .collections-carousel__title { margin: 8px 0 0; font-size: 16px; }
  .collections-carousel__arrow { flex: 0 0 auto; width: 36px; height: 36px; border: 1px solid #ccc; background: #fff; border-radius: 50%; cursor: pointer; font-size: 18px; line-height: 1; }
</style>

{% schema %}
{
  "name": "Collection List",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    }
  ]
}
{% endschema %}