{{ 'list-collections-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'list-collections-carousel.js' | asset_url }}" defer="defer"></script>

{%- assign sorted_collections = collections | sort: 'title' -%}

<div class="collections-carousel">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="collections-carousel__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="collections-carousel__wrap">
      <button type="button" class="collections-carousel__arrow collections-carousel__arrow--prev" data-carousel-prev aria-label="Previous">‹</button>

      <ul class="collections-carousel__track" data-carousel-track>
        {%- for collection in sorted_collections -%}
          <li class="collections-carousel__slide">
            <a href="{{ collection.url }}">
              <div class="collections-carousel__image">
                {%- if collection.featured_image -%}
                  <img src="{{ collection.featured_image | image_url: width: 500 }}" alt="{{ collection.title | escape }}" loading="lazy" width="500" height="500">
                {%- else -%}
                  {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <p class="collections-carousel__title">{{ collection.title }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      <button type="button" class="collections-carousel__arrow collections-carousel__arrow--next" data-carousel-next aria-label="Next">›</button>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Carousel List",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    }
  ]
}
{% endschema %}
