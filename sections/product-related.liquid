<div
  class="product-recommendations product-recommendations--related"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <h2 class="product-recommendations__heading">
      {{ 'product_recommendations.related_heading' | t }}
    </h2>
    <ul class="product-recommendations__list">
      {%- for product in recommendations.products -%}
        <li class="product-recommendations__item">
          <a href="{{ product.url }}" class="product-recommendations__link">
            {%- if product.featured_image -%}
              <img
                class="product-recommendations__img"
                src="{{ product.featured_image | image_url: width: 400 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >
            {%- endif -%}
            <p class="product-recommendations__title">{{ product.title }}</p>
            <p class="product-recommendations__price">{{ product.price | money }}</p>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
.product-recommendations {
  margin-top: 3rem;
}
.product-recommendations__heading {
  font-size: 1.5rem;
  margin-bottom: 1.5rem;
}
.product-recommendations__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 1.5rem;
}
.product-recommendations__item {
  display: flex;
  flex-direction: column;
}
.product-recommendations__link {
  text-decoration: none;
  color: inherit;
}
.product-recommendations__img {
  width: 100%;
  height: auto;
  display: block;
  margin-bottom: 0.75rem;
}
.product-recommendations__title {
  margin: 0 0 0.25rem;
}
.product-recommendations__price {
  margin: 0;
}
{% endstylesheet %}

{% javascript %}
  const relatedSection = document.querySelector('.product-recommendations--related');

  if (relatedSection) {
    const handleIntersection = (entries, observer) => {
      if (!entries[0].isIntersecting) return;

      observer.unobserve(relatedSection);

      const url = relatedSection.dataset.url;

      fetch(url)
        .then((response) => response.text())
        .then((text) => {
          const html = document.createElement('div');
          html.innerHTML = text;
          const recommendations = html.querySelector('.product-recommendations--related');

          if (recommendations && recommendations.innerHTML.trim().length) {
            relatedSection.innerHTML = recommendations.innerHTML;
          }
        })
        .catch((e) => {
          console.error(e);
        });
    };

    const observer = new IntersectionObserver(handleIntersection, {
      rootMargin: '0px 0px 200px 0px'
    });

    observer.observe(relatedSection);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:product_recommendations.related_name",
  "settings": [
    {
      "type": "range",
      "id": "limit",
      "label": "t:product_recommendations.settings.limit_label",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}