{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'product-related__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'product-related__full-width'
  elsif width_type == 'custom-width'
    assign width_class = 'product-related__custom-width'
  else
    assign width_class = 'product-related__default-width'
  endif
-%}

{{ 'product-related.css' | asset_url | stylesheet_tag }}

<div
  class="product-recommendations product-recommendations--related {{ width_class }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
  style="
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <h2 class="product-recommendations__heading">
      {{ 'product_recommendations.related_heading' | t }}
    </h2>
    <div class="product-recommendations__carousel">
      <button
        type="button"
        class="product-recommendations__arrow product-recommendations__arrow--prev"
        data-carousel-prev
        aria-label="Previous"
        disabled
      >&#8249;</button>

      <ul class="product-recommendations__list" data-carousel-track>
        {%- for recommended_product in recommendations.products -%}
          <li class="product-recommendations__item">
            <a href="{{ recommended_product.url }}" class="product-recommendations__link">
              {%- if recommended_product.featured_image -%}
                <img
                  class="product-recommendations__img"
                  src="{{ recommended_product.featured_image | image_url: width: 400 }}"
                  srcset="
                    {{ recommended_product.featured_image | image_url: width: 400 }} 1x,
                    {{ recommended_product.featured_image | image_url: width: 800 }} 2x
                  "
                  alt="{{ recommended_product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="{{ recommended_product.featured_image.width }}"
                  height="{{ recommended_product.featured_image.height }}"
                >
              {%- else -%}
                <div class="product-recommendations__img product-recommendations__img--placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'product-recommendations__placeholder-svg' }}
                </div>
              {%- endif -%}
              <p class="product-recommendations__title">{{ recommended_product.title }}</p>
              <p class="product-recommendations__price">{{ recommended_product.price | money }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      <button
        type="button"
        class="product-recommendations__arrow product-recommendations__arrow--next"
        data-carousel-next
        aria-label="Next"
      >&#8250;</button>
    </div>
  {%- elsif section.settings.limit and request.design_mode -%}
    {%- comment -%} Placeholder so merchants see structure in the theme editor before live data loads {%- endcomment -%}
    <h2 class="product-recommendations__heading">
      {{ 'product_recommendations.related_heading' | t }}
    </h2>
    <div class="product-recommendations__carousel">
      <ul class="product-recommendations__list">
        {%- for i in (1..section.settings.limit) -%}
          <li class="product-recommendations__item">
            <div class="product-recommendations__link">
              <div class="product-recommendations__img product-recommendations__img--placeholder">
                {{ 'product-1' | placeholder_svg_tag: 'product-recommendations__placeholder-svg' }}
              </div>
              <p class="product-recommendations__title">{{ 'onboarding.product_title' | t }}</p>
              <p class="product-recommendations__price">{{ 1999 | money }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'product-related.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:product_recommendations.related_name",
  "settings": [
    {
      "type": "range",
      "id": "limit",
      "label": "t:product_recommendations.settings.limit_label",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ]
}
{% endschema %}