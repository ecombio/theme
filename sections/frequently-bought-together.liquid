{%- comment -%}
  Frequently Bought Together
  Reads: product.metafields.custom.frequently_bought_together (List of Product references)
  Self-contained: loads its own CSS + JS, scoped to this section.
{%- endcomment -%}

{{ 'frequently-bought-together.css' | asset_url | stylesheet_tag }}

{%- assign fbt_list = product.metafields.custom.frequently_bought_together.value -%}

{%- if fbt_list != blank -%}
  <section
    class="fbt-section color-{{ section.settings.color_scheme }}"
    id="fbt-section-{{ section.id }}"
    data-fbt-section
    data-section-id="{{ section.id }}"
  >
    <div class="fbt-container page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="fbt-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="fbt-content">
        <div class="fbt-products" data-fbt-products>

          {%- comment -%} Main product — always included, locked on {%- endcomment -%}
          <div
            class="fbt-item fbt-item--main"
            data-fbt-item
            data-product-id="{{ product.id }}"
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            data-price="{{ product.selected_or_first_available_variant.price | default: 0 }}"
          >
            <div class="fbt-item-checkbox">
              <input
                type="checkbox"
                id="fbt-check-main-{{ section.id }}"
                checked
                disabled
                aria-label="{{ product.title | escape }} (always included)"
              >
              <label for="fbt-check-main-{{ section.id }}"></label>
            </div>

            <a href="{{ product.url }}" class="fbt-item-image" tabindex="-1">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 200 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="100"
                  height="100"
                >
              {%- else -%}
                <div class="fbt-item-image--placeholder"></div>
              {%- endif -%}
            </a>

            <div class="fbt-item-info">
              <a href="{{ product.url }}" class="fbt-item-title">{{ product.title }}</a>
              <span class="fbt-item-price" data-fbt-price>
                {{ product.selected_or_first_available_variant.price | default: 0 | money }}
              </span>
            </div>
          </div>

          {%- comment -%} Related products from the metafield list {%- endcomment -%}
          {%- for fbt_product in fbt_list -%}
            {%- if fbt_product != blank and fbt_product.id != product.id -%}
              <div class="fbt-plus" aria-hidden="true">+</div>

              <div
                class="fbt-item"
                data-fbt-item
                data-product-id="{{ fbt_product.id }}"
                data-variant-id="{{ fbt_product.selected_or_first_available_variant.id }}"
                data-price="{{ fbt_product.selected_or_first_available_variant.price | default: 0 }}"
              >
                <div class="fbt-item-checkbox">
                  <input
                    type="checkbox"
                    id="fbt-check-{{ section.id }}-{{ forloop.index }}"
                    data-fbt-checkbox
                    {% if fbt_product.available %}checked{% else %}disabled{% endif %}
                  >
                  <label for="fbt-check-{{ section.id }}-{{ forloop.index }}"></label>
                </div>

                <a href="{{ fbt_product.url }}" class="fbt-item-image" tabindex="-1">
                  {%- if fbt_product.featured_image -%}
                    <img
                      src="{{ fbt_product.featured_image | image_url: width: 200 }}"
                      alt="{{ fbt_product.featured_image.alt | escape }}"
                      loading="lazy"
                      width="100"
                      height="100"
                    >
                  {%- else -%}
                    <div class="fbt-item-image--placeholder"></div>
                  {%- endif -%}
                </a>

                <div class="fbt-item-info">
                  <a href="{{ fbt_product.url }}" class="fbt-item-title">{{ fbt_product.title }}</a>

                  {%- if fbt_product.available == false -%}
                    <span class="fbt-item-soldout">Sold out</span>
                  {%- elsif fbt_product.variants.size > 1 -%}
                    <select class="fbt-variant-select" data-fbt-variant-select aria-label="{{ fbt_product.title | escape }} variant">
                      {%- for variant in fbt_product.variants -%}
                        <option
                          value="{{ variant.id }}"
                          data-price="{{ variant.price }}"
                          {% unless variant.available %}disabled{% endunless %}
                          {% if variant.id == fbt_product.selected_or_first_available_variant.id %}selected{% endif %}
                        >
                          {{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}
                        </option>
                      {%- endfor -%}
                    </select>
                  {%- endif -%}

                  <span class="fbt-item-price" data-fbt-price>
                    {{ fbt_product.selected_or_first_available_variant.price | default: 0 | money }}
                  </span>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="fbt-summary">
          <div class="fbt-summary-total">
            <span class="fbt-summary-label">{{ section.settings.total_label | default: 'Total price:' }}</span>
            <span class="fbt-summary-price" data-fbt-total>{{ 0 | money }}</span>
          </div>

          <button type="button" class="fbt-add-button button" data-fbt-add-button>
            <span data-fbt-button-text>{{ section.settings.button_label | default: 'Add selected to cart' }}</span>
            <svg class="fbt-spinner" data-fbt-spinner viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10" fill="none" stroke-width="3"></circle>
            </svg>
          </button>

          <div class="fbt-message" data-fbt-message role="status" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </section>

  <script src="{{ 'frequently-bought-together.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Bought Together",
  "tag": "section",
  "class": "section fbt-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Bought Together"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total price label",
      "default": "Total price:"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add selected to cart"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Bought Together"
    }
  ]
}
{% endschema %}