{{ 'featured-articles.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign blog = blogs[section.settings.blog]
  assign articles_to_show = section.settings.articles_to_show
  assign show_author = section.settings.show_author
  assign show_date = section.settings.show_date
  assign show_excerpt = section.settings.show_excerpt
-%}

<div class="featured-articles color-{{ section.settings.color_scheme }}" id="FeaturedArticles-{{ section.id }}">
  <div class="featured-articles__container page-width">

    <div class="featured-articles__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="featured-articles__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="featured-articles__nav" role="group" aria-label="{{ 'sections.featured_articles.carousel_navigation' | default: 'Carousel navigation' }}">
        <button type="button" class="featured-articles__nav-btn featured-articles__nav-btn--prev" aria-label="{{ 'general.slider.previous_slide' | default: 'Previous' }}" disabled>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M11 3.5L5.5 9l5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="featured-articles__nav-btn featured-articles__nav-btn--next" aria-label="{{ 'general.slider.next_slide' | default: 'Next' }}">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M7 3.5L12.5 9 7 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    {%- if blog != blank and blog.articles.size > 0 -%}
      <div class="featured-articles__track-wrapper">
        <ul class="featured-articles__track" id="FeaturedArticlesTrack-{{ section.id }}" role="list">
          {%- for article in blog.articles limit: articles_to_show -%}
            <li class="featured-articles__slide">
              <a href="{{ article.url }}" class="featured-articles__card" aria-label="{{ article.title | escape }}">
                <div class="featured-articles__image-wrapper">
                  {%- if article.image -%}
                    <img
                      src="{{ article.image | image_url: width: 700 }}"
                      srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 700 }} 700w, {{ article.image | image_url: width: 1000 }} 1000w"
                      sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 85vw"
                      alt="{{ article.image.alt | default: article.title | escape }}"
                      loading="lazy"
                      width="{{ article.image.width }}"
                      height="{{ article.image.height }}"
                      class="featured-articles__image"
                    >
                  {%- else -%}
                    <div class="featured-articles__image featured-articles__image--placeholder">
                      {{ 'article' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>

                <div class="featured-articles__content">
                  {%- if show_date -%}
                    <span class="featured-articles__date">{{ article.published_at | date: format: 'month_day_year' }}</span>
                  {%- endif -%}

                  <h3 class="featured-articles__title">{{ article.title }}</h3>

                  {%- if show_excerpt -%}
                    <p class="featured-articles__excerpt">
                      {{ article.excerpt_or_content | strip_html | truncatewords: 20 }}
                    </p>
                  {%- endif -%}

                  {%- if show_author -%}
                    <span class="featured-articles__author">{{ article.author }}</span>
                  {%- endif -%}
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- else -%}
      <p class="featured-articles__empty">{{ 'sections.featured_articles.no_articles' | default: 'No articles found. Select a blog with published posts.' }}</p>
    {%- endif -%}

    {%- if section.settings.show_view_all and blog != blank -%}
      <div class="featured-articles__footer">
        <a href="{{ blog.url }}" class="featured-articles__view-all">
          {{ 'sections.featured_articles.view_all' | default: 'View all articles' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'featured-articles.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Featured articles",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Number of articles",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Featured articles"
    }
  ]
}
{% endschema %}
