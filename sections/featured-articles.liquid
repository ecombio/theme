{{ 'featured-articles.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign content_source = section.settings.content_source
  assign articles_to_show = section.settings.articles_to_show
  assign blog = blogs[section.settings.blog]

  if content_source == 'metafield'
    assign curated_articles = shop.metafields.custom.featured_articles.value
    if curated_articles != blank
      assign articles = curated_articles
      assign articles_count = curated_articles.size
    endif
  else
    if blog != blank
      assign articles = blog.articles
      assign articles_count = blog.articles.size
    endif
  endif
-%}

<div class="featured-articles color-{{ section.settings.color_scheme }}" id="FeaturedArticles-{{ section.id }}">
  <div class="featured-articles__container page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="featured-articles__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if articles_count > 0 -%}
      <div class="featured-articles__track-wrapper">
        <button type="button" class="featured-articles__nav-btn featured-articles__nav-btn--prev" aria-label="{{ 'general.slider.previous_slide' | default: 'Previous' }}" disabled>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M11 3.5L5.5 9l5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <ul class="featured-articles__track" id="FeaturedArticlesTrack-{{ section.id }}" role="list">
          {%- for article in articles limit: articles_to_show -%}
            <li class="featured-articles__slide">
              <a href="{{ article.url }}" class="featured-articles__card" aria-label="{{ article.title | escape }}">
                <div class="featured-articles__image-wrapper">
                  {%- if article.image -%}
                    <img
                      src="{{ article.image | image_url: width: 700 }}"
                      srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 700 }} 700w, {{ article.image | image_url: width: 1000 }} 1000w"
                      sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 85vw"
                      alt="{{ article.image.alt | default: article.title | escape }}"
                      loading="lazy"
                      width="{{ article.image.width }}"
                      height="{{ article.image.height }}"
                      class="featured-articles__image"
                    >
                  {%- else -%}
                    <div class="featured-articles__image featured-articles__image--placeholder">
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>
                <h3 class="featured-articles__title">{{ article.title }}</h3>
              </a>
            </li>
          {%- endfor -%}
        </ul>

        <button type="button" class="featured-articles__nav-btn featured-articles__nav-btn--next" aria-label="{{ 'general.slider.next_slide' | default: 'Next' }}">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M7 3.5L12.5 9 7 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'featured-articles.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Featured articles",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "content_source",
      "label": "Content source",
      "options": [
        { "value": "blog", "label": "Blog (latest articles)" },
        { "value": "metafield", "label": "Curated list (shop metafield)" }
      ],
      "default": "blog",
      "info": "Curated list uses the shop metafield custom.featured_articles (type: List of Blog post references)."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Used only when content source is set to Blog."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Number of articles",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Featured articles"
    }
  ]
}
{% endschema %}