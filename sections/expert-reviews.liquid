{%- comment -%}
  sections/expert-reviews.liquid
  ============================================
  Video-only carousel for third-party review videos (YouTube/Vimeo
  clips or uploaded files), with a title, view count, and source
  attribution shown under each card — see snippets/expert-review-card.liquid.

  This section deliberately reuses, unchanged:
    - assets/video-section.js   → carousel arrow/scroll behavior
    - assets/video-card.js      → play-trigger click → 'video-card:play' dispatch
    - snippets/video-modal.liquid + assets/video-modal.css/js → shared lightbox

  Those scripts already query generic data-* attributes (not class
  names), so this section's markup below carries the same
  data-video-section / data-video-track / data-video-prev /
  data-video-next / data-video-item / data-video-card-trigger
  attributes as sections/video-section.liquid. No new JS file exists
  for this section — writing one would just duplicate logic that
  already works.

  Only the card's own look (snippets/expert-review-card.liquid +
  assets/expert-reviews.css) is new.

  NOTE: like video-section.liquid, this renders its own copy of
  video-modal. If a page has this section AND a Video Section on it,
  video-modal.js's de-dupe keeps only the first instance in the DOM —
  see the note in video-modal.liquid.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'expert-reviews.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'video-modal.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>
  <link rel="stylesheet" href="{{ 'expert-reviews.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'video-modal.css' | asset_url }}">
</noscript>
<script src="{{ 'video-section.js' | asset_url }}" defer></script>
<script src="{{ 'video-card.js' | asset_url }}" defer></script>
<script src="{{ 'video-modal.js' | asset_url }}" defer></script>

<div
  {% render 'section-width', section: section, extra_class: 'expert-reviews' %}
  id="ExpertReviews-{{ section.id }}"
  data-video-section
>

  {%- if section.settings.heading != blank -%}
    <div class="expert-reviews__header">
      <h2 class="expert-reviews__heading">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="expert-reviews__carousel" data-video-carousel>

      <button
        type="button"
        class="expert-reviews__arrow expert-reviews__arrow--prev"
        data-video-prev
        aria-label="Previous reviews"
        aria-controls="ExpertReviewsTrack-{{ section.id }}"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div
        class="expert-reviews__track"
        id="ExpertReviewsTrack-{{ section.id }}"
        data-video-track
        role="list"
      >
        {%- for block in section.blocks -%}
          <div
            class="expert-reviews__item"
            id="ExpertReview-{{ block.id }}"
            data-video-item
            role="listitem"
            {{ block.shopify_attributes }}
          >
            {%- render 'expert-review-card', block: block -%}
          </div>
        {%- endfor -%}
      </div>

      <button
        type="button"
        class="expert-reviews__arrow expert-reviews__arrow--next"
        data-video-next
        aria-label="Next reviews"
        aria-controls="ExpertReviewsTrack-{{ section.id }}"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

    </div>
  {%- endif -%}

</div>

{%- render 'video-modal' -%}

{% schema %}
{
  "name": "Expert Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Expert Reviews"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Upload a video file. Takes priority over an external video link."
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "External video link",
          "accept": ["youtube", "vimeo"],
          "info": "Used only if no video file is uploaded above."
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail",
          "info": "If left blank, uses the uploaded video's preview image, or a placeholder."
        },
        {
          "type": "header",
          "content": "Review details"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title"
        },
        {
          "type": "text",
          "id": "view_count",
          "label": "View count",
          "info": "e.g. \"20,211 views\""
        },
        {
          "type": "image_picker",
          "id": "source_icon",
          "label": "Source icon"
        },
        {
          "type": "text",
          "id": "source_name",
          "label": "Source name",
          "info": "e.g. \"Electric Bike Report\""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Expert Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
