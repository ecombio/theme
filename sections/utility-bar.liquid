{%- comment -%}
  sections/utility-bar.liquid
  Thin wrapper around snippets/utility-bar.liquid so the bar can live
  as its own entry in sections/header-group.json — independently
  reorderable/removable from main-header.

  NOTE ON LAYOUT SETTINGS: the snippet reads settings.section_width /
  settings.custom_width / settings.section_padding to line up with
  whatever row is rendering it. When this lived inside main-header.liquid,
  those came for free from main-header's own "Section layout" group, so
  the utility bar always matched automatically. Now that this is a
  separate section, those three fields are duplicated below so the
  snippet still has something to read — but they no longer auto-sync
  with main-header's width/padding. If you want the utility bar to
  visually line up with the header row above it, match these values to
  main-header's Section layout settings by hand (or eyeball it live in
  the theme editor).

  All rendering logic (including the "enable_bar" check, and loading
  utility-bar.css/js) already lives in the snippet and is untouched here.
{%- endcomment -%}

{%- render 'utility-bar', settings: section.settings -%}

{% schema %}
{
  "name": "Utility Bar",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Section layout" },
    {
      "type": "paragraph",
      "content": "These control the bar's own width/padding. To visually line up with the main header row above it, match these to that section's Section layout settings."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },

    { "type": "header", "content": "Utility Bar" },
    {
      "type": "checkbox",
      "id": "enable_bar",
      "label": "Enable utility bar",
      "default": true
    },
    {
      "type": "select",
      "id": "bar_style",
      "label": "Bar style",
      "default": "hyper",
      "options": [
        { "value": "hyper", "label": "Hyper (white)" },
        { "value": "focus", "label": "Focus (warm grey)" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "Show currency selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_locale",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "link_1_icon",
      "label": "Link 1 icon (optional)"
    },
    {
      "type": "text",
      "id": "link_1_label",
      "label": "Link 1 label",
      "default": "Track Order"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "image_picker",
      "id": "link_2_icon",
      "label": "Link 2 icon (optional)"
    },
    {
      "type": "text",
      "id": "link_2_label",
      "label": "Link 2 label",
      "default": "Store Locator"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "image_picker",
      "id": "link_3_icon",
      "label": "Link 3 icon (optional)"
    },
    {
      "type": "text",
      "id": "link_3_label",
      "label": "Link 3 label",
      "default": "Track Order"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "label": "Link 3 URL"
    }
  ],
  "presets": [
    {
      "name": "Utility Bar",
      "settings": {
        "link_1_label": "Track Order",
        "link_1_url": "/apps/track",
        "link_2_label": "Store Locator",
        "link_2_url": "/pages/stores",
        "link_3_label": "Track Order",
        "link_3_url": "/apps/track"
      }
    }
  ]
}
{% endschema %}