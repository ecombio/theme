{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

{{ 'page.css' | asset_url | stylesheet_tag }}

<div class="page-section">
  <h1 class="page-section__heading">{{ page.title }}</h1>

  <div class="page-section__content" data-page-content>
    {{ page.content }}
  </div>
</div>

<script src="{{ 'page.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}