{% comment %}
  ╔══════════════════════════════════════════════════════════╗
  ║  sections/product-recommendations.liquid                 ║
  ║  Mode: Shopify native recommendations                    ║
  ║        (routes.product_recommendations_url)              ║
  ║  Cards: snippets/product-card.liquid — rendered directly ║
  ║         in THIS section, same pattern as                 ║
  ║         sections/product-carousel.liquid.                ║
  ║                                                            ║
  ║  How it works:                                           ║
  ║  On a normal page load, `recommendations` is blank, so   ║
  ║  the section renders `hidden` with an empty grid. The    ║
  ║  script below re-fetches THIS section through             ║
  ║  routes.product_recommendations_url?section_id=...&      ║
  ║  product_id=...&limit=... — Shopify resolves              ║
  ║  `recommendations.products` server-side and returns the  ║
  ║  fully rendered section HTML, cards and all. We swap the ║
  ║  grid's innerHTML with that response and reveal the      ║
  ║  section. Single request, no per-product fetch, no       ║
  ║  separate product-card-single section required — that    ║
  ║  file can be deleted if nothing else references it.      ║
  ║                                                            ║
  ║  product-card.css / product-card.js are assumed global   ║
  ║  (loaded once in theme.liquid), same assumption already  ║
  ║  made by product-carousel.liquid — not re-loaded here.   ║
  ╚══════════════════════════════════════════════════════════╝
{% endcomment %}

{%- liquid
  assign cols_d     = section.settings.columns_desktop
  assign cols_m     = section.settings.columns_mobile
  assign gap        = section.settings.card_gap
  assign pad_top    = section.settings.padding_top
  assign pad_bottom = section.settings.padding_bottom
  assign cs         = section.settings.color_scheme
  assign limit      = section.settings.products_to_show

  assign show_recs = false
  if recommendations.performed and recommendations.products_count > 0
    assign show_recs = true
  endif
-%}

<section
  class="pr-section cs-{{ cs }}"
  id="pr-recs-section-{{ section.id }}"
  data-recommendations-url="{{ routes.product_recommendations_url }}"
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}"
  data-limit="{{ limit }}"
  style="
    --pr-cols: {{ cols_d }};
    --pr-cols-mob: {{ cols_m }};
    --pr-gap: {{ gap }}px;
    --pr-pad-top: {{ pad_top }}px;
    --pr-pad-bottom: {{ pad_bottom }}px;
  "
  aria-label="{{ section.settings.heading | escape }}"
  {%- unless show_recs %} hidden{% endunless %}
>
  <div class="pr-inner">
    <div class="pr-header">
      <h2 class="pr-heading">{{ section.settings.heading }}</h2>
    </div>
    <ul class="pr-grid" id="pr-recs-grid-{{ section.id }}" role="list">
      {%- if show_recs -%}
        {%- for rec_product in recommendations.products limit: limit -%}
          <li class="pr-grid__item">
            {%- render 'product-card', product: rec_product -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

<script>
(function () {
  var section = document.getElementById('pr-recs-section-{{ section.id }}');
  if (!section) return;

  // Already server-rendered with real recommendations (this section
  // was itself fetched via section_id) — nothing left to do.
  var alreadyPerformed = {{ recommendations.performed | json }};
  if (alreadyPerformed) return;

  var baseUrl   = section.getAttribute('data-recommendations-url');
  var productId = section.getAttribute('data-product-id');
  var sectionId = section.getAttribute('data-section-id');
  var limit     = section.getAttribute('data-limit');

  if (!baseUrl || !productId) return;

  var fetchUrl = baseUrl
    + '?section_id=' + encodeURIComponent(sectionId)
    + '&product_id=' + encodeURIComponent(productId)
    + '&limit=' + encodeURIComponent(limit)
    + '&intent=related';

  fetch(fetchUrl)
    .then(function (res) { return res.ok ? res.text() : Promise.reject(); })
    .then(function (html) {
      var doc     = new DOMParser().parseFromString(html, 'text/html');
      var newGrid = doc.getElementById('pr-recs-grid-{{ section.id }}');
      var grid    = document.getElementById('pr-recs-grid-{{ section.id }}');

      if (!newGrid || !grid || newGrid.children.length === 0) return;

      grid.innerHTML = newGrid.innerHTML;
      section.removeAttribute('hidden');

      // Re-sync wishlist + compare state for injected cards
      // (handled globally by product-card.js's productcard:injected listener)
      document.dispatchEvent(new CustomEvent('productcard:injected', { bubbles: true }));
    })
    .catch(function () {
      // Silently fail — section stays hidden
    });
})();
</script>

{% schema %}
{
  "name": "AI Recommendations",
  "tag": "section",
  "class": "section-pr-recommendations",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Number of Products"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Columns (desktop)"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "Columns (mobile)"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 16,
      "label": "Card gap (px)"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "light",  "label": "Light" },
        { "value": "gray",   "label": "Light Gray" },
        { "value": "dark",   "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "label": "Padding top (px)"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "label": "Padding bottom (px)"
    }
  ],
  "presets": [
    {
      "name": "AI Recommendations",
      "settings": {
        "heading": "You May Also Like",
        "products_to_show": 4
      }
    }
  ]
}
{% endschema %}