{{ 'featured-collection.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  product-card.liquid doesn't load its own CSS (see asset ownership rule
  in that file) — it expects the host page to have loaded it already.
  This section renders product-card for every product in the grid, so
  load it here explicitly (same convention used in video-carousel.liquid).
  image-card.liquid follows the same convention when the promo card is on.
{%- endcomment -%}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{%- if section.settings.enable_promo_card -%}
  {{ 'image-card.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.collection != blank -%}
  {%- comment -%}
    Section width / side padding follow the shared pattern documented
    in sections/example-width-section.liquid: --section-padding and
    --custom-width are local to this section instance, set inline
    here only, and never read from the global --page-margin /
    --page-width variables.
  {%- endcomment -%}
  {%- liquid
    assign width_type = section.settings.section_width
    if width_type == blank
      assign width_class = 'featured-collection__default-width'
    else
      assign width_class = 'featured-collection__' | append: width_type
    endif

    assign is_row = false
    if section.settings.layout_style == 'row'
      assign is_row = true
    endif

    assign show_promo = false
    if section.settings.enable_promo_card and section.settings.promo_image != blank
      assign show_promo = true
    endif

    assign promo_width = blank
    if section.settings.promo_custom_width
      assign promo_width = section.settings.promo_width_px | append: 'px'
    endif
  -%}

  <div
    class="featured-collection {{ width_class }}"
    {% if is_row %}data-featured-collection data-layout="row"{% endif %}
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >
    <div class="featured-collection__header">
      <h2 class="featured-collection__heading">{{ section.settings.heading | default: section.settings.collection.title }}</h2>
      {%- if section.settings.show_view_all and section.settings.collection.url != blank -%}
        <a href="{{ section.settings.collection.url }}" class="featured-collection__view-all">
          {{ section.settings.view_all_text | default: 'View all' }}
        </a>
      {%- endif -%}
    </div>

    {%- if is_row -%}
      <div class="featured-collection__wrapper" data-featured-collection-wrapper>
        {%- if show_promo -%}
          <div class="featured-collection__promo-pinned">
            {%- render 'image-card',
              image: section.settings.promo_image,
              mobile_image: section.settings.promo_mobile_image,
              link: section.settings.promo_link,
              heading: section.settings.promo_heading,
              subheading: section.settings.promo_subheading,
              price_text: section.settings.promo_price_text,
              price_truncate: section.settings.promo_price_truncate,
              button_label: section.settings.promo_button_label,
              content_position: section.settings.promo_content_position,
              image_scale: section.settings.promo_image_scale,
              text_color: section.settings.promo_text_color,
              heading_size: section.settings.promo_heading_size,
              subheading_size: section.settings.promo_subheading_size,
              price_size: section.settings.promo_price_size,
              button_size: section.settings.promo_button_size,
              height_mobile: section.settings.promo_height_mobile,
              height_desktop: section.settings.promo_height_desktop,
              width: promo_width,
              loading: 'eager'
            -%}
          </div>
        {%- endif -%}

        <div class="featured-collection__scroll-region">
          {%- if section.settings.show_arrows -%}
            <button
              type="button"
              class="featured-collection__arrow featured-collection__arrow--prev"
              aria-label="Previous products"
              data-fc-prev
            >
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                <path d="M15 4l-8 8 8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          {%- endif -%}

          <div
            class="featured-collection__grid featured-collection__grid--row"
            data-fc-track
            tabindex="0"
            role="region"
            aria-label="{{ section.settings.heading | default: section.settings.collection.title }}"
          >
            {%- for product in section.settings.collection.products limit: section.settings.limit -%}
              {%- render 'product-card', product: product -%}
            {%- endfor -%}
          </div>

          {%- if section.settings.show_arrows -%}
            <button
              type="button"
              class="featured-collection__arrow featured-collection__arrow--next"
              aria-label="Next products"
              data-fc-next
            >
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                <path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_dots -%}
        <div class="featured-collection__dots" data-fc-dots role="tablist" aria-label="Product page navigation"></div>
      {%- endif -%}
    {%- else -%}
      <div class="featured-collection__grid">
        {%- if show_promo -%}
          <div class="featured-collection__promo-cell">
            {%- render 'image-card',
              image: section.settings.promo_image,
              mobile_image: section.settings.promo_mobile_image,
              link: section.settings.promo_link,
              heading: section.settings.promo_heading,
              subheading: section.settings.promo_subheading,
              price_text: section.settings.promo_price_text,
              price_truncate: section.settings.promo_price_truncate,
              button_label: section.settings.promo_button_label,
              content_position: section.settings.promo_content_position,
              image_scale: section.settings.promo_image_scale,
              text_color: section.settings.promo_text_color,
              heading_size: section.settings.promo_heading_size,
              subheading_size: section.settings.promo_subheading_size,
              price_size: section.settings.promo_price_size,
              button_size: section.settings.promo_button_size,
              height_mobile: section.settings.promo_height_mobile,
              height_desktop: section.settings.promo_height_desktop,
              width: promo_width,
              loading: 'eager'
            -%}
          </div>
        {%- endif -%}

        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{{ 'featured-collection.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "default": 8
    },
    { "type": "header", "content": "View all link" },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" link",
      "default": true,
      "info": "Links to the collection page. Hidden automatically if the collection has no page of its own."
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Link text",
      "default": "View all"
    },
    { "type": "header", "content": "Grid" },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "row", "label": "Scrollable row" }
      ],
      "default": "grid",
      "info": "Grid wraps products onto multiple lines. Scrollable row keeps them on one line the person can scroll through horizontally."
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true,
      "visible_if": "{{ section.settings.layout_style == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true,
      "visible_if": "{{ section.settings.layout_style == 'row' }}"
    },
    { "type": "header", "content": "Promo card" },
    {
      "type": "checkbox",
      "id": "enable_promo_card",
      "label": "Show promo card",
      "default": false,
      "info": "Adds one extra image card as the first item in the grid, before the products. Doesn't count against \"Products to show\"."
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Image",
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "image_picker",
      "id": "promo_mobile_image",
      "label": "Mobile image (optional)",
      "info": "Falls back to the image above on small screens if not set.",
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "Link",
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "Heading",
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "text",
      "id": "promo_subheading",
      "label": "Subheading",
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "text",
      "id": "promo_price_text",
      "label": "Price text",
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "checkbox",
      "id": "promo_price_truncate",
      "label": "Truncate price text",
      "default": false,
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "text",
      "id": "promo_button_label",
      "label": "Button label",
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "select",
      "id": "promo_content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "range",
      "id": "promo_image_scale",
      "label": "Image zoom",
      "min": 100,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "color",
      "id": "promo_text_color",
      "label": "Text color",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    { "type": "header", "content": "Promo card text sizing" },
    {
      "type": "range",
      "id": "promo_heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "range",
      "id": "promo_subheading_size",
      "label": "Subheading size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "range",
      "id": "promo_price_size",
      "label": "Price text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14,
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "range",
      "id": "promo_button_size",
      "label": "Button label size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14,
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    { "type": "header", "content": "Promo card sizing" },
    {
      "type": "checkbox",
      "id": "promo_custom_width",
      "label": "Use a custom width",
      "default": false,
      "info": "Off: card fills its grid cell, same as before. On: set an exact pixel width below — this can be larger than the cell, letting the card grow beyond the space the grid would normally give it.",
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "range",
      "id": "promo_width_px",
      "label": "Card width",
      "min": 200,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 400,
      "visible_if": "{{ section.settings.enable_promo_card and section.settings.promo_custom_width }}"
    },
    {
      "type": "range",
      "id": "promo_height_mobile",
      "label": "Image height (mobile)",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 320,
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    {
      "type": "range",
      "id": "promo_height_desktop",
      "label": "Image height (desktop)",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 500,
      "visible_if": "{{ section.settings.enable_promo_card }}"
    },
    { "type": "header", "content": "Section layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    { "name": "Featured Collection" }
  ]
}
{% endschema %}