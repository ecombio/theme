{%- comment -%} sections/main-search.liquid {%- endcomment -%}
{{ 'main-search.css' | asset_url | stylesheet_tag }}
{{ 'promo-banner.css' | asset_url | stylesheet_tag }}
{{ 'promo-carousel.css' | asset_url | stylesheet_tag }}
{{ 'article-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Use search.types as primary source of truth (most reliable)
  assign active_type = 'product'
  if search.types contains 'article'
    assign active_type = 'article'
  endif

  # Safety fallback from URL param
  assign type_from_url = request.query_parameters['type'] | default: ''
  if type_from_url == 'article'
    assign active_type = 'article'
  endif

  assign search_terms = search.terms
  assign results_count = search.results_count | default: 0

  # Whether the filter sidebar is enabled at all. Previously this was
  # also gated on active_type == 'product' (Shopify has no faceted
  # filtering for articles), which hid the whole sidebar -- and
  # collapsed the feed to full width -- the moment you switched to
  # the Articles tab. Now the sidebar stays put on both tabs
  # (search-filter.liquid shows a placeholder message on Articles
  # instead of disappearing), so this only reflects the merchant's
  # setting.
  assign show_filters = false
  if section.settings.show_filters
    assign show_filters = true
  endif

  # Formerly passed into snippets/search-toolbar.liquid; now used
  # directly since the toolbar markup is inlined below.
  assign tab_products_label = section.settings.tab_products_label | default: 'Products'
  assign tab_articles_label = section.settings.tab_articles_label | default: 'Articles'

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'search-page__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'search-page__full-width'
  else
    assign width_class = 'search-page__custom-width'
  endif
-%}

<div class="main-search" id="main-search" data-section-id="{{ section.id }}">

  <div
    class="search-page {{ width_class }}"
    data-search-page
    data-active-type="{{ active_type }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >

    <div class="search-hero" id="search-hero">
      {%- if search.performed -%}
        <h1 class="search-title">Search results</h1>
        {%- if search_terms != blank -%}
          <p class="search-result-count" id="search-result-count">
            {{ results_count }} result{% if results_count != 1 %}s{% endif %} for &ldquo;{{ search_terms }}&rdquo;
          </p>
        {%- endif -%}
      {%- else -%}
        <h1 class="search-title">Search</h1>
      {%- endif -%}
    </div>

    {%- if search.performed -%}

      <section class="search-section">

        {%- comment -%}
          -----------------------------------------------------
          Inlined from snippets/search-toolbar.liquid
          -----------------------------------------------------
          Renders the search results toolbar: the filter-drawer
          toggle, the Products/Articles tab switcher, and the sort
          <select> (desktop), plus the equivalent condensed mobile
          bar. Inlined directly into this section (rather than
          rendered as a separate snippet) along with its CSS/JS
          assets above/below.
        {%- endcomment -%}

        <div class="search-toolbar" id="search-toolbar" role="navigation" aria-label="Search results navigation">

          {%- if section.settings.show_filters -%}
            {%- comment -%}
              Filter toggle is enabled on both tabs now -- the sidebar itself
              stays visible on Articles (search-filter.liquid shows a
              placeholder message there instead of disappearing), so there's
              no longer a reason to disable this button when active_type is
              'article'.
            {%- endcomment -%}
            <button
              class="search-toolbar__filter-toggle"
              type="button"
              aria-expanded="{% if show_filters %}true{% else %}false{% endif %}"
              aria-controls="search-filter"
              aria-label="Toggle filters"
              data-filter-toggle
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 4h12M4 8h8M6 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              Filters
            </button>
          {%- endif -%}

          {%- comment -%}
            TAB SWITCHING IS NOW AJAX (2026-07): these are still real
            <a href> links to ?type=product|article -- that's what
            makes plain navigation (JS disabled, fetch failure, no
            section id) work as a reliable fallback -- but
            main-search.js's toolbar IIFE intercepts the click and
            re-fetches this section via the Section Rendering API
            instead, so switching tabs no longer causes a full page
            reload in the common case. data-type is what that handler
            keys off of; it's also present on the "Switch to
            Products" link inside the Articles-tab filter placeholder
            below, so that link goes through the exact same live path.
          {%- endcomment -%}
          <div class="tab-switcher" role="tablist" aria-label="Search result type">
            <a
              href="{{ routes.search_url }}?q={{ search_terms | url_param_escape }}&type=product"
              class="tab-switcher__tab{% if active_type == 'product' %} tab-switcher__tab--active{% endif %}"
              role="tab"
              aria-selected="{% if active_type == 'product' %}true{% else %}false{% endif %}"
              aria-controls="panel-products"
              id="tab-products"
              data-type="product"
              tabindex="{% if active_type == 'product' %}0{% else %}-1{% endif %}"
            >{{ tab_products_label }}</a>

            <a
              href="{{ routes.search_url }}?q={{ search_terms | url_param_escape }}&type=article"
              class="tab-switcher__tab{% if active_type == 'article' %} tab-switcher__tab--active{% endif %}"
              role="tab"
              aria-selected="{% if active_type == 'article' %}true{% else %}false{% endif %}"
              aria-controls="panel-articles"
              id="tab-articles"
              data-type="article"
              tabindex="{% if active_type == 'article' %}0{% else %}-1{% endif %}"
            >{{ tab_articles_label }}</a>
          </div>

          {%- if section.settings.show_sort -%}
            <div class="search-toolbar__sort"{% if active_type != 'product' %} style="display:none;"{% endif %}>
              <label for="SortBy" class="visually-hidden">Sort</label>
              <select id="SortBy" data-sort>
                {%- for option in search.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == search.sort_by %}selected{% endif %}>
                    {{ option.name }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}

        </div>

        {%- if section.settings.show_filters or section.settings.show_sort -%}
          <div class="search-mobile-bar" aria-label="Search controls" role="toolbar">

            {%- if section.settings.show_filters -%}
              <button
                class="search-mobile-bar__btn"
                type="button"
                aria-expanded="false"
                aria-controls="search-filter"
                aria-label="Toggle filters"
                data-filter-toggle
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M2 4h12M4 8h8M6 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                Filters
              </button>
            {%- endif -%}

            {%- if section.settings.show_sort -%}
              <button
                class="search-mobile-bar__btn"
                type="button"
                aria-expanded="false"
                aria-label="Sort results"
                data-mobile-sort-toggle
                {%- if active_type != 'product' %} disabled{%- endif %}
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M2 4h8M2 8h6M2 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <path d="M12 3v10M9.5 10.5L12 13l2.5-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Sort
              </button>
            {%- endif -%}

          </div>
        {%- endif -%}

        <div class="search-body{% unless show_filters %} search-body--filters-hidden{% endunless %}" data-search-body>

          {%- if section.settings.show_filters -%}
            {%- comment -%}
              -----------------------------------------------------
              Inlined from snippets/search-filter.liquid
              -----------------------------------------------------
              The product-filter drawer. Filters only apply to
              product search -- Shopify doesn't support faceted
              filters on article results -- so the filter <form>
              only renders when active_type is 'product'. On the
              Articles tab the drawer still renders with a short
              placeholder message instead of the form, so the
              sidebar's presence/width stays consistent across both
              tabs instead of disappearing and reflowing the
              results grid.
            {%- endcomment -%}

            <aside
              class="search-filter"
              id="search-filter"
              aria-label="Product filters"
              data-search-filter
              {%- unless show_filters %} hidden{%- endunless %}
            >

              <div class="search-filter__close">
                <span class="search-filter__close-label">Filters</span>
                <button class="search-filter__close-btn" type="button" aria-label="Close filters" data-filter-close>&times;</button>
              </div>

              {%- if active_type == 'product' -%}
                <form method="get" action="{{ routes.search_url }}" id="SearchFilterForm">
                  <input type="hidden" name="q" value="{{ search_terms }}">
                  <input type="hidden" name="type" value="product">

                  {%- for filter in search.filters -%}
                    <details class="search-filter__group" open>
                      <summary class="search-filter__group-label">
                        {{ filter.label }}
                        {%- if filter.active_values.size > 0 -%}
                          <span class="search-filter__group-badge">{{ filter.active_values.size }}</span>
                        {%- endif -%}
                      </summary>

                      <div class="search-filter__group-body">
                        {%- case filter.type -%}
                          {%- when 'list' -%}
                            {%- for value in filter.values -%}
                              <label class="search-filter__option
                                {%- if value.active %} search-filter__option--active{%- endif %}
                                {%- if value.count == 0 and value.active == false %} search-filter__option--disabled{%- endif %}">
                                <input
                                  type="checkbox"
                                  name="{{ value.param_name }}"
                                  value="{{ value.value }}"
                                  {%- if value.active %} checked{%- endif %}
                                  {%- if value.count == 0 and value.active == false %} disabled{%- endif %}
                                >
                                {{ value.label }} <span>({{ value.count }})</span>
                              </label>
                            {%- endfor -%}

                          {%- when 'price_range' -%}
                            <div class="search-filter__price">
                              <input
                                type="number"
                                name="{{ filter.min_value.param_name }}"
                                value="{{ filter.min_value.value }}"
                                min="0"
                                max="{{ filter.range_max }}"
                                placeholder="0"
                              >
                              <span>&ndash;</span>
                              <input
                                type="number"
                                name="{{ filter.max_value.param_name }}"
                                value="{{ filter.max_value.value }}"
                                min="0"
                                max="{{ filter.range_max }}"
                                placeholder="{{ filter.range_max }}"
                              >
                            </div>
                        {%- endcase -%}
                      </div>
                    </details>
                  {%- else -%}
                    <p class="search-filter__empty">No filters are configured for this search.</p>
                  {%- endfor -%}

                  {%- assign active_count = 0 -%}
                  {%- for filter in search.filters -%}
                    {%- assign active_count = active_count | plus: filter.active_values.size -%}
                  {%- endfor -%}

                  {%- if active_count > 0 -%}
                    <div class="search-filter__active">
                      {%- for filter in search.filters -%}
                        {%- for value in filter.active_values -%}
                          <a href="{{ value.url_to_remove }}&type=product" class="search-filter__pill">
                            {{ value.label }} &times;
                          </a>
                        {%- endfor -%}
                      {%- endfor -%}
                      <a href="{{ routes.search_url }}?q={{ search_terms | url_param_escape }}&type=product" class="search-filter__pill search-filter__pill--clear">Clear all</a>
                    </div>
                  {%- endif -%}

                  <button type="submit" class="search-filter__submit">Apply</button>
                </form>
              {%- else -%}
                {%- comment -%}
                  ARTICLES-TAB PLACEHOLDER (2026-07): previously a
                  single small <p>, which "ghosted" the sidebar —
                  made it feel empty/broken rather than intentional.
                  Kept as a block-level placeholder (not the form) so
                  .search-filter's width stays exactly the same as it
                  is on the Products tab; only the CONTENTS differ,
                  same "no layout shift" reasoning as the width fix
                  documented in main-search.css.
                {%- endcomment -%}
                <div class="search-filter__placeholder">
                  <svg class="search-filter__placeholder-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 4h16v2.586a1 1 0 0 1-.293.707l-5.414 5.414a1 1 0 0 0-.293.707V19l-4 2v-7.586a1 1 0 0 0-.293-.707L4.293 7.293A1 1 0 0 1 4 6.586V4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  </svg>
                  <p class="search-filter__placeholder-title">No filters for articles</p>
                  <p class="search-filter__placeholder-text">Filters only apply to product results. Switch tabs to narrow products down by price, type, and more.</p>
                  {%- comment -%}
                    data-type="product" lets main-search.js's AJAX
                    tab-switch handler pick this up alongside the two
                    real tabs above -- functionally it's the same
                    action as clicking the Products tab, so it goes
                    through the identical live-fetch path (with the
                    same full-navigation fallback if JS can't run it).
                  {%- endcomment -%}
                  <a href="{{ routes.search_url }}?q={{ search_terms | url_param_escape }}&type=product" class="search-filter__placeholder-btn" data-type="product">Switch to Products</a>
                </div>
              {%- endif -%}

            </aside>
          {%- endif -%}

          <div class="search-body__feed">
            {%- comment -%}
              -----------------------------------------------------
              Inlined from snippets/search-results.liquid
              -----------------------------------------------------
              Renders the two result panels (tabpanels). The
              Products/Articles tab switcher itself lives in the
              toolbar markup above (the ids referenced by
              aria-labelledby below -- tab-products / tab-articles --
              are defined there); this used to render its own
              duplicate copy of that tab switcher, which produced two
              conflicting sets of the same DOM ids on the page.
              Removed in favor of the single tab switcher owned by
              the toolbar.

              Product and article result rendering (formerly
              snippets/product-results.liquid and snippets/
              article-results.liquid) are inlined directly below,
              each still isolated inside its own {%- paginate -%}
              loop so the two result sets don't interfere with each
              other.

              In-feed promo_banner / promo_carousel blocks (products
              panel only, matching main-collection.liquid's behavior
              -- Shopify search doesn't facet/merchandise article
              results the same way, so blocks aren't offered on that
              tab) are positioned using an ABSOLUTE index across the
              whole result set:

                absolute_index = paginate.current_offset + forloop.index

              rather than forloop.parentloop.index alone.
              forloop.parentloop.index resets to 1 on every page, so
              comparing a block's `position` setting against it
              directly would render that block once per page instead
              of once at the intended spot in the overall result set
              -- the same bug found in main-collection.liquid's
              original banner/carousel loop. Same reasoning applies
              to the "position beyond the end" case: it's gated on
              `paginate.next` being absent, so the "append at the
              end" fallback only fires on the last page.
            {%- endcomment -%}

            <div class="search-feed" id="search-feed" data-search-feed>

              <div
                id="panel-products"
                class="search-feed__panel"
                role="tabpanel"
                aria-labelledby="tab-products"
                data-panel="product"
                {%- if active_type != 'product' %} hidden{%- endif %}
              >
                {%- if active_type == 'product' -%}

                  {%- comment -%} snippet: product-results (formerly snippets/product-results.liquid) {%- endcomment -%}
                  <div id="product-results" class="product-results">

                    {%- liquid
                      assign banner_blocks   = section.blocks | where: 'type', 'promo_banner'
                      assign carousel_blocks = section.blocks | where: 'type', 'promo_carousel'
                    -%}

                    {%- paginate search.results by section.settings.results_per_page -%}

                      <div
                        id="search-results-grid"
                        class="search-results-grid"
                        style="--columns: {{ section.settings.columns | default: 4 }};"
                      >
                        {%- for result in search.results -%}

                          {%- assign absolute_index = paginate.current_offset | plus: forloop.index -%}

                          {%- for banner in banner_blocks -%}
                            {%- assign banner_position = banner.settings.position | default: 0 -%}
                            {%- if banner_position > 0 and banner_position == absolute_index -%}
                              {%- render 'promo-banner', block: banner -%}
                            {%- endif -%}
                          {%- endfor -%}

                          {%- for carousel in carousel_blocks -%}
                            {%- assign carousel_position = carousel.settings.position | default: 0 -%}
                            {%- if carousel_position > 0 and carousel_position == absolute_index -%}
                              {%- render 'promo-carousel', block: carousel -%}
                            {%- endif -%}
                          {%- endfor -%}

                          {%- render 'product-card', product: result -%}

                        {%- else -%}
                          <p class="search-empty">No products found for &ldquo;{{ search_terms }}&rdquo;.</p>
                        {%- endfor -%}

                        {%- comment -%}
                          "Position beyond the result count" = "put it at the end".
                          Only render on the last page (no paginate.next), or this
                          would append the block once per page instead of once,
                          overall.
                        {%- endcomment -%}
                        {%- unless paginate.next -%}
                          {%- for banner in banner_blocks -%}
                            {%- assign banner_position = banner.settings.position | default: 0 -%}
                            {%- if banner_position > 0 and banner_position > paginate.items -%}
                              {%- render 'promo-banner', block: banner -%}
                            {%- endif -%}
                          {%- endfor -%}

                          {%- for carousel in carousel_blocks -%}
                            {%- assign carousel_position = carousel.settings.position | default: 0 -%}
                            {%- if carousel_position > 0 and carousel_position > paginate.items -%}
                              {%- render 'promo-carousel', block: carousel -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endunless -%}
                      </div>

                      {%- if paginate.pages > 1 -%}
                        <nav class="pagination" aria-label="Pagination">
                          {%- if paginate.previous -%}
                            <a href="{{ paginate.previous.url }}&type=product" class="pagination__link">&larr; Previous</a>
                          {%- endif -%}
                          {%- for part in paginate.parts -%}
                            {%- if part.is_link -%}
                              <a href="{{ part.url }}&type=product" class="pagination__link">{{ part.title }}</a>
                            {%- else -%}
                              <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
                            {%- endif -%}
                          {%- endfor -%}
                          {%- if paginate.next -%}
                            <a href="{{ paginate.next.url }}&type=product" class="pagination__link">Next &rarr;</a>
                          {%- endif -%}
                        </nav>
                      {%- endif -%}

                    {%- endpaginate -%}

                  </div>
                  {%- comment -%} /snippet: product-results {%- endcomment -%}

                {%- endif -%}
              </div>

              <div
                id="panel-articles"
                class="search-feed__panel"
                role="tabpanel"
                aria-labelledby="tab-articles"
                data-panel="article"
                {%- if active_type != 'article' %} hidden{%- endif %}
              >
                {%- if active_type == 'article' -%}

                  {%- comment -%} snippet: article-results (formerly snippets/article-results.liquid) {%- endcomment -%}
                  <div id="article-results" class="article-results">

                    {%- paginate search.results by section.settings.results_per_page -%}

                      <div id="search-articles-grid" class="article-feed">
                        {%- for result in search.results -%}
                          {%- render 'article-card', article: result -%}
                        {%- else -%}
                          <p class="search-empty">No articles found for &ldquo;{{ search_terms }}&rdquo;.</p>
                        {%- endfor -%}
                      </div>

                      {%- if paginate.pages > 1 -%}
                        <nav class="pagination" aria-label="Pagination">
                          {%- if paginate.previous -%}
                            <a href="{{ paginate.previous.url }}&type=article" class="pagination__link">&larr; Previous</a>
                          {%- endif -%}
                          {%- for part in paginate.parts -%}
                            {%- if part.is_link -%}
                              <a href="{{ part.url }}&type=article" class="pagination__link">{{ part.title }}</a>
                            {%- else -%}
                              <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
                            {%- endif -%}
                          {%- endfor -%}
                          {%- if paginate.next -%}
                            <a href="{{ paginate.next.url }}&type=article" class="pagination__link">Next &rarr;</a>
                          {%- endif -%}
                        </nav>
                      {%- endif -%}

                    {%- endpaginate -%}

                  </div>
                  {%- comment -%} /snippet: article-results {%- endcomment -%}

                {%- endif -%}
              </div>

            </div>
          </div>

        </div>

      </section>

    {%- else -%}

      <div class="search-hero__prompt">
        <p>Enter a search term above to get started.</p>
      </div>

    {%- endif -%}

  </div>

  <div class="search-mobile-backdrop" aria-hidden="true"></div>

</div>

{%- comment -%}
  main-search.js owns the filter drawer, live filtering, the sort
  <select>, AJAX tab switching (Products <-> Articles, via the Section
  Rendering API), and scroll-restore for both result grids. See the
  file's own header comment for the full breakdown.
{%- endcomment -%}
<script src="{{ 'main-search.js' | asset_url }}" defer></script>
<script src="{{ 'promo-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main search",
  "tag": "section",
  "class": "section-search",
  "settings": [
    {
      "type": "text",
      "id": "tab_products_label",
      "label": "Products tab label",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "tab_articles_label",
      "label": "Articles tab label",
      "default": "Articles"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filters (Products tab only)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort (Products tab only)",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "In-feed banners"
    },
    {
      "type": "paragraph",
      "content": "Add 'In-feed banner' blocks below to place promotional banners inside the product results grid. Each banner has its own position number and size — set both per block. Products-tab only; banners are not shown in article results."
    },
    {
      "type": "header",
      "content": "Promo carousels"
    },
    {
      "type": "paragraph",
      "content": "Add a 'Promo carousel' block to insert a product carousel into the product results grid. Set its collection directly on the block. Products-tab only; carousels are not shown in article results."
    }
  ],
  "blocks": [
    {
      "type": "promo_banner",
      "name": "Promo Banner",
      "settings": [
        {
          "type": "number",
          "id": "position",
          "label": "Position in results grid",
