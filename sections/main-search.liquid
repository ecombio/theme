{%- comment -%}
  sections/main-search.liquid
  Renders /search results.

  Shopify's `search` object can return three result types in one
  query: product, page, article. This section splits them into a
  type-filter tab bar so the product grid can reuse product-card.liquid
  unmodified (that snippet only ever expects a Product object) while
  pages/articles get their own lightweight result row.

  No on-page search bar here — the header's search input is the only
  entry point into /search; this section is purely the results view.

  FILTERING:
    Reuses snippets/collection-filter.liquid, same as sections/collection.liquid,
    instead of a bespoke search filter UI. Rendered inside the same
    .collection-body / .collection-body__feed wrapper collection.liquid
    uses so collection-filter's layout CSS (in collection.css) applies
    unchanged.
    collection-filter.liquid was originally written only against the
    `collection` object and has been patched (branching on
    `template.name`) to read from `search` instead when rendered here —
    see the CONTEXT note at the top of that snippet for specifics
    (sort options fallback, hidden q/type inputs on the filter form).
    Requires this section's show_filters / show_sort settings below,
    same setting ids collection-filter.liquid already expects.

  ASSET OWNERSHIP:
    This section renders 'product-card' and 'collection-filter', so it
    owns loading both of their CSS dependencies (product-card.css,
    collection.css — collection-filter.css is loaded by the snippet
    itself) plus collection-filter.js, the same way collection.liquid
    owns its own dependencies.

  Wired to assets/main-search.js (loaded below, section-scoped).
{%- endcomment -%}

{{ 'collection.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'main-search.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign search_terms = search.terms
  assign total_results = search.results_size

  assign current_type = search.types | first
  if current_type == blank
    assign current_type = 'all'
  endif

  assign sort_by = search.sort_by | default: 'relevance'
-%}

<div class="main-search" data-main-search>

  {%- comment -%}── HEADER ──{%- endcomment -%}
  <div class="main-search__header">
    {%- if search.performed -%}
      <h1 class="main-search__title">
        {%- if total_results > 0 -%}
          {{ total_results }} result{% if total_results != 1 %}s{% endif %} for
          <span class="main-search__term">&ldquo;{{ search_terms }}&rdquo;</span>
        {%- else -%}
          No results for <span class="main-search__term">&ldquo;{{ search_terms }}&rdquo;</span>
        {%- endif -%}
      </h1>
    {%- else -%}
      <h1 class="main-search__title">Search</h1>
    {%- endif -%}
  </div>

  {%- if search.performed and total_results > 0 -%}
  {%- paginate search.results by section.settings.results_per_page -%}
  {%- comment -%}
    NOTE: product_results/page_results/article_results are derived from
    search.results, which is already paginated at this point. Their
    .size counts (shown in the tab labels below) reflect only the
    current page, not the true total per type — Shopify's search
    object doesn't expose per-type totals independent of pagination.
    Good enough for tab labels; don't rely on these for anything that
    needs an exact grand total.
  {%- endcomment -%}
  {%- liquid
    assign product_results = search.results | where: 'object_type', 'product'
    assign page_results = search.results | where: 'object_type', 'page'
    assign article_results = search.results | where: 'object_type', 'article'
  -%}

  <div class="collection-body">

    {%- render 'collection-filter-1' -%}

    <div class="collection-body__feed">

    {%- comment -%}── TYPE FILTER TABS ──{%- endcomment -%}
    <div class="main-search__controls">
      <div class="main-search__tabs" role="tablist" data-search-tabs>
        <button
          type="button"
          class="main-search__tab{% if current_type == 'all' %} main-search__tab--active{% endif %}"
          data-search-tab="all"
          role="tab"
          aria-selected="{% if current_type == 'all' %}true{% else %}false{% endif %}"
        >
          All ({{ total_results }})
        </button>
        {%- if product_results.size > 0 -%}
          <button
            type="button"
            class="main-search__tab{% if current_type == 'product' %} main-search__tab--active{% endif %}"
            data-search-tab="product"
            role="tab"
            aria-selected="{% if current_type == 'product' %}true{% else %}false{% endif %}"
          >
            Products ({{ product_results.size }})
          </button>
        {%- endif -%}
        {%- if page_results.size > 0 -%}
          <button
            type="button"
            class="main-search__tab{% if current_type == 'page' %} main-search__tab--active{% endif %}"
            data-search-tab="page"
            role="tab"
            aria-selected="{% if current_type == 'page' %}true{% else %}false{% endif %}"
          >
            Pages ({{ page_results.size }})
          </button>
        {%- endif -%}
        {%- if article_results.size > 0 -%}
          <button
            type="button"
            class="main-search__tab{% if current_type == 'article' %} main-search__tab--active{% endif %}"
            data-search-tab="article"
            role="tab"
            aria-selected="{% if current_type == 'article' %}true{% else %}false{% endif %}"
          >
            Articles ({{ article_results.size }})
          </button>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}── PRODUCT GRID ──{%- endcomment -%}
    {%- if product_results.size > 0 -%}
      <div
        class="product-feed__grid main-search__grid"
        data-search-panel="product"
        {% if current_type != 'all' and current_type != 'product' %}hidden{% endif %}
      >
        {%- for product in product_results -%}
          {%- render 'product-card', product: product, show_quickview: true, show_compare: true, show_eta: true -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%}── PAGE RESULTS ──{%- endcomment -%}
    {%- if page_results.size > 0 -%}
      <ul
        class="main-search__result-list"
        data-search-panel="page"
        {% if current_type != 'all' and current_type != 'page' %}hidden{% endif %}
      >
        {%- for result in page_results -%}
          <li class="main-search__result-row">
            <a href="{{ result.url }}" class="main-search__result-title">{{ result.title }}</a>
            {%- if result.content != blank -%}
              <p class="main-search__result-excerpt">{{ result.content | strip_html | truncatewords: 30 }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- comment -%}── ARTICLE RESULTS ──{%- endcomment -%}
    {%- if article_results.size > 0 -%}
      <ul
        class="main-search__result-list"
        data-search-panel="article"
        {% if current_type != 'all' and current_type != 'article' %}hidden{% endif %}
      >
        {%- for result in article_results -%}
          <li class="main-search__result-row">
            <a href="{{ result.url }}" class="main-search__result-title">{{ result.title }}</a>
            {%- if result.excerpt_or_content != blank -%}
              <p class="main-search__result-excerpt">{{ result.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- comment -%}── PAGINATION ──{%- endcomment -%}
    {%- if paginate.pages > 1 -%}
      <nav class="main-search__pagination" role="navigation" aria-label="Pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="main-search__page-link main-search__page-link--prev">Previous</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="main-search__page-link">{{ part.title }}</a>
          {%- else -%}
            <span class="main-search__page-link main-search__page-link--current">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="main-search__page-link main-search__page-link--next">Next</a>
        {%- endif -%}
      </nav>
    {%- endif -%}

    </div>
    {%- comment -%} /collection-body__feed {%- endcomment -%}

  </div>
  {%- comment -%} /collection-body {%- endcomment -%}

  {%- endpaginate -%}
  {%- elsif search.performed -%}

    {%- comment -%}── EMPTY STATE ──{%- endcomment -%}
    <div class="main-search__empty">
      <p class="main-search__empty-text">
        Try checking your spelling, using fewer or more general words, or browse our collections instead.
      </p>
    </div>

  {%- endif -%}

</div>

<script src="{{ 'collection-filter.js' | asset_url }}" defer></script>
<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Search results",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort",
      "default": true
    }
  ]
}
{% endschema %}