{%- comment -%}
  sections/main-search.liquid

  Note: neither 'search-filter.css' nor 'search-results.css' are
  loaded here -- both are loaded directly by their own snippets
  (snippets/search-filter.liquid and snippets/search-results.liquid
  respectively), so each stays self-contained. Adding either
  stylesheet_tag here as well would load it twice.

  PRODUCT-CARD ASSETS (2026-07 fix): 'product-card.css' and
  'product-card.js' were previously not loaded anywhere in the
  search page's render path -- product-card.liquid's markup was
  rendering with no styling and no interactivity (add to cart,
  wishlist, quick view, compare all silently did nothing).

  These are loaded HERE rather than self-contained inside
  product-card.liquid itself, unlike search-filter.css/js and
  search-results.css/js: product-card.liquid renders once PER
  PRODUCT in the results grid, so a tag inside it would duplicate
  once per card. product-card.js binds its listeners via delegated
  document.body.addEventListener calls with no re-entry guard (unlike
  this file's own window.__searchFilterLoaded /
  window.__searchToolbarLoaded pattern below), so duplicate script
  tags would mean duplicate listeners firing per click -- e.g. one
  click on Add to cart adding N copies to the cart. Loading both
  exactly once at the section level, alongside main-search.css/js,
  avoids that entirely.

  If product-card.liquid is ever rendered from another section
  (main-collection.liquid, related-products.liquid, etc.), that
  section needs this same pair of tags too -- product-card.liquid
  does not carry its own.
{%- endcomment -%}
{{ 'main-search.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Use search.types as primary source of truth (most reliable)
  assign active_type = 'product'
  if search.types contains 'article'
    assign active_type = 'article'
  endif

  # Safety fallback from URL param
  assign type_from_url = request.query_parameters['type'] | default: ''
  if type_from_url == 'article'
    assign active_type = 'article'
  endif

  assign search_terms = search.terms
  assign results_count = search.results_count | default: 0

  # Whether the filter sidebar is enabled at all. Previously this was
  # also gated on active_type == 'product' (Shopify has no faceted
  # filtering for articles), which hid the whole sidebar -- and
  # collapsed the feed to full width -- the moment you switched to
  # the Articles tab. Now the sidebar stays put on both tabs
  # (search-filter.liquid shows a placeholder message on Articles
  # instead of disappearing), so this only reflects the merchant's
  # setting.
  assign show_filters = false
  if section.settings.show_filters
    assign show_filters = true
  endif

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'search-page__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'search-page__full-width'
  else
    assign width_class = 'search-page__custom-width'
  endif
-%}

<div class="main-search" id="main-search" data-section-id="{{ section.id }}">

  <div
    class="search-page {{ width_class }}"
    data-search-page
    data-active-type="{{ active_type }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >

    <div class="search-hero" id="search-hero">
      {%- if search.performed -%}
        <h1 class="search-title">Search results</h1>
        {%- if search_terms != blank -%}
          <p class="search-result-count" id="search-result-count">
            {{ results_count }} result{% if results_count != 1 %}s{% endif %} for &ldquo;{{ search_terms }}&rdquo;
          </p>
        {%- endif -%}
      {%- else -%}
        <h1 class="search-title">Search</h1>
      {%- endif -%}
    </div>

    {%- if search.performed -%}

      <section class="search-section">

        {%- render 'search-toolbar', search_terms: search_terms, active_type: active_type, show_filters: show_filters, section: section -%}

        {%- comment -%}
          OPEN QUESTION (not yet verified): search-body--filters-hidden
          has no matching rule in the cleaned main-search.css -- the
          FLEXBOX FIX note there says a hidden flex sibling just stops
          taking space, so this class may be a vestige of the old
          grid-based fix. Before removing it, confirm nothing in
          search-toolbar.js / main-search.js / search-filter.js reads
          this class name.
        {%- endcomment -%}
        <div class="search-body{% unless show_filters %} search-body--filters-hidden{% endunless %}" data-search-body>

          {%- if section.settings.show_filters -%}
            {%- render 'search-filter', search_terms: search_terms, active_type: active_type, show_filters: show_filters -%}
          {%- endif -%}

          <div class="search-body__feed">
            {%- render 'search-results', search_terms: search_terms, active_type: active_type, section: section -%}
          </div>

        </div>

      </section>

    {%- else -%}

      <div class="search-hero__prompt">
        <p>Enter a search term above to get started.</p>
      </div>

    {%- endif -%}

  </div>

  <div class="search-mobile-backdrop" aria-hidden="true"></div>

</div>

{%- comment -%}
  OPEN QUESTION (not yet verified): this comment says main-search.js
  has been retired in favor of search-toolbar.js, but the script tag
  below still loads it. Check assets/main-search.js directly -- if
  it's empty/dead, delete the tag below; if it still does something,
  fix this comment instead.

  This is now more than an open question -- if ajax_navigation is on,
  this <script> tag will NOT re-execute after search-toolbar.js
  replaces #main-search via fetch (browsers don't run scripts injected
  via replaceWith/innerHTML). If main-search.js does any per-load
  setup, that setup will silently stop running on the 2nd+ tab switch.
  UNVERIFIED until main-search.js is reviewed -- do not ship
  ajax_navigation: true as the default until this is checked.
{%- endcomment -%}
<script src="{{ 'main-search.js' | asset_url }}" defer></script>
<script src="{{ 'product-card.js' | asset_url }}" defer></script>

