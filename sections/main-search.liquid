{%- comment -%} sections/main-search.liquid — Products/Articles are now two independently-paginated searches; switching tabs is a real navigation (type=product vs type=article), not a client-side toggle. {%- endcomment -%}
{{ 'main-search.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign requested_type = request.query_parameters['type'] | default: 'product'
  unless requested_type == 'product' or requested_type == 'article'
    assign requested_type = 'product'
  endunless

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'collection-page__default-width'
  else
    assign width_class = 'collection-page__custom-width'
  endif
-%}

<div class="main-search" id="main-search" data-section-id="{{ section.id }}">

  <div
    class="collection-page {{ width_class }}"
    data-search-page
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >

    <div class="collection-hero" id="search-hero">
      {%- if search.performed -%}
        <h1 class="collection-title">Search results for &ldquo;{{ search.terms }}&rdquo;</h1>
        <p class="search-result-count">
          {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}
        </p>
      {%- else -%}
        <h1 class="collection-title">Search</h1>
      {%- endif -%}
    </div>

    <section class="collection-section">

      <div class="collection-toolbar" id="search-toolbar" role="navigation" aria-label="Search filters navigation">

        {%- if section.settings.show_filters and requested_type == 'product' -%}
          <button
            class="collection-toolbar__filter-toggle"
            type="button"
            aria-expanded="true"
            aria-controls="collection-filter"
            aria-label="Toggle filters"
            data-filter-toggle
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 4h12M4 8h8M6 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Filters
          </button>
        {%- endif -%}

        <div class="tab-switcher" role="tablist" aria-label="Search results view">
          
            href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product"
            class="tab-switcher__tab{% if requested_type == 'product' %} tab-switcher__tab--active{% endif %}"
            role="tab"
            aria-selected="{% if requested_type == 'product' %}true{% else %}false{% endif %}"
            aria-controls="panel-products"
            id="tab-products"
            data-tab="product"
          >{{ section.settings.tab_products_label | default: 'Products' }}</a>

          
            href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=article"
            class="tab-switcher__tab{% if requested_type == 'article' %} tab-switcher__tab--active{% endif %}"
            role="tab"
            aria-selected="{% if requested_type == 'article' %}true{% else %}false{% endif %}"
            aria-controls="panel-articles"
            id="tab-articles"
            data-tab="article"
          >{{ section.settings.tab_articles_label | default: 'Articles' }}</a>
        </div>

      </div>

      {%- if section.settings.show_filters and requested_type == 'product' -%}
        <div class="collection-mobile-bar" aria-label="Search controls" role="toolbar">
          <button
            class="collection-mobile-bar__btn"
            type="button"
            aria-expanded="false"
            aria-controls="collection-filter"
            aria-label="Toggle filters"
            data-filter-toggle
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 4h12M4 8h8M6 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Filters
          </button>
        </div>
      {%- endif -%}

      {%- comment -%}
        Filters/sort only make sense for the product search — search.filters
        is generated against whatever `type` the current request used, so on
        the Articles tab it'd either be empty or full of product-shaped
        facets that don't apply. Only show the sidebar on the Products tab.
      {%- endcomment -%}
      <div class="collection-body{% if requested_type == 'article' or section.settings.show_filters == false %} collection-body--filters-hidden{% endif %}">

        {%- if requested_type == 'product' and section.settings.show_filters -%}
          <aside class="collection-filter" id="collection-filter" aria-label="Product filters">

            {%- if section.settings.show_sort -%}
              <div class="collection-filter__sort">
                <label for="SortBy">Sort</label>
                <select id="SortBy" data-sort>
                  {%- for option in search.sort_options -%}
                    <option value="{{ option.value }}"{% if option.value == search.sort_by %} selected{% endif %}>
                      {{ option.name }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}

            <form method="get" action="{{ routes.search_url }}" id="FilterForm">
              <input type="hidden" name="q" value="{{ search.terms | escape }}">
              <input type="hidden" name="type" value="product">

              {%- for filter in search.filters -%}
                <details class="collection-filter__group" open>
                  <summary class="collection-filter__group-label">
                    {{ filter.label }}
                    {%- if filter.active_values.size > 0 -%}
                      <span class="collection-filter__group-badge">{{ filter.active_values.size }}</span>
                    {%- endif -%}
                  </summary>

                  <div class="collection-filter__group-body">
                    {%- case filter.type -%}
                      {%- when 'list' -%}
                        {%- for value in filter.values -%}
                          <label class="collection-filter__option
                            {%- if value.active %} collection-filter__option--active{%- endif %}
                            {%- if value.count == 0 and value.active == false %} collection-filter__option--disabled{%- endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {%- if value.active %} checked{%- endif %}
                              {%- if value.count == 0 and value.active == false %} disabled{%- endif %}
                            >
                            {{ value.label }} <span>({{ value.count }})</span>
                          </label>
                        {%- endfor -%}

                      {%- when 'price_range' -%}
                        <div class="collection-filter__price">
                          <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" min="0" max="{{ filter.range_max }}" placeholder="0">
                          <span>–</span>
                          <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" min="0" max="{{ filter.range_max }}" placeholder="{{ filter.range_max }}">
                        </div>
                    {%- endcase -%}
                  </div>
                </details>
              {%- endfor -%}

              {%- assign active_count = 0 -%}
              {%- for filter in search.filters -%}
                {%- assign active_count = active_count | plus: filter.active_values.size -%}
              {%- endfor -%}

              {%- if active_count > 0 -%}
                <div class="collection-filter__active">
                  {%- for filter in search.filters -%}
                    {%- for value in filter.active_values -%}
                      <a href="{{ value.url_to_remove }}" class="collection-filter__pill">{{ value.label }} &times;</a>
                    {%- endfor -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <button type="submit" class="collection-filter__submit">Apply</button>
            </form>

          </aside>
        {%- endif -%}

        <div class="collection-body__feed">

          {%- if requested_type == 'product' -%}
            <div class="collection-feed" id="search-feed">
              {{ 'product-card.css' | asset_url | stylesheet_tag }}

              {%- paginate search.results by section.settings.results_per_page -%}

                <div id="product-feed" class="product-feed" style="--columns: {{ section.settings.columns | default: 4 }};">
                  <div class="product-feed__grid">
                    {%- assign has_results = false -%}
                    {%- for item in search.results -%}
                      {%- if item.object_type == 'product' -%}
                        {%- assign has_results = true -%}
                        {%- render 'product-card', product: item -%}
                      {%- endif -%}
                    {%- endfor -%}

                    {%- unless has_results -%}
                      <p class="collection-empty">
                        {%- if search.performed -%}
                          No product results found for &ldquo;{{ search.terms }}&rdquo;.
                        {%- else -%}
                          Enter a search term to see results.
                        {%- endif -%}
                      </p>
                    {%- endunless -%}
                  </div>
                </div>

                {%- if paginate.pages > 1 -%}
                  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
                    {%- if paginate.previous -%}
                      <a href="{{ paginate.previous.url }}&type=product" class="pagination__link">&larr; {{ 'general.pagination.previous' | t }}</a>
                    {%- endif -%}
                    {%- for part in paginate.parts -%}
                      {%- if part.is_link -%}
                        <a href="{{ part.url }}&type=product" class="pagination__link">{{ part.title }}</a>
                      {%- else -%}
                        <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if paginate.next -%}
                      <a href="{{ paginate.next.url }}&type=product" class="pagination__link">{{ 'general.pagination.next' | t }} &rarr;</a>
                    {%- endif -%}
                  </nav>
                {%- endif -%}

              {%- endpaginate -%}
            </div>

          {%- else -%}
            <div class="collection-feed" id="search-feed">
              {{ 'article-card.css' | asset_url | stylesheet_tag }}

              {%- paginate search.results by section.settings.results_per_page -%}

                <div class="article-feed">
                  {%- assign has_results = false -%}
                  {%- for item in search.results -%}
                    {%- if item.object_type == 'article' -%}
                      {%- assign has_results = true -%}
                      {%- render 'article-card', article: item -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {%- unless has_results -%}
                    <p class="collection-empty">
                      {%- if search.performed -%}
                        No article results found for &ldquo;{{ search.terms }}&rdquo;.
                      {%- else -%}
                        Enter a search term to see results.
                      {%- endif -%}
                    </p>
                  {%- endunless -%}
                </div>

                {%- if paginate.pages > 1 -%}
                  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
                    {%- if paginate.previous -%}
                      <a href="{{ paginate.previous.url }}&type=article" class="pagination__link">&larr; {{ 'general.pagination.previous' | t }}</a>
                    {%- endif -%}
                    {%- for part in paginate.parts -%}
                      {%- if part.is_link -%}
                        <a href="{{ part.url }}&type=article" class="pagination__link">{{ part.title }}</a>
                      {%- else -%}
                        <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if paginate.next -%}
                      <a href="{{ paginate.next.url }}&type=article" class="pagination__link">{{ 'general.pagination.next' | t }} &rarr;</a>
                    {%- endif -%}
                  </nav>
                {%- endif -%}

              {%- endpaginate -%}
            </div>
          {%- endif -%}

        </div>

      </div>

    </section>

  </div>

  <div class="collection-mobile-backdrop" aria-hidden="true"></div>

</div>

<script src="{{ 'main-search.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main search",
  "tag": "section",
  "class": "section-search",
  "settings": [
    {
      "type": "text",
      "id": "tab_products_label",
      "label": "Products tab label",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "tab_articles_label",
      "label": "Articles tab label",
      "default": "Articles"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    { "name": "Main search" }
  ]
}
{% endschema %}