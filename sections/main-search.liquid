{%- comment -%} sections/main-search.liquid {%- endcomment -%}
{{ 'main-search.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Use search.types as primary source of truth (most reliable)
  assign active_type = 'product'
  if search.types contains 'article'
    assign active_type = 'article'
  endif

  # Safety fallback from URL param
  assign type_from_url = request.query_parameters['type'] | default: ''
  if type_from_url == 'article'
    assign active_type = 'article'
  endif

  assign search_terms = search.terms
  assign results_count = search.results_count | default: 0

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'search-page__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'search-page__custom-width'
  else
    assign width_class = 'search-page__custom-width'
  endif
-%}

<div class="main-search" id="main-search" data-section-id="{{ section.id }}">

  <div
    class="search-page {{ width_class }}"
    data-search-page
    data-active-type="{{ active_type }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >

    <div class="search-hero" id="search-hero">
      {%- if search.performed -%}
        <h1 class="search-title">Search results</h1>
        {%- if search_terms != blank -%}
          <p class="search-result-count">
            {{ results_count }} result{% if results_count != 1 %}s{% endif %} for &ldquo;{{ search_terms }}&rdquo;
          </p>
        {%- endif -%}
      {%- else -%}
        <h1 class="search-title">Search</h1>
      {%- endif -%}
    </div>

    {%- if search.performed -%}

      <section class="search-section">

        <div class="search-toolbar" id="search-toolbar" role="navigation" aria-label="Search results navigation">

          <div class="tab-switcher" role="tablist" aria-label="Search result type">
            <a
              href="{{ routes.search_url }}?q={{ search_terms | url_param_escape }}&type=product"
              class="tab-switcher__tab{% if active_type == 'product' %} tab-switcher__tab--active{% endif %}"
              role="tab"
              aria-selected="{% if active_type == 'product' %}true{% else %}false{% endif %}"
              aria-controls="panel-products"
              id="tab-products"
              data-type="product"
              tabindex="{% if active_type == 'product' %}0{% else %}-1{% endif %}"
            >{{ section.settings.tab_products_label | default: 'Products' }}</a>

            <a
              href="{{ routes.search_url }}?q={{ search_terms | url_param_escape }}&type=article"
              class="tab-switcher__tab{% if active_type == 'article' %} tab-switcher__tab--active{% endif %}"
              role="tab"
              aria-selected="{% if active_type == 'article' %}true{% else %}false{% endif %}"
              aria-controls="panel-articles"
              id="tab-articles"
              data-type="article"
              tabindex="{% if active_type == 'article' %}0{% else %}-1{% endif %}"
            >{{ section.settings.tab_articles_label | default: 'Articles' }}</a>
          </div>

          {%- if section.settings.show_sort -%}
            <div class="search-toolbar__sort"{% if active_type != 'product' %} style="display:none;"{% endif %}>
              <label for="SortBy" class="visually-hidden">Sort</label>
              <select id="SortBy" data-sort>
                {%- for option in search.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == search.sort_by %}selected{% endif %}>
                    {{ option.name }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}

        </div>

        {%- if section.settings.show_sort -%}
          <div class="search-mobile-bar" aria-label="Search controls" role="toolbar">
            <button
              class="search-mobile-bar__btn"
              type="button"
              aria-expanded="false"
              aria-label="Sort results"
              data-mobile-sort-toggle
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 4h8M2 8h6M2 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 3v10M9.5 10.5L12 13l2.5-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Sort
            </button>
          </div>
        {%- endif -%}

        <div class="search-feed" id="search-feed" data-search-feed>

          <!-- PRODUCTS PANEL -->
          <div
            id="panel-products"
            class="search-feed__panel"
            role="tabpanel"
            aria-labelledby="tab-products"
            data-panel="product"
            {%- if active_type != 'product' %} hidden{%- endif %}
          >
            {{ 'product-card.css' | asset_url | stylesheet_tag }}

            {%- if active_type == 'product' -%}
              {%- paginate search.results by section.settings.results_per_page -%}

                <div id="search-results-grid" class="search-results-grid" style="--columns: {{ section.settings.columns | default: 4 }};">
                  {%- for result in search.results -%}
                    {%- render 'product-card', product: result -%}
                  {%- else -%}
                    <p class="search-empty">No products found for &ldquo;{{ search_terms }}&rdquo;.</p>
                  {%- endfor -%}
                </div>

                {%- if paginate.pages > 1 -%}
                  <nav class="pagination" aria-label="Pagination">
                    {%- if paginate.previous -%}
                      <a href="{{ paginate.previous.url }}&type=product" class="pagination__link">&larr; Previous</a>
                    {%- endif -%}
                    {%- for part in paginate.parts -%}
                      {%- if part.is_link -%}
                        <a href="{{ part.url }}&type=product" class="pagination__link">{{ part.title }}</a>
                      {%- else -%}
                        <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if paginate.next -%}
                      <a href="{{ paginate.next.url }}&type=product" class="pagination__link">Next &rarr;</a>
                    {%- endif -%}
                  </nav>
                {%- endif -%}

              {%- endpaginate -%}
            {%- endif -%}
          </div>

          <!-- ARTICLES PANEL -->
          <div
            id="panel-articles"
            class="search-feed__panel"
            role="tabpanel"
            aria-labelledby="tab-articles"
            data-panel="article"
            {%- if active_type != 'article' %} hidden{%- endif %}
          >
            {{ 'article-card.css' | asset_url | stylesheet_tag }}

            {%- if active_type == 'article' -%}
              {%- paginate search.results by section.settings.results_per_page -%}

                <div id="search-articles-grid" class="article-feed">
                  {%- for result in search.results -%}
                    {%- render 'article-card', article: result -%}
                  {%- else -%}
                    <p class="search-empty">No articles found for &ldquo;{{ search_terms }}&rdquo;.</p>
                  {%- endfor -%}
                </div>

                {%- if paginate.pages > 1 -%}
                  <nav class="pagination" aria-label="Pagination">
                    {%- if paginate.previous -%}
                      <a href="{{ paginate.previous.url }}&type=article" class="pagination__link">&larr; Previous</a>
                    {%- endif -%}
                    {%- for part in paginate.parts -%}
                      {%- if part.is_link -%}
                        <a href="{{ part.url }}&type=article" class="pagination__link">{{ part.title }}</a>
                      {%- else -%}
                        <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if paginate.next -%}
                      <a href="{{ paginate.next.url }}&type=article" class="pagination__link">Next &rarr;</a>
                    {%- endif -%}
                  </nav>
                {%- endif -%}

              {%- endpaginate -%}
            {%- endif -%}
          </div>

        </div>

      </section>

    {%- else -%}

      <div class="search-hero__prompt">
        <p>Enter a search term above to get started.</p>
      </div>

    {%- endif -%}

  </div>

  <div class="search-mobile-backdrop" aria-hidden="true"></div>

</div>

<script src="{{ 'main-search.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main search",
  "tag": "section",
  "class": "section-search",
  "settings": [
    {
      "type": "text",
      "id": "tab_products_label",
      "label": "Products tab label",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "tab_articles_label",
      "label": "Articles tab label",
      "default": "Articles"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort (Products tab only)",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Main search"
    }
  ]
}
{% endschema %}
