{%- comment -%}
  sections/main-search.liquid
  Built on main-collection's shell. Reuses main-collection.css,
  collection-filter.css/js, and main-collection.js UNCHANGED -- same
  ids/classes (#collection-active-filters, .collection-feed__panel,
  the tab-switcher, etc. -- wait, see note below) so that machinery
  (live-AJAX filtering, price slider, drawer, backdrop, sort select)
  just works here with zero forking.

  COMPONENTIZED (2026-07): the result panels are no longer inlined in
  this section. They're delegated to snippets/search-results.liquid,
  which in turn renders snippets/product-results.liquid and
  snippets/article-results.liquid -- each snippet owns its own grid
  markup/ids and its own CSS/JS pair (product-results.css/js,
  article-results.css/js), loaded below per the "snippets don't load
  their own assets, the parent section does" rule already documented
  in product-card.liquid. This is what makes the Articles tab
  reliably render through article-card: article-results.liquid is a
  dedicated, independently-testable component that only ever renders
  'article-card', instead of a second copy of that loop inlined here
  that could drift out of sync with it.

  The one thing search needs that collection doesn't: Shopify's
  search endpoint only returns ONE result type per request (whichever
  `type` param was sent), so the inactive tab's panel is empty on
  first load. main-search.js (loaded after main-collection.js) adds
  a lazy fetch-on-first-click for whichever tab wasn't server-rendered,
  then hands off to main-collection.js's normal tab toggle once that
  tab's data exists.
{%- endcomment -%}

{{ 'main-collection.css' | asset_url | stylesheet_tag }}
{{ 'main-search.css' | asset_url | stylesheet_tag }}
{{ 'search-results.css' | asset_url | stylesheet_tag }}
{{ 'product-results.css' | asset_url | stylesheet_tag }}
{{ 'article-results.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'article-card.css' | asset_url | stylesheet_tag }}
{{ 'promo-banner.css' | asset_url | stylesheet_tag }}
{{ 'promo-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign result_type = request.query_parameters['type'] | default: 'product'
  unless result_type == 'product' or result_type == 'article'
    assign result_type = 'product'
  endunless

  assign active_tab = 'products'
  if result_type == 'article'
    assign active_tab = 'articles'
  endif

  assign search_terms = search.terms
  assign results_count = search.results_count | default: 0

  assign active_filter_count = 0
  for filter in search.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
  endfor

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'collection-page__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'collection-page__full-width'
  else
    assign width_class = 'collection-page__custom-width'
  endif
-%}

<div class="main-collection" id="main-collection" data-section-id="{{ section.id }}">

  <div
    class="collection-page {{ width_class }}"
    data-collection-page
    data-search-page
    data-active-tab="{{ active_tab }}"
    data-search-terms="{{ search_terms }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >

    <div class="collection-hero" id="collection-hero">
      {%- if search.performed -%}
        <h1 class="collection-title">Search results</h1>
        {%- if search_terms != blank -%}
          <div class="collection-description rte" id="search-result-count">
            <p>{{ results_count }} result{% if results_count != 1 %}s{% endif %} for &ldquo;{{ search_terms }}&rdquo;</p>
          </div>
        {%- endif -%}
      {%- else -%}
        <h1 class="collection-title">Search</h1>
      {%- endif -%}
    </div>

    {%- if search.performed -%}
    <section class="collection-section">

      <div class="collection-toolbar" id="collection-toolbar" role="navigation" aria-label="Search results navigation">

        <div class="tab-switcher" role="tablist" aria-label="Search result type">
          <a
            href="{{ routes.search_url }}?q={{ search_terms | url_param_escape }}&type=product"
            class="tab-switcher__tab{% if active_tab == 'products' %} tab-switcher__tab--active{% endif %}"
            role="tab"
            aria-selected="{% if active_tab == 'products' %}true{% else %}false{% endif %}"
            aria-controls="panel-products"
            id="tab-products"
            data-tab="products"
            tabindex="{% if active_tab == 'products' %}0{% else %}-1{% endif %}"
          >{{ section.settings.tab_products_label | default: 'Products' }}</a>

          <a
            href="{{ routes.search_url }}?q={{ search_terms | url_param_escape }}&type=article"
            class="tab-switcher__tab{% if active_tab == 'articles' %} tab-switcher__tab--active{% endif %}"
            role="tab"
            aria-selected="{% if active_tab == 'articles' %}true{% else %}false{% endif %}"
            aria-controls="panel-articles"
            id="tab-articles"
            data-tab="articles"
            tabindex="{% if active_tab == 'articles' %}0{% else %}-1{% endif %}"
          >{{ section.settings.tab_articles_label | default: 'Articles' }}</a>
        </div>

        {%- if section.settings.show_filters -%}
          <div
            class="collection-active-filters"
            id="collection-active-filters"
            aria-label="Active filters"
            {%- if active_filter_count == 0 or result_type != 'product' %} hidden{%- endif %}
          >
            <div class="collection-active-filters__scroll">
              <button type="button" class="collection-active-filters__nav collection-active-filters__nav--prev" aria-label="Scroll active filters left" data-active-filters-prev>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="collection-active-filters__track" data-active-filters-track>
                {%- for filter in search.filters -%}
                  {%- for value in filter.active_values -%}
                    <a href="{{ value.url_to_remove }}&type=product" class="collection-filter__pill">{{ value.label }} &times;</a>
                  {%- endfor -%}
                {%- endfor -%}
              </div>
              <button type="button" class="collection-active-filters__nav collection-active-filters__nav--next" aria-label="Scroll active filters right" data-active-filters-next>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            {%- if active_filter_count > 0 -%}
              <a href="{{ routes.search_url }}?q={{ search_terms | url_param_escape }}&type=product" class="collection-filter__pill collection-filter__pill--clear">Clear all</a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_sort -%}
          <div class="collection-toolbar__sort"{% if result_type != 'product' %} style="display:none;"{% endif %}>
            <label for="SortBy" class="visually-hidden">Sort</label>
            <select id="SortBy" data-sort>
              {%- for option in search.sort_options -%}
                <option value="{{ option.value }}" {%- if option.value == search.sort_by %} selected{%- endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_filters or section.settings.show_sort -%}
        <div class="collection-mobile-bar" aria-label="Search controls" role="toolbar">
          {%- if section.settings.show_filters -%}
            <button class="collection-mobile-bar__btn" type="button" aria-expanded="false" aria-controls="collection-filter" aria-label="Toggle filters" data-filter-toggle>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 4h12M4 8h8M6 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              Filters
            </button>
          {%- endif -%}
          {%- if section.settings.show_sort -%}
            <button class="collection-mobile-bar__btn" type="button" aria-expanded="false" aria-label="Sort results" data-mobile-sort-toggle {%- if result_type != 'product' %} disabled{%- endif %}>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 4h8M2 8h6M2 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M12 3v10M9.5 10.5L12 13l2.5-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Sort
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="collection-body{% unless section.settings.show_filters %} collection-body--filters-hidden{% endunless %}">

        {%- if section.settings.show_filters -%}
          {%- if result_type == 'product' -%}
            {%- render 'collection-filter', search_terms: search_terms, result_type: 'product' -%}
          {%- else -%}
            {%- comment -%}
              Same width/id as the real filter form so switching tabs
              doesn't reflow the two-column layout -- placeholder
              content only, no <form>, since Shopify doesn't facet
              article results.
            {%- endcomment -%}
            <aside class="collection-filter" id="collection-filter" aria-label="Product filters">
              <div class="collection-filter__placeholder">
                <p class="collection-filter__placeholder-title">No filters for articles</p>
                <p class="collection-filter__placeholder-text">Filters only apply to product results. Switch tabs to narrow products down by price, type, and more.</p>
                <a href="{{ routes.search_url }}?q={{ search_terms | url_param_escape }}&type=product" class="collection-filter__placeholder-btn" data-tab="products">Switch to Products</a>
              </div>
            </aside>
          {%- endif -%}
        {%- endif -%}

        <div class="collection-body__feed">
          {%- render 'search-results', search_terms: search_terms, active_type: result_type, section: section -%}
        </div>
      </div>
    </section>
    {%- else -%}
      <div class="collection-hero__prompt">
        <p>Enter a search term above to get started.</p>
      </div>
    {%- endif -%}

  </div>

  <div class="collection-mobile-backdrop" aria-hidden="true"></div>

</div>

<script src="{{ 'main-collection.js' | asset_url }}" defer></script>
<script src="{{ 'main-search.js' | asset_url }}" defer></script>
<script src="{{ 'search-results.js' | asset_url }}" defer></script>
<script src="{{ 'product-results.js' | asset_url }}" defer></script>
<script src="{{ 'article-results.js' | asset_url }}" defer></script>
<script src="{{ 'promo-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main search",
  "tag": "section",
  "class": "section-search",
  "settings": [
    { "type": "text", "id": "tab_products_label", "label": "Products tab label", "default": "Products" },
    { "type": "text", "id": "tab_articles_label", "label": "Articles tab label", "default": "Articles" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "results_per_page", "label": "Results per page", "min": 4, "max": 48, "step": 4, "default": 16 },
    { "type": "checkbox", "id": "show_filters", "label": "Show filters (Products tab only)", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort (Products tab only)", "default": true },
    { "type": "header", "content": "Section layout" },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [
      { "value": "", "label": "Default" },
      { "value": "full-width", "label": "Full width" },
      { "value": "custom-width", "label": "Custom width" }
    ], "default": "" },
    { "type": "range", "id": "custom_width", "label": "Custom width", "min": 40, "max": 120, "step": 5, "unit": "rem", "default": 80, "visible_if": "{{ section.settings.section_width == 'custom-width' }}" },
    { "type": "range", "id": "section_padding", "label": "Side padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "header", "content": "In-feed banners" },
    { "type": "paragraph", "content": "Products-tab only; banners are not shown in article results." },
    { "type": "header", "content": "Promo carousels" },
    { "type": "paragraph", "content": "Products-tab only; carousels are not shown in article results." }
  ],
  "blocks": [
    { "type": "promo_banner", "name": "Promo Banner", "settings": [
      { "type": "number", "id": "position", "label": "Position in results grid" },
      { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
      { "type": "image_picker", "id": "mobile_image", "label": "Image (mobile)" },
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "text", "id": "subheading", "label": "Subheading" },
      { "type": "text", "id": "button_label", "label": "Button label" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
      { "type": "select", "id": "content_alignment", "label": "Content alignment", "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
      ], "default": "left" },
      { "type": "range", "id": "overlay_opacity", "label": "Image overlay darkness", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 20 },
      { "type": "range", "id": "column_span", "label": "Width (columns spanned)", "min": 1, "max": 4, "step": 1, "default": 2 },
      { "type": "range", "id": "row_span", "label": "Height (rows spanned)", "min": 1, "max": 3, "step": 1, "default": 1 }
    ]},
    { "type": "promo_carousel", "name": "Promo carousel", "settings": [
      { "type": "number", "id": "position", "label": "Position in results grid" },
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "text", "id": "subheading", "label": "Subheading" },
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "range", "id": "products_limit", "label": "Products to show", "min": 4, "max": 24, "step": 1, "default": 12 },
      { "type": "range", "id": "cards_per_row_desktop", "label": "Cards per row (desktop)", "min": 2, "max": 5, "step": 1, "default": 3 },
      { "type": "range", "id": "cards_per_row_mobile", "label": "Cards per row (mobile)", "min": 1, "max": 3, "step": 1, "default": 2 },
      { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
      { "type": "select", "id": "arrow_position", "label": "Arrow position", "options": [
        { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }, { "value": "side", "label": "Side" }
      ], "default": "bottom" },
      { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false },
      { "type": "range", "id": "autoplay_interval", "label": "Autoplay interval (seconds)", "min": 2, "max": 10, "step": 1, "default": 4 },
      { "type": "checkbox", "id": "show_banner", "label": "Show side banner", "default": false },
      { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
      { "type": "url", "id": "banner_link", "label": "Banner link" }
    ]}
  ],
  "presets": [{ "name": "Main search" }]
}
{% endschema %}
