{%- comment -%}
  sections/main-search.liquid

  Repurposed thin shell from main-collection.liquid for the search results page.
  Keeps 100% identical inner class names (collection-hero, collection-page, collection-body, etc.)
  so we can reuse main-collection.css + main-collection.js with ZERO changes to start.

  HOW TO USE:
  1. Drop this file in your theme's `sections/` folder.
  2. Copy your 3 snippets → create:
       snippets/search-toolbar.liquid
       snippets/search-filter.liquid
       snippets/search-feed.liquid
     (Start by duplicating the collection versions, then update variable names + data sources inside search-feed.liquid)
  3. In search-feed.liquid you will switch from `collection` to `search` object:
     - Products tab → filter search.results where object_type == 'product'
     - Articles tab → filter search.results where object_type == 'article'
  4. (Optional) If you want search-specific tweaks later, duplicate assets/main-collection.css → main-search.css
     and same for .js, then update the includes below + any hardcoded #main-collection selectors in JS.

  The active_tab query param (?tab=products or ?tab=articles) works exactly the same.
  Promo banners & carousels blocks are kept because they work great inside search result grids.
{%- endcomment -%}

{{ 'main-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign active_tab = request.query_parameters['tab'] | default: 'products'
  unless active_tab == 'products' or active_tab == 'articles'
    assign active_tab = 'products'
  endunless

  assign active_filter_count = 0
  # search object doesn't expose .filters the same way collection does.
  # Leave at 0 for now. You can enhance search-filter.liquid later with custom facets or JS filtering.

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'collection-page__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'collection-page__custom-width'
  else
    assign width_class = 'collection-page__custom-width'
  endif
-%}

<div class="main-collection main-search" id="main-collection" data-section-id="{{ section.id }}">

  <div
    class="collection-page {{ width_class }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >

    <div class="collection-hero" id="collection-hero">
      <h1 class="collection-title">
        Search results
        {%- if search.terms != blank -%}
          for &ldquo;{{ search.terms }}&rdquo;
        {%- endif -%}
      </h1>
    </div>

    <section class="collection-section">

      {%- render 'search-toolbar',
        section: section,
        search: search,
        active_tab: active_tab,
        active_filter_count: active_filter_count
      -%}

      <div class="collection-body{% unless section.settings.show_filters %} collection-body--filters-hidden{% endunless %}">

        {%- if section.settings.show_filters -%}
          {%- render 'search-filter', search: search -%}
        {%- endif -%}

        <div class="collection-body__feed">
          {%- render 'search-feed',
            search: search,
            section: section,
            active_tab: active_tab
          -%}
        </div>

      </div>

    </section>

    {# after-items metafield block removed — not applicable to global search #}

  </div>

  <div class="collection-mobile-backdrop" aria-hidden="true"></div>

</div>

<script src="{{ 'main-collection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main search",
  "tag": "section",
  "class": "section-search",
  "settings": [
    {
      "type": "text",
      "id": "tab_products_label",
      "label": "Products tab label",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "tab_articles_label",
      "label": "Articles tab label",
      "default": "Articles"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Results per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filters sidebar",
      "default": false,
      "info": "Search has limited native filters. Keep disabled until you add custom filtering (JS or app)."
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "In-feed banners & promo carousels"
    },
    {
      "type": "paragraph",
      "content": "Add Promo Banner or Promo Carousel blocks below. They insert into the results grid at the position you set — perfect for merchandizing on search pages."
    }
  ],
  "blocks": [
    {
      "type": "promo_banner",
      "name": "Promo Banner",
      "settings": [
        {
          "type": "number",
          "id": "position",
          "label": "Position in results grid",
          "info": "Banner appears before the Nth result on the current page. Leave blank or 0 to hide."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Image (mobile)",
          "info": "Optional. Falls back to the desktop image if not set."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Makes the entire banner clickable"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Content alignment",
          "info": "Aligns the heading, subheading, and button together",
          "options": [
            { "value": "left",   "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right",  "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image overlay darkness",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 20
        },
        {
          "type": "header",
          "content": "Size"
        },
        {
          "type": "range",
          "id": "column_span",
          "label": "Width (columns spanned)",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 2,
          "info": "Capped automatically on smaller screens so it never exceeds the live column count"
        },
        {
          "type": "range",
          "id": "row_span",
          "label": "Height (rows spanned)",
          "min": 1,
          "max": 3,
          "step": 1,
          "default": 1
        }
      ]
    },
    {
      "type": "promo_carousel",
      "name": "Promo carousel",
      "settings": [
        {
          "type": "number",
          "id": "position",
          "label": "Position in results grid",
          "info": "Carousel appears before the Nth result on this page. Leave blank or 0 to hide."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "header",
          "content": "Products in carousel"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection to show"
        },
        {
          "type": "range",
          "id": "products_limit",
          "label": "Products to show",
          "min": 4,
          "max": 24,
          "step": 1,
          "default": 12
        },
        {
          "type": "range",
          "id": "cards_per_row_desktop",
          "label": "Cards per row (desktop)",
          "min": 2,
          "max": 5,
          "step": 1,
          "default": 3
        },
        {
          "type": "range",
          "id": "cards_per_row_mobile",
          "label": "Cards per row (mobile)",
          "min": 1,
          "max": 3,
          "step": 1,
          "default": 2
        },
        {
          "type": "checkbox",
          "id": "show_arrows",
          "label": "Show arrows",
          "default": true
        },
        {
          "type": "select",
          "id": "arrow_position",
          "label": "Arrow position",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "side", "label": "Side" }
          ],
          "default": "bottom"
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "label": "Autoplay",
          "default": false
        },
        {
          "type": "range",
          "id": "autoplay_interval",
          "label": "Autoplay interval (seconds)",
          "min": 2,
          "max": 10,
          "step": 1,
          "default": 4
        },
        {
          "type": "header",
          "content": "Side banner (optional)"
        },
        {
          "type": "checkbox",
          "id": "show_banner",
          "label": "Show side banner",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "Banner image"
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "Banner link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main search",
      "blocks": []
    }
  ]
}
{% endschema %}