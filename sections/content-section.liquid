-%}

{%- style -%}

  {{ heading_font | font_face: font_display: 'swap' }}
  {{ sub_heading_font | font_face: font_display: 'swap' }}
  {{ text_font | font_face: font_display: 'swap' }}
  {{ button_font | font_face: font_display: 'swap' }}

  .cs-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
  }

  .cs-{{ section.id }}-wrap {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  .cs-{{ section.id }}-heading {
    order: {{ heading_position_mobile }};
    text-align: {{ heading_align_mobile }};
  }

  .cs-{{ section.id }}-heading * {
    margin: 0;
    font-size: {{ heading_size_mobile }}px;
    color: {{ heading_color }};
    line-height: {{ heading_height }}%;
    text-transform: unset;
  }

  .cs-{{ section.id }}-items {
    display: flex;
    align-items: center;
  }

  .cs-{{ section.id }}-media {
    width: {{ media_width_mobile }}%;
    border-radius: {{ media_radius }}px;
    border: {{ media_border_thickness }}px solid {{ media_border_color }};
    overflow: hidden;
    background-color: #e5e5e5;
  }

  .cs-{{ section.id }}-media img,
  .cs-{{ section.id }}-media svg,
  .cs-{{ section.id }}-media iframe,
  .cs-{{ section.id }}-media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    box-shadow: none;
  }

  .cs-{{ section.id }}-content {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: {{ content_padding_vertical_mobile }}px {{ content_padding_horizontal_mobile }}px;
  }

  .cs-{{ section.id }}-subheading {
    order: {{ sub_heading_position_mobile }};
    margin-top: {{ sub_heading_mt | times: 0.75 | round: 0 }}px;
    text-align: {{ sub_heading_align_mobile }};
  }

  .cs-{{ section.id }}-subheading * {
    margin: 0;
    font-size: {{ sub_heading_size_mobile }}px;
    color: {{ sub_heading_color }};
    line-height: {{ sub_heading_height }}%;
    text-transform: unset;
  }

  .cs-{{ section.id }}-text {
    order: {{ text_position_mobile }};
    margin-top: {{ text_mt | times: 0.75 | round: 0 }}px;
    text-align: {{ text_align_mobile }};
  }

  .cs-{{ section.id }}-text * {
    margin: 0;
    font-size: {{ text_size_mobile }}px;
    color: {{ text_color }};
    line-height: {{ text_height }}%;
    text-transform: unset;
  }

  .cs-{{ section.id }}-button {
    order: {{ button_position_mobile }};
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    max-width: fit-content;
    margin: 0;
    margin-top: {{ button_mt | times: 0.75 | round: 0 }}px;
    font-size: {{ button_size_mobile }}px;
    font-weight: 700;
    color: {{ button_color }};
    line-height: {{ button_height }}%;
    text-align: center;
    text-transform: unset;
    text-decoration: none;
    padding: {{ button_padding_vertical_mobile }}px {{ button_padding_horizontal_mobile }}px;
    border-radius: {{ button_radius }}px;
    border: {{ button_border_thickness }}px solid {{ button_border_color }};
    background-color: {{ button_bg_color }};
    transition: all 0.25s ease 0s;
  }

  .cs-{{ section.id }}-button:hover {
    color: {{ button_hover_color }};
    border: {{ button_border_thickness }}px solid {{ button_border_hover_color }};
    background-color: {{ button_bg_hover_color }};
  }

  .cs-{{ section.id }}-button svg {
    display: block;
    width: 24px;
    height: 24px;
  }

  @media (min-width: 1024px) {

    .cs-{{ section.id }} {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
    }

    .cs-{{ section.id }}-wrap {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }

    .cs-{{ section.id }}-heading {
      order: {{ heading_position }};
      text-align: {{ heading_align }};
    }

    .cs-{{ section.id }}-heading * {
      font-size: {{ heading_size }}px;
    }

    .cs-{{ section.id }}-media {
      width: 100%;
      flex: 0 0 {{ media_width }}%;
    }

    .cs-{{ section.id }}-content {
      flex: 0 1 {{ 100 | minus: media_width }}%;
      padding: {{ content_padding_vertical }}px {{ content_padding_horizontal }}px;
    }

    .cs-{{ section.id }}-subheading {
      order: {{ sub_heading_position }};
      margin-top: {{ sub_heading_mt }}px;
      text-align: {{ sub_heading_align }};
    }

    .cs-{{ section.id }}-subheading * {
      font-size: {{ sub_heading_size }}px;
    }

    .cs-{{ section.id }}-text {
      order: {{ text_position }};
      margin-top: {{ text_mt }}px;
      text-align: {{ text_align }};
    }

    .cs-{{ section.id }}-text * {
      font-size: {{ text_size }}px;
    }

    .cs-{{ section.id }}-button {
      order: {{ button_position }};
      margin-top: {{ button_mt }}px;
      padding: {{ button_padding_vertical }}px {{ button_padding_horizontal }}px;
      font-size: {{ button_size }}px;
    }
  }

  {%- unless full_width -%}
    .cs-{{ section.id }}-wrap {
      max-width: {{ content_width }}rem;
    }
  {%- endunless -%}

  {%- if heading_custom -%}
    .cs-{{ section.id }}-heading * {
      font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      font-weight: {{ heading_font.weight }};
      font-style: {{ heading_font.style }};
    }
  {%- endif -%}

  {%- if sub_heading_custom -%}
    .cs-{{ section.id }}-subheading * {
      font-family: {{ sub_heading_font.family }}, {{ sub_heading_font.fallback_families }};
      font-weight: {{ sub_heading_font.weight }};
      font-style: {{ sub_heading_font.style }};
    }
  {%- endif -%}

  {%- if text_custom -%}
    .cs-{{ section.id }}-text * {
      font-family: {{ text_font.family }}, {{ text_font.fallback_families }};
      font-weight: {{ text_font.weight }};
      font-style: {{ text_font.style }};
    }
  {%- endif -%}

  {%- if button_custom -%}
    .cs-{{ section.id }}-button {
      font-family: {{ button_font.family }}, {{ button_font.fallback_families }};
      font-weight: {{ button_font.weight }};
      font-style: {{ button_font.style }};
    }
  {%- endif -%}

  {%- if button_align_mobile == "center" -%}
    .cs-{{ section.id }}-button { margin-left: auto; margin-right: auto; }
  {%- elsif button_align_mobile == "right" -%}
    .cs-{{ section.id }}-button { margin-left: auto; }
  {%- endif -%}

  @media (min-width: 1024px) {
    {%- if button_align == "center" -%}
      .cs-{{ section.id }}-button { margin-left: auto; margin-right: auto; }
    {%- elsif button_align == "right" -%}
      .cs-{{ section.id }}-button { margin-left: auto; }
    {%- else -%}
      .cs-{{ section.id }}-button { margin-left: 0; margin-right: 0; }
    {%- endif -%}
  }

  {%- if media_position_mobile == "first" -%}
    .cs-{{ section.id }}-items { flex-direction: column; }
  {%- else -%}
    .cs-{{ section.id }}-items { flex-direction: column-reverse; }
  {%- endif -%}

  @media (min-width: 1024px) {
    {%- if media_position == "first" -%}
      .cs-{{ section.id }}-items { flex-direction: row; }
    {%- else -%}
      .cs-{{ section.id }}-items { flex-direction: row-reverse; }
    {%- endif -%}
  }

  {%- if media_ratio_mobile == "portrait" -%}
    .cs-{{ section.id }}-media { aspect-ratio: 9.6/12; }
  {%- elsif media_ratio_mobile == "landscape" -%}
    .cs-{{ section.id }}-media { aspect-ratio: 12/7; }
  {%- elsif media_ratio_mobile == "square" -%}
    .cs-{{ section.id }}-media { aspect-ratio: 12/12; }
  {%- endif -%}

  @media (min-width: 1024px) {
    {%- if media_ratio == "portrait" -%}
      .cs-{{ section.id }}-media { aspect-ratio: 9.6/12; }
    {%- elsif media_ratio == "landscape" -%}
      .cs-{{ section.id }}-media { aspect-ratio: 12/7; }
    {%- elsif media_ratio == "square" -%}
      .cs-{{ section.id }}-media { aspect-ratio: 12/12; }
    {%- endif -%}
  }

{%- endstyle -%}

<div class="cs-{{ section.id }}" style="background-color:{{ background_color }}; background-image: {{ background_gradient }};">
  <div class="cs-{{ section.id }}-wrap">
    <div class="cs-{{ section.id }}-items">

      <div class="cs-{{ section.id }}-media">
        {%- if media == "image" -%}
          {%- if image != blank -%}
            <img
              src="{{ image | image_url: width: 200 }}"
              srcset="
                {{ image | image_url: width: 400 }} 400w,
                {{ image | image_url: width: 800 }} 800w,
                {{ image | image_url: width: 1200 }} 1200w,
                {{ image | image_url: width: 1600 }} 1600w
              "
              sizes="(min-width: 1024px) {{ media_width }}vw, {{ media_width_mobile }}vw"
              alt="{{ image.alt | escape }}"
              width="{{ image.width }}"
              height="{{ image.height }}"
              loading="lazy"
              decoding="async"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag }}
          {%- endif -%}

        {%- else -%}
          {%- assign video_id = video.id | default: video_url.id -%}

          {%- if video == null and video_url != null -%}
            {%- comment -%} External embed: only build src on demand, never on initial paint {%- endcomment -%}
            {%- assign embed_params = '' -%}
            {%- if loop -%}
              {%- assign embed_params = embed_params | append: '&loop=1&playlist=' | append: video_id -%}
            {%- endif -%}
            {%- if autoplay -%}
              {%- assign embed_params = embed_params | append: '&mute=1&autoplay=1' -%}
            {%- endif -%}

            {%- if video_url.type == 'youtube' -%}
              <div
                class="cs-video-facade"
                data-embed-src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1{{ embed_params }}"
                data-autoplay="{{ autoplay }}"
                style="width:100%;height:100%;cursor:pointer;"
              >
                <img
                  src="https://i.ytimg.com/vi/{{ video_id }}/hqdefault.jpg"
                  alt="{{ heading | strip_html | escape }}"
                  loading="lazy"
                  decoding="async"
                  style="width:100%;height:100%;object-fit:cover;"
                >
              </div>
            {%- else -%}
              <div
                class="cs-video-facade"
                data-embed-src="https://player.vimeo.com/video/{{ video_id }}?{{ embed_params }}"
                data-autoplay="{{ autoplay }}"
                style="width:100%;height:100%;cursor:pointer;background:#000;"
              >
                {%- if poster != blank -%}
                  <img
                    src="{{ poster | image_url: width: 800 }}"
                    alt="{{ heading | strip_html | escape }}"
                    loading="lazy"
                    decoding="async"
                    style="width:100%;height:100%;object-fit:cover;"
                  >
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- else -%}
            {%- comment -%} Shopify-hosted video: load lazily via IntersectionObserver, no external library {%- endcomment -%}
            <video
              class="cs-lazy-video"
              {% if poster != blank %}poster="{{ poster | image_url: width: 800 }}"{% endif %}
              data-src="{{ video.sources[1].url }}"
              playsinline
              {% if loop %}loop{% endif %}
              {% if autoplay %}data-autoplay="true" muted{% endif %}
              {% if controls %}controls{% endif %}
              preload="none"
            ></video>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="cs-{{ section.id }}-content">

        {%- if heading != blank -%}
          <div class="cs-{{ section.id }}-heading">{{ heading }}</div>
        {%- endif -%}

        {%- if sub_heading != blank -%}
          <div class="cs-{{ section.id }}-subheading">{{ sub_heading }}</div>
        {%- endif -%}

        {%- if text != blank -%}
          <div class="cs-{{ section.id }}-text">{{ text }}</div>
        {%- endif -%}

        {%- if button != blank -%}
          <a href="{{ button_url }}" class="cs-{{ section.id }}-button">
            {{ button }}
            {%- if button_use_arrow -%}
              <svg viewBox="0 0 24 24" fill="none" width="24" height="24" focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path d="M4.09998 12H20.1M20.1 12L14.1 6M20.1 12L14.1 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            {%- endif -%}
          </a>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>

{%- comment -%}
  No external CDN dependency. Native `loading="lazy"` handles images.
  Shopify-hosted <video> tags and third-party embeds (YouTube/Vimeo) are
  loaded on-demand via a single, page-wide IntersectionObserver defined
  once regardless of how many instances of this section are on the page.
{%- endcomment -%}
<script>
  (function () {
    if (window.__csMediaObserverInit) return;
    window.__csMediaObserverInit = true;

    function playVideo(el) {
      if (el.dataset.loaded) return;
      el.dataset.loaded = 'true';
      el.src = el.dataset.src;
      el.load();
      if (el.dataset.autoplay === 'true') {
        var p = el.play();
        if (p && p.catch) p.catch(function () {});
      }
    }

    function loadFacade(el) {
      if (el.dataset.loaded) return;
      el.dataset.loaded = 'true';
      var iframe = document.createElement('iframe');
      iframe.src = el.dataset.embedSrc;
      iframe.setAttribute('allow', 'autoplay; encrypted-media');
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('loading', 'lazy');
      iframe.style.width = '100%';
      iframe.style.height = '100%';
      iframe.style.border = '0';
      el.innerHTML = '';
      el.appendChild(iframe);
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var el = entry.target;
          if (el.classList.contains('cs-lazy-video')) {
            playVideo(el);
          } else if (el.classList.contains('cs-video-facade')) {
            // Only auto-load on scroll into view if autoplay was requested;
            // otherwise wait for a click to save bandwidth.
            if (el.dataset.autoplay === 'true') loadFacade(el);
          }
          observer.unobserve(el);
        });
      },
      { rootMargin: '200px 0px' }
    );

    function bindClickToLoad() {
      document.querySelectorAll('.cs-video-facade:not([data-bound])').forEach(function (el) {
        el.setAttribute('data-bound', 'true');
        el.addEventListener('click', function () { loadFacade(el); });
      });
    }

    function observeAll() {
      document
        .querySelectorAll('.cs-lazy-video, .cs-video-facade')
        .forEach(function (el) {
          observer.observe(el);
        });
      bindClickToLoad();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', observeAll);
    } else {
      observeAll();
    }

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', observeAll);
    }
  })();
</script>

{% schema %}
  {
    "name": "Content Section",
    "settings": [
      {
        "type": "header",
        "content": "Media Settings"
      },
      {
        "type": "select",
        "id": "media",
        "label": "Media Selector",
        "default": "image",
        "options": [
          { "label": "Image", "value": "image" },
          { "label": "Video", "value": "video" }
        ]
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "video",
        "id": "video",
        "label": "Video from Shopify"
      },
      {
        "type": "video_url",
        "id": "video_url",
        "label": "Video Embed from Url",
        "accept": ["youtube", "vimeo"],
        "info": "Shows when no Shopify-hosted video is selected. Loads on scroll-into-view (or on click if autoplay is off)."
      },
      {
        "type": "image_picker",
        "id": "poster",
        "label": "Thumbnail image for video",
        "info": "Recommended for all videos — shown until the video loads, avoids layout shift and unnecessary requests."
      },
      {
        "type": "range",
        "id": "media_width",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "Media Width",
        "default": 50
      },
      {
        "type": "range",
        "id": "media_width_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "Media Width - Mobile",
        "default": 100
      },
      {
        "type": "select",
        "id": "media_position",
        "label": "Media Position",
        "default": "first",
        "options": [
          { "label": "First", "value": "first" },
          { "label": "Second", "value": "second" }
        ]
      },
      {
        "type": "select",
        "id": "media_position_mobile",
        "label": "Media Position - Mobile",
        "default": "first",
        "options": [
          { "label": "First", "value": "first" },
          { "label": "Second", "value": "second" }
        ]
      },
      {
        "type": "select",
        "id": "media_ratio",
        "label": "Media Aspect Ratio",
        "default": "square",
        "options": [
          { "label": "Original", "value": "original" },
          { "label": "Portrait", "value": "portrait" },
          { "label": "Square", "value": "square" },
          { "label": "Landscape", "value": "landscape" }
        ]
      },
      {
        "type": "select",
        "id": "media_ratio_mobile",
        "label": "Media Aspect Ratio - Mobile",
        "default": "landscape",
        "options": [
          { "label": "Original", "value": "original" },
          { "label": "Portrait", "value": "portrait" },
          { "label": "Square", "value": "square" },
          { "label": "Landscape", "value": "landscape" }
        ]
      },
      {
        "type": "range",
        "id": "media_border_thickness",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "Media Border Thickness",
        "default": 0
