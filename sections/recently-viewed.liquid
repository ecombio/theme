{{ 'recently-viewed.js' | asset_url | script_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .recently-viewed {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .recently-viewed[hidden] {
    display: none;
  }
  .recently-viewed__list {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    list-style: none;
    padding: 0;
    margin: 0;
    scroll-snap-type: x mandatory;
  }
  .recently-viewed__item {
    flex: 0 0 auto;
    width: 220px;
    scroll-snap-align: start;
  }
  .recently-viewed__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .recently-viewed__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius, 6px);
    margin-bottom: 0.5rem;
  }
  .recently-viewed__title {
    display: block;
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }
  .recently-viewed__price {
    display: block;
    font-size: 0.9rem;
    opacity: 0.8;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient page-width">
  <recently-viewed-products
    class="recently-viewed"
    data-limit="{{ section.settings.products_to_show }}"
    {% if product %}data-current-product-handle="{{ product.handle }}"{% endif %}
    hidden
  >
    <h2 class="recently-viewed__heading {{ section.settings.heading_size }}">
      {{ section.settings.heading }}
    </h2>
    <ul class="recently-viewed__list" data-recently-viewed-list role="list"></ul>
  </recently-viewed-products>
</div>

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Recently viewed",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Products to show"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Recently viewed"
    }
  ]
}
{% endschema %}
