{%- comment -%}
  sections/newsletter.liquid

  Customer newsletter signup section.

  - Adopts the independent "Section layout" pattern from
    sections/example-width-section.liquid (section_width / custom_width /
    section_padding). Width classes are scoped to this section's own BEM
    namespace (newsletter__default-width / __full-width / __custom-width)
    per that pattern's guidance, defined in assets/section-newsletter.css.
  - Uses the {% form 'customer' %} newsletter form. Submission is a normal
    (non-AJAX) POST; Shopify redirects back with form.posted_successfully?
    set, which drives the success/error state rendered below.
  - assets/section-newsletter.js only handles client-side UX (loading
    state, inline validation) — it never intercepts or fetches the form.
{%- endcomment -%}

{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'newsletter__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'newsletter__full-width'
  else
    assign width_class = 'newsletter__custom-width'
  endif
-%}

{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}

<div
  class="newsletter color-{{ section.settings.color_scheme }} {{ width_class }}"
  style="
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
  id="Newsletter-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="newsletter"
>
  <div class="section newsletter__inner" style="padding-block: var(--section-spacing);">

    {%- if section.settings.image != blank -%}
      <div class="newsletter__media">
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="
            {{ section.settings.image | image_url: width: 400 }} 400w,
            {{ section.settings.image | image_url: width: 800 }} 800w,
            {{ section.settings.image | image_url: width: 1200 }} 1200w
          "
          sizes="(min-width: 750px) 40vw, 100vw"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
          class="newsletter__image"
        >
      </div>
    {%- endif -%}

    <div class="newsletter__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="newsletter__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- form 'customer', id: 'NewsletterForm-' | append: section.id, class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {%- if form.posted_successfully? -%}
          <p class="newsletter__message newsletter__message--success" role="status" tabindex="-1" data-newsletter-success>
            {{ section.settings.success_message | default: 'Thanks for signing up!' }}
          </p>
        {%- elsif form.errors -%}
          <p class="newsletter__message newsletter__message--error" role="alert" tabindex="-1" data-newsletter-error>
            {{ form.errors.messages['form'] | default: form.errors.messages['email'] | default: 'Please enter a valid email address.' }}
          </p>
        {%- endif -%}

        <div class="newsletter__field-group">
          <div class="newsletter__field">
            <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">
              {{ section.settings.email_label | default: 'Email address' }}
            </label>
            <input
              type="email"
              id="NewsletterEmail-{{ section.id }}"
              name="contact[email]"
              class="newsletter__input"
              value="{{ form.email }}"
              aria-required="true"
              autocomplete="email"
              placeholder="{{ section.settings.email_label | default: 'Email address' }}"
              required
              data-newsletter-input
            >
          </div>
          <button
            type="submit"
            class="newsletter__submit"
            name="commit"
            data-newsletter-submit
          >
            <span data-newsletter-submit-label>{{ section.settings.button_label | default: 'Sign up' }}</span>
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{{ 'section-newsletter.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Be the first to hear about new products, restocks, and offers.</p>"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email field label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for signing up!"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optional)"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
