{{ 'product-bundles.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  sections/product-bundles.liquid
  ------------------------------------------------------------
  DISPLAY ONLY. Renders bundle cards from a product's
  `custom.product_bundles` metafield (List of Product).
  No JS, no cart/add-to-cart, no live re-fetching -- everything
  is computed once, server-side, at render time. Each card links
  to the bundle product's own page, where the merchant's normal
  product form / add-to-cart handles the purchase.
{%- endcomment -%}

<section class="ecombio-bundles color-{{ section.settings.color_scheme }}">
  <div class="ecombio-bundles__container page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="ecombio-bundles__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size == 0 -%}
      <p class="ecombio-bundles__empty-state">Add bundle blocks, each pointing at a bundle product.</p>
    {%- else -%}
      <div class="ecombio-bundles__grid" style="--ecombio-bundles-columns: {{ section.settings.columns_desktop }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign bundle_product = block.settings.product
            if bundle_product == blank
              continue
            endif
            assign bundle_items = bundle_product.metafields.custom.product_bundles.value
            assign total = 0
          -%}

          <a href="{{ bundle_product.url }}" class="ecombio-bundle-card" {{ block.shopify_attributes }}>
            <div class="ecombio-bundle-card__media">
              {%- if bundle_product.featured_image != blank -%}
                <img
                  src="{{ bundle_product.featured_image | image_url: width: 600 }}"
                  alt="{{ bundle_product.featured_image.alt | default: bundle_product.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | divided_by: bundle_product.featured_image.aspect_ratio }}"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'ecombio-bundle-card__placeholder' }}
              {%- endif -%}
            </div>

            <div class="ecombio-bundle-card__body">
              <h3 class="ecombio-bundle-card__title">{{ bundle_product.title }}</h3>

              {%- if bundle_items != blank -%}
                <ul class="ecombio-bundle-card__items">
                  {%- for item in bundle_items -%}
                    {%- liquid
                      assign item_variant = item.selected_or_first_available_variant
                      unless item_variant
                        continue
                      endunless
                      assign total = total | plus: item_variant.price
                    -%}
                    <li>{{ item.title }}</li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              <span class="ecombio-bundle-card__price">{{ total | money }}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product bundles",
  "class": "section-product-bundles",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bundle & save"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Bundle product",
          "info": "Its custom.product_bundles (List of Product) metafield defines the contents."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product bundles",
      "blocks": [{ "type": "bundle" }, { "type": "bundle" }, { "type": "bundle" }]
    }
  ]
}
{% endschema %}