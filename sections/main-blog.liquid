{% comment %}
  sections/main-blog.liquid
  Main blog listing section for the `blog` template. Renders the
  sticky `blog-menu` snippet (tag filter + sort, sits directly under
  #header-group-wrapper and follows its hide-on-scroll/hover-lock
  behavior the same way collection-toolbar does — see blog-menu.css
  for the exact contract) followed by the article grid + pagination.
{% endcomment %}

{{ 'main-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_tag = ''
  if request.path contains '/tagged/'
    assign current_tag = request.path | split: '/tagged/' | last | url_decode
  endif

  assign per_page = section.settings.articles_per_page
  assign columns = section.settings.columns_desktop
-%}

<div class="main-blog" id="main-blog" data-blog-page data-active-tag="{{ current_tag }}">

  {%- render 'blog-menu',
    blog: blog,
    current_tag: current_tag,
    show_tag_menu: section.settings.show_tag_menu,
    show_sort: section.settings.show_sort
  -%}

  <div class="main-blog__container page-width">

    {% paginate blog.articles by per_page %}

      {%- if blog.articles.size == 0 -%}
        <div class="main-blog__empty">
          <p>{{ 'blog.general.no_articles' | t | default: 'No articles yet.' }}</p>
        </div>
      {%- else -%}
        <div
          class="main-blog__grid"
          id="main-blog-grid"
          style="--main-blog-columns: {{ columns }};"
          data-main-blog-grid
        >
          {%- for article in blog.articles -%}
            <article
              class="blog-article-card"
              data-article-card
              data-date="{{ article.published_at | date: '%s' }}"
              data-title="{{ article.title | escape }}"
            >
              <a href="{{ article.url }}" class="blog-article-card__link">
                {%- if article.image -%}
                  <div class="blog-article-card__media">
                    <img
                      src="{{ article.image | image_url: width: 800 }}"
                      srcset="{{ article.image | image_url: width: 400 }} 400w,
                              {{ article.image | image_url: width: 800 }} 800w,
                              {{ article.image | image_url: width: 1200 }} 1200w"
                      sizes="(min-width: 990px) 33vw, 100vw"
                      alt="{{ article.image.alt | escape | default: article.title | escape }}"
                      loading="lazy"
                      width="{{ article.image.width }}"
                      height="{{ article.image.height }}"
                    >
                  </div>
                {%- endif -%}

                <div class="blog-article-card__content">
                  {%- if section.settings.show_date -%}
                    <time class="blog-article-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                      {{ article.published_at | time_tag: format: 'date' }}
                    </time>
                  {%- endif -%}

                  <h2 class="blog-article-card__title">{{ article.title }}</h2>

                  {%- if section.settings.show_excerpt -%}
                    <div class="blog-article-card__excerpt">
                      {{ article.excerpt_or_content | strip_html | truncatewords: 28 }}
                    </div>
                  {%- endif -%}

                  <div class="blog-article-card__meta">
                    {%- if section.settings.show_author -%}
                      <span class="blog-article-card__author">{{ article.author }}</span>
                    {%- endif -%}

                    {%- if article.tags.size > 0 -%}
                      <span class="blog-article-card__tags">
                        {%- for tag in article.tags limit: 3 -%}{{ tag }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}
                      </span>
                    {%- endif -%}
                  </div>
                </div>
              </a>
            </article>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav
            class="main-blog__pagination"
            role="navigation"
            aria-label="{{ 'general.pagination.label' | t | default: 'Pagination' }}"
            data-main-blog-pagination
          >
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="main-blog__pagination-link main-blog__pagination-link--prev" rel="prev">
                {{ 'general.pagination.previous' | t | default: 'Previous' }}
              </a>
            {%- endif -%}

            <span class="main-blog__pagination-status">{{ paginate.current_page }} / {{ paginate.pages }}</span>

            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="main-blog__pagination-link main-blog__pagination-link--next" rel="next">
                {{ 'general.pagination.next' | t | default: 'Next' }}
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}

    {% endpaginate %}

  </div>
</div>

{{ 'main-blog.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Main blog",
  "tag": "section",
  "class": "section main-blog-section",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 9
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "checkbox", "id": "show_tag_menu", "label": "Show tag menu", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort control", "default": true }
  ]
}
{% endschema %}
