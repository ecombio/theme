{%- liquid
  assign heading          = section.settings.heading
  assign hide_widget_title = section.settings.hide_widget_title
  assign cs                = section.settings.color_scheme
  assign pad_top           = section.settings.padding_top
  assign pad_bottom        = section.settings.padding_bottom
  assign show_demo         = section.settings.show_demo_data

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'default-width'
  else
    assign width_class = width_type
  endif
-%}

{{ 'product-reviews.css' | asset_url | stylesheet_tag }}

<div
  class="revs-section cs-{{ cs }}{% if hide_widget_title %} revs-section--hide-widget-title{% endif %} {{ width_class }}"
  id="revs-section-{{ section.id }}"
  {%- unless show_demo %} data-revs-section{% endunless %}
  style="
    --revs-pad-top: {{ pad_top }}px;
    --revs-pad-bottom: {{ pad_bottom }}px;
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  {%- if heading != blank -%}
    <div class="revs-header">
      <h2 class="revs-heading">{{ heading }}</h2>
      {%- if show_demo -%}
        <p class="revs-demo-flag">Showing sample data — turn off "Show demo data" in section settings once Judge.me has real reviews.</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="revs-widget-wrapper" data-revs-widget-wrapper>
    {%- if show_demo -%}
      <div class="jdgm-widget jdgm-review-widget jdgm-rev-widg jdgm--done-setup-widget">
        <div class="jdgm-rev-widg__header">
          <div class="jdgm-rev-widg__title">Customer Reviews</div>
          <div class="jdgm-row-stars">
            <div class="jdgm-rev-widg__summary">
              <div class="jdgm-rev-widg__summary-stars">
                <span class="jdgm-star jdgm--on"></span>
                <span class="jdgm-star jdgm--on"></span>
                <span class="jdgm-star jdgm--on"></span>
                <span class="jdgm-star jdgm--on"></span>
                <span class="jdgm-star jdgm--half"></span>
              </div>
              <span class="jdgm-rev-widg__summary-average">4.6 out of 5</span>
              <span class="jdgm-rev-widg__summary-text">Based on 128 reviews</span>
            </div>
            <a href="#" class="jdgm-write-rev-link jdgm-btn jdgm-btn--solid" onclick="return false;">Write a review</a>
          </div>
        </div>

        <div class="jdgm-rev-widg__body">
          <div class="jdgm-rev-widg__reviews">
            {%- assign demo_names = 'Alex M.|Jordan K.|Priya S.' | split: '|' -%}
            {%- assign demo_titles = 'Exactly what I needed|Great quality, fast shipping|Would buy again' | split: '|' -%}
            {%- assign demo_bodies = 'This exceeded my expectations — well made and works exactly as described. Would recommend to anyone on the fence.|Arrived earlier than expected and the quality feels premium. A couple of small quirks but overall very happy.|Second time ordering this. Consistent quality and the customer service team was quick to answer my questions.' | split: '|' -%}
            {%- assign demo_dates = '07/02/2026|06/24/2026|06/11/2026' | split: '|' -%}
            {%- assign demo_stars = '5|4|5' | split: '|' -%}

            {%- for i in (0..2) -%}
              <div class="jdgm-rev">
                <div class="jdgm-rev__header">
                  <div class="jdgm-row-rating">
                    <div class="jdgm-rev__rating">
                      {%- assign star_count = demo_stars[i] | plus: 0 -%}
                      {%- for s in (1..5) -%}
                        <span class="jdgm-star{% if s <= star_count %} jdgm--on{% else %} jdgm--off{% endif %}"></span>
                      {%- endfor -%}
                    </div>
                    <span class="jdgm-rev__timestamp">{{ demo_dates[i] }}</span>
                  </div>
                  <div class="jdgm-row-profile">
                    <span class="jdgm-rev__author-wrapper">
                      <span class="jdgm-rev__author">{{ demo_names[i] }}</span>
                    </span>
                    <span class="jdgm-rev__buyer-badge-wrapper">Verified buyer</span>
                  </div>
                </div>
                <div class="jdgm-rev__content">
                  <b class="jdgm-rev__title">{{ demo_titles[i] }}</b>
                  <p class="jdgm-rev__body">{{ demo_bodies[i] }}</p>
                </div>
              </div>
            {%- endfor -%}
          </div>

          <div class="jdgm-paginate">
            <span class="jdgm-paginate__page jdgm-curt">1</span>
            <span class="jdgm-paginate__page">2</span>
            <span class="jdgm-paginate__page">3</span>
          </div>
        </div>
      </div>
    {%- else -%}
      <div
        id="judgeme_product_reviews"
        class="jdgm-widget jdgm-review-widget"
        data-id="{{ product.id }}"
      ></div>

      <div class="revs-shimmer" data-revs-shimmer aria-hidden="true">
        <div class="revs-shimmer__summary">
          <div class="revs-shimmer__line revs-shimmer__line--stars"></div>
          <div class="revs-shimmer__line revs-shimmer__line--text"></div>
        </div>
        <div class="revs-shimmer__list">
          {%- for i in (1..3) -%}
            <div class="revs-shimmer__card">
              <div class="revs-shimmer__line revs-shimmer__line--stars-sm"></div>
              <div class="revs-shimmer__line revs-shimmer__line--title"></div>
              <div class="revs-shimmer__line revs-shimmer__line--body"></div>
              <div class="revs-shimmer__line revs-shimmer__line--body revs-shimmer__line--short"></div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- unless show_demo -%}
  <script src="{{ 'product-reviews.js' | asset_url }}" defer></script>
{%- endunless -%}

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "section-product-reviews",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use Judge.me's own \"Customer Reviews\" title instead.",
      "default": "Customer Reviews"
    },
    {
      "type": "checkbox",
      "id": "hide_widget_title",
      "label": "Hide Judge.me's built-in title",
      "info": "Turn this on if you're using the Heading field above, to avoid showing two titles.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_demo_data",
      "label": "Show demo data",
      "info": "Temporary — shows sample reviews for previewing the design, ignoring your real Judge.me data. Turn this off when you're ready to go live.",
      "default": false
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light",  "label": "Light" },
        { "value": "gray",   "label": "Light gray" },
        { "value": "dark",   "label": "Dark" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    }
  ],
  "templates": ["product"],
  "presets": [
    {
      "name": "Product reviews"
    }
  ]
}
{% endschema %}