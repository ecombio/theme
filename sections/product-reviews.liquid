{% comment %}
  ╔══════════════════════════════════════════════════════════╗
  ║  sections/product-reviews.liquid                          ║
  ║                                                            ║
  ║  Core logic: this section does NOT call any review API    ║
  ║  itself. Judge.me's own storefront script (installed via  ║
  ║  the app / app embed) scans the page on load for the       ║
  ║  anchor div below (#judgeme_product_reviews, the app's     ║
  ║  documented "manual installation" target) and injects the  ║
  ║  fully rendered widget into it — summary, star histogram,  ║
  ║  review list, pagination, AND the "Write a review" form,   ║
  ║  all in one shot. We never touch Judge.me's raw REST API   ║
  ║  from the browser (their own docs warn against this: the   ║
  ║  raw /reviews endpoint needs a private token and can       ║
  ║  return unpublished/unsanitized content — it's meant for   ║
  ║  server-side use, not storefront rendering).                ║
  ║                                                            ║
  ║  Restyling: assets/product-reviews.css overrides Judge.me's║
  ║  documented, stable .jdgm-* classes (see Judge.me's public ║
  ║  CSS reference) to match this theme's design tokens —      ║
  ║  same supported approach Judge.me's own docs recommend for ║
  ║  custom styling, just applied via our theme's CSS file      ║
  ║  instead of their in-app 500-character custom CSS box.      ║
  ║                                                            ║
  ║  Loading state: Judge.me adds a `jdgm--done-setup-widget`  ║
  ║  class to the anchor div once its script has populated it. ║
  ║  We show a shimmer skeleton until that happens (CSS-only), ║
  ║  and assets/product-reviews.js hides the ENTIRE section if ║
  ║  that class never appears within a timeout — e.g. the app  ║
  ║  is uninstalled, its script is blocked, or the store has   ║
  ║  no reviews app configured — rather than leaving a stuck    ║
  ║  shimmer visible forever.                                   ║
  ║                                                            ║
  ║  Section layout: width_class + --section-padding follow    ║
  ║  the same pattern as sections/product-recommendations.liquid║
  ║  and sections/frequently-bought-together.liquid — side      ║
  ║  padding is section-local, not tied to the theme's global   ║
  ║  --page-margin.                                              ║
  ╚══════════════════════════════════════════════════════════╝
{% endcomment %}

{%- liquid
  assign heading          = section.settings.heading
  assign hide_widget_title = section.settings.hide_widget_title
  assign cs                = section.settings.color_scheme
  assign pad_top           = section.settings.padding_top
  assign pad_bottom        = section.settings.padding_bottom

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'default-width'
  else
    assign width_class = width_type
  endif
-%}

{{ 'product-reviews.css' | asset_url | stylesheet_tag }}

<div
  class="revs-section cs-{{ cs }}{% if hide_widget_title %} revs-section--hide-widget-title{% endif %} {{ width_class }}"
  id="revs-section-{{ section.id }}"
  data-revs-section
  style="
    --revs-pad-top: {{ pad_top }}px;
    --revs-pad-bottom: {{ pad_bottom }}px;
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  {%- if heading != blank -%}
    <div class="revs-header">
      <h2 class="revs-heading">{{ heading }}</h2>
    </div>
  {%- endif -%}

  <div class="revs-widget-wrapper" data-revs-widget-wrapper>
    {%- comment -%}
      This is Judge.me's documented manual-installation anchor.
      Leave the id and base classes exactly as-is — their script
      matches on them. Everything visual is handled in our CSS
      by targeting the classes Judge.me adds inside this div.
    {%- endcomment -%}
    <div
      id="judgeme_product_reviews"
      class="jdgm-widget jdgm-review-widget"
      data-id="{{ product.id }}"
    ></div>

    <div class="revs-shimmer" data-revs-shimmer aria-hidden="true">
      <div class="revs-shimmer__summary">
        <div class="revs-shimmer__line revs-shimmer__line--stars"></div>
        <div class="revs-shimmer__line revs-shimmer__line--text"></div>
      </div>
      <div class="revs-shimmer__list">
        {%- for i in (1..3) -%}
          <div class="revs-shimmer__card">
            <div class="revs-shimmer__line revs-shimmer__line--stars-sm"></div>
            <div class="revs-shimmer__line revs-shimmer__line--title"></div>
            <div class="revs-shimmer__line revs-shimmer__line--body"></div>
            <div class="revs-shimmer__line revs-shimmer__line--body revs-shimmer__line--short"></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'product-reviews.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "section-product-reviews",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use Judge.me's own \"Customer Reviews\" title instead.",
      "default": "Customer Reviews"
    },
    {
      "type": "checkbox",
      "id": "hide_widget_title",
      "label": "Hide Judge.me's built-in title",
      "info": "Turn this on if you're using the Heading field above, to avoid showing two titles.",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light",  "label": "Light" },
        { "value": "gray",   "label": "Light gray" },
        { "value": "dark",   "label": "Dark" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    }
  ],
  "templates": ["product"],
  "presets": [
    {
      "name": "Product reviews"
    }
  ]
}
{% endschema %}