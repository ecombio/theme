{% comment %} Product Sections - Controller {% endcomment %}

<div class="product-sections">
  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'product-reviews' -%}
        {%- render 'judgeme-reviews', block: block, product: product -%}

      {%- when 'expert-reviews' -%}
        {%- assign reviews = product.metafields.custom.expert_reviews.value -%}
        {%- if reviews != blank -%}
          <div class="product-sections__block" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="expert-reviews-section__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- render 'video-carousel', reviews: reviews, carousel_id: 'expert-reviews-carousel' -%}
          </div>
        {%- endif -%}

    {%- endcase -%}
  {%- endfor -%}
</div>

<style>
  .expert-reviews-section__heading { font-size: 1.6rem; margin-bottom: 1.5rem; }
  .expert-reviews-section__empty { color: #999; font-style: italic; }
</style>

{% schema %}
{
  "name": "Product Sections",
  "blocks": [
    {
      "type": "product-reviews",
      "name": "Product Reviews",
      "limit": 1,
      "settings": []
    },
    {
      "type": "expert-reviews",
      "name": "Expert Reviews",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Expert Reviews"
        }
      ]
    }
  ],
  "presets": []
}
{% endschema %}