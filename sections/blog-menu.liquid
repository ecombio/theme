{%- comment -%}
  Section: Blog Menu
  A lightweight navigation bar for blog/article pages.
  Supports two block types:
    - single_link : a single <a> nav item
    - link_list   : a dropdown nav item backed by a native Shopify menu (Navigation resource)
{%- endcomment -%}

{%- assign section_id = section.id -%}

<nav
  class="blog-menu{% if section.settings.sticky %} blog-menu--sticky{% endif %}"
  id="blog-menu-{{ section_id }}"
  data-blog-menu
  aria-label="{{ section.settings.heading | default: 'Blog navigation' | escape }}"
>
  <div class="blog-menu__inner page-width">

    {%- if section.settings.heading != blank -%}
      <div class="blog-menu__heading">{{ section.settings.heading | escape }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <button
        type="button"
        class="blog-menu__toggle"
        data-blog-menu-toggle
        aria-expanded="false"
        aria-controls="blog-menu-list-{{ section_id }}"
      >
        <span class="blog-menu__toggle-label">{{ section.settings.mobile_label | default: 'Menu' | escape }}</span>
        <span class="blog-menu__toggle-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>

      <ul class="blog-menu__list" id="blog-menu-list-{{ section_id }}" data-blog-menu-list>
        {%- for block in section.blocks -%}

          {%- case block.type -%}

            {%- when 'single_link' -%}
              <li class="blog-menu__item blog-menu__item--single" {{ block.shopify_attributes }}>
                {%- if block.settings.url != blank -%}
                  <a
                    href="{{ block.settings.url }}"
                    class="blog-menu__link"
                    {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
                  >
                    {{ block.settings.label | default: 'Link' | escape }}
                  </a>
                {%- else -%}
                  <span class="blog-menu__link blog-menu__link--disabled">
                    {{ block.settings.label | default: 'Link' | escape }}
                  </span>
                {%- endif -%}
              </li>

            {%- when 'link_list' -%}
              {%- assign menu_handle = block.settings.menu -%}
              {%- assign menu = linklists[menu_handle] -%}
              <li class="blog-menu__item blog-menu__item--list{% if menu.links.size == 0 %} blog-menu__item--empty{% endif %}" {{ block.shopify_attributes }}>
                <button
                  type="button"
                  class="blog-menu__link blog-menu__link--parent"
                  data-blog-menu-dropdown-toggle
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {{ block.settings.label | default: menu.title | default: 'More' | escape }}
                  <span class="blog-menu__caret" aria-hidden="true"></span>
                </button>

                {%- if menu != blank and menu.links.size > 0 -%}
                  <ul class="blog-menu__dropdown" data-blog-menu-dropdown>
                    {%- for link in menu.links -%}
                      <li class="blog-menu__dropdown-item">
                        <a
                          href="{{ link.url }}"
                          class="blog-menu__dropdown-link{% if link.active %} blog-menu__dropdown-link--active{% endif %}"
                        >
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>

          {%- endcase -%}

        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</nav>

{%- style -%}
  #blog-menu-{{ section_id }} {
    --blog-menu-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --blog-menu-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --blog-menu-accent: {{ section.settings.accent_color | default: '#1a1a1a' }};
    --blog-menu-border: {{ section.settings.border_color | default: '#e5e5e5' }};

    background: var(--blog-menu-bg);
    color: var(--blog-menu-text);
    border-bottom: 1px solid var(--blog-menu-border);
    width: 100%;
    z-index: 20;
  }

  #blog-menu-{{ section_id }}.blog-menu--sticky {
    position: sticky;
    top: 0;
  }

  #blog-menu-{{ section_id }} .blog-menu__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.75rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  #blog-menu-{{ section_id }} .blog-menu__heading {
    font-weight: 600;
    font-size: 1rem;
    white-space: nowrap;
    margin-right: 0.5rem;
  }

  #blog-menu-{{ section_id }} .blog-menu__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  #blog-menu-{{ section_id }} .blog-menu__item {
    position: relative;
  }

  #blog-menu-{{ section_id }} .blog-menu__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 0.85rem;
    color: var(--blog-menu-text);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 4px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  #blog-menu-{{ section_id }} .blog-menu__link:hover,
  #blog-menu-{{ section_id }} .blog-menu__link--parent[aria-expanded="true"] {
    background: rgba(0, 0, 0, 0.05);
    color: var(--blog-menu-accent);
  }

  #blog-menu-{{ section_id }} .blog-menu__link--disabled {
    opacity: 0.5;
    cursor: default;
  }

  #blog-menu-{{ section_id }} .blog-menu__caret {
    width: 7px;
    height: 7px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.15s ease;
    margin-top: -2px;
  }

  #blog-menu-{{ section_id }} .blog-menu__link--parent[aria-expanded="true"] .blog-menu__caret {
    transform: rotate(-135deg);
    margin-top: 2px;
  }

  #blog-menu-{{ section_id }} .blog-menu__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background: var(--blog-menu-bg);
    border: 1px solid var(--blog-menu-border);
    border-radius: 6px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0.35rem;
    display: none;
    z-index: 30;
  }

  #blog-menu-{{ section_id }} .blog-menu__item--list.is-open .blog-menu__dropdown {
    display: block;
  }

  #blog-menu-{{ section_id }} .blog-menu__dropdown-link {
    display: block;
    padding: 0.5rem 0.65rem;
    color: var(--blog-menu-text);
    text-decoration: none;
    font-size: 0.875rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  #blog-menu-{{ section_id }} .blog-menu__dropdown-link:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  #blog-menu-{{ section_id }} .blog-menu__dropdown-link--active {
    color: var(--blog-menu-accent);
    font-weight: 600;
  }

  #blog-menu-{{ section_id }} .blog-menu__toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    background: none;
    border: 1px solid var(--blog-menu-border);
    border-radius: 4px;
    padding: 0.45rem 0.75rem;
    font-size: 0.85rem;
    cursor: pointer;
    color: var(--blog-menu-text);
  }

  #blog-menu-{{ section_id }} .blog-menu__toggle-icon {
    display: inline-flex;
    flex-direction: column;
    gap: 3px;
  }

  #blog-menu-{{ section_id }} .blog-menu__toggle-icon span {
    width: 16px;
    height: 2px;
    background: currentColor;
    display: block;
  }

  @media screen and (max-width: 749px) {
    #blog-menu-{{ section_id }} .blog-menu__toggle {
      display: inline-flex;
    }

    #blog-menu-{{ section_id }} .blog-menu__list {
      display: none;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      gap: 0;
      border-top: 1px solid var(--blog-menu-border);
      margin-top: 0.5rem;
      padding-top: 0.5rem;
    }

    #blog-menu-{{ section_id }} .blog-menu__list.is-open {
      display: flex;
    }

    #blog-menu-{{ section_id }} .blog-menu__inner {
      flex-wrap: wrap;
    }

    #blog-menu-{{ section_id }} .blog-menu__dropdown {
      position: static;
      box-shadow: none;
      border: none;
      margin: 0;
      padding-left: 0.75rem;
    }
  }
{%- endstyle -%}

<script src="{{ 'blog-menu.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Blog menu",
  "tag": "section",
  "class": "section-blog-menu",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional label shown before the nav items."
    },
    {
      "type": "text",
      "id": "mobile_label",
      "label": "Mobile toggle label",
      "default": "Menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Make menu sticky on scroll",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (hover / active)",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e5e5e5"
    }
  ],
  "blocks": [
    {
      "type": "single_link",
      "name": "Single Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Link List",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Shown as the dropdown's clickable title. Defaults to the menu's own title if left blank."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Choose a navigation menu from Online Store > Navigation. Its links become the dropdown items."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Blog menu",
      "blocks": [
        {
          "type": "single_link"
        },
        {
          "type": "link_list"
        }
      ]
    }
  ]
}
{% endschema %}