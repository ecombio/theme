{{ 'section-blog-category.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'blog-category__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'blog-category__full-width'
  else
    assign width_class = 'blog-category__custom-width'
  endif
-%}

<div
  class="{{ width_class }}"
  style="
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  <div class="blog-category-section">

    {%- if section.settings.show_title -%}
      <h2 class="blog-category-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <nav class="blog-category-pills" aria-label="Blog categories" style="--pill-alignment: {{ section.settings.alignment }};">
        {%- for block in section.blocks -%}
          {%- if block.settings.post != blank -%}
            <a
              href="{{ block.settings.post.url }}"
              class="blog-category-pill{% if block.settings.post.url == request.path %} is-active{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.post.title }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- else -%}
      <p class="blog-category-empty">
        {{ section.settings.empty_text }}
      </p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Blog category",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Pill alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Add categories in the section settings."
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "blog_link",
      "name": "Category",
      "settings": [
        {
          "type": "article",
          "id": "post",
          "label": "Blog post"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog category",
      "blocks": [
        { "type": "blog_link" },
        { "type": "blog_link" },
        { "type": "blog_link" }
      ]
    }
  ]
}
{% endschema %}