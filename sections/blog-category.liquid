{{ 'section-blog-category.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  BLOG CATEGORY NAV — pill-shaped category links
  --------------------------------------------------------------
  Each block = one pill. Merchants only pick a Link (collection,
  blog, article, or page); the pill's label is derived automatically
  from whatever that link resolves to:
    /collections/<handle>          -> collection title
    /blogs/<handle>                -> blog title
    /blogs/<handle>/<article>      -> article title
    /pages/<handle>                -> page title
  Anything else (external URL, home page, etc.) falls back to the
  block's "Fallback label" setting.

  The pill whose link matches the current page URL gets highlighted
  automatically.

  SECTION LAYOUT (width/padding):
  Follows the independent width/padding pattern from
  sections/example-width-section.liquid — this section defines
  its own local --section-padding / --custom-width variables,
  set inline per-instance from its own settings below. It does
  NOT read from the global --page-margin / --page-width, so
  changing Theme settings > Layout > Body side padding will never
  affect this section. Classes are scoped to
  blog-category__default-width / __full-width / __custom-width
  since this theme has no shared global width utility classes.
{%- endcomment -%}

{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'blog-category__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'blog-category__full-width'
  else
    assign width_class = 'blog-category__custom-width'
  endif
-%}

<div
  class="{{ width_class }}"
  style="
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  <div class="blog-category-section">

    {%- if section.settings.show_title -%}
      <h2 class="blog-category-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <nav class="blog-category-pills" aria-label="Blog categories" style="--pill-alignment: {{ section.settings.alignment }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign pill_link = block.settings.link
            assign resolved_label = blank

            if pill_link contains '/collections/'
              assign c_handle = pill_link | split: '/collections/' | last | split: '/' | first | split: '?' | first
              assign resolved_label = collections[c_handle].title

            elsif pill_link contains '/blogs/'
              assign after_blogs = pill_link | split: '/blogs/' | last | split: '?' | first
              assign b_handle = after_blogs | split: '/' | first
              assign a_handle = after_blogs | split: '/' | last
              if a_handle != b_handle and a_handle != blank
                assign resolved_label = blogs[b_handle].articles[a_handle].title
              else
                assign resolved_label = blogs[b_handle].title
              endif

            elsif pill_link contains '/pages/'
              assign p_handle = pill_link | split: '/pages/' | last | split: '?' | first
              assign resolved_label = pages[p_handle].title
            endif

            assign pill_label = resolved_label | default: block.settings.fallback_label
          -%}
          {%- if pill_link != blank -%}
            <a
              href="{{ pill_link }}"
              class="blog-category-pill{% if pill_link == request.path %} is-active{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ pill_label }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- else -%}
      <p class="blog-category-empty">
        {{ section.settings.empty_text }}
      </p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Blog category",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Pill alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Add categories in the section settings."
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "blog_link",
      "name": "Category",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Pick the collection, blog, article, or page this pill should go to. Its title is used as the pill label automatically."
        },
        {
          "type": "text",
          "id": "fallback_label",
          "label": "Fallback label",
          "default": "Category",
          "info": "Only shown if the link above isn't a collection, blog, article, or page (e.g. an external URL or the home page)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog category",
      "blocks": [
        { "type": "blog_link" },
        { "type": "blog_link" },
        { "type": "blog_link" }
      ]
    }
  ]
}
{% endschema %}