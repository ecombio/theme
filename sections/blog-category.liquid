{{ 'section-blog-category.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  BLOG CATEGORY NAV — pill-shaped category links
  --------------------------------------------------------------
  Each block = one blog/category pill. Add, remove, or reorder
  blocks in the theme editor to control exactly what shows —
  nothing here depends on which page/URL you're on.
{%- endcomment -%}

<div class="blog-category-section page-width">

  {%- if section.settings.show_title -%}
    <h2 class="blog-category-title">
      {{ section.settings.heading }}
    </h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <nav class="blog-category-pills" aria-label="Blog categories" style="--pill-alignment: {{ section.settings.alignment }};">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a
            href="{{ block.settings.link }}"
            class="blog-category-pill{% if block.settings.link == request.path %} is-active{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  {%- else -%}
    <p class="blog-category-empty">
      {{ section.settings.empty_text }}
    </p>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Blog category",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Pill alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Add categories in the section settings."
    }
  ],
  "blocks": [
    {
      "type": "blog_link",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Pill label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Pick the exact blog, article, or page this pill should go to."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog category",
      "blocks": [
        { "type": "blog_link" },
        { "type": "blog_link" },
        { "type": "blog_link" }
      ]
    }
  ]
}
{% endschema %}