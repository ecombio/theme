{{ 'section-blog-category.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  BLOG CATEGORY SECTION
  --------------------------------------------------------------
  Add this section to any template (blog page, homepage, custom
  page, etc.) and pick your "category" blog from the section
  settings (Content > Blog). It simply lists every post in that
  blog — no tags, no filtering, no /tagged/ URLs involved.
{%- endcomment -%}

{%- assign category_blog = blogs[section.settings.blog] -%}

<div class="blog-category-section page-width">

  {%- if section.settings.show_title -%}
    <div class="blog-category-header">
      <h2 class="blog-category-title">
        {{ section.settings.heading | default: category_blog.title }}
      </h2>
    </div>
  {%- endif -%}

  {%- if category_blog and category_blog.articles.size > 0 -%}
    <div
      class="blog-category-grid"
      style="--columns: {{ section.settings.columns_desktop }}; --columns-mobile: {{ section.settings.columns_mobile }};"
    >
      {%- for article in category_blog.articles limit: section.settings.articles_to_show -%}
        <article class="blog-category-card">
          <a href="{{ article.url }}" class="blog-category-card__link">
            {%- if article.image and section.settings.show_image -%}
              <div class="blog-category-card__image-wrapper">
                {{
                  article.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    class: 'blog-category-card__image',
                    widths: '400,600,800',
                    alt: article.image.alt | default: article.title
                }}
              </div>
            {%- endif -%}

            <div class="blog-category-card__content">
              {%- if section.settings.show_date -%}
                <span class="blog-category-card__date">{{ article.published_at | date: format: 'month_day_year' }}</span>
              {%- endif -%}

              <h3 class="blog-category-card__title">{{ article.title }}</h3>

              {%- if section.settings.show_excerpt -%}
                <div class="blog-category-card__excerpt">
                  {{ article.excerpt_or_content | strip_html | truncatewords: section.settings.excerpt_length }}
                </div>
              {%- endif -%}
            </div>
          </a>
        </article>
      {%- endfor -%}
    </div>

  {%- else -%}
    <p class="blog-category-empty">
      {{ section.settings.empty_text | default: 'No posts found yet.' }}
    </p>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Blog category",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog to pull posts from"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (leave blank to use the blog's own title)"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on mobile",
      "default": 1
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 1,
      "max": 24,
      "step": 1,
      "label": "Posts to show",
      "default": 5,
      "info": "Set this to at least the number of posts you have in the blog so they all show."
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publish date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "excerpt_length",
      "min": 10,
      "max": 60,
      "step": 5,
      "label": "Excerpt length (words)",
      "default": 25
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "No posts found yet."
    }
  ],
  "presets": [
    {
      "name": "Blog category"
    }
  ]
}
{% endschema %}