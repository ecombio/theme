{{ 'section-blog-category.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  BLOG CATEGORY NAV — pill-shaped category links
  --------------------------------------------------------------
  Each block = one pill, driven only by a Link picker — no manual
  label field. The pill's text is always auto-derived from the
  linked page/blog/article/collection/product title based on the
  URL's handle. If no link is picked yet (fresh block) or the
  link type can't be resolved, it falls back to showing "Category".
  The pill whose link matches the current page URL gets
  highlighted automatically.

  SECTION LAYOUT (width/padding):
  Follows the independent width/padding pattern from
  sections/example-width-section.liquid — this section defines
  its own local --section-padding / --custom-width variables,
  set inline per-instance from its own settings below. It does
  NOT read from the global --page-margin / --page-width, so
  changing Theme settings > Layout > Body side padding will never
  affect this section. Classes are scoped to
  blog-category__default-width / __full-width / __custom-width
  since this theme has no shared global width utility classes.
{%- endcomment -%}

{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'blog-category__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'blog-category__full-width'
  else
    assign width_class = 'blog-category__custom-width'
  endif
-%}

<div
  class="{{ width_class }}"
  style="
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  <div class="blog-category-section">

    {%- if section.settings.show_title and section.settings.heading != blank -%}
      <h2 class="blog-category-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <nav class="blog-category-pills" aria-label="Blog categories" style="--pill-alignment: {{ section.settings.alignment }};">
        {%- for block in section.blocks -%}
          {%- if block.settings.link == blank -%}
            <span class="blog-category-pill blog-category-pill--empty" {{ block.shopify_attributes }}>
              Category
            </span>
          {%- else -%}
            {%- liquid
              assign link = block.settings.link
              assign auto_label = ''

              if link contains '/pages/'
                assign handle = link | split: '/pages/' | last | split: '/' | first | split: '?' | first
                assign auto_label = pages[handle].title

              elsif link contains '/blogs/'
                assign parts = link | split: '/blogs/' | last | split: '/'
                assign blog_handle = parts[0]
                if parts.size > 1 and parts[1] != blank
                  assign article_handle = parts[1] | split: '?' | first
                  assign auto_label = blogs[blog_handle].articles[article_handle].title
                else
                  assign auto_label = blogs[blog_handle].title
                endif

              elsif link contains '/collections/'
                assign handle = link | split: '/collections/' | last | split: '/' | first | split: '?' | first
                assign auto_label = collections[handle].title

              elsif link contains '/products/'
                assign handle = link | split: '/products/' | last | split: '/' | first | split: '?' | first
                assign auto_label = all_products[handle].title
              endif

              assign pill_label = auto_label | default: 'Category'
            -%}
            <a
              href="{{ link }}"
              class="blog-category-pill{% if link == request.path %} is-active{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ pill_label }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- else -%}
      <p class="blog-category-empty">
        {{ section.settings.empty_text }}
      </p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Blog category",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Pill alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Add categories in the section settings."
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "blog_link",
      "name": "Category",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Pick the exact blog, article, page, collection, or product this pill should go to. The pill's text is filled in automatically from whatever you pick."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog category",
      "blocks": [
        { "type": "blog_link" },
        { "type": "blog_link" },
        { "type": "blog_link" }
      ]
    }
  ]
}
{% endschema %}