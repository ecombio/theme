{{ 'video-carousel.css' | asset_url | stylesheet_tag }}
{{ 'video-card.css' | asset_url | stylesheet_tag }}
{{ 'video-modal.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_arrows = section.settings.show_arrows
  assign show_dots = section.settings.show_dots
  assign container_class = 'page-width'
  if section.settings.full_width
    assign container_class = 'video-carousel__full-bleed'
  endif
-%}

<div
  class="video-carousel-section"
  id="VideoCarousel-{{ section.id }}"
  data-video-carousel
  data-section-id="{{ section.id }}"
  data-autoplay-first="{{ section.settings.autoplay_first }}"
  style="
    --vc-slides-desktop: {{ section.settings.slides_desktop }};
    --vc-slides-tablet: {{ section.settings.slides_tablet }};
    --vc-slides-mobile: {{ section.settings.slides_mobile }};
    --vc-gap: {{ section.settings.gap }}px;
    {% if section.settings.background_color != blank %}--vc-bg: {{ section.settings.background_color }};{% endif %}
    {% if section.settings.text_color != blank %}--vc-text: {{ section.settings.text_color }};{% endif %}
    --vc-card-ratio: {% if section.settings.card_style == 'reel' %}9 / 16{% else %}16 / 9{% endif %};
  "
>
  <div class="{{ container_class }}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="video-carousel__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="video-carousel__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="video-carousel__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="video-carousel__wrapper">
      {%- if show_arrows -%}
        <button
          type="button"
          class="video-carousel__arrow video-carousel__arrow--prev"
          aria-label="Previous videos"
          data-carousel-prev
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M15 4l-8 8 8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}

      <div
        class="video-carousel__track"
        data-carousel-track
        tabindex="0"
        role="region"
        aria-label="{{ section.settings.heading | default: 'Video carousel' }}"
      >
        <div class="video-carousel__list" data-carousel-list>
          {%- for block in section.blocks -%}
            {%- if block.type == 'video' -%}
              {%- render 'video-card', block: block, index: forloop.index -%}
            {%- endif -%}
          {%- else -%}
            <p class="video-carousel__empty">Add video blocks in the theme editor.</p>
          {%- endfor -%}
        </div>
      </div>

      {%- if show_arrows -%}
        <button
          type="button"
          class="video-carousel__arrow video-carousel__arrow--next"
          aria-label="Next videos"
          data-carousel-next
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}
    </div>

    {%- if show_dots -%}
      <div class="video-carousel__dots" data-carousel-dots role="tablist" aria-label="Slide navigation"></div>
    {%- endif -%}
  </div>
</div>

{%- render 'video-modal' -%}

{{ 'video-carousel.js' | asset_url | script_tag }}
{{ 'video-card.js' | asset_url | script_tag }}
{{ 'video-modal.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Video carousel",
  "tag": "section",
  "class": "section video-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch & learn"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "info": "Removes the max-width constraint so the carousel spans the browser edge-to-edge, instead of matching your header's content width.",
      "default": false
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "standard", "label": "Standard (16:9)" },
        { "value": "reel", "label": "Reel / Shorts (9:16)" }
      ],
      "default": "standard"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Videos per view (desktop)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "label": "Videos per view (tablet)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "label": "Videos per view (mobile)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between videos",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay_first",
      "label": "Autoplay first video's sound off preview",
      "default": false,
      "info": "Only applies to uploaded MP4 videos, muted."
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"],
          "info": "Paste a YouTube or Vimeo link. Leave blank if uploading a file below."
        },
        {
          "type": "video",
          "id": "video_file",
          "label": "Or upload a video file"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail image",
          "info": "Recommended if using a Video URL. Uploaded videos can use their own preview image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video carousel",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}