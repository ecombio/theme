{%- comment -%}
  sections/example-width-section.liquid

  This is a minimal, self-contained example showing how to wire up
  the "Page width / Full width / Custom width" option in a section.

  Copy the schema block's "section_width" and "custom_width" settings
  into any section you want this behavior on, and copy the class +
  style attribute pattern from the <div> below into that section's
  markup.
{%- endcomment -%}

<div
  class="{{ section.settings.section_width }}"
  {%- if section.settings.section_width == 'custom-width' %}
    style="--custom-width: {{ section.settings.custom_width }}rem;"
  {%- endif %}
>
  <div class="section" style="padding-block: var(--section-spacing);">
    <h2>{{ section.settings.heading | default: 'Example section' }}</h2>
    <p>
      This block's outer div is a direct child of the section's
      .shopify-section grid wrapper, so its width class
      (empty / full-width / custom-width) controls how it spans
      that grid.
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Example width section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Example section"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Page width" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 100,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    }
  ],
  "presets": [
    {
      "name": "Example width section"
    }
  ]
}
{% endschema %}
