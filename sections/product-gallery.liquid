{{ 'product-card.css'    | asset_url | stylesheet_tag }}
{{ 'product-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-gallery.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign style = section.settings.gallery_style
  assign columns = section.settings.columns
-%}

<div
  class="product-gallery{% if style == 'intro' %} product-gallery--intro{% endif %}"
  style="--product-gallery-columns: {{ columns }}; --section-padding: {{ section.settings.section_padding }}px;"
>

  {%- if section.settings.heading != blank or section.settings.description != blank -%}
    <div class="product-gallery__header">
      {%- if style == 'intro' -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="product-gallery__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="product-gallery__description">{{ section.settings.description }}</p>
        {%- endif -%}
      {%- else -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="product-gallery__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.view_all_link != blank and section.settings.view_all_label != blank -%}
          <a href="{{ section.settings.view_all_link }}" class="product-gallery__view-all">{{ section.settings.view_all_label }}</a>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- assign product_blocks = section.blocks | where: 'type', 'product' -%}

  {%- if product_blocks.size > 0 -%}
    <ul class="product-gallery__grid" role="list">
      {%- for block in product_blocks -%}
        {%- assign product = block.settings.product -%}
        <li class="product-gallery__item" {{ block.shopify_attributes }}>
          {%- if product != blank -%}
            <div class="product-card" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}">
              <div class="product-card__img-zone">
                <a href="{{ product.url }}" class="product-card__image-wrapper" aria-label="{{ product.title }}">
                  {%- if product.featured_image != blank -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | default: product.title }}"
                      class="product-card__img product-card__img--primary"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {%- endif -%}
                  {%- if product.images[1] != blank -%}
                    <img
                      src="{{ product.images[1] | image_url: width: 600 }}"
                      alt="{{ product.images[1].alt | default: product.title | append: ', alternate view' }}"
                      class="product-card__img product-card__img--secondary"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {%- endif -%}
                </a>
                <button
                  class="product-card__wishlist-btn"
                  type="button"
                  aria-label="Add {{ product.title }} to wishlist"
                  aria-pressed="false"
                  data-wishlist-btn
                  data-product-id="{{ product.id }}"
                >
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path class="product-card__wishlist-path" d="M9 15.5S2 11 2 6a4 4 0 0 1 7-2.65A4 4 0 0 1 16 6c0 5-7 9.5-7 9.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                  </svg>
                </button>
                {%- if product.compare_at_price > product.price -%}
                  {%- assign savings_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price -%}
                  <span class="product-card__badge">Save {{ savings_percent | round }}%</span>
                {%- endif -%}
              </div>
              <div class="product-card__body">
                {%- if product.vendor != blank -%}
                  <span class="product-card__vendor">{{ product.vendor }}</span>
                {%- endif -%}
                <a href="{{ product.url }}" class="product-card__title" title="{{ product.title }}">{{ product.title }}</a>
                <div class="product-card__reviews">
                  <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" data-auto-install="false"></div>
                </div>
                <div class="product-card__pricing">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="product-card__price product-card__price--compare"><s>{{ product.compare_at_price | money }}</s></span>
                    <span class="product-card__price product-card__price--sale">{{ product.price | money }}</span>
                  {%- else -%}
                    <span class="product-card__price">{{ product.price | money }}</span>
                  {%- endif -%}
                </div>
                <div class="product-card__bottom-row">
                  <button
                    class="product-card__atc-btn"
                    type="button"
                    aria-label="Add {{ product.title }} to cart"
                    data-atc-btn
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    data-product-title="{{ product.title }}"
                  >
                    <span data-atc-label>Add to cart</span>
                  </button>
                </div>
              </div>
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="product-gallery__empty">{{ 'sections.product-gallery.no_products' | t: default: 'Add up to 3 products in the section settings.' }}</p>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Product Gallery",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "gallery_style",
      "label": "Header style",
      "options": [
        { "value": "split", "label": "Heading + link (side by side)" },
        { "value": "intro", "label": "Centered heading + description" }
      ],
      "default": "split"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the edit"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "info": "Only shown with the centered header style."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" label",
      "default": "Shop Now",
      "visible_if": "{{ section.settings.gallery_style == 'split' }}"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "\"View all\" link",
      "visible_if": "{{ section.settings.gallery_style == 'split' }}"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Gallery",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
