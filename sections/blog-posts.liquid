{% comment %}
  Only shows articles that have theme.article-tags metafield filled
  Supports multi-tag selection via ?tags=tag1,tag2 (OR logic)

  Defensive parsing: handles article-tags whether it's a proper
  "List of single line text" metafield OR a plain text metafield that
  happens to hold a JSON array string (e.g. '["news","recipes"]' or '[]').
  Best fix long-term is to set the metafield type to "List of single line text"
  in Settings > Custom data > Articles.
{% endcomment %}

{{ 'blog-posts.css' | asset_url | stylesheet_tag }}
{{ 'blog-posts.js' | asset_url | script_tag }}

{% assign target_blog = blogs['articles'] %}

<div class="blog-posts-section section-{{ section.id }}">

  {% if section.settings.heading != blank %}
    <div class="blog-posts-header">
      <h2 class="blog-posts-title">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  {% comment %} === Multi-tag selection from URL, e.g. ?tags=news,recipes === {% endcomment %}
  {% assign current_tags_param = request.params.tags | default: '' %}
  {% assign current_tags = current_tags_param | split: ',' %}

  {% comment %} === Collect tags only from articles that have the metafield === {% endcomment %}
  {% assign all_tags = '' | split: '' %}
  {% for article in target_blog.articles %}
    {% assign raw_tags = article.metafields.theme['article-tags'].value %}
    {% assign a_tags = empty %}
    {% if raw_tags != blank and raw_tags != "[]" %}
      {% if raw_tags.first %}
        {% comment %} Real list-type metafield {% endcomment %}
        {% assign a_tags = raw_tags %}
      {% else %}
        {% comment %} Text metafield holding JSON - parse it safely {% endcomment %}
        {% assign parsed_tags = raw_tags | parse_json %}
        {% if parsed_tags.size > 0 %}
          {% assign a_tags = parsed_tags %}
        {% endif %}
      {% endif %}
    {% endif %}
    {% if a_tags != blank %}
      {% for tag in a_tags %}
        {% unless all_tags contains tag %}
          {% assign all_tags = all_tags | append: tag | append: '|' %}
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endfor %}
  {% assign all_tags = all_tags | split: '|' | uniq | compact %}

  {% comment %} === Tag Filter Bar (multi-select, toggles) === {% endcomment %}
  {% if all_tags.size > 0 %}
    <div class="tag-filter-bar" id="tag-filter-bar">
      <a href="{{ target_blog.url }}" class="tag-pill {% if current_tags_param == blank %}active{% endif %}">
        All
      </a>
      {% for tag in all_tags %}
        {% assign is_active = false %}
        {% if current_tags contains tag %}
          {% assign is_active = true %}
        {% endif %}

        {% comment %} Build the tag list this pill should link to (toggle behavior) {% endcomment %}
        {% assign new_tags_list = '' | split: '' %}
        {% if is_active %}
          {% for t in current_tags %}
            {% unless t == tag %}
              {% assign new_tags_list = new_tags_list | push: t %}
            {% endunless %}
          {% endfor %}
        {% else %}
          {% assign new_tags_list = current_tags | push: tag %}
        {% endif %}
        {% assign new_tags_param = new_tags_list | join: ',' %}

        <a href="{% if new_tags_param == blank %}{{ target_blog.url }}{% else %}{{ target_blog.url }}?tags={{ new_tags_param | url_encode }}{% endif %}"
           class="tag-pill {% if is_active %}active{% endif %}"
           data-tag="{{ tag | escape }}">
          {{ tag }}
        </a>
      {% endfor %}
    </div>
  {% endif %}

  {% comment %} === Only show articles matching at least one selected tag === {% endcomment %}
  <div class="blog-posts-grid">
    {% for article in target_blog.articles limit: section.settings.limit %}
      {% assign raw_art_tags = article.metafields.theme['article-tags'].value %}
      {% assign art_tags = empty %}
      {% if raw_art_tags != blank and raw_art_tags != "[]" %}
        {% if raw_art_tags.first %}
          {% assign art_tags = raw_art_tags %}
        {% else %}
          {% assign parsed_art_tags = raw_art_tags | parse_json %}
          {% if parsed_art_tags.size > 0 %}
            {% assign art_tags = parsed_art_tags %}
          {% endif %}
        {% endif %}
      {% endif %}

      {% if art_tags != blank %}
        {% assign show_article = false %}
        {% if current_tags_param == blank %}
          {% assign show_article = true %}
        {% else %}
          {% for t in current_tags %}
            {% if art_tags contains t %}
              {% assign show_article = true %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if show_article %}
          <article class="blog-post-card">

            {% if article.image %}
              <a href="{{ article.url }}" class="blog-post-image">
                <img
                  src="{{ article.image | image_url: width: 800, height: 520, crop: 'center' }}"
                  alt="{{ article.image.alt | escape }}"
                  loading="lazy">
              </a>
            {% endif %}

            <div class="blog-post-content">
              <h3 class="blog-post-title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>

              {% if article.excerpt != blank %}
                <p class="blog-post-excerpt">{{ article.excerpt | strip_html | truncate: 135 }}</p>
              {% endif %}

              <div class="blog-post-tags">
                {% for tag in art_tags %}
                  {% assign card_is_active = false %}
                  {% if current_tags contains tag %}
                    {% assign card_is_active = true %}
                  {% endif %}

                  {% assign card_new_tags = '' | split: '' %}
                  {% if card_is_active %}
                    {% for t in current_tags %}
                      {% unless t == tag %}
                        {% assign card_new_tags = card_new_tags | push: t %}
                      {% endunless %}
                    {% endfor %}
                  {% else %}
                    {% assign card_new_tags = current_tags | push: tag %}
                  {% endif %}
                  {% assign card_new_tags_param = card_new_tags | join: ',' %}

                  <a href="{% if card_new_tags_param == blank %}{{ target_blog.url }}{% else %}{{ target_blog.url }}?tags={{ card_new_tags_param | url_encode }}{% endif %}"
                     class="tag-pill small {% if card_is_active %}active{% endif %}">
                    {{ tag }}
                  </a>
                {% endfor %}
              </div>

              <div class="blog-post-meta">
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: '%b %d, %Y' }}
                </time>
                <a href="{{ article.url }}" class="read-more-link">Read article →</a>
              </div>
            </div>

          </article>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>

</div>

{% schema %}
{
  "name": "Blog Posts with Tags",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Latest Articles"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 12,
      "label": "Max articles to show"
    }
  ],
  "presets": [
    {
      "name": "Blog Posts with Tags",
      "category": "Blog"
    }
  ]
}
{% endschema %}