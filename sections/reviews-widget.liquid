{% comment %}
  ╔══════════════════════════════════════════════════════════╗
  ║  sections/reviews-widget.liquid  (Yotpo version)          ║
  ║                                                            ║
  ║  Core logic: this section does NOT fetch review data       ║
  ║  itself. Yotpo's own loader script (see install step 1     ║
  ║  below) scans the page for `.yotpo-widget-instance` divs   ║
  ║  and injects the fully rendered widget into them —          ║
  ║  summary, star histogram, review list, pagination, and      ║
  ║  the "Write a review" form, all in one shot.                ║
  ║                                                            ║
  ║  ONE-TIME SETUP REQUIRED (not part of this section):        ║
  ║  Yotpo's loader script must be added once, site-wide, to    ║
  ║  theme.liquid — this is Yotpo's own install step 1, and     ║
  ║  it's specific to your store's Yotpo account. Paste it      ║
  ║  right before </head> in theme.liquid:                      ║
  ║                                                              ║
  ║    <script src="https://cdn-widgetsrepository.yotpo.com/    ║
  ║    v1/loader/YOUR_LOADER_KEY" async></script>                ║
  ║                                                              ║
  ║  Get the exact snippet from Yotpo admin > On-Site Widgets >  ║
  ║  Reviews Widget > Publish > Show Instructions. This section  ║
  ║  only handles step 2 (the per-product widget instance) —     ║
  ║  it assumes the loader is already on every page.             ║
  ║                                                              ║
  ║  Detecting "loaded": Yotpo doesn't document a stable ready  ║
  ║  class the way some other review apps do, so                ║
  ║  assets/reviews-widget.js watches for content appearing     ║
  ║  inside the widget div (MutationObserver on childList) and   ║
  ║  treats that as "loaded." If nothing appears within a        ║
  ║  timeout — app disabled, script blocked, zero reviews and    ║
  ║  Yotpo renders an empty state — the whole section hides       ║
  ║  rather than leaving a stuck shimmer visible forever.         ║
  ║                                                              ║
  ║  Styling: Yotpo's supported way to restyle the widget is      ║
  ║  their own admin (On-Site Widgets > Look & Feel core color,   ║
  ║  or the Widget CSS Editor on Premium/Enterprise plans) —      ║
  ║  their docs note custom CSS written outside that editor       ║
  ║  isn't supported and can break on widget version updates.     ║
  ║  So reviews-widget.css only handles OUR layer: section       ║
  ║  width/padding and the loading shimmer. It intentionally      ║
  ║  does not reach into Yotpo's internal markup.                  ║
  ║                                                              ║
  ║  Section layout: width_class + --section-padding follow      ║
  ║  the same pattern as sections/product-recommendations.liquid  ║
  ║  and sections/frequently-bought-together.liquid — side        ║
  ║  padding is section-local, not tied to the theme's global      ║
  ║  --page-margin.                                                ║
  ╚══════════════════════════════════════════════════════════╝
{% endcomment %}

{%- liquid
  assign heading    = section.settings.heading
  assign cs          = section.settings.color_scheme
  assign pad_top     = section.settings.padding_top
  assign pad_bottom  = section.settings.padding_bottom
  assign show_demo   = section.settings.show_demo_data
  assign instance_id = section.settings.yotpo_instance_id

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'default-width'
  else
    assign width_class = width_type
  endif
-%}

{{ 'reviews-widget.css' | asset_url | stylesheet_tag }}

<div
  class="revs-section cs-{{ cs }} {{ width_class }}"
  {%- comment -%}
    id="yotpoReviewsWidget" is a plain HTML anchor target — the
    Yotpo Star Rating snippet (snippets/star-rating.liquid)
    links to #yotpoReviewsWidget so clicking it scrolls here. This
    works via normal browser anchor scrolling and doesn't depend on
    Yotpo's own script recognizing the id. (Not section.id-based,
    since it needs to match the fixed anchor the star rating uses.)
  {%- endcomment -%}
  id="yotpoReviewsWidget"
  {%- unless show_demo %} data-revs-section{% endunless %}
  style="
    --revs-pad-top: {{ pad_top }}px;
    --revs-pad-bottom: {{ pad_bottom }}px;
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  {%- if heading != blank -%}
    <div class="revs-header">
      <h2 class="revs-heading">{{ heading }}</h2>
      {%- if show_demo -%}
        <p class="revs-demo-flag">Showing sample data — turn off "Show demo data" in section settings once Yotpo has real reviews.</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="revs-widget-wrapper" data-revs-widget-wrapper>
    {%- if show_demo -%}
      {%- comment -%}
        Static, inert sample markup — NOT a reproduction of Yotpo's
        internal DOM (which isn't stable/documented enough to fake
        reliably). This just previews our own layout/shimmer/spacing
        with placeholder content so the section doesn't look empty
        while you're setting Yotpo up.
      {%- endcomment -%}
      <div class="revs-demo">
        <div class="revs-demo__header">
          <div class="revs-demo__stars" aria-hidden="true">★★★★☆</div>
          <span class="revs-demo__average">4.6 out of 5</span>
          <span class="revs-demo__count">Based on 128 reviews</span>
          <a href="#" class="revs-demo__cta" onclick="return false;">Write a review</a>
        </div>
        <div class="revs-demo__list">
          {%- assign demo_names = 'Alex M.|Jordan K.|Priya S.' | split: '|' -%}
          {%- assign demo_titles = 'Exactly what I needed|Great quality, fast shipping|Would buy again' | split: '|' -%}
          {%- assign demo_bodies = 'This exceeded my expectations — well made and works exactly as described.|Arrived earlier than expected and the quality feels premium.|Second time ordering this. Consistent quality every time.' | split: '|' -%}
          {%- assign demo_dates = '07/02/2026|06/24/2026|06/11/2026' | split: '|' -%}
          {%- assign demo_stars = '5|4|5' | split: '|' -%}

          {%- for i in (0..2) -%}
            <div class="revs-demo__card">
              <div class="revs-demo__card-top">
                {%- assign star_count = demo_stars[i] | plus: 0 -%}
                <span class="revs-demo__card-stars" aria-hidden="true">
                  {%- for s in (1..5) -%}{% if s <= star_count %}★{% else %}☆{% endif %}{%- endfor -%}
                </span>
                <span class="revs-demo__card-date">{{ demo_dates[i] }}</span>
              </div>
              <b class="revs-demo__card-title">{{ demo_titles[i] }}</b>
              <p class="revs-demo__card-body">{{ demo_bodies[i] }}</p>
              <span class="revs-demo__card-author">{{ demo_names[i] }}</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      {%- comment -%}
        This is Yotpo's documented per-product widget snippet
        (install step 2). Leave the class and data attributes as
        Yotpo generated them for your account — their loader script
        matches on `.yotpo-widget-instance` and the data-yotpo-*
        attributes. Swap in your real Instance ID via the section
        setting below (find it in Yotpo admin > On-Site Widgets >
        Reviews Widget > Publish > Show Instructions).
      {%- endcomment -%}
      <div
        class="yotpo-widget-instance"
        data-yotpo-instance-id="{{ instance_id }}"
        data-yotpo-product-id="{{ product.id }}"
        data-yotpo-name="{{ product.title | escape }}"
        data-yotpo-url="{{ shop.url }}{{ product.url }}"
        data-yotpo-image-url="{{ product.featured_image | product_img_url: 'large' | prepend: 'https:' | replace: '?', '%3F' | replace: '&', '%26' }}"
        data-yotpo-price="{{ product.price | divided_by: 100.00 }}"
        data-yotpo-currency="{{ shop.currency }}"
        data-yotpo-description="{{ product.description | escape }}"
      ></div>

      <div class="revs-shimmer" data-revs-shimmer aria-hidden="true">
        <div class="revs-shimmer__summary">
          <div class="revs-shimmer__line revs-shimmer__line--stars"></div>
          <div class="revs-shimmer__line revs-shimmer__line--text"></div>
        </div>
        <div class="revs-shimmer__list">
          {%- for i in (1..3) -%}
            <div class="revs-shimmer__card">
              <div class="revs-shimmer__line revs-shimmer__line--stars-sm"></div>
              <div class="revs-shimmer__line revs-shimmer__line--title"></div>
              <div class="revs-shimmer__line revs-shimmer__line--body"></div>
              <div class="revs-shimmer__line revs-shimmer__line--body revs-shimmer__line--short"></div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- unless show_demo -%}
  <script src="{{ 'reviews-widget.js' | asset_url }}" defer></script>
{%- endunless -%}

{% schema %}
{
  "name": "Reviews Widget",
  "tag": "section",
  "class": "section-reviews-widget",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "yotpo_instance_id",
      "label": "Yotpo Reviews Widget Instance ID",
      "info": "Find this in Yotpo admin: On-Site Widgets > Reviews Widget > Publish > Show Instructions. It's the same ID across all products."
    },
    {
      "type": "checkbox",
      "id": "show_demo_data",
      "label": "Show demo data",
      "info": "Temporary — shows sample reviews for previewing the layout, ignoring your real Yotpo data. Turn this off when you're ready to go live.",
      "default": false
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light",  "label": "Light" },
        { "value": "gray",   "label": "Light gray" },
        { "value": "dark",   "label": "Dark" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    }
  ],
  "templates": ["product"],
  "presets": [
    {
      "name": "Reviews Widget"
    }
  ]
}
{% endschema %}
