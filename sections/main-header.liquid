{%- comment -%}
  sections/main-header.liquid

  Converted from snippets/main-header.liquid. Rendered from inside sections/header.liquid
  via {% section 'main-header' %}, so it stays nested inside <header id="site-header">
  (preserving that element's sticky/autohide behavior) while getting its own independent
  settings and blocks in the theme editor.

  NOTE: enable_search_drawer / enable_search_drawer_tablet are duplicated here and on
  sections/header.liquid's own schema. header.liquid uses them to add
  site-header--search-drawer-mobile / --search-drawer-tablet classes to the outer
  <header> wrapper; this section uses them for its own drawer markup and conditionals.
  Two separate section scopes now — keep both in sync if you change one.
{%- endcomment -%}

{{ 'main-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo       = settings.logo
  assign logo_width = settings.logo_width | default: 140
  assign show_acct  = section.settings.show_icon_account
  assign show_cart  = section.settings.show_icon_cart
  assign show_wish  = section.settings.show_icon_wishlist
  assign show_comp  = section.settings.show_icon_compare
  assign label_acct = section.settings.show_label_account
  assign label_cart = section.settings.show_label_cart
  assign label_wish = section.settings.show_label_wishlist
  assign label_comp = section.settings.show_label_compare
  assign enable_search_drawer_tablet = section.settings.enable_search_drawer_tablet

  assign trending_terms = ''
  for i in (1..8)
    assign key = 'trending_' | append: i
    assign term = section.settings[key]
    if term != blank
      assign trending_terms = trending_terms | append: term | append: '||'
    endif
  endfor
-%}

<div class="main-header__bar">
  <div class="main-header__inner">

    {%- if section.blocks.size > 0 -%}
      <button type="button"
              class="ecombio-header__hamburger"
              id="main-header-menu-trigger"
              aria-expanded="false"
              aria-controls="main-header-mobile-nav"
              aria-label="Open menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    {%- endif -%}

    {%- if section.settings.enable_search_drawer -%}
      <div class="main-header__search-drawer-mobile-only">
        {%- render 'header-search-drawer',
          enable_predictive_search: section.settings.enable_predictive_search,
          trending_terms: trending_terms,
          enable_typewriter: section.settings.enable_typewriter,
          typewriter_type_speed: section.settings.typewriter_type_speed,
          typewriter_hold_ms: section.settings.typewriter_hold_ms
        -%}
      </div>
    {%- endif -%}
    {%- if enable_search_drawer_tablet -%}
      <div class="main-header__search-drawer-tablet-only">
        {%- render 'header-search-drawer',
          enable_predictive_search: section.settings.enable_predictive_search,
          trending_terms: trending_terms,
          enable_typewriter: section.settings.enable_typewriter,
          typewriter_type_speed: section.settings.typewriter_type_speed,
          typewriter_hold_ms: section.settings.typewriter_hold_ms
        -%}
      </div>
    {%- endif -%}

    {%- render 'header-logo', logo: logo, logo_width: logo_width -%}

    <div class="main-header__search--inline">
      {%- render 'header-search',
        enable_predictive_search: section.settings.enable_predictive_search,
        variant: 'desktop',
        trending_terms: trending_terms,
        enable_typewriter: section.settings.enable_typewriter,
        typewriter_type_speed: section.settings.typewriter_type_speed,
        typewriter_hold_ms: section.settings.typewriter_hold_ms
      -%}
    </div>

    <ul class="main-header__icons" role="list" aria-label="Header actions">
      {%- if show_comp != false -%}
        <li>{%- render 'header-compare', show_label: label_comp -%}</li>
      {%- endif -%}
      {%- if show_wish != false -%}
        <li>{%- render 'header-wishlist', show_label: label_wish -%}</li>
      {%- endif -%}
      {%- if show_acct != false -%}
        <li>{%- render 'header-account', show_label: label_acct -%}</li>
      {%- endif -%}
      {%- if show_cart != false -%}
        <li>{%- render 'header-cart', show_label: label_cart -%}</li>
      {%- endif -%}
    </ul>

  </div>
</div>

<div class="main-header__search-row{% if section.settings.enable_search_drawer %} main-header__search-row--drawer-mobile{% endif %}{% if enable_search_drawer_tablet %} main-header__search-row--drawer-tablet{% endif %}">
  <div class="main-header__search-row-inner">
    {%- render 'header-search',
      enable_predictive_search: section.settings.enable_predictive_search,
      variant: 'mobile',
      trending_terms: trending_terms,
      enable_typewriter: section.settings.enable_typewriter,
      typewriter_type_speed: section.settings.typewriter_type_speed,
      typewriter_hold_ms: section.settings.typewriter_hold_ms
    -%}
  </div>
</div>

{%- render 'header-menu', blocks: section.blocks -%}

{% schema %}
{
  "name": "Main header",
  "tag": "div",
  "class": "main-header-only-section",
  "settings": [
    { "type": "header", "content": "Mobile Division (< 640px)" },
    {
      "type": "checkbox",
      "id": "enable_search_drawer",
      "label": "Enable search drawer icon (mobile only, < 640px)",
      "info": "Adds a search icon that opens a full-screen drawer sliding down from the top, replacing the search row on mobile screens only (below 640px). Must match the Header section's own setting of the same name, which controls a wrapper class on the outer <header> element.",
      "default": false
    },

    { "type": "header", "content": "Tablet Division (640px – 1023px)" },
    {
      "type": "checkbox",
      "id": "enable_search_drawer_tablet",
      "label": "Enable search drawer icon (tablet only, 640px – 1023px)",
      "info": "Adds a search icon that opens a full-screen drawer sliding down from the top, replacing the search row on tablet screens only (640px–1023px). Must match the Header section's own setting of the same name, which controls a wrapper class on the outer <header> element.",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "Icon labels are shown automatically at this width via CSS, with no toggle."
    },

    { "type": "header", "content": "Search (all breakpoints)" },
    {
      "type": "checkbox",
      "id": "enable_predictive_search",
      "label": "Enable predictive search",
      "info": "Shows product, collection and query suggestions as the customer types.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_typewriter",
      "label": "Animate placeholder (typewriter effect)",
      "default": true,
      "visible_if": "{{ section.settings.enable_predictive_search }}"
    },
    {
      "type": "range",
      "id": "typewriter_type_speed",
      "label": "Typing speed",
      "min": 30,
      "max": 150,
      "step": 5,
      "default": 70,
      "unit": "ms",
      "visible_if": "{{ section.settings.enable_predictive_search and section.settings.enable_typewriter }}"
    },
    {
      "type": "range",
      "id": "typewriter_hold_ms",
      "label": "Pause on full word",
      "min": 1000,
      "max": 5000,
      "step": 100,
      "default": 3200,
      "unit": "ms",
      "visible_if": "{{ section.settings.enable_predictive_search and section.settings.enable_typewriter }}"
    },
    {
      "type": "paragraph",
      "content": "Trending search terms — shown as the animated placeholder and in the empty-state suggestions. Leave a field blank to drop that term.",
      "visible_if": "{{ section.settings.enable_predictive_search }}"
    },
    {
      "type": "text",
      "id": "trending_1",
      "label": "Trending term 1",
      "default": "sneakers",
      "visible_if": "{{ section.settings.enable_predictive_search }}"
    },
    {
      "type": "text",
      "id": "trending_2",
      "label": "Trending term 2",
      "default": "hoodies",
      "visible_if": "{{ section.settings.enable_predictive_search }}"
    },
    {
      "type": "text",
      "id": "trending_3",
      "label": "Trending term 3",
      "default": "summer dresses",
      "visible_if": "{{ section.settings.enable_predictive_search }}"
    },
    {
      "type": "text",
      "id": "trending_4",
      "label": "Trending term 4",
      "default": "running shoes",
      "visible_if": "{{ section.settings.enable_predictive_search }}"
    },
    {
      "type": "text",
      "id": "trending_5",
      "label": "Trending term 5",
      "default": "gift sets",
      "visible_if": "{{ section.settings.enable_predictive_search }}"
    },
    {
      "type": "text",
      "id": "trending_6",
      "label": "Trending term 6",
      "default": "new arrivals",
      "visible_if": "{{ section.settings.enable_predictive_search }}"
    },
    {
      "type": "text",
      "id": "trending_7",
      "label": "Trending term 7",
      "default": "accessories",
      "visible_if": "{{ section.settings.enable_predictive_search }}"
    },
    {
      "type": "text",
      "id": "trending_8",
      "label": "Trending term 8",
      "default": "sale items",
      "visible_if": "{{ section.settings.enable_predictive_search }}"
    },

    { "type": "header", "content": "Icons (all breakpoints)" },
    {
      "type": "checkbox",
      "id": "show_icon_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_label_account",
      "label": "Show account label",
      "info": "When off, only the icon is shown for this item — no text label at any breakpoint.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_icon_wishlist",
      "label": "Show wishlist icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_label_wishlist",
      "label": "Show wishlist label",
      "info": "When off, only the icon is shown for this item — no text label at any breakpoint.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_icon_compare",
      "label": "Show compare icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_label_compare",
      "label": "Show compare label",
      "info": "When off, only the icon is shown for this item — no text label at any breakpoint.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_icon_cart",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_label_cart",
      "label": "Show cart label",
      "info": "When off, only the icon is shown for this item — no text label at any breakpoint.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "single-link",
      "name": "Single Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Single Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "URL"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name",
          "info": "Optional. Uses snippets/menu-icon.liquid"
        }
      ]
    },
    {
      "type": "link-list",
      "name": "Link list",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Top-level URL (optional)"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Link list menu"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name"
        }
      ]
    },
    {
      "type": "mega-menu",
      "name": "Mega menu",
      "settings": [
        {
          "type": "header",
          "content": "Nav bar"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Optional. Falls back to the selected menu's title, then to the linked collection's title, then to \"Mega menu\"."
        },
        {
          "type": "url",
          "id": "link",
          "label": "URL",
          "info": "Optional. Falls back to first menu link."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name"
        },
        {
          "type": "header",
          "content": "Products"
        },
        {
          "type": "checkbox",
          "id": "show_products",
          "label": "Show trending products",
          "default": false,
          "info": "Pulls the first 3 products from the first collection link found in the chosen menu."
        }
      ]
    },
    {
      "type": "showcase",
      "name": "Showcase",
      "settings": [
        { "type": "header", "content": "Nav bar" },
        { "type": "text", "id": "label", "label": "Label", "info": "Optional. Falls back to the linked collection's title, then to \"Showcase\"." },
        { "type": "url", "id": "link", "label": "URL", "info": "Optional. Falls back to '#' if blank." },
        { "type": "text", "id": "icon", "label": "Icon name", "info": "Optional. Uses snippets/menu-icon.liquid" },

        { "type": "header", "content": "Panel layout" },
        {
          "type": "select",
          "id": "panel_width",
          "label": "Panel width",
          "info": "Default aligns the dropdown panel with the header's own content width, so it doesn't stretch further than the header above it.",
          "options": [
            { "value": "", "label": "Default (aligns with header)" },
            { "value": "full-width", "label": "Full width" },
            { "value": "custom-width", "label": "Custom width" }
          ],
          "default": ""
        },
        {
          "type": "range",
          "id": "panel_custom_width",
          "label": "Custom width",
          "min": 40,
          "max": 120,
          "step": 5,
          "unit": "rem",
          "default": 80,
          "visible_if": "{{ block.settings.panel_width == 'custom-width' }}"
        },
        {
          "type": "range",
          "id": "panel_padding",
          "label": "Side padding",
          "min": 0,
          "max": 80,
          "step": 4,
          "unit": "px",
          "default": 24
        },

        { "type": "header", "content": "Sidebar (optional)" },
        { "type": "checkbox", "id": "show_sidebar", "label": "Show sidebar", "default": true },
        { "type": "text", "id": "sidebar_heading", "label": "Sidebar heading", "default": "Good to know" },

        { "type": "text", "id": "tip_1_icon", "label": "Tip 1 icon name" },
        { "type": "text", "id": "tip_1_heading", "label": "Tip 1 heading", "default": "Trade-in" },
        { "type": "text", "id": "tip_1_body", "label": "Tip 1 body", "default": "Get up to $700 for your old device" },

        { "type": "text", "id": "tip_2_icon", "label": "Tip 2 icon name" },
        { "type": "text", "id": "tip_2_heading", "label": "Tip 2 heading" },
        { "type": "text", "id": "tip_2_body", "label": "Tip 2 body" },

        { "type": "text", "id": "tip_3_icon", "label": "Tip 3 icon name" },
        { "type": "text", "id": "tip_3_heading", "label": "Tip 3 heading" },
        { "type": "text", "id": "tip_3_body", "label": "Tip 3 body" },

        { "type": "header", "content": "Categories" },

        { "type": "paragraph", "content": "\"See all\" automatically uses the collection linked in the URL field above. Each category below uses its selected collection's title, link, and featured image automatically." },

        { "type": "collection", "id": "cat_1_collection", "label": "Category 1 collection" },
        { "type": "collection", "id": "cat_2_collection", "label": "Category 2 collection" },
        { "type": "collection", "id": "cat_3_collection", "label": "Category 3 collection" },
        { "type": "collection", "id": "cat_4_collection", "label": "Category 4 collection" },
        { "type": "collection", "id": "cat_5_collection", "label": "Category 5 collection" },
        { "type": "collection", "id": "cat_6_collection", "label": "Category 6 collection" },
        { "type": "collection", "id": "cat_7_collection", "label": "Category 7 collection" },
        { "type": "collection", "id": "cat_8_collection", "label": "Category 8 collection" }
      ]
    },
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "On Sale"
        },
        {
          "type": "url",
          "id": "link",
          "label": "URL"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Main header",
      "blocks": [
        { "type": "single-link", "settings": { "label": "Single link", "link": "/collections/all" } },
        { "type": "link-list", "settings": { "label": "Link list" } },
        { "type": "mega-menu", "settings": {} },
        { "type": "showcase", "settings": {} },
        { "type": "highlight", "settings": { "label": "On Sale", "link": "/collections/sale" } }
      ]
    }
  ]
}
{% endschema %}