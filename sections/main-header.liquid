{{ 'main-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo       = settings.logo
  assign logo_width = settings.logo_width | default: 140
  assign show_acct  = section.settings.show_icon_account
  assign show_cart  = section.settings.show_icon_cart
  assign enable_search_drawer_tablet = section.settings.enable_search_drawer_tablet

  assign section_width = section.settings.section_width
  if section_width == blank
    assign width_class = 'main-header--default-width'
  elsif section_width == 'full-width'
    assign width_class = 'main-header--full-width'
  else
    assign width_class = 'main-header--custom-width'
  endif
-%}

<header class="main-header {{ width_class }}{% if section.settings.enable_sticky %} main-header--sticky-enabled{% endif %}{% if section.settings.enable_search_drawer %} main-header--search-drawer-mobile{% endif %}{% if enable_search_drawer_tablet %} main-header--search-drawer-tablet{% endif %}"
        id="main-header"
        role="banner"
        {%- if section.settings.enable_sticky %}
        data-sticky-fixed="true"
        data-autohide="{{ section.settings.enable_autohide }}"
        {%- endif %}
        style="
          --section-padding: {{ section.settings.section_padding }}px;
          {%- if section_width == 'custom-width' %}
            --custom-width: {{ section.settings.custom_width }}rem;
          {%- endif %}
        ">

  <div class="main-header__bar">
    <div class="main-header__inner">

      {%- if section.blocks.size > 0 -%}
        <button type="button"
                class="ecombio-header__hamburger"
                id="main-header-menu-trigger"
                aria-expanded="false"
                aria-controls="main-header-mobile-nav"
                aria-label="Open menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      {%- endif -%}

      {%- if section.settings.enable_search_drawer -%}
        <div class="main-header__search-drawer-mobile-only">
          {%- render 'header-search-drawer', enable_predictive_search: section.settings.enable_predictive_search -%}
        </div>
      {%- endif -%}
      {%- if enable_search_drawer_tablet -%}
        <div class="main-header__search-drawer-tablet-only">
          {%- render 'header-search-drawer', enable_predictive_search: section.settings.enable_predictive_search -%}
        </div>
      {%- endif -%}

      {%- render 'header-logo', logo: logo, logo_width: logo_width -%}

      <div class="main-header__search--inline">
        {%- render 'header-search', enable_predictive_search: section.settings.enable_predictive_search, variant: 'desktop' -%}
      </div>

      <ul class="main-header__icons" role="list" aria-label="Header actions">
        {%- if show_acct != false -%}
          <li>{%- render 'header-account' -%}</li>
        {%- endif -%}
        {%- if show_cart != false -%}
          <li>{%- render 'header-cart' -%}</li>
        {%- endif -%}
      </ul>

    </div>
  </div>

  <div class="main-header__search-row{% if section.settings.enable_search_drawer %} main-header__search-row--drawer-mobile{% endif %}{% if enable_search_drawer_tablet %} main-header__search-row--drawer-tablet{% endif %}">
    <div class="main-header__search-row-inner">
      {%- render 'header-search', enable_predictive_search: section.settings.enable_predictive_search, variant: 'mobile' -%}
    </div>
  </div>

  {%- render 'header-menu', blocks: section.blocks -%}

</header>

<script src="{{ 'main-header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Main Header",
  "tag": "div",
  "class": "main-header-section",
  "settings": [
    { "type": "header", "content": "Section layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24,
      "info": "Applies at tablet and desktop widths. Mobile (< 640px) keeps its own fixed, tighter padding regardless of this setting."
    },

    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky header",
      "info": "Keeps the header pinned to the top of the viewport while the page scrolls.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autohide",
      "label": "Hide header on scroll down",
      "info": "Only applies when sticky header is enabled. Header slides away as the customer scrolls down, and reappears when they scroll back up or near the top of the page.",
      "default": false,
      "visible_if": "{{ section.settings.enable_sticky }}"
    },

    { "type": "header", "content": "Mobile Division (< 640px)" },
    {
      "type": "checkbox",
      "id": "enable_search_drawer",
      "label": "Enable search drawer icon (mobile only, < 640px)",
      "info": "Adds a search icon to the header that opens a full-screen drawer sliding down from the top, replacing the search row on mobile screens only (below 640px). Independent of Tablet's setting below.",
      "default": false
    },

    { "type": "header", "content": "Tablet Division (640px – 1023px)" },
    {
      "type": "checkbox",
      "id": "enable_search_drawer_tablet",
      "label": "Enable search drawer icon (tablet only, 640px – 1023px)",
      "info": "Adds a search icon to the header that opens a full-screen drawer sliding down from the top, replacing the search row on tablet screens only (640px–1023px). Independent of Mobile's setting above.",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "Icon labels are shown automatically at this width via CSS, with no toggle."
    },

    { "type": "header", "content": "Search (all breakpoints)" },
    {
      "type": "checkbox",
      "id": "enable_predictive_search",
      "label": "Enable predictive search",
      "info": "Shows product, collection and query suggestions as the customer types.",
      "default": true
    },

    { "type": "header", "content": "Icons (all breakpoints)" },
    {
      "type": "checkbox",
      "id": "show_icon_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_icon_cart",
      "label": "Show cart icon",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "single-link",
      "name": "Single Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Single Link" },
        { "type": "url", "id": "link", "label": "URL" },
        { "type": "text", "id": "icon", "label": "Icon name", "info": "Optional. Uses snippets/menu-icon.liquid" }
      ]
    },
    {
      "type": "link-list",
      "name": "Link list",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Top-level URL (optional)" },
        { "type": "link_list", "id": "menu", "label": "Link list menu" },
        { "type": "text", "id": "icon", "label": "Icon name" }
      ]
    },
    {
      "type": "mega-menu",
      "name": "Mega menu",
      "settings": [
        { "type": "header", "content": "Nav bar" },
        { "type": "text", "id": "label", "label": "Label", "info": "Optional. Falls back to the selected menu's title, then to the linked collection's title, then to \"Mega menu\"." },
        { "type": "url", "id": "link", "label": "URL", "info": "Optional. Falls back to first menu link." },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "text", "id": "icon", "label": "Icon name" },
        { "type": "header", "content": "Products" },
        { "type": "checkbox", "id": "show_products", "label": "Show trending products", "default": false, "info": "Pulls the first 3 products from the first collection link found in the chosen menu." }
      ]
    },
    {
      "type": "showcase",
      "name": "Showcase",
      "settings": [
        { "type": "header", "content": "Nav bar" },
        { "type": "text", "id": "label", "label": "Label", "info": "Optional. Falls back to the linked collection's title, then to \"Showcase\"." },
        { "type": "url", "id": "link", "label": "URL", "info": "Optional. Falls back to '#' if blank." },
        { "type": "text", "id": "icon", "label": "Icon name", "info": "Optional. Uses snippets/menu-icon.liquid" },

        { "type": "header", "content": "Panel layout" },
        {
          "type": "select",
          "id": "panel_width",
          "label": "Panel width",
          "info": "Default aligns the dropdown panel with the header's own content width, so it doesn't stretch further than the header above it.",
          "options": [
            { "value": "", "label": "Default (aligns with header)" },
            { "value": "full-width", "label": "Full width" },
            { "value": "custom-width", "label": "Custom width" }
          ],
          "default": ""
        },
        {
          "type": "range",
          "id": "panel_custom_width",
          "label": "Custom width",
          "min": 40,
          "max": 120,
          "step": 5,
          "unit": "rem",
          "default": 80,
          "visible_if": "{{ block.settings.panel_width == 'custom-width' }}"
        },
        {
          "type": "range",
          "id": "panel_padding",
          "label": "Side padding",
          "min": 0,
          "max": 80,
          "step": 4,
          "unit": "px",
          "default": 24
        },

        { "type": "header", "content": "Sidebar (optional)" },
        { "type": "checkbox", "id": "show_sidebar", "label": "Show sidebar", "default": true },
        { "type": "text", "id": "sidebar_heading", "label": "Sidebar heading", "default": "Good to know" },

        { "type": "text", "id": "tip_1_icon", "label": "Tip 1 icon name" },
        { "type": "text", "id": "tip_1_heading", "label": "Tip 1 heading", "default": "Trade-in" },
        { "type": "text", "id": "tip_1_body", "label": "Tip 1 body", "default": "Get up to $700 for your old device" },

        { "type": "text", "id": "tip_2_icon", "label": "Tip 2 icon name" },
        { "type": "text", "id": "tip_2_heading", "label": "Tip 2 heading" },
        { "type": "text", "id": "tip_2_body", "label": "Tip 2 body" },

        { "type": "text", "id": "tip_3_icon", "label": "Tip 3 icon name" },
        { "type": "text", "id": "tip_3_heading", "label": "Tip 3 heading" },
        { "type": "text", "id": "tip_3_body", "label": "Tip 3 body" },

        { "type": "header", "content": "Categories" },
        { "type": "paragraph", "content": "\"See all\" automatically uses the collection linked in the URL field above. Each category below uses its selected collection's title, link, and featured image automatically." },

        { "type": "collection", "id": "cat_1_collection", "label": "Category 1 collection" },
        { "type": "collection", "id": "cat_2_collection", "label": "Category 2 collection" },
        { "type": "collection", "id": "cat_3_collection", "label": "Category 3 collection" },
        { "type": "collection", "id": "cat_4_collection", "label": "Category 4 collection" },
        { "type": "collection", "id": "cat_5_collection", "label": "Category 5 collection" },
        { "type": "collection", "id": "cat_6_collection", "label": "Category 6 collection" },
        { "type": "collection", "id": "cat_7_collection", "label": "Category 7 collection" },
        { "type": "collection", "id": "cat_8_collection", "label": "Category 8 collection" }
      ]
    },
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "On Sale" },
        { "type": "url", "id": "link", "label": "URL" },
        { "type": "text", "id": "icon", "label": "Icon name" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Main Header",
      "blocks": [
        { "type": "single-link", "settings": { "label": "Single link", "link": "/collections/all" } },
        { "type": "link-list", "settings": { "label": "Link list" } },
        { "type": "mega-menu", "settings": {} },
        { "type": "showcase", "settings": {} },
        { "type": "highlight", "settings": { "label": "On Sale", "link": "/collections/sale" } }
      ]
    }
  ]
}
{% endschema %}