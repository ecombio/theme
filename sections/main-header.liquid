{{ 'main-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo       = settings.logo
  assign logo_width = settings.logo_width | default: 110
  assign show_acct  = section.settings.show_icon_account
  assign show_cart  = section.settings.show_icon_cart
  assign show_wish  = section.settings.show_icon_wishlist
  assign show_comp  = section.settings.show_icon_compare
  assign label_acct = section.settings.show_label_account
  assign label_cart = section.settings.show_label_cart
  assign label_wish = section.settings.show_label_wishlist
  assign label_comp = section.settings.show_label_compare
  assign enable_search_drawer_tablet = section.settings.enable_search_drawer_tablet

  assign section_width = section.settings.section_width
  case section_width
    when 'full-width'
      assign width_class = 'main-header--full-width'
    when 'custom-width'
      assign width_class = 'main-header--custom-width'
    else
      assign width_class = 'main-header--default-width'
  endcase

  assign trending_terms = ''
  for i in (1..12)
    assign key = 'trending_' | append: i
    assign term = section.settings[key]
    if term != blank
      assign trending_terms = trending_terms | append: term | append: '||'
    endif
  endfor

  comment
    ADDED — transparent-over-hero header (see main-header.css /
    header-group.css / header-group.js for the rest of the
    implementation). Homepage-only by design: computed server-side
    from request.page_type rather than any client-side URL check, so
    it can never be spoofed or drift out of sync, and it degrades
    safely to "false" (today's normal solid header) on every other
    page even if the JS fails to load.
  endcomment
  assign transparent_header_enabled = false
  if request.page_type == 'index'
    assign transparent_header_enabled = true
  endif
-%}

{%- if transparent_header_enabled -%}
  {%- comment -%}
    ADDED — pairs with data-transparent-header below. Emitted as an
    inline server-rendered style rather than a class on <body> (which
    we don't control from this file, and header-group.css's earlier
    guess at that class — .template-index — didn't match this theme).
    This is computed from the same request.page_type check above, so
    it's guaranteed correct with zero dependency on theme.liquid or
    JS timing: overrides header-group.css's
    `main[role="main"] { padding-top: var(--header-group-height...) }`
    so the hero/slideshow section starts at the very top of the page
    instead of leaving a gap the height of the header above it.
    !important since header-group.css's rule loads from a separate
    stylesheet and doesn't use one itself.

    FIX (desktop-only transparency) — wrapped in the same
    min-width: 64rem breakpoint used everywhere else the transparent
    header is scoped (main-header.css, header-group.css,
    header-group.js). Transparency is a desktop-only effect; on
    mobile/tablet the header stays solid (see the other three files),
    so the padding this rule removes must stay reserved on those
    breakpoints too — otherwise page content would render underneath
    the solid fixed header instead of below it.
  {%- endcomment -%}
  <style>
    @media (min-width: 64rem) {
      main[role="main"] { padding-top: 0 !important; }
    }
  </style>
{%- endif -%}

<header
  class="main-header {{ width_class }}{% if section.settings.enable_search_drawer %} main-header--search-drawer-mobile{% endif %}{% if enable_search_drawer_tablet %} main-header--search-drawer-tablet{% endif %}"
  id="main-header"
  role="banner"
  data-transparent-header="{{ transparent_header_enabled }}"
  style="
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if section_width == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  <div class="main-header__bar">
    <div class="main-header__inner">

      {%- if section.blocks.size > 0 -%}
        <button type="button"
                class="ecombio-header__hamburger"
                id="main-header-menu-trigger"
                aria-expanded="false"
                aria-controls="main-header-mobile-nav"
                aria-label="Open menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      {%- endif -%}

      {%- if section.settings.enable_search_drawer -%}
        <div class="main-header__search-drawer-mobile-only">
          {%- render 'header-search-drawer',
            enable_predictive_search: section.settings.enable_predictive_search,
            trending_terms: trending_terms,
            enable_typewriter: section.settings.enable_typewriter,
            typewriter_type_speed: section.settings.typewriter_type_speed,
            typewriter_hold_ms: section.settings.typewriter_hold_ms
          -%}
        </div>
      {%- endif -%}
      {%- if enable_search_drawer_tablet -%}
        <div class="main-header__search-drawer-tablet-only">
          {%- render 'header-search-drawer',
            enable_predictive_search: section.settings.enable_predictive_search,
            trending_terms: trending_terms,
            enable_typewriter: section.settings.enable_typewriter,
            typewriter_type_speed: section.settings.typewriter_type_speed,
            typewriter_hold_ms: section.settings.typewriter_hold_ms
          -%}
        </div>
      {%- endif -%}

      <div class="main-header__logo">
        {%- render 'header-logo', logo: logo, logo_width: logo_width -%}
      </div>

      <div class="main-header__nav">
        {%- render 'header-menu', blocks: section.blocks -%}
      </div>

      <ul class="main-header__icons" role="list" aria-label="Header actions">
        <li>
          <button type="button"
                  class="main-header__search-trigger"
                  id="main-header-search-trigger"
                  aria-haspopup="dialog"
                  aria-expanded="false"
                  aria-controls="main-header-search-overlay"
                  aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <span class="visually-hidden">Search</span>
          </button>
        </li>
        {%- if show_wish != false -%}
          <li>{%- render 'header-wishlist', show_label: label_wish -%}</li>
        {%- endif -%}
        {%- if show_comp != false -%}
          <li>{%- render 'header-compare', show_label: label_comp -%}</li>
        {%- endif -%}
        {%- if show_acct != false -%}
          <li>{%- render 'header-account', show_label: label_acct -%}</li>
        {%- endif -%}
        {%- if show_cart != false -%}
          <li>{%- render 'header-cart', show_label: label_cart -%}</li>
        {%- endif -%}
      </ul>

    </div>
  </div>

  <div class="main-header__search-row{% if section.settings.enable_search_drawer %} main-header__search-row--drawer-mobile{% endif %}{% if enable_search_drawer_tablet %} main-header__search-row--drawer-tablet{% endif %}">
    <div class="main-header__search-row-inner">
      {%- render 'header-search',
        enable_predictive_search: section.settings.enable_predictive_search,
        variant: 'mobile',
        trending_terms: trending_terms,
        enable_typewriter: section.settings.enable_typewriter,
        typewriter_type_speed: section.settings.typewriter_type_speed,
        typewriter_hold_ms: section.settings.typewriter_hold_ms
      -%}
    </div>
  </div>

  <div class="main-header__search-overlay" id="main-header-search-overlay" data-search-overlay hidden>
    <div class="main-header__search-overlay-backdrop" data-search-overlay-close></div>
    <div class="main-header__search-overlay-panel" role="dialog" aria-modal="true" aria-label="Search">
      <div class="main-header__search-overlay-top">
        <a href="{{ routes.root_url }}" class="main-header__search-overlay-logo" aria-label="{{ shop.name }} home">
          {%- render 'header-logo', logo: logo, logo_width: 84 -%}
        </a>
        <div class="main-header__search-overlay-inner">
          {%- render 'header-search',
            enable_predictive_search: section.settings.enable_predictive_search,
            variant: 'overlay',
            trending_terms: trending_terms,
            enable_typewriter: section.settings.enable_typewriter,
            typewriter_type_speed: section.settings.typewriter_type_speed,
            typewriter_hold_ms: section.settings.typewriter_hold_ms
          -%}
        </div>
        <button type="button" class="main-header__search-overlay-cancel" data-search-overlay-close>
          Cancel
        </button>
      </div>
    </div>
  </div>

</header>

<script src="{{ 'main-header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Main header",
  "tag": "div",
  "class": "main-header-section",
  "settings": [
    { "type": "header", "content": "Section layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40, "max": 120, "step": 5, "unit": "rem", "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32
    },

    { "type": "header", "content": "Mobile Division (< 640px)" },
    {
      "type": "checkbox",
      "id": "enable_search_drawer",
      "label": "Enable search drawer icon (mobile only, < 640px)",
      "default": false
    },

    { "type": "header", "content": "Tablet Division (640px – 1023px)" },
    {
      "type": "checkbox",
      "id": "enable_search_drawer_tablet",
      "label": "Enable search drawer icon (tablet only, 640px – 1023px)",
      "default": false
    },

    { "type": "header", "content": "Search (all breakpoints)" },
    { "type": "checkbox", "id": "enable_predictive_search", "label": "Enable predictive search", "default": true },
    { "type": "checkbox", "id": "enable_typewriter", "label": "Animate placeholder (typewriter effect)", "default": false, "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "range", "id": "typewriter_type_speed", "label": "Typing speed", "min": 30, "max": 150, "step": 5, "default": 70, "unit": "ms", "visible_if": "{{ section.settings.enable_predictive_search and section.settings.enable_typewriter }}" },
    { "type": "range", "id": "typewriter_hold_ms", "label": "Pause on full word", "min": 1000, "max": 5000, "step": 100, "default": 3200, "unit": "ms", "visible_if": "{{ section.settings.enable_predictive_search and section.settings.enable_typewriter }}" },
    { "type": "text", "id": "trending_1", "label": "Trending term 1", "default": "electric scooters", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_2", "label": "Trending term 2", "default": "electric bikes", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_3", "label": "Trending term 3", "default": "electric skateboards", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_4", "label": "Trending term 4", "default": "electric cargo bikes", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_5", "label": "Trending term 5", "default": "electric city bikes", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_6", "label": "Trending term 6", "default": "electric fat bikes", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_7", "label": "Trending term 7", "default": "electric folding bikes", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_8", "label": "Trending term 8", "default": "electric mountain bikes", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_9", "label": "Trending term 9", "default": "commuter electric scooters", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_10", "label": "Trending term 10", "default": "off-road electric scooters", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_11", "label": "Trending term 11", "default": "performance electric scooters", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_12", "label": "Trending term 12", "default": "youth electric scooters", "visible_if": "{{ section.settings.enable_predictive_search }}" },

    { "type": "header", "content": "Icons (all breakpoints)" },
    { "type": "checkbox", "id": "show_icon_account", "label": "Show account icon", "default": false },
    { "type": "checkbox", "id": "show_label_account", "label": "Show account label", "default": false },
    { "type": "checkbox", "id": "show_icon_wishlist", "label": "Show wishlist icon", "default": true },
    { "type": "checkbox", "id": "show_label_wishlist", "label": "Show wishlist label", "default": false },
    { "type": "checkbox", "id": "show_icon_compare", "label": "Show compare icon", "default": false },
    { "type": "checkbox", "id": "show_label_compare", "label": "Show compare label", "default": false },
    { "type": "checkbox", "id": "show_icon_cart", "label": "Show cart icon", "default": true },
    { "type": "checkbox", "id": "show_label_cart", "label": "Show cart label", "default": false }
  ],
  "blocks": [
    { "type": "single-link", "name": "Single Link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Single Link" },
      { "type": "url", "id": "link", "label": "URL" },
      { "type": "text", "id": "icon", "label": "Icon name" }
    ]},
    { "type": "link-list", "name": "Link list", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "url", "id": "link", "label": "Top-level URL (optional)" },
      { "type": "link_list", "id": "menu", "label": "Link list menu" },
      { "type": "text", "id": "icon", "label": "Icon name" }
    ]},
    { "type": "mega-menu", "name": "Mega menu", "settings": [
      { "type": "header", "content": "Nav bar" },
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "url", "id": "link", "label": "URL" },
      { "type": "link_list", "id": "menu", "label": "Menu" },
      { "type": "text", "id": "icon", "label": "Icon name" },
      { "type": "header", "content": "Products" },
      { "type": "checkbox", "id": "show_products", "label": "Show trending products", "default": false }
    ]},
    { "type": "showcase", "name": "Showcase", "settings": [
      { "type": "header", "content": "Nav bar" },
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "url", "id": "link", "label": "URL" },
      { "type": "text", "id": "icon", "label": "Icon name" },
      { "type": "header", "content": "Panel layout" },
      { "type": "select", "id": "panel_width", "label": "Panel width", "options": [
        { "value": "", "label": "Default (aligns with header)" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ], "default": "" },
      { "type": "range", "id": "panel_custom_width", "label": "Custom width", "min": 40, "max": 120, "step": 5, "unit": "rem", "default": 80, "visible_if": "{{ block.settings.panel_width == 'custom-width' }}" },
      { "type": "range", "id": "panel_padding", "label": "Side padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
      { "type": "header", "content": "Sidebar (optional)" },
      { "type": "checkbox", "id": "show_sidebar", "label": "Show sidebar", "default": true },
      { "type": "text", "id": "sidebar_heading", "label": "Sidebar heading", "default": "Good to know" },
      { "type": "text", "id": "tip_1_icon", "label": "Tip 1 icon name" },
      { "type": "text", "id": "tip_1_heading", "label": "Tip 1 heading", "default": "Trade-in" },
      { "type": "text", "id": "tip_1_body", "label": "Tip 1 body", "default": "Get up to $700 for your old device" },
      { "type": "text", "id": "tip_2_icon", "label": "Tip 2 icon name" },
      { "type": "text", "id": "tip_2_heading", "label": "Tip 2 heading" },
      { "type": "text", "id": "tip_2_body", "label": "Tip 2 body" },
      { "type": "text", "id": "tip_3_icon", "label": "Tip 3 icon name" },
      { "type": "text", "id": "tip_3_heading", "label": "Tip 3 heading" },
      { "type": "text", "id": "tip_3_body", "label": "Tip 3 body" },
      { "type": "header", "content": "Categories" },
      { "type": "collection", "id": "cat_1_collection", "label": "Category 1 collection" },
      { "type": "collection", "id": "cat_2_collection", "label": "Category 2 collection" },
      { "type": "collection", "id": "cat_3_collection", "label": "Category 3 collection" },
      { "type": "collection", "id": "cat_4_collection", "label": "Category 4 collection" },
      { "type": "collection", "id": "cat_5_collection", "label": "Category 5 collection" },
      { "type": "collection", "id": "cat_6_collection", "label": "Category 6 collection" },
      { "type": "collection", "id": "cat_7_collection", "label": "Category 7 collection" },
      { "type": "collection", "id": "cat_8_collection", "label": "Category 8 collection" }
    ]},
    { "type": "highlight", "name": "Highlight", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "On Sale" },
      { "type": "url", "id": "link", "label": "URL" },
      { "type": "text", "id": "icon", "label": "Icon name" }
    ]},
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Main header",
      "blocks": [
        { "type": "single-link", "settings": { "label": "Single link", "link": "/collections/all" } },
        { "type": "link-list", "settings": { "label": "Link list" } },
        { "type": "mega-menu", "settings": {} },
        { "type": "showcase", "settings": {} },
        { "type": "highlight", "settings": { "label": "On Sale", "link": "/collections/sale" } }
      ]
    }
  ]
}
{% endschema %}