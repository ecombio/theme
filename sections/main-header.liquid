{{ 'main-header.css' | asset_url | stylesheet_tag }}

<style>
  .main-header__search-drawer-mobile-only {
    display: block;
  }
  @media (min-width: 640px) {
    .main-header__search-drawer-mobile-only {
      display: none;
    }
  }
  @media (max-width: 639px) {
    .main-header__search-row--drawer-mobile {
      display: none;
    }
  }
  @media (max-width: 639px) {
    .main-header--search-drawer-mobile .main-header__inner {
      justify-content: center;
    }
  }

  .main-header__search-drawer-tablet-only {
    display: none;
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .main-header__search-drawer-tablet-only {
      display: block;
    }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .main-header__search-row--drawer-tablet {
      display: none;
    }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .main-header--search-drawer-tablet .main-header__inner {
      justify-content: center;
    }
  }
</style>

{%- liquid
  assign logo       = settings.logo
  assign logo_width = settings.logo_width | default: 140
  assign show_acct  = section.settings.show_icon_account
  assign show_cart  = section.settings.show_icon_cart
  assign enable_sticky = section.settings.enable_sticky_header
  assign mobile_drawer_style = section.settings.mobile_drawer_style | default: 'compact'
  assign show_menu_bar_mobile = section.settings.show_menu_bar_mobile
  assign show_menu_bar_tablet = section.settings.show_menu_bar_tablet
  assign enable_search_drawer_tablet = section.settings.enable_search_drawer_tablet
  assign hide_utility_bar_sticky = section.settings.hide_utility_bar_on_sticky

  # ── Section layout (width + padding) ──
  # Mirrors the pattern in sections/example-width-section.liquid /
  # snippets/main-product.liquid: --section-padding / --custom-width are
  # local vars set inline below, from this section's own "Section layout"
  # settings, fully independent of the global --page-margin / --page-width
  # vars. NOTE: snippets/utility-bar.liquid now reads these SAME settings
  # (section.settings.section_width / .custom_width / .section_padding)
  # directly, so the utility bar row always shares this exact width/padding
  # instead of having its own separate copy that could drift out of sync.
  assign section_width = section.settings.section_width
  if section_width == blank
    assign width_class = 'main-header--default-width'
  elsif section_width == 'full-width'
    assign width_class = 'main-header--full-width'
  else
    assign width_class = 'main-header--custom-width'
  endif
-%}

<header class="main-header {{ width_class }}{% if enable_sticky %} main-header--sticky-enabled main-header--sticky-autohide{% endif %}{% if show_menu_bar_mobile %} main-header--menu-bar-mobile-visible{% endif %}{% if show_menu_bar_tablet %} main-header--menu-bar-tablet-visible{% endif %}{% if section.settings.enable_search_drawer %} main-header--search-drawer-mobile{% endif %}{% if enable_search_drawer_tablet %} main-header--search-drawer-tablet{% endif %}{% if hide_utility_bar_sticky %} main-header--hide-utility-bar-sticky{% endif %}"
        id="main-header"
        role="banner"
        style="
          --section-padding: {{ section.settings.section_padding }}px;
          {%- if section_width == 'custom-width' %}
            --custom-width: {{ section.settings.custom_width }}rem;
          {%- endif %}
        ">

  {%- render 'utility-bar', settings: section.settings -%}

  <div class="main-header__bar">
    <div class="main-header__inner">

      {%- render 'header-hamburger', blocks: section.blocks, enable_sticky: enable_sticky, drawer_style: mobile_drawer_style, enable_predictive_search: section.settings.enable_predictive_search -%}

      {%- if section.settings.enable_search_drawer -%}
        <div class="main-header__search-drawer-mobile-only">
          {%- render 'header-search-drawer', enable_predictive_search: section.settings.enable_predictive_search -%}
        </div>
      {%- endif -%}
      {%- if enable_search_drawer_tablet -%}
        <div class="main-header__search-drawer-tablet-only">
          {%- render 'header-search-drawer', enable_predictive_search: section.settings.enable_predictive_search -%}
        </div>
      {%- endif -%}

      {%- render 'header-logo', logo: logo, logo_width: logo_width -%}

      <div class="main-header__search--inline">
        {%- render 'header-search', enable_predictive_search: section.settings.enable_predictive_search, variant: 'desktop' -%}
      </div>

      <ul class="main-header__icons" role="list" aria-label="Header actions">
        {%- if show_acct != false -%}
          <li>{%- render 'header-account' -%}</li>
        {%- endif -%}
        {%- if show_cart != false -%}
          <li>{%- render 'header-cart' -%}</li>
        {%- endif -%}
      </ul>

    </div>
  </div>

  <div class="main-header__search-row{% if section.settings.enable_search_drawer %} main-header__search-row--drawer-mobile{% endif %}{% if enable_search_drawer_tablet %} main-header__search-row--drawer-tablet{% endif %}">
    <div class="main-header__search-row-inner">
      {%- render 'header-search', enable_predictive_search: section.settings.enable_predictive_search, variant: 'mobile' -%}
    </div>
  </div>

  {%- render 'header-menu', blocks: section.blocks, show_on_mobile: show_menu_bar_mobile, show_on_tablet: show_menu_bar_tablet -%}

</header>

<script src="{{ 'main-header.js' | asset_url }}" defer></script>

{% schema %}
{
