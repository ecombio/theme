{{ 'main-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo       = settings.logo
  assign logo_width = settings.logo_width | default: 140
  assign show_acct  = section.settings.show_icon_account
  assign show_cart  = section.settings.show_icon_cart
  assign enable_sticky = true
  assign enable_search_drawer_tablet = section.settings.enable_search_drawer_tablet

  assign section_width = section.settings.section_width
  if section_width == blank
    assign width_class = 'main-header--default-width'
  elsif section_width == 'full-width'
    assign width_class = 'main-header--full-width'
  else
    assign width_class = 'main-header--custom-width'
  endif
-%}

<header class="main-header {{ width_class }} main-header--menu-bar-mobile-visible main-header--menu-bar-tablet-visible{% if section.settings.enable_search_drawer %} main-header--search-drawer-mobile{% endif %}{% if enable_search_drawer_tablet %} main-header--search-drawer-tablet{% endif %}{% if enable_sticky %} main-header--sticky-enabled main-header--sticky-autohide{% endif %}"
        id="main-header"
        role="banner"
        style="
          --section-padding: {{ section.settings.section_padding }}px;
          {%- if section_width == 'custom-width' %}
            --custom-width: {{ section.settings.custom_width }}rem;
          {%- endif %}
        ">

  {%- render 'utility-bar', settings: section.settings -%}

  <div class="main-header__bar">
    <div class="main-header__inner">

      {%- if section.settings.enable_search_drawer -%}
        <div class="main-header__search-drawer-mobile-only">
          {%- render 'header-search-drawer', enable_predictive_search: section.settings.enable_predictive_search -%}
        </div>
      {%- endif -%}
      {%- if enable_search_drawer_tablet -%}
        <div class="main-header__search-drawer-tablet-only">
          {%- render 'header-search-drawer', enable_predictive_search: section.settings.enable_predictive_search -%}
        </div>
      {%- endif -%}

      {%- render 'header-logo', logo: logo, logo_width: logo_width -%}

      <div class="main-header__search--inline">
        {%- render 'header-search', enable_predictive_search: section.settings.enable_predictive_search, variant: 'desktop' -%}
      </div>

      <ul class="main-header__icons" role="list" aria-label="Header actions">
        {%- if show_acct != false -%}
          <li>{%- render 'header-account' -%}</li>
        {%- endif -%}
        {%- if show_cart != false -%}
          <li>{%- render 'header-cart' -%}</li>
        {%- endif -%}
      </ul>

    </div>
  </div>

  <div class="main-header__search-row{% if section.settings.enable_search_drawer %} main-header__search-row--drawer-mobile{% endif %}{% if enable_search_drawer_tablet %} main-header__search-row--drawer-tablet{% endif %}">
    <div class="main-header__search-row-inner">
      {%- render 'header-search', enable_predictive_search: section.settings.enable_predictive_search, variant: 'mobile' -%}
    </div>
  </div>

  {{ 'highlight.css'   | asset_url | stylesheet_tag }}

  {%- liquid
    assign has_mega_menu = false
    assign has_showcase_menu = false
    assign has_link_list = false
    for block in section.blocks
      if block.type == 'mega-menu'
        assign has_mega_menu = true
      endif
      if block.type == 'showcase-menu'
        assign has_showcase_menu = true
      endif
      if block.type == 'link-list'
        assign has_link_list = true
      endif
    endfor
  -%}

  {%- if has_mega_menu -%}
    {{ 'mega-menu.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- if has_showcase_menu -%}
    {{ 'showcase-menu.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- if has_link_list -%}
    {{ 'link-list.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <nav class="menu-bar" id="main-header-menu-bar" aria-label="Primary navigation">
      <div class="menu-bar__edge-fade menu-bar__edge-fade--left" aria-hidden="true"></div>
      <div class="menu-bar__edge-fade menu-bar__edge-fade--right" aria-hidden="true"></div>

      <div class="menu-bar__container page-width--header">
        <ul class="menu-bar__list">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'single-link' -%}
                {%- render 'single-link', block: block -%}

              {%- when 'link-list' -%}
                {%- render 'link-list', block: block -%}

              {%- when 'highlight' -%}
                {%- render 'highlight', block: block -%}

              {%- when 'mega-menu' -%}
                {%- render 'mega-menu', block: block -%}

              {%- when 'showcase-menu' -%}
                {%- render 'showcase-menu', block: block -%}

            {%- endcase -%}
          {%- endfor -%}
        </ul>
      </div>
    </nav>

    <script src="{{ 'header-menu.js' | asset_url }}" defer></script>
    {%- if has_mega_menu -%}
      <script src="{{ 'mega-menu.js' | asset_url }}" defer></script>
    {%- endif -%}
    {%- if has_showcase_menu -%}
      <script src="{{ 'showcase-menu.js' | asset_url }}" defer></script>
    {%- endif -%}
    {%- if has_link_list -%}
      <script src="{{ 'link-list.js' | asset_url }}" defer></script>
    {%- endif -%}
  {%- endif -%}

</header>

<script src="{{ 'main-header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Main Header",
  "tag": "div",
  "class": "main-header-section",
  "settings": [
    { "type": "header", "content": "Section layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24,
      "info": "Applies at tablet and desktop widths. Mobile (< 640px) keeps its own fixed, tighter padding regardless of this setting. Also controls the Utility Bar's width/padding below it, so the two rows always line up."
    },

    { "type": "header", "content": "Sticky Header" },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky header",
      "info": "Header sticks to the top on scroll and auto-hides when scrolling down, reappearing when scrolling up.",
      "default": false
    },

    { "type": "header", "content": "Mobile Division (< 640px)" },
    {
      "type": "checkbox",
      "id": "enable_search_drawer",
      "label": "Enable search drawer icon (mobile only, < 640px)",
      "info": "Adds a search icon to the header that opens a full-screen drawer sliding down from the top, replacing the search row on mobile screens only (below 640px). Independent of Tablet's setting below.",
      "default": false
    },

    { "type": "header", "content": "Tablet Division (640px – 1023px)" },
    {
      "type": "checkbox",
      "id": "enable_search_drawer_tablet",
      "label": "Enable search drawer icon (tablet only, 640px – 1023px)",
      "info": "Adds a search icon to the header that opens a full-screen drawer sliding down from the top, replacing the search row on tablet screens only (640px–1023px). Independent of Mobile's setting above.",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "Icon labels are shown automatically at this width via CSS, with no toggle."
    },

    { "type": "header", "content": "Utility Bar" },
    {
      "type": "paragraph",
      "content": "Slim strip rendered above the main header row. Previously its own section; now built into this one via snippets/utility-bar.liquid (see that file — assets/utility-bar.css/.js load themselves, no separate section needed). Its width and side padding automatically match the header row's own Section layout settings above — there's no separate width control for it anymore."
    },
    {
      "type": "checkbox",
      "id": "enable_bar",
      "label": "Enable utility bar",
      "default": true
    },
    {
      "type": "select",
      "id": "bar_style",
      "label": "Bar style",
      "default": "hyper",
      "options": [
        { "value": "hyper", "label": "Hyper (white)" },
        { "value": "focus", "label": "Focus (warm grey)" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "Show currency selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_locale",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "link_1_icon",
      "label": "Link 1 icon (optional)"
    },
    {
      "type": "text",
      "id": "link_1_label",
      "label": "Link 1 label",
      "default": "Track Order"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "image_picker",
      "id": "link_2_icon",
      "label": "Link 2 icon (optional)"
    },
    {
      "type": "text",
      "id": "link_2_label",
      "label": "Link 2 label",
      "default": "Store Locator"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "image_picker",
      "id": "link_3_icon",
      "label": "Link 3 icon (optional)"
    },
    {
      "type": "text",
      "id": "link_3_label",
      "label": "Link 3 label",
      "default": "Track Order"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "label": "Link 3 URL"
    },

    { "type": "header", "content": "Search (all breakpoints)" },
    {
      "type": "checkbox",
      "id": "enable_predictive_search",
      "label": "Enable predictive search",
      "info": "Shows product, collection and query suggestions as the customer types.",
      "default": true
    },

    { "type": "header", "content": "Icons (all breakpoints)" },
    {
      "type": "checkbox",
      "id": "show_icon_store",
      "label": "Show store locator icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_icon_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_icon_cart",
      "label": "Show cart icon",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "single-link",
      "name": "Single Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Single Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "URL"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name",
          "info": "Optional. Uses snippets/menu-icon.liquid"
        }
      ]
    },
    {
      "type": "link-list",
      "name": "Link list",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Top-level URL (optional)"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Link list menu"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name"
        }
      ]
    },
    {
      "type": "mega-menu",
      "name": "Mega menu",
      "settings": [
        {
          "type": "header",
          "content": "Nav bar"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Mega menu"
        },
        {
          "type": "url",
          "id": "link",
          "label": "URL",
          "info": "Optional. Falls back to first menu link."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name"
        },
        {
          "type": "header",
          "content": "Products"
        },
        {
          "type": "checkbox",
          "id": "show_products",
          "label": "Show trending products",
          "default": false,
          "info": "Pulls the first 3 products from the first collection link found in the chosen menu."
        }
      ]
    },
    {
      "type": "showcase-menu",
      "name": "Showcase menu",
      "settings": [
        { "type": "header", "content": "Nav bar" },
        { "type": "text", "id": "label", "label": "Label", "default": "Shop by category" },
        { "type": "url", "id": "link", "label": "URL", "info": "Optional. Falls back to '#' if blank." },
        { "type": "text", "id": "icon", "label": "Icon name", "info": "Optional. Uses snippets/menu-icon.liquid" },

        { "type": "header", "content": "Panel layout" },
        {
          "type": "select",
          "id": "panel_width",
          "label": "Panel width",
          "info": "Default aligns the dropdown panel with the header's own content width, so it doesn't stretch further than the header above it.",
          "options": [
            { "value": "", "label": "Default (aligns with header)" },
            { "value": "full-width", "label": "Full width" },
            { "value": "custom-width", "label": "Custom width" }
          ],
          "default": ""
        },
        {
          "type": "range",
          "id": "panel_custom_width",
          "label": "Custom width",
          "min": 40,
          "max": 120,
          "step": 5,
          "unit": "rem",
          "default": 80,
          "visible_if": "{{ block.settings.panel_width == 'custom-width' }}"
        },
        {
          "type": "range",
          "id": "panel_padding",
          "label": "Side padding",
          "min": 0,
          "max": 80,
          "step": 4,
          "unit": "px",
          "default": 24
        },

        { "type": "header", "content": "Sidebar (optional)" },
        { "type": "checkbox", "id": "show_sidebar", "label": "Show sidebar", "default": true },
        { "type": "text", "id": "sidebar_heading", "label": "Sidebar heading", "default": "Good to know" },

        { "type": "text", "id": "tip_1_icon", "label": "Tip 1 icon name" },
        { "type": "text", "id": "tip_1_heading", "label": "Tip 1 heading", "default": "Trade-in" },
        { "type": "text", "id": "tip_1_body", "label": "Tip 1 body", "default": "Get up to $700 for your old device" },

        { "type": "text", "id": "tip_2_icon", "label": "Tip 2 icon name" },
        { "type": "text", "id": "tip_2_heading", "label": "Tip 2 heading" },
        { "type": "text", "id": "tip_2_body", "label": "Tip 2 body" },

        { "type": "text", "id": "tip_3_icon", "label": "Tip 3 icon name" },
        { "type": "text", "id": "tip_3_heading", "label": "Tip 3 heading" },
        { "type": "text", "id": "tip_3_body", "label": "Tip 3 body" },

        { "type": "header", "content": "Categories" },
        { "type": "url", "id": "see_all_link", "label": "\"See all\" link" },
        { "type": "text", "id": "see_all_label", "label": "\"See all\" label", "default": "See all" },

        { "type": "paragraph", "content": "Each category below: leave Image blank to pull the linked collection's featured image, or a generic placeholder if neither is set." },

        { "type": "text", "id": "cat_1_label", "label": "Category 1 label" },
        { "type": "url", "id": "cat_1_link", "label": "Category 1 link" },
        { "type": "collection", "id": "cat_1_collection", "label": "Category 1 collection (optional image source)" },
        { "type": "image_picker", "id": "cat_1_image", "label": "Category 1 image (optional)" },

        { "type": "text", "id": "cat_2_label", "label": "Category 2 label" },
        { "type": "url", "id": "cat_2_link", "label": "Category 2 link" },
        { "type": "collection", "id": "cat_2_collection", "label": "Category 2 collection (optional image source)" },
        { "type": "image_picker", "id": "cat_2_image", "label": "Category 2 image (optional)" },

        { "type": "text", "id": "cat_3_label", "label": "Category 3 label" },
        { "type": "url", "id": "cat_3_link", "label": "Category 3 link" },
        { "type": "collection", "id": "cat_3_collection", "label": "Category 3 collection (optional image source)" },
        { "type": "image_picker", "id": "cat_3_image", "label": "Category 3 image (optional)" },

        { "type": "text", "id": "cat_4_label", "label": "Category 4 label" },
        { "type": "url", "id": "cat_4_link", "label": "Category 4 link" },
        { "type": "collection", "id": "cat_4_collection", "label": "Category 4 collection (optional image source)" },
        { "type": "image_picker", "id": "cat_4_image", "label": "Category 4 image (optional)" },

        { "type": "text", "id": "cat_5_label", "label": "Category 5 label" },
        { "type": "url", "id": "cat_5_link", "label": "Category 5 link" },
        { "type": "collection", "id": "cat_5_collection", "label": "Category 5 collection (optional image source)" },
        { "type": "image_picker", "id": "cat_5_image", "label": "Category 5 image (optional)" },

        { "type": "text", "id": "cat_6_label", "label": "Category 6 label" },
        { "type": "url", "id": "cat_6_link", "label": "Category 6 link" },
        { "type": "collection", "id": "cat_6_collection", "label": "Category 6 collection (optional image source)" },
        { "type": "image_picker", "id": "cat_6_image", "label": "Category 6 image (optional)" },

        { "type": "text", "id": "cat_7_label", "label": "Category 7 label" },
        { "type": "url", "id": "cat_7_link", "label": "Category 7 link" },
        { "type": "collection", "id": "cat_7_collection", "label": "Category 7 collection (optional image source)" },
        { "type": "image_picker", "id": "cat_7_image", "label": "Category 7 image (optional)" },

        { "type": "text", "id": "cat_8_label", "label": "Category 8 label" },
        { "type": "url", "id": "cat_8_link", "label": "Category 8 link" },
        { "type": "collection", "id": "cat_8_collection", "label": "Category 8 collection (optional image source)" },
        { "type": "image_picker", "id": "cat_8_image", "label": "Category 8 image (optional)" }
      ]
    },
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "On Sale"
        },
        {
          "type": "url",
          "id": "link",
          "label": "URL"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name"
        }
      ]
    },
    {
      "type": "@app"
    },
    {
      "type": "flyout",
      "name": "Flyout Menu",
      "settings": [
        {
          "type": "header",
          "content": "Nav bar"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Browse all categories"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Top-level URL (optional)"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Flyout menu",
          "info": "Top-level links become the left-hand category list. Their child links become the column content; grandchild links become indented sub-items."
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name"
        },
        {
          "type": "header",
          "content": "Style"
        },
        {
          "type": "select",
          "id": "panel_style",
          "label": "Flyout panel style",
          "info": "Compact keeps the panel left-aligned under its trigger. Full-width span stretches it across most of the header for a bigger, more modern look.",
