{% comment %} Snippets rendered below are self-contained — each owns its own CSS/JS and does not reach into another snippet's DOM. {% endcomment %}
{% comment %}
  Main Header Section
  File: sections/main-header.liquid
{% endcomment %}
{{ 'main-header.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Scoped override so "Enable search drawer icon" only takes effect below
  640px (Mobile Division). Tablet/desktop always keep their normal search
  bar (inline on desktop, row on tablet) regardless of this setting.
{%- endcomment -%}
<style>
  .main-header__search-drawer-mobile-only {
    display: block;
  }
  @media (min-width: 640px) {
    .main-header__search-drawer-mobile-only {
      display: none;
    }
  }
  @media (max-width: 639px) {
    .main-header__search-row--drawer-mobile {
      display: none;
    }
  }
  @media (max-width: 639px) {
    .main-header--search-drawer-mobile .main-header__inner {
      justify-content: center;
    }
  }
</style>

{% comment %}
  Mobile Menu (commented out for future use)
  {{ 'mobile-menu.css' | asset_url | stylesheet_tag }}
  {%- render 'mobile-menu', nav_menu: mobile_menu -%}
{% endcomment %}

{%- liquid
  assign logo       = settings.logo
  assign logo_width = settings.logo_width | default: 140
  assign show_acct  = section.settings.show_icon_account
  assign show_cart  = section.settings.show_icon_cart
  assign mobile_menu = section.settings.mobile_menu
  assign enable_sticky = section.settings.enable_sticky_header
  assign mobile_drawer_style = section.settings.mobile_drawer_style | default: 'compact'
  assign show_menu_bar_mobile = section.settings.show_menu_bar_mobile
-%}

<header class="main-header{% if enable_sticky %} main-header--sticky-enabled{% endif %}{% if show_menu_bar_mobile %} main-header--menu-bar-mobile-visible{% endif %}{% if section.settings.enable_search_drawer %} main-header--search-drawer-mobile{% endif %}"
        id="main-header"
        role="banner">

  <div class="main-header__bar">
    <div class="main-header__inner">

      {%- comment -%}
        Both hamburger buttons (sticky + mobile drawer) and the mobile
        nav drawer itself now live in snippets/header-hamburger.liquid,
        which also loads header-hamburger.css/js on its own. See that
        file for details. Rendered here so the two buttons land in the
        correct spot in this flex row, before the logo.
      {%- endcomment -%}
      {%- render 'header-hamburger', mobile_menu: mobile_menu, enable_sticky: enable_sticky, drawer_style: mobile_drawer_style, enable_predictive_search: section.settings.enable_predictive_search -%}

      {%- comment -%}
        Search drawer trigger + full-screen slide-down drawer, both
        self-contained in snippets/header-search-drawer.liquid (own
        CSS/JS). Opt-in via the "Enable search drawer icon" checkbox
        (Mobile Division). MOBILE-ONLY (< 640px) — the wrapping div
        below is hidden at 640px+ via the <style> block above, so
        tablet/desktop are unaffected and keep their normal search
        bar. Rendered here so the icon lands between the hamburger
        and the logo.
      {%- endcomment -%}
      {%- if section.settings.enable_search_drawer -%}
        <div class="main-header__search-drawer-mobile-only">
          {%- render 'header-search-drawer', enable_predictive_search: section.settings.enable_predictive_search -%}
        </div>
      {%- endif -%}

      {%- render 'header-logo', logo: logo, logo_width: logo_width -%}

      {%- comment -%}
        Desktop search — flex-grows to fill the bar, hidden below
        1024px via CSS. Always rendered; the search drawer setting
        is mobile-only, so desktop keeps this regardless.
      {%- endcomment -%}
      <div class="main-header__search--inline">
        {%- render 'header-search', enable_predictive_search: section.settings.enable_predictive_search, variant: 'desktop' -%}
      </div>

      <ul class="main-header__icons" role="list" aria-label="Header actions">
        {%- if show_acct != false -%}
          <li>{%- render 'header-account' -%}</li>
        {%- endif -%}
        {%- if show_cart != false -%}
          <li>{%- render 'header-cart' -%}</li>
        {%- endif -%}
      </ul>

    </div>
  </div>

  {%- comment -%}
    Mobile/tablet search row — sits below the bar, hidden at 1024px+
    via CSS. When the search drawer icon is enabled, this row is hidden
    only below 640px (mobile) via the --drawer-mobile class above, since
    the drawer icon replaces it there — tablet (640–1023px) keeps this
    row regardless of the drawer setting.
  {%- endcomment -%}
  <div class="main-header__search-row{% if section.settings.enable_search_drawer %} main-header__search-row--drawer-mobile{% endif %}">
    <div class="main-header__search-row-inner">
      {%- render 'header-search', enable_predictive_search: section.settings.enable_predictive_search, variant: 'mobile' -%}
    </div>
  </div>

  {%- comment -%}Desktop nav bar — built from blocks. Hidden below 1024px via CSS (mobile drawer takes over);
  when sticky is enabled, also collapses on scroll and is toggled back open via the sticky hamburger
  (in header-hamburger.liquid) above. Markup, styles, and its block-type CSS/JS all live in
  snippets/header-menu.liquid.{%- endcomment -%}
  {%- render 'header-menu', blocks: section.blocks, show_on_mobile: show_menu_bar_mobile -%}

</header>

<script src="{{ 'main-header.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main Header",
  "tag": "div",
  "class": "main-header-section",
  "settings": [
    { "type": "header", "content": "Mobile Division (< 640px)" },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Mobile navigation menu",
      "default": "main-menu",
      "info": "Used for the mobile drawer. Desktop items are configured via blocks below."
    },
    {
      "type": "select",
      "id": "mobile_drawer_style",
      "label": "Mobile drawer style",
      "info": "Compact keeps the drawer narrow with a dimmed backdrop over the page. Full-width fills the whole screen with no backdrop.",
      "options": [
        { "value": "compact", "label": "Compact (280px, with backdrop)" },
        { "value": "full-width", "label": "Full-width (no backdrop)" }
      ],
      "default": "compact"
    },
    {
      "type": "checkbox",
      "id": "show_menu_bar_mobile",
      "label": "Show Menu Bar",
      "info": "Shows the desktop navigation bar (blocks configured below) on mobile as well, in addition to the hamburger drawer. Off by default.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_search_drawer",
      "label": "Enable search drawer icon (mobile only, < 640px)",
      "info": "Adds a search icon to the header that opens a full-screen drawer sliding down from the top, replacing the search row on mobile screens only (below 640px). Tablet and desktop are unaffected and always keep their normal search bar. The mobile nav drawer (hamburger menu) is unaffected either way.",
      "default": false
    },

    { "type": "header", "content": "Tablet Division (640px – 1023px)" },
    {
      "type": "paragraph",
      "content": "Tablet currently inherits Mobile's drawer and menu-bar settings above — there's no separate tablet override in the code yet. Icon labels are shown automatically at this width via CSS, with no toggle."
    },

    { "type": "header", "content": "Desktop Division (≥ 1024px)" },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable sticky header",
      "default": true,
      "info": "Header stays visible while scrolling. Desktop-only — the sticky hamburger/X toggle only appears at 1024px and up."
    },

    { "type": "header", "content": "Search (all breakpoints)" },
    {
      "type": "checkbox",
      "id": "enable_predictive_search",
      "label": "Enable predictive search",
      "info": "Shows product, collection and query suggestions as the customer types.",
      "default": true
    },

    { "type": "header", "content": "Icons (all breakpoints)" },
    {
      "type": "checkbox",
      "id": "show_icon_store",
      "label": "Show store locator icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_icon_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_icon_cart",
      "label": "Show cart icon",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "single-link",
      "name": "Single Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Single Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "URL"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name",
          "info": "Optional. Uses snippets/menu-icon.liquid"
        }
      ]
    },
    {
      "type": "link-list",
      "name": "Link list",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Top-level URL (optional)"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Link list menu"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name"
        }
      ]
    },
    {
      "type": "mega-menu",
      "name": "Mega menu",
      "settings": [
        {
          "type": "header",
          "content": "Nav bar"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Mega menu"
        },
        {
          "type": "url",
          "id": "link",
          "label": "URL",
          "info": "Optional. Falls back to first menu link."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name"
        },
        {
          "type": "header",
          "content": "Products"
        },
        {
          "type": "checkbox",
          "id": "show_products",
          "label": "Show trending products",
          "default": false,
          "info": "Pulls the first 3 products from the first collection link found in the chosen menu."
        }
      ]
    },
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "On Sale"
        },
        {
          "type": "url",
          "id": "link",
          "label": "URL"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name"
        }
      ]
    },
    {
      "type": "@app"
    },
    {
      "type": "flyout",
      "name": "Flyout Menu",
      "settings": [
        {
          "type": "header",
          "content": "Nav bar"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Browse all categories"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Top-level URL (optional)"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Flyout menu",
          "info": "Top-level links become the left-hand category list. Their child links become the column content; grandchild links become indented sub-items."
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name"
        },
        {
          "type": "header",
          "content": "Style"
        },
        {
          "type": "select",
          "id": "panel_style",
          "label": "Flyout panel style",
          "info": "Compact keeps the panel left-aligned under its trigger. Full-width span stretches it across most of the header for a bigger, more modern look.",
          "options": [
            {
              "value": "compact",
              "label": "Compact (left-aligned)"
            },
            {
              "value": "full-width",
              "label": "Full-width span"
            }
          ],
          "default": "compact"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main Header",
      "settings": {
        "mobile_menu": "main-menu"
      },
      "blocks": [
        { "type": "single-link", "settings": { "label": "Single link", "link": "/collections/all" } },
        { "type": "link-list", "settings": { "label": "Link list" } },
        { "type": "mega-menu", "settings": { "label": "Mega menu" } },
        { "type": "highlight", "settings": { "label": "On Sale", "link": "/collections/sale" } }
      ]
    }
  ]
}
{% endschema %}