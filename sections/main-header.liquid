{{ 'main-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo       = settings.logo
  assign logo_width = settings.logo_width | default: 140
  assign show_acct  = section.settings.show_icon_account
  assign show_cart  = section.settings.show_icon_cart
  assign enable_search_drawer_tablet = section.settings.enable_search_drawer_tablet

  assign section_width = section.settings.section_width
  if section_width == blank
    assign width_class = 'main-header--default-width'
  elsif section_width == 'full-width'
    assign width_class = 'main-header--full-width'
  else
    assign width_class = 'main-header--custom-width'
  endif
-%}

<header class="main-header {{ width_class }} main-header--menu-bar-mobile-visible main-header--menu-bar-tablet-visible{% if section.settings.enable_search_drawer %} main-header--search-drawer-mobile{% endif %}{% if enable_search_drawer_tablet %} main-header--search-drawer-tablet{% endif %}"
        id="main-header"
        role="banner"
        style="
          --section-padding: {{ section.settings.section_padding }}px;
          {%- if section_width == 'custom-width' %}
            --custom-width: {{ section.settings.custom_width }}rem;
          {%- endif %}
        ">

  {%- liquid
    assign ann_active_count = 0
    if section.settings.ann_enable
      for i in (1..5)
        assign ann_type_key = 'ann_' | append: i | append: '_type'
        assign ann_slide_type = section.settings[ann_type_key]
        if ann_slide_type == 'announcement' or ann_slide_type == 'countdown'
          assign ann_active_count = ann_active_count | plus: 1
        endif
      endfor
    endif

    assign ann_width_class = 'announcement-bar--full-width'
    if section.settings.ann_section_width == 'boxed'
      assign ann_width_class = 'announcement-bar--boxed'
    elsif section.settings.ann_section_width == 'custom-width'
      assign ann_width_class = 'announcement-bar--custom-width'
    endif
  -%}

  {%- if section.settings.ann_enable and ann_active_count > 0 -%}
    {{ 'announcement-bar.css' | asset_url | stylesheet_tag }}

    <div
      class="announcement-bar {{ ann_width_class }}"
      role="region"
      aria-label="Announcements"
      data-announcement-bar
      data-autorotate="{{ section.settings.ann_autorotate }}"
      data-interval="{{ section.settings.ann_autorotate_speed | times: 1000 }}"
      style="
        --section-padding: {{ section.settings.ann_section_padding }}px;
        {%- if section.settings.ann_section_width == 'custom-width' %}
          --custom-width: {{ section.settings.ann_custom_width }}rem;
        {%- endif %}
      "
    >
      <div class="announcement-bar__track" data-track>
        {%- assign ann_first_rendered = true -%}
        {%- for i in (1..5) -%}
          {%- assign ann_type_key = 'ann_' | append: i | append: '_type' -%}
          {%- assign ann_slide_type = section.settings[ann_type_key] -%}

          {%- if ann_slide_type == 'announcement' -%}
            {%- assign ann_text_key = 'ann_' | append: i | append: '_text' -%}
            {%- assign ann_link_key = 'ann_' | append: i | append: '_link' -%}
            <div
              class="announcement-bar__slide{% if ann_first_rendered %} is-active{% endif %}"
              role="status"
              aria-live="polite"
            >
              {%- if section.settings[ann_link_key] != blank -%}
                <a href="{{ section.settings[ann_link_key] }}" class="announcement-bar__message announcement-bar__message--link">
                  {{ section.settings[ann_text_key] }}
                </a>
              {%- else -%}
                <p class="announcement-bar__message">{{ section.settings[ann_text_key] }}</p>
              {%- endif -%}
            </div>
            {%- assign ann_first_rendered = false -%}

          {%- elsif ann_slide_type == 'countdown' -%}
            {%- assign ann_text_key = 'ann_' | append: i | append: '_text' -%}
            {%- assign ann_ctype_key = 'ann_' | append: i | append: '_countdown_type' -%}
            {%- assign ann_end_key = 'ann_' | append: i | append: '_end_date' -%}
            {%- assign ann_ever_key = 'ann_' | append: i | append: '_evergreen_minutes' -%}
            {%- assign ann_btnlabel_key = 'ann_' | append: i | append: '_button_label' -%}
            {%- assign ann_btnlink_key = 'ann_' | append: i | append: '_button_link' -%}
            <div
              class="announcement-bar__slide announcement-bar__slide--countdown{% if ann_first_rendered %} is-active{% endif %}"
            >
              {%- if section.settings[ann_text_key] != blank -%}
                <span class="announcement-bar__countdown-label">{{ section.settings[ann_text_key] }}</span>
              {%- endif -%}
              <span
                class="announcement-bar__countdown"
                data-countdown
                data-type="{{ section.settings[ann_ctype_key] }}"
                data-end="{{ section.settings[ann_end_key] }}"
                data-duration="{{ section.settings[ann_ever_key] }}"
              >
                <span class="countdown__unit"><span data-days>0</span><em>d</em></span>
                <span class="countdown__sep">:</span>
                <span class="countdown__unit"><span data-hours>0</span><em>h</em></span>
                <span class="countdown__sep">:</span>
                <span class="countdown__unit"><span data-minutes>0</span><em>m</em></span>
                <span class="countdown__sep">:</span>
                <span class="countdown__unit"><span data-seconds>0</span><em>s</em></span>
              </span>
              {%- if section.settings[ann_btnlabel_key] != blank -%}
                <a href="{{ section.settings[ann_btnlink_key] }}" class="announcement-bar__btn">
                  {{ section.settings[ann_btnlabel_key] }}
                </a>
              {%- endif -%}
            </div>
            {%- assign ann_first_rendered = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if ann_active_count > 1 -%}
        <button class="announcement-bar__arrow announcement-bar__arrow--prev" aria-label="Previous announcement">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" width="16" height="16" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
        <button class="announcement-bar__arrow announcement-bar__arrow--next" aria-label="Next announcement">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" width="16" height="16" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
      {%- endif -%}
    </div>

    <script>
      (function () {
        var bar = document.querySelector('[data-announcement-bar]');
        if (!bar) return;

        var slides     = bar.querySelectorAll('.announcement-bar__slide');
        var autorotate = bar.dataset.autorotate === 'true';
        var interval   = parseInt(bar.dataset.interval, 10) || 5000;
        var current    = 0;
        var timer;

        function show(index) {
          slides[current].classList.remove('is-active');
          current = (index + slides.length) % slides.length;
          slides[current].classList.add('is-active');
        }

        function next() { show(current + 1); }
        function prev() { show(current - 1); }

        function startAuto() {
          if (autorotate && slides.length > 1) timer = setInterval(next, interval);
        }
        function stopAuto() { clearInterval(timer); }

        var btnNext = bar.querySelector('.announcement-bar__arrow--next');
        var btnPrev = bar.querySelector('.announcement-bar__arrow--prev');
        if (btnNext) btnNext.addEventListener('click', function () { stopAuto(); next(); startAuto(); });
        if (btnPrev) btnPrev.addEventListener('click', function () { stopAuto(); prev(); startAuto(); });

        bar.querySelectorAll('[data-countdown]').forEach(function (el) {
          var type     = el.dataset.type;
          var endMs;

          if (type === 'fixed') {
            endMs = new Date(el.dataset.end.replace(/\//g, '-')).getTime();
          } else {
            var storageKey = 'ann_countdown_' + el.dataset.duration;
            var saved = sessionStorage.getItem(storageKey);
            endMs = saved ? parseInt(saved, 10) : Date.now() + parseInt(el.dataset.duration, 10) * 60000;
            sessionStorage.setItem(storageKey, endMs);
          }

          function tick() {
            var diff = endMs - Date.now();
            if (diff <= 0) { el.closest('.announcement-bar__slide').style.display = 'none'; return; }
            var d = Math.floor(diff / 86400000);
            var h = Math.floor((diff % 86400000) / 3600000);
            var m = Math.floor((diff % 3600000) / 60000);
            var s = Math.floor((diff % 60000) / 1000);
            el.querySelector('[data-days]').textContent    = String(d).padStart(2,'0');
            el.querySelector('[data-hours]').textContent   = String(h).padStart(2,'0');
            el.querySelector('[data-minutes]').textContent = String(m).padStart(2,'0');
            el.querySelector('[data-seconds]').textContent = String(s).padStart(2,'0');
          }
          tick();
          setInterval(tick, 1000);
        });

        startAuto();
      })();
    </script>
  {%- endif -%}

  {%- if section.settings.enable_bar -%}
    {{ 'utility-bar.css' | asset_url | stylesheet_tag }}

    {%- liquid
      assign bar_style = section.settings.bar_style | default: 'hyper'
      assign show_curr  = section.settings.show_currency
      assign show_loc   = section.settings.show_locale

      assign utility_width_type = section.settings.section_width
      if utility_width_type == blank
        assign utility_width_class = 'utility-bar__default-width'
      elsif utility_width_type == 'full-width'
        assign utility_width_class = 'utility-bar__full-width'
      else
        assign utility_width_class = 'utility-bar__custom-width'
      endif
    -%}

    <div class="utility-bar utility-bar--{{ bar_style }} {{ utility_width_class }}"
         role="navigation"
         aria-label="Utility bar"
         id="utility-bar"
         style="
           --section-padding: {{ section.settings.section_padding }}px;
           {%- if utility_width_type == 'custom-width' %}
             --custom-width: {{ section.settings.custom_width }}rem;
           {%- endif %}
         ">

      <div class="utility-bar__inner">

        <div class="utility-bar__col utility-bar__col--left">
          {%- render 'utility-links', settings: section.settings, count: 3 -%}
        </div>

        <div class="utility-bar__col utility-bar__col--right">
          <div class="utility-bar__switchers">
            {%- if show_curr -%}
              {%- render 'currency-selector', form_id: 'utility-bar-currency-form' -%}
            {%- endif -%}

            {%- if show_loc -%}
              {%- render 'locale-selector', form_id: 'utility-bar-locale-form' -%}
            {%- endif -%}

            {%- render 'region-picker' -%}
          </div>
        </div>

      </div>
    </div>

    <script src="{{ 'utility-bar.js' | asset_url }}" defer></script>
  {%- endif -%}

  <div class="main-header__bar">
    <div class="main-header__inner">

      {%- if section.settings.enable_search_drawer -%}
        <div class="main-header__search-drawer-mobile-only">
          {%- render 'header-search-drawer', enable_predictive_search: section.settings.enable_predictive_search -%}
        </div>
      {%- endif -%}
      {%- if enable_search_drawer_tablet -%}
        <div class="main-header__search-drawer-tablet-only">
          {%- render 'header-search-drawer', enable_predictive_search: section.settings.enable_predictive_search -%}
        </div>
      {%- endif -%}

      {%- render 'header-logo', logo: logo, logo_width: logo_width -%}

      <div class="main-header__search--inline">
        {%- render 'header-search', enable_predictive_search: section.settings.enable_predictive_search, variant: 'desktop' -%}
      </div>

      <ul class="main-header__icons" role="list" aria-label="Header actions">
        {%- if show_acct != false -%}
          <li>{%- render 'header-account' -%}</li>
        {%- endif -%}
        {%- if show_cart != false -%}
          <li>{%- render 'header-cart' -%}</li>
        {%- endif -%}
      </ul>

    </div>
  </div>

  <div class="main-header__search-row{% if section.settings.enable_search_drawer %} main-header__search-row--drawer-mobile{% endif %}{% if enable_search_drawer_tablet %} main-header__search-row--drawer-tablet{% endif %}">
    <div class="main-header__search-row-inner">
      {%- render 'header-search', enable_predictive_search: section.settings.enable_predictive_search, variant: 'mobile' -%}
    </div>
  </div>

  {{ 'highlight.css'   | asset_url | stylesheet_tag }}

  {%- liquid
    assign has_mega_menu = false
    assign has_showcase_menu = false
    assign has_link_list = false
    for block in section.blocks
      if block.type == 'mega-menu'
        assign has_mega_menu = true
      endif
      if block.type == 'showcase-menu'
        assign has_showcase_menu = true
      endif
      if block.type == 'link-list'
        assign has_link_list = true
      endif
    endfor
  -%}

  {%- if has_mega_menu -%}
    {{ 'mega-menu.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- if has_showcase_menu -%}
    {{ 'showcase-menu.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- if has_link_list -%}
    {{ 'link-list.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <nav class="menu-bar" id="main-header-menu-bar" aria-label="Primary navigation">
      <div class="menu-bar__edge-fade menu-bar__edge-fade--left" aria-hidden="true"></div>
      <div class="menu-bar__edge-fade menu-bar__edge-fade--right" aria-hidden="true"></div>

      <div class="menu-bar__container page-width--header">
        <ul class="menu-bar__list">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'single-link' -%}
                {%- render 'single-link', block: block -%}

              {%- when 'link-list' -%}
                {%- render 'link-list', block: block -%}

              {%- when 'highlight' -%}
                {%- render 'highlight', block: block -%}

              {%- when 'mega-menu' -%}
                {%- render 'mega-menu', block: block -%}

              {%- when 'showcase-menu' -%}
                {%- render 'showcase-menu', block: block -%}

            {%- endcase -%}
          {%- endfor -%}
        </ul>
      </div>
    </nav>

    {%- if has_mega_menu -%}
      <script src="{{ 'mega-menu.js' | asset_url }}" defer></script>
    {%- endif -%}
    {%- if has_showcase_menu -%}
      <script src="{{ 'showcase-menu.js' | asset_url }}" defer></script>
    {%- endif -%}
    {%- if has_link_list -%}
      <script src="{{ 'link-list.js' | asset_url }}" defer></script>
    {%- endif -%}
  {%- endif -%}

</header>

<script src="{{ 'main-header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Main Header",
  "tag": "div",
  "class": "main-header-section",
  "settings": [
    { "type": "header", "content": "Section layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24,
      "info": "Applies at tablet and desktop widths. Mobile (< 640px) keeps its own fixed, tighter padding regardless of this setting. Also controls the Utility Bar's width/padding below it, so the two rows always line up."
    },

    { "type": "header", "content": "Announcement Bar" },
    {
      "type": "checkbox",
      "id": "ann_enable",
      "label": "Enable announcement bar",
      "default": true
    },
    {
      "type": "select",
      "id": "ann_section_width",
      "label": "Announcement bar width",
      "options": [
        { "value": "", "label": "Full width" },
        { "value": "boxed", "label": "Boxed (matches header width)" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "ann_custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.ann_section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "ann_section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "ann_autorotate",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "ann_autorotate_speed",
      "label": "Rotation interval (seconds)",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 5
    },

    { "type": "header", "content": "Announcement Bar — Slide 1" },
    {
      "type": "select",
      "id": "ann_1_type",
      "label": "Slide 1 type",
      "options": [
        { "value": "", "label": "None (disabled)" },
        { "value": "announcement", "label": "Announcement" },
        { "value": "countdown", "label": "Countdown timer" }
      ],
      "default": "announcement"
    },
    {
      "type": "text",
      "id": "ann_1_text",
      "label": "Text",
      "default": "✌️ Free Express Shipping on orders $500!",
      "visible_if": "{{ section.settings.ann_1_type != '' }}"
    },
    {
      "type": "url",
      "id": "ann_1_link",
      "label": "Link (announcement only)",
      "visible_if": "{{ section.settings.ann_1_type == 'announcement' }}"
    },
    {
      "type": "select",
      "id": "ann_1_countdown_type",
      "label": "Countdown type",
      "options": [
        { "value": "fixed", "label": "Fixed date" },
        { "value": "evergreen", "label": "Evergreen (repeating)" }
      ],
      "default": "evergreen",
      "visible_if": "{{ section.settings.ann_1_type == 'countdown' }}"
    },
    {
      "type": "text",
      "id": "ann_1_end_date",
      "label": "End date (fixed) — format: YYYY/MM/DD HH:MM",
      "placeholder": "2025/12/31 23:59",
      "visible_if": "{{ section.settings.ann_1_type == 'countdown' }}"
    },
    {
      "type": "number",
      "id": "ann_1_evergreen_minutes",
      "label": "Evergreen duration (minutes)",
      "default": 720,
      "visible_if": "{{ section.settings.ann_1_type == 'countdown' }}"
    },
    {
      "type": "text",
      "id": "ann_1_button_label",
      "label": "Button label",
      "visible_if": "{{ section.settings.ann_1_type == 'countdown' }}"
    },
    {
      "type": "url",
      "id": "ann_1_button_link",
      "label": "Button link",
      "visible_if": "{{ section.settings.ann_1_type == 'countdown' }}"
    },

    { "type": "header", "content": "Announcement Bar — Slide 2" },
    {
      "type": "select",
      "id": "ann_2_type",
      "label": "Slide 2 type",
      "options": [
        { "value": "", "label": "None (disabled)" },
        { "value": "announcement", "label": "Announcement" },
        { "value": "countdown", "label": "Countdown timer" }
      ],
      "default": ""
    },
    {
      "type": "text",
      "id": "ann_2_text",
      "label": "Text",
      "visible_if": "{{ section.settings.ann_2_type != '' }}"
    },
    {
      "type": "url",
      "id": "ann_2_link",
      "label": "Link (announcement only)",
      "visible_if": "{{ section.settings.ann_2_type == 'announcement' }}"
    },
    {
      "type": "select",
      "id": "ann_2_countdown_type",
      "label": "Countdown type",
      "options": [
        { "value": "fixed", "label": "Fixed date" },
        { "value": "evergreen", "label": "Evergreen (repeating)" }
      ],
      "default": "evergreen",
      "visible_if": "{{ section.settings.ann_2_type == 'countdown' }}"
    },
    {
      "type": "text",
      "id": "ann_2_end_date",
      "label": "End date (fixed) — format: YYYY/MM/DD HH:MM",
      "placeholder": "2025/12/31 23:59",
      "visible_if": "{{ section.settings.ann_2_type == 'countdown' }}"
    },
    {
      "type": "number",
      "id": "ann_2_evergreen_minutes",
      "label": "Evergreen duration (minutes)",
      "default": 720,
      "visible_if": "{{ section.settings.ann_2_type == 'countdown' }}"
    },
    {
      "type": "text",
      "id": "ann_2_button_label",
      "label": "Button label",
      "visible_if": "{{ section.settings.ann_2_type == 'countdown' }}"
    },
    {
      "type": "url",
      "id": "ann_2_button_link",
      "label": "Button link",
      "visible_if": "{{ section.settings.ann_2_type == 'countdown' }}"
    },

    { "type": "header", "content": "Announcement Bar — Slide 3" },
    {
      "type": "select",
      "id": "ann_3_type",
      "label": "Slide 3 type",
      "options": [
        { "value": "", "label": "None (disabled)" },
        { "value": "announcement", "label": "Announcement" },
        { "value": "countdown", "label": "Countdown timer" }
      ],
      "default": ""
    },
    {
      "type": "text",
      "id": "ann_3_text",
      "label": "Text",
      "visible_if": "{{ section.settings.ann_3_type != '' }}"
    },
    {
      "type": "url",
      "id": "ann_3_link",
      "label": "Link (announcement only)",
      "visible_if": "{{ section.settings.ann_3_type == 'announcement' }}"
    },
    {
      "type": "select",
      "id": "ann_3_countdown_type",
      "label": "Countdown type",
      "options": [
        { "value": "fixed", "label": "Fixed date" },
        { "value": "evergreen", "label": "Evergreen (repeating)" }
      ],
      "default": "evergreen",
      "visible_if": "{{ section.settings.ann_3_type == 'countdown' }}"
    },
    {
      "type": "text",
      "id": "ann_3_end_date",
      "label": "End date (fixed) — format: YYYY/MM/DD HH:MM",
      "placeholder": "2025/12/31 23:59",
      "visible_if": "{{ section.settings.ann_3_type == 'countdown' }}"
    },
    {
      "type": "number",
      "id": "ann_3_evergreen_minutes",
      "label": "Evergreen duration (minutes)",
      "default": 720,
      "visible_if": "{{ section.settings.ann_3_type == 'countdown' }}"
    },
    {
      "type": "text",
      "id": "ann_3_button_label",
      "label": "Button label",
      "visible_if": "{{ section.settings.ann_3_type == 'countdown' }}"
    },
    {
      "type": "url",
      "id": "ann_3_button_link",
      "label": "Button link",
