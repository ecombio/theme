{{ 'main-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo       = settings.logo
  assign logo_width = settings.logo_width | default: 110
  assign show_acct  = section.settings.show_icon_account
  assign show_cart  = section.settings.show_icon_cart
  assign show_wish  = section.settings.show_icon_wishlist
  assign show_comp  = section.settings.show_icon_compare
  assign label_acct = section.settings.show_label_account
  assign label_cart = section.settings.show_label_cart
  assign label_wish = section.settings.show_label_wishlist
  assign label_comp = section.settings.show_label_compare
  assign enable_search_drawer_tablet = section.settings.enable_search_drawer_tablet

  assign section_width = section.settings.section_width
  case section_width
    when 'full-width'
      assign width_class = 'main-header--full-width'
    when 'custom-width'
      assign width_class = 'main-header--custom-width'
    else
      assign width_class = 'main-header--default-width'
  endcase

  comment
    ADDED — menu position (inline vs below). Desktop-only distinction
    (see main-header.css @media min-width: 64rem); mobile/tablet keep
    the hamburger drawer regardless of this setting, since the drawer
    is rendered from `blocks` separately via header-menu-mobile
    markup elsewhere, not from header_nav_markup below.
  endcomment
  assign menu_position = section.settings.menu_position | default: 'inline'
  assign menu_below = false
  if menu_position == 'below'
    assign menu_below = true
  endif

  comment
    ADDED — search style (icon+overlay vs always-visible bar).
    Desktop-only distinction (see main-header.css @media min-width:
    64rem) — mobile/tablet are unaffected either way, since they
    always use the dedicated .main-header__search-row bar (rendered
    further down) regardless of this setting; that row was never the
    icon/overlay pattern to begin with. When search_bar is true, the
    desktop search-trigger icon and its full overlay markup are
    omitted entirely (see further down) rather than just hidden with
    CSS, since a bar makes them fully redundant.
  endcomment
  assign search_style = section.settings.search_style | default: 'icon'
  assign search_bar = false
  if search_style == 'bar'
    assign search_bar = true
  endif

  assign trending_terms = ''
  for i in (1..12)
    assign key = 'trending_' | append: i
    assign term = section.settings[key]
    if term != blank
      assign trending_terms = trending_terms | append: term | append: '||'
    endif
  endfor

  comment
    ADDED — transparent-over-hero header (see main-header.css /
    header-group.css / header-group.js for the rest of the
    implementation). Enabled on the homepage always, plus any Page
    resource whose handle is listed in the "Additional pages" setting
    below (for landing pages built with the same slideshow hero as
    the homepage). Computed entirely server-side — from
    request.page_type / page.handle rather than any client-side URL
    check — so it can never be spoofed or drift out of sync, and it
    degrades safely to "false" (today's normal solid header) on every
    other page even if the JS fails to load.

    Kept handle-based rather than checking page.template_suffix, so
    this works no matter which template file each landing page
    happens to use — it only cares about the page's URL handle, which
    is what was actually given for this feature. handleize is applied
    to both sides of the comparison: page.handle is already lowercase
    /hyphenated (Shopify generates it that way), and running the
    merchant-entered list through the same filter means stray spaces,
    capitalization, or double-spaces typed into the setting (e.g.
    "Electric  Bikes") still resolve to the correct "electric-bikes"
    instead of silently failing to match.

    ADDED (master toggle) — everything above was previously always-on
    for the homepage with no way to turn it off short of editing this
    file. enable_transparent_header (default: true, so existing
    stores keep today's behavior with zero config change) now gates
    the entire block: when the merchant unchecks it in the theme
    editor, transparent_header_enabled is forced false regardless of
    page type or the "Additional pages" list, and the header renders
    solid everywhere, every time — same as if the feature didn't
    exist. Checked first, before request.page_type, so nothing below
    even needs to run once it's off.
  endcomment
  assign transparent_header_enabled = false
  if section.settings.enable_transparent_header != false
    if request.page_type == 'index'
      assign transparent_header_enabled = true
    elsif request.page_type == 'page' and page.handle != blank
      assign extra_pages_raw = section.settings.transparent_header_page_handles
      if extra_pages_raw != blank
        assign extra_pages = extra_pages_raw | split: ','
        for raw_handle in extra_pages
          assign candidate_handle = raw_handle | handleize
          if candidate_handle == page.handle
            assign transparent_header_enabled = true
            break
          endif
        endfor
      endif
    endif
  endif
-%}

{%- if transparent_header_enabled -%}
  {%- comment -%}
    ADDED — pairs with data-transparent-header below. Emitted as an
    inline server-rendered style rather than a class on <body> (which
    we don't control from this file, and header-group.css's earlier
    guess at that class — .template-index — didn't match this theme).
    This is computed from the same transparent_header_enabled check
    above, so it's guaranteed correct with zero dependency on
    theme.liquid or JS timing: overrides header-group.css's
    `main[role="main"] { padding-top: var(--header-group-height...) }`
    so the hero/slideshow section starts at the very top of the page
    instead of leaving a gap the height of the header above it.
    !important since header-group.css's rule loads from a separate
    stylesheet and doesn't use one itself. Applies equally to the
    homepage and any landing page listed in "Additional pages" below,
    since both share this same variable.

    FIX (desktop-only transparency) — wrapped in the same
    min-width: 64rem breakpoint used everywhere else the transparent
    header is scoped (main-header.css, header-group.css,
    header-group.js). Transparency is a desktop-only effect; on
    mobile/tablet the header stays solid (see the other three files),
    so the padding this rule removes must stay reserved on those
    breakpoints too — otherwise page content would render underneath
    the solid fixed header instead of below it.
  {%- endcomment -%}
  <style>
    @media (min-width: 64rem) {
      main[role="main"] { padding-top: 0 !important; }
    }
  </style>
{%- endif -%}

{%- comment -%}
  ADDED — the nav is captured once here rather than rendered inline
  where it's used, so the exact same markup can be placed either
  inside .main-header__inner (menu_position: inline) or in its own
  full-width row below .main-header__bar (menu_position: below)
  without rendering header-menu twice or duplicating its render call.
{%- endcomment -%}
{%- capture header_nav_markup -%}
  {%- render 'header-menu', blocks: section.blocks -%}
{%- endcapture -%}

<header
  class="main-header {{ width_class }}{% if section.settings.enable_search_drawer %} main-header--search-drawer-mobile{% endif %}{% if enable_search_drawer_tablet %} main-header--search-drawer-tablet{% endif %}{% if section.settings.logo_position == 'center' %} main-header--logo-center{% endif %}{% if menu_below %} main-header--menu-below{% endif %}{% if search_bar %} main-header--search-bar{% endif %}"
  id="main-header"
  role="banner"
  data-transparent-header="{{ transparent_header_enabled }}"
  style="
    --section-padding: {{ section.settings.section_padding }}px;
    --hdr-logo-slot-width: {{ section.settings.logo_slot_width | default: 160 }}px;
    {%- if section_width == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  <div class="main-header__bar">
    <div class="main-header__inner">

      {%- if section.blocks.size > 0 -%}
        <button type="button"
                class="ecombio-header__hamburger"
                id="main-header-menu-trigger"
                aria-expanded="false"
                aria-controls="main-header-mobile-nav"
                aria-label="Open menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      {%- endif -%}

      {%- if section.settings.enable_search_drawer -%}
        <div class="main-header__search-drawer-mobile-only">
          {%- render 'header-search-drawer',
            enable_predictive_search: section.settings.enable_predictive_search,
            trending_terms: trending_terms,
            enable_typewriter: section.settings.enable_typewriter,
            typewriter_type_speed: section.settings.typewriter_type_speed,
            typewriter_hold_ms: section.settings.typewriter_hold_ms
          -%}
        </div>
      {%- endif -%}
      {%- if enable_search_drawer_tablet -%}
        <div class="main-header__search-drawer-tablet-only">
          {%- render 'header-search-drawer',
            enable_predictive_search: section.settings.enable_predictive_search,
            trending_terms: trending_terms,
            enable_typewriter: section.settings.enable_typewriter,
            typewriter_type_speed: section.settings.typewriter_type_speed,
            typewriter_hold_ms: section.settings.typewriter_hold_ms
          -%}
        </div>
      {%- endif -%}

      <div class="main-header__logo">
        {%- render 'header-logo', logo: logo, logo_width: logo_width -%}
      </div>

      {%- comment -%}
        ADDED — .main-header__nav-group wraps the nav AND (when
        search_style is "bar") the inline search bar, and is always
        rendered — even when both are empty (menu_position: below
        with search_style: icon) — so it always occupies the same
        DOM/grid slot. This matters specifically for
        main-header--logo-center's 3-column grid (nav | logo | icons)
        further down in main-header.css: with a stable 3-item
        structure at all times, the grid's normal auto-placement
        always lands logo in the middle column and icons on the
        right, with no per-combination grid-column overrides needed
        — previously, omitting the nav entirely (menu-below +
        logo-center) required a special-cased override; that's no
        longer necessary now that this wrapper is never omitted.

        Inside the wrapper: the nav itself is still omitted when
        menu_below is true (rendered in .main-header__menu-row
        instead, further down), and the inline search bar is only
        rendered when search_bar is true — each independently, so
        this wrapper can hold nav only, bar only, both, or neither.
      {%- endcomment -%}
      <div class="main-header__nav-group">
        {%- unless menu_below -%}
          <div class="main-header__nav">
            {{ header_nav_markup }}
          </div>
        {%- endunless -%}
        {%- if search_bar -%}
          <div class="main-header__search-bar-inline">
            {%- render 'header-search',
              enable_predictive_search: section.settings.enable_predictive_search,
              variant: 'desktop-bar',
              trending_terms: trending_terms,
              enable_typewriter: section.settings.enable_typewriter,
              typewriter_type_speed: section.settings.typewriter_type_speed,
              typewriter_hold_ms: section.settings.typewriter_hold_ms
            -%}
          </div>
        {%- endif -%}
      </div>

      <ul class="main-header__icons" role="list" aria-label="Header actions">
        {%- comment -%}
          ADDED — the search-trigger icon is only rendered when
          search_style is "icon" (the default / previous behavior).
          When search_style is "bar", the inline bar above already
          covers this, and the icon + its overlay (further down) are
          omitted entirely rather than just hidden with CSS, since
          they'd be fully redundant. main-header.js's overlay IIFE
          already no-ops safely when the trigger/overlay elements
          aren't present (`if (!trigger || !overlay) return;`), so
          nothing else needs to change there.
        {%- endcomment -%}
        {%- unless search_bar -%}
          <li>
            <button type="button"
                    class="main-header__search-trigger"
                    id="main-header-search-trigger"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    aria-controls="main-header-search-overlay"
                    aria-label="Search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              <span class="visually-hidden">Search</span>
            </button>
          </li>
        {%- endunless -%}
        {%- if show_wish != false -%}
          <li class="main-header__icons-item--wishlist">{%- render 'header-wishlist', show_label: label_wish -%}</li>
        {%- endif -%}
        {%- if show_comp != false -%}
          <li>{%- render 'header-compare', show_label: label_comp -%}</li>
        {%- endif -%}
        {%- if show_acct != false -%}
          <li>{%- render 'header-account', show_label: label_acct -%}</li>
        {%- endif -%}
        {%- if show_cart != false -%}
          <li>{%- render 'header-cart', show_label: label_cart -%}</li>
        {%- endif -%}
      </ul>

    </div>
  </div>

  {%- comment -%}
    ADDED — menu-below row. Only rendered when menu_position is
    "below". Sits as its own full-width row directly under
    .main-header__bar (before .main-header__search-row), sharing the
    exact same header_nav_markup captured above. Desktop-only in
    practice — see the display:none base rule + min-width: 64rem
    override in main-header.css — mobile/tablet keep the hamburger
    drawer regardless of this setting, so nothing renders here below
    that breakpoint.
  {%- endcomment -%}
  {%- if menu_below -%}
    <div class="main-header__menu-row">
      {{ header_nav_markup }}
    </div>
  {%- endif -%}

  <div class="main-header__search-row{% if section.settings.enable_search_drawer %} main-header__search-row--drawer-mobile{% endif %}{% if enable_search_drawer_tablet %} main-header__search-row--drawer-tablet{% endif %}">
    <div class="main-header__search-row-inner">
      {%- render 'header-search',
        enable_predictive_search: section.settings.enable_predictive_search,
        variant: 'mobile',
        trending_terms: trending_terms,
        enable_typewriter: section.settings.enable_typewriter,
        typewriter_type_speed: section.settings.typewriter_type_speed,
        typewriter_hold_ms: section.settings.typewriter_hold_ms
      -%}
    </div>
  </div>

  {%- comment -%}
    ADDED — only rendered when search_style is "icon" (the default).
    When search_style is "bar", the inline bar in .main-header__nav-group
    covers search directly with no trigger/overlay needed, so this
    entire block — including header-search's 'overlay' variant render
    — is skipped rather than left in the DOM hidden.
  {%- endcomment -%}
  {%- unless search_bar -%}
    <div class="main-header__search-overlay" id="main-header-search-overlay" data-search-overlay hidden>
      <div class="main-header__search-overlay-backdrop" data-search-overlay-close></div>
      <div class="main-header__search-overlay-panel" role="dialog" aria-modal="true" aria-label="Search">
        <div class="main-header__search-overlay-top">
          <a href="{{ routes.root_url }}" class="main-header__search-overlay-logo" aria-label="{{ shop.name }} home">
            {%- render 'header-logo', logo: logo, logo_width: 84 -%}
          </a>
          <div class="main-header__search-overlay-inner">
            {%- render 'header-search',
              enable_predictive_search: section.settings.enable_predictive_search,
              variant: 'overlay',
              trending_terms: trending_terms,
              enable_typewriter: section.settings.enable_typewriter,
              typewriter_type_speed: section.settings.typewriter_type_speed,
              typewriter_hold_ms: section.settings.typewriter_hold_ms
            -%}
          </div>
          <button type="button" class="main-header__search-overlay-cancel" data-search-overlay-close>
            Cancel
          </button>
        </div>
      </div>
    </div>
  {%- endunless -%}

</header>

<script src="{{ 'main-header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Main header",
  "tag": "div",
  "class": "main-header-section",
  "settings": [
    { "type": "header", "content": "Section layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40, "max": 120, "step": 5, "unit": "rem", "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "info": "Center moves the menu to the left (where the logo currently sits) and places the logo in the middle. Desktop only (1024px+) — mobile and tablet are unaffected. Works with any Menu position or Search style combination.",
      "options": [
        { "value": "left", "label": "Left (menu next to logo)" },
        { "value": "center", "label": "Center (menu on the left)" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "logo_slot_width",
      "label": "Logo slot width",
      "info": "Desktop only (1024px+), Logo position: Left only. Reserves a fixed amount of space for the logo so the search bar/menu next to it stays anchored in the same spot even if you resize the logo later (Theme settings → Logo width) — otherwise a bigger or smaller logo shifts everything after it. If your logo is wider than this slot, it'll overflow rather than get cropped; raise this value to match.",
      "min": 80, "max": 320, "step": 10, "unit": "px", "default": 160,
      "visible_if": "{{ section.settings.logo_position == 'left' }}"
    },

    { "type": "header", "content": "Menu position" },
    {
      "type": "select",
      "id": "menu_position",
      "label": "Menu position",
      "info": "Desktop only (1024px+) — mobile/tablet keep the hamburger menu either way.",
      "options": [
        { "value": "inline", "label": "Inline with logo (default)" },
        { "value": "below", "label": "Below header row" }
      ],
      "default": "inline"
    },

    { "type": "header", "content": "Search style" },
    {
      "type": "select",
      "id": "search_style",
      "label": "Search style",
      "info": "Desktop only (1024px+) — mobile/tablet always use the search bar shown below the header, and the \"search drawer\" toggles under Mobile/Tablet Division below control that separately. \"Icon\" opens a full-screen search overlay when clicked. \"Bar\" shows an always-visible search input inline in the header, next to the menu.",
      "options": [
        { "value": "icon", "label": "Icon (opens overlay)" },
        { "value": "bar", "label": "Always-visible bar" }
      ],
      "default": "icon"
    },

    { "type": "header", "content": "Transparent header" },
    {
      "type": "checkbox",
      "id": "enable_transparent_header",
      "label": "Enable transparent header effect",
      "info": "Turns the whole effect on or off. When unchecked, the header is always solid — everywhere, regardless of the settings below — the exact same as if this feature didn't exist. When checked, the homepage always gets the transparent-over-hero header, plus any pages listed below.",
      "default": true
    },
    {
      "type": "textarea",
      "id": "transparent_header_page_handles",
      "label": "Additional pages (comma-separated)",
      "info": "The homepage always gets the transparent-over-hero header (when the toggle above is on). To use it on a landing page (Page template) too, enter its handle here — the part of its URL after /pages/. Separate multiple handles with commas, e.g. electric-scooters, electric-skateboards, electric-bikes, accessories. Only works on pages that have a full-width hero/slideshow at the top, same as the homepage.",
      "default": "electric-scooters, electric-skateboards, electric-bikes, accessories",
      "visible_if": "{{ section.settings.enable_transparent_header }}"
    },

    { "type": "header", "content": "Mobile Division (< 640px)" },
    {
      "type": "checkbox",
      "id": "enable_search_drawer",
      "label": "Enable search drawer icon (mobile only, < 640px)",
      "default": false
    },

    { "type": "header", "content": "Tablet Division (640px – 1023px)" },
    {
      "type": "checkbox",
      "id": "enable_search_drawer_tablet",
      "label": "Enable search drawer icon (tablet only, 640px – 1023px)",
      "default": false
    },

    { "type": "header", "content": "Search (all breakpoints)" },
    { "type": "checkbox", "id": "enable_predictive_search", "label": "Enable predictive search", "default": true },
    { "type": "checkbox", "id": "enable_typewriter", "label": "Animate placeholder (typewriter effect)", "default": false, "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "range", "id": "typewriter_type_speed", "label": "Typing speed", "min": 30, "max": 150, "step": 5, "default": 70, "unit": "ms", "visible_if": "{{ section.settings.enable_predictive_search and section.settings.enable_typewriter }}" },
    { "type": "range", "id": "typewriter_hold_ms", "label": "Pause on full word", "min": 1000, "max": 5000, "step": 100, "default": 3200, "unit": "ms", "visible_if": "{{ section.settings.enable_predictive_search and section.settings.enable_typewriter }}" },
    { "type": "text", "id": "trending_1", "label": "Trending term 1", "default": "electric scooters", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_2", "label": "Trending term 2", "default": "electric bikes", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_3", "label": "Trending term 3", "default": "electric skateboards", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_4", "label": "Trending term 4", "default": "electric cargo bikes", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_5", "label": "Trending term 5", "default": "electric city bikes", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_6", "label": "Trending term 6", "default": "electric fat bikes", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_7", "label": "Trending term 7", "default": "electric folding bikes", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_8", "label": "Trending term 8", "default": "electric mountain bikes", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_9", "label": "Trending term 9", "default": "commuter electric scooters", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_10", "label": "Trending term 10", "default": "off-road electric scooters", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_11", "label": "Trending term 11", "default": "performance electric scooters", "visible_if": "{{ section.settings.enable_predictive_search }}" },
    { "type": "text", "id": "trending_12", "label": "Trending term 12", "default": "youth electric scooters", "visible_if": "{{ section.settings.enable_predictive_search }}" },

    { "type": "header", "content": "Icons (all breakpoints)" },
    { "type": "checkbox", "id": "show_icon_account", "label": "Show account icon", "default": false },
    { "type": "checkbox", "id": "show_label_account", "label": "Show account label", "default": false },
    { "type": "checkbox", "id": "show_icon_wishlist", "label": "Show wishlist icon", "default": true },
    { "type": "checkbox", "id": "show_label_wishlist", "label": "Show wishlist label", "default": false },
    { "type": "checkbox", "id": "show_icon_compare", "label": "Show compare icon", "default": false },
    { "type": "checkbox", "id": "show_label_compare", "label": "Show compare label", "default": false },
    { "type": "checkbox", "id": "show_icon_cart", "label": "Show cart icon", "default": true },
    { "type": "checkbox", "id": "show_label_cart", "label": "Show cart label", "default": false }
  ],
  "blocks": [
    { "type": "single-link", "name": "Single Link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Single Link" },
      { "type": "url", "id": "link", "label": "URL" },
      { "type": "text", "id": "icon", "label": "Icon name" }
    ]},
    { "type": "link-list", "name": "Link list", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "url", "id": "link", "label": "Top-level URL (optional)" },
      { "type": "link_list", "id": "menu", "label": "Link list menu" },
      { "type": "text", "id": "icon", "label": "Icon name" }
    ]},
    { "type": "mega-menu", "name": "Mega menu", "settings": [
