<div
  class="product-recommendations product-recommendations--complementary"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=complementary"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <h2 class="product-recommendations__heading">
      {{ 'product_recommendations.complementary_heading' | t }}
    </h2>
    <ul class="product-recommendations__list">
      {%- for product in recommendations.products -%}
        <li class="product-recommendations__item">
          <a href="{{ product.url }}" class="product-recommendations__link">
            {%- if product.featured_image -%}
              <img
                class="product-recommendations__img"
                src="{{ product.featured_image | image_url: width: 300 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >
            {%- endif -%}
            <p class="product-recommendations__title">{{ product.title }}</p>
            <p class="product-recommendations__price">{{ product.price | money }}</p>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode and section.settings.preview_product != blank -%}
    {%- assign preview_product = section.settings.preview_product -%}
    <h2 class="product-recommendations__heading">
      {{ 'product_recommendations.complementary_heading' | t }}
    </h2>
    <ul class="product-recommendations__list">
      <li class="product-recommendations__item">
        <a href="{{ preview_product.url }}" class="product-recommendations__link">
          {%- if preview_product.featured_image -%}
            <img
              class="product-recommendations__img"
              src="{{ preview_product.featured_image | image_url: width: 300 }}"
              alt="{{ preview_product.featured_image.alt | escape }}"
              loading="lazy"
              width="{{ preview_product.featured_image.width }}"
              height="{{ preview_product.featured_image.height }}"
            >
          {%- endif -%}
          <p class="product-recommendations__title">{{ preview_product.title }}</p>
          <p class="product-recommendations__price">{{ preview_product.price | money }}</p>
        </a>
      </li>
    </ul>
    <p class="product-recommendations__preview-note">Editor preview only — showing manually selected product because live complementary data isn't available in this draft theme.</p>
  {%- endif -%}
</div>

{% stylesheet %}
.product-recommendations--complementary {
  margin-top: 2rem;
}
.product-recommendations__preview-note {
  margin-top: 1rem;
  font-size: 0.8rem;
  font-style: italic;
  opacity: 0.65;
}
{% endstylesheet %}

{% javascript %}
  const complementarySection = document.querySelector('.product-recommendations--complementary');

  if (complementarySection) {
    const fetchRecommendations = () => {
      const url = complementarySection.dataset.url;

      fetch(url)
        .then((response) => response.text())
        .then((text) => {
          const html = document.createElement('div');
          html.innerHTML = text;
          const recommendations = html.querySelector('.product-recommendations--complementary');

          if (recommendations && recommendations.innerHTML.trim().length) {
            complementarySection.innerHTML = recommendations.innerHTML;
          }
        })
        .catch((e) => {
          console.error(e);
        });
    };

    if (Shopify && Shopify.designMode) {
      // In the theme editor, fetch immediately so merchants see results
      // without relying on scroll-triggered IntersectionObserver behavior.
      fetchRecommendations();
    } else {
      const handleIntersection = (entries, observer) => {
        if (!entries[0].isIntersecting) return;

        observer.unobserve(complementarySection);
        fetchRecommendations();
      };

      const observer = new IntersectionObserver(handleIntersection, {
        rootMargin: '0px 0px 200px 0px'
      });

      observer.observe(complementarySection);
    }
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:product_recommendations.complementary_name",
  "settings": [
    {
      "type": "range",
      "id": "limit",
      "label": "t:product_recommendations.settings.limit_label",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "product",
      "id": "preview_product",
      "label": "t:product_recommendations.settings.preview_product_label",
      "info": "t:product_recommendations.settings.preview_product_info"
    }
  ]
}
{% endschema %}