{{ 'product-complementary.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'fbt__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'fbt__full-width'
  else
    assign width_class = 'fbt__custom-width'
  endif
-%}

<div
  class="product-recommendations product-recommendations--complementary fbt {{ width_class }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=complementary"
  style="
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <h2 class="fbt__heading">{{ 'product_recommendations.fbt_heading' | t }}</h2>

    <div class="fbt__body">
      <div class="fbt__row">
        <div class="fbt__item fbt__item--main">
          <label class="fbt__checkbox-wrap">
            <input
              type="checkbox"
              class="fbt__checkbox"
              checked
              disabled
              aria-label="{{ product.title | escape }}"
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              data-price="{{ product.selected_or_first_available_variant.price | default: product.price }}"
            >
          </label>
          <a href="{{ product.url }}" class="fbt__img-link">
            {%- if product.featured_image -%}
              <img
                class="fbt__img"
                src="{{ product.featured_image | image_url: width: 300 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >
            {%- endif -%}
          </a>
          <p class="fbt__label">
            <span class="fbt__this-item">{{ 'product_recommendations.this_item_label' | t }}</span>
            <a href="{{ product.url }}" class="fbt__title-link">{{ product.title }}</a>
          </p>
          <p class="fbt__price">{{ product.selected_or_first_available_variant.price | default: product.price | money }}</p>
        </div>

        {%- for rec_product in recommendations.products -%}
          <div class="fbt__plus" aria-hidden="true">+</div>
          <div class="fbt__item">
            <label class="fbt__checkbox-wrap">
              <input
                type="checkbox"
                class="fbt__checkbox"
                checked
                aria-label="{{ rec_product.title | escape }}"
                data-variant-id="{{ rec_product.selected_or_first_available_variant.id }}"
                data-price="{{ rec_product.selected_or_first_available_variant.price | default: rec_product.price }}"
              >
            </label>
            <a href="{{ rec_product.url }}" class="fbt__img-link">
              {%- if rec_product.featured_image -%}
                <img
                  class="fbt__img"
                  src="{{ rec_product.featured_image | image_url: width: 300 }}"
                  alt="{{ rec_product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="{{ rec_product.featured_image.width }}"
                  height="{{ rec_product.featured_image.height }}"
                >
              {%- endif -%}
            </a>
            <p class="fbt__label">
              <a href="{{ rec_product.url }}" class="fbt__title-link">{{ rec_product.title }}</a>
            </p>
            <p class="fbt__price">{{ rec_product.selected_or_first_available_variant.price | default: rec_product.price | money }}</p>
          </div>
        {%- endfor -%}
      </div>

      <div class="fbt__summary">
        <p class="fbt__total">
          {{ 'product_recommendations.total_price_label' | t }}
          <span class="fbt__total-price" data-fbt-total></span>
        </p>
        <button type="button" class="fbt__add-all" data-fbt-add-all>
          {{ 'product_recommendations.add_all_label' | t }}
        </button>
        <p class="fbt__note">{{ 'product_recommendations.shipping_note' | t }}</p>
      </div>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'product-complementary.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:product_recommendations.complementary_name",
  "settings": [
    {
      "type": "range",
      "id": "limit",
      "label": "t:product_recommendations.settings.limit_label",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ]
}
{% endschema %}