{%- comment -%}
  sections/product-complementary.liquid
  Mode: Shopify native recommendations (intent: complementary)
  Cards: snippets/product-card.liquid (rendered server-side, no second AJAX hop)
{%- endcomment -%}

{{ 'pr-section.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cols_d     = section.settings.columns_desktop
  assign cols_m     = section.settings.columns_mobile
  assign gap        = section.settings.card_gap
  assign pad_top    = section.settings.padding_top
  assign pad_bottom = section.settings.padding_bottom
  assign limit      = section.settings.products_to_show
-%}

<product-complementary
  class="pr-section color-{{ section.settings.color_scheme }}"
  id="pr-comp-section-{{ section.id }}"
  style="
    --pr-cols: {{ cols_d }};
    --pr-cols-mob: {{ cols_m }};
    --pr-gap: {{ gap }}px;
    --pr-pad-top: {{ pad_top }}px;
    --pr-pad-bottom: {{ pad_bottom }}px;
  "
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&intent=complementary&limit={{ limit }}"
  data-product-id="{{ product.id }}"
  aria-label="{{ section.settings.heading | escape }}"
  hidden
>
  <div class="pr-inner">
    {% if recommendations.performed and recommendations.products_count > 0 %}
      <div class="pr-header">
        <h2 class="pr-heading">{{ section.settings.heading }}</h2>
      </div>
      <ul class="pr-grid" role="list">
        {% for recommendation in recommendations.products %}
          <li class="pr-grid__item">
            {% render 'product-card', card_product: recommendation %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</product-complementary>

<script>
  class ProductComplementary extends HTMLElement {
    connectedCallback() {
      // If Liquid already populated recommendations (this render came back
      // from its own fetch), just reveal it — no need to fetch again.
      if (this.querySelector('.pr-grid')) {
        this.removeAttribute('hidden');
        return;
      }

      const url = this.dataset.url;
      if (!url) return;

      fetch(url)
        .then((res) => (res.ok ? res.text() : Promise.reject()))
        .then((text) => {
          const html = new DOMParser().parseFromString(text, 'text/html');
          const newInner = html.querySelector('.pr-inner');
          const grid = newInner && newInner.querySelector('.pr-grid');

          if (!grid) {
            // No complementary products configured for this product — stay hidden.
            return;
          }

          this.querySelector('.pr-inner').innerHTML = newInner.innerHTML;
          this.removeAttribute('hidden');
        })
        .catch(() => {
          // Fetch failed — leave the section hidden rather than show a broken shelf.
        });
    }
  }

  customElements.define('product-complementary', ProductComplementary);
</script>

{% schema %}
{
  "name": "Complementary products",
  "tag": "section",
  "class": "section-pr-complementary",
  "limit": 1,
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pair it with"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3,
      "label": "Max products to show"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Columns (desktop)"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "1",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ]
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 16,
      "label": "Card gap (px)"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 52,
      "label": "Padding top (px)"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 52,
      "label": "Padding bottom (px)"
    }
  ],
  "presets": [
    {
      "name": "Complementary products"
    }
  ]
}
{% endschema %}
