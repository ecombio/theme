{{ 'custom-articles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-articles.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign nav_menu = section.settings.menu
  assign nav_items_total = nav_menu.links.size

  assign section_width = section.settings.posts_section_width
  case section_width
    when 'full-width'
      assign width_class = 'full-width'
      assign menu_width_class = 'blog-menu--full-width'
    when 'custom-width'
      assign width_class = 'custom-width'
      assign menu_width_class = 'blog-menu--custom-width'
    else
      assign width_class = 'default-width'
      assign menu_width_class = 'blog-menu--default-width'
  endcase
-%}

<nav
  class="blog-menu {{ menu_width_class }}{% if section.settings.menu_sticky %} blog-menu--sticky{% endif %}"
  data-blog-menu
  aria-label="{{ section.settings.menu_heading | default: 'Blog navigation' | escape }}"
  style="
    --blog-menu-bg: {{ section.settings.menu_background_color | default: '#ffffff' }};
    --blog-menu-text: {{ section.settings.menu_text_color | default: '#111111' }};
    --blog-menu-accent: {{ section.settings.menu_accent_color | default: '#0A3161' }};
    --blog-menu-border: {{ section.settings.menu_border_color | default: '#e5e5e5' }};
    --section-padding: {{ section.settings.posts_section_padding }}px;
    {%- if section_width == 'custom-width' %}
      --custom-width: {{ section.settings.posts_custom_width }}rem;
    {%- endif %}
  "
>
  <div class="blog-menu__inner">

    {%- if section.settings.menu_heading != blank -%}
      <div class="blog-menu__heading">{{ section.settings.menu_heading | escape }}</div>
    {%- endif -%}

    {%- if nav_items_total > 0 -%}
      <button
        type="button"
        class="blog-menu__toggle"
        data-blog-menu-toggle
        aria-expanded="false"
        aria-controls="blog-menu-list-{{ section.id }}"
      >
        <span class="blog-menu__toggle-label">{{ section.settings.menu_mobile_label | default: 'Menu' | escape }}</span>
        <span class="blog-menu__toggle-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>

      <div class="blog-menu__scroll" data-blog-menu-scroll>
        <ul class="blog-menu__list" id="blog-menu-list-{{ section.id }}" data-blog-menu-list>
          {%- for link in nav_menu.links -%}

            {%- if link.links.size > 0 -%}
              <li class="blog-menu__item blog-menu__item--list">
                <button
                  type="button"
                  class="blog-menu__link blog-menu__link--parent"
                  data-blog-menu-dropdown-toggle
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {{ link.title | escape }}
                  <span class="blog-menu__caret" aria-hidden="true"></span>
                </button>

                <ul class="blog-menu__dropdown" data-blog-menu-dropdown>
                  {%- for sublink in link.links -%}
                    <li class="blog-menu__dropdown-item">
                      <a
                        href="{{ sublink.url }}"
                        class="blog-menu__dropdown-link{% if sublink.active %} blog-menu__dropdown-link--active{% endif %}"
                      >
                        {{ sublink.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </li>

            {%- else -%}
              <li class="blog-menu__item blog-menu__item--single">
                <a
                  href="{{ link.url }}"
                  class="blog-menu__link{% if link.active %} blog-menu__link--active{% endif %}"
                >
                  {{ link.title | escape }}
                </a>
              </li>
            {%- endif -%}

          {%- endfor -%}
        </ul>

        <span class="blog-menu__edge-fade blog-menu__edge-fade--left" aria-hidden="true"></span>
        <span class="blog-menu__edge-fade blog-menu__edge-fade--right" aria-hidden="true"></span>
      </div>
    {%- endif -%}

  </div>
</nav>

{{ 'article-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign target_blog = blogs['articles']
  assign custom_tags_list = section.settings.posts_custom_tags | split: ','
-%}

<div
  class="{{ width_class }}"
  style="
    --section-padding: {{ section.settings.posts_section_padding }}px;
    {%- if section.settings.posts_section_width == 'custom-width' %}
      --custom-width: {{ section.settings.posts_custom_width }}rem;
    {%- endif %}
  "
>
  <div class="blog-posts-section section-{{ section.id }}" style="padding-block: var(--section-spacing);">

    {% if section.settings.posts_heading != blank %}
      <div class="blog-posts__header">
        <h2 class="blog-posts__title">{{ section.settings.posts_heading }}</h2>
      </div>
    {% endif %}

    {% if custom_tags_list.size > 0 %}
      <div class="blog-posts__tags">
        <a href="{{ target_blog.url }}" class="blog-posts__tag-pill {% if target_blog.current_tags.size == 0 %}is-active{% endif %}">
          All
        </a>
        {% for tag in custom_tags_list %}
          {%- assign tag = tag | strip -%}
          {%- assign tag_slug = tag | handle -%}
          <a href="{{ target_blog.url }}/tagged/{{ tag_slug }}"
             class="blog-posts__tag-pill {% if target_blog.current_tags contains tag_slug %}is-active{% endif %}">
            {{ tag }}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% paginate target_blog.articles by section.settings.posts_limit %}
      {% if target_blog.articles.size > 0 %}
        <div class="blog-posts__grid" style="--blog-posts-columns: {{ section.settings.posts_columns }};">
          {%- assign visible_index = 0 -%}
          {% for article in target_blog.articles %}
            {%- liquid
              assign show_article = false
              if custom_tags_list.size == 0
                assign show_article = true
              else
                for tag in custom_tags_list
                  assign trimmed_tag = tag | strip | handle
                  if article.tags contains trimmed_tag
                    assign show_article = true
                  endif
                endfor
              endif
            -%}

            {% if show_article %}
              {%- assign visible_index = visible_index | plus: 1 -%}
              {% assign loading = 'lazy' %}
              {% if visible_index <= section.settings.posts_columns %}
                {% assign loading = 'eager' %}
              {% endif %}

              {% render 'article-card', article: article, loading: loading %}
            {% endif %}
          {% endfor %}
        </div>

        {% if custom_tags_list.size > 0 and visible_index == 0 %}
          <p class="blog-posts__empty">No articles match the selected tags on this page.</p>
        {% endif %}

        {% if paginate.pages > 1 %}
          <nav class="blog-posts__pagination" role="navigation" aria-label="Pagination">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="blog-posts__page-link blog-posts__page-link--prev">
                ← Previous
              </a>
            {% endif %}

            <ul class="blog-posts__page-list">
              {% for part in paginate.parts %}
                <li>
                  {% if part.is_link %}
                    <a href="{{ part.url }}" class="blog-posts__page-link">{{ part.title }}</a>
                  {% else %}
                    {% if part.title == paginate.current_page %}
                      <span class="blog-posts__page-link is-active" aria-current="page">{{ part.title }}</span>
                    {% else %}
                      <span class="blog-posts__page-link blog-posts__page-link--gap">{{ part.title }}</span>
                    {% endif %}
                  {% endif %}
                </li>
              {% endfor %}
            </ul>

            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="blog-posts__page-link blog-posts__page-link--next">
                Next →
              </a>
            {% endif %}
          </nav>
        {% endif %}
      {% else %}
        <p class="blog-posts__empty">No articles to show yet.</p>
      {% endif %}
    {% endpaginate %}

  </div>
</div>

{% schema %}
{
  "name": "Custom articles",
  "tag": "section",
  "class": "section-custom-articles",
  "settings": [
    {
      "type": "header",
      "content": "Blog menu"
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Menu heading",
      "info": "Optional label shown before the nav items."
    },
    {
      "type": "text",
      "id": "menu_mobile_label",
      "label": "Mobile toggle label",
      "default": "Menu"
    },
    {
      "type": "checkbox",
      "id": "menu_sticky",
      "label": "Make menu sticky on scroll",
      "default": false
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Choose a navigation menu from Online Store > Navigation. Top-level links become nav items; any link with nested links becomes a dropdown."
    },
    {
      "type": "header",
      "content": "Blog menu colors"
    },
    {
      "type": "color",
      "id": "menu_background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "menu_text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "menu_accent_color",
      "label": "Accent (hover / active)",
      "default": "#0A3161"
    },
    {
      "type": "color",
      "id": "menu_border_color",
      "label": "Border",
      "default": "#e5e5e5"
    },
    {
      "type": "header",
      "content": "Blog posts"
    },
    {
      "type": "text",
      "id": "posts_heading",
      "label": "Heading",
      "default": "Latest Articles"
    },
    {
      "type": "text",
      "id": "posts_custom_tags",
      "label": "Tags (comma-separated)",
      "info": "Type tags however you'd like them displayed (e.g. \"Electric Scooters\"). The /tagged/ URL and article matching auto-use the hyphenated, lowercased form behind the scenes — no need to type hyphens yourself.",
      "default": "Electric Scooters, Batteries, Accessories"
    },
    {
      "type": "range",
      "id": "posts_limit",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 12,
      "label": "Articles per page"
    },
    {
      "type": "range",
      "id": "posts_columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns (desktop)"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "paragraph",
      "content": "Controls both the blog nav bar above and the article grid below, so they stay aligned."
    },
    {
      "type": "select",
      "id": "posts_section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "posts_custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.posts_section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "posts_section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Custom articles",
      "category": "Blog"
    }
  ]
}
{% endschema %}