{%- comment -%}
  sections/announcement-bar.liquid
  Thin wrapper around snippets/announcement-bar.liquid so the bar can
  live as its own entry in sections/header-group.json — independently
  reorderable/removable from main-header, instead of always being
  glued to the top of it.

  All rendering logic (including the "is there anything active to show"
  check, and loading announcement-bar.css/js) already lives in the
  snippet and is untouched here.
{%- endcomment -%}

{%- render 'announcement-bar', settings: section.settings -%}

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "div",
  "settings": [
    {
      "type": "checkbox",
      "id": "ann_enable",
      "label": "Enable announcement bar",
      "default": true
    },
    {
      "type": "select",
      "id": "ann_section_width",
      "label": "Announcement bar width",
      "options": [
        { "value": "", "label": "Full width" },
        { "value": "boxed", "label": "Boxed (matches header width)" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "ann_custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.ann_section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "ann_section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "ann_autorotate",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "ann_autorotate_speed",
      "label": "Rotation interval (seconds)",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "ann_enable_close",
      "label": "Allow customers to close the bar",
      "info": "Adds an X button. Once closed, it stays hidden for the rest of the browsing session (resets on a new session/tab).",
      "default": false
    },

    { "type": "header", "content": "Slide 1" },
    {
      "type": "select",
      "id": "ann_1_type",
      "label": "Slide 1 type",
      "options": [
        { "value": "", "label": "None (disabled)" },
        { "value": "announcement", "label": "Announcement" },
        { "value": "countdown", "label": "Countdown timer" }
      ],
      "default": "announcement"
    },
    {
      "type": "text",
      "id": "ann_1_text",
      "label": "Text",
      "default": "✌️ Free Express Shipping on orders $500!",
      "visible_if": "{{ section.settings.ann_1_type != '' }}"
    },
    {
      "type": "url",
      "id": "ann_1_link",
      "label": "Link (announcement only)",
      "visible_if": "{{ section.settings.ann_1_type == 'announcement' }}"
    },
    {
      "type": "select",
      "id": "ann_1_countdown_type",
      "label": "Countdown type",
      "options": [
        { "value": "fixed", "label": "Fixed date" },
        { "value": "evergreen", "label": "Evergreen (repeating)" }
      ],
      "default": "evergreen",
      "visible_if": "{{ section.settings.ann_1_type == 'countdown' }}"
    },
    {
      "type": "text",
      "id": "ann_1_end_date",
      "label": "End date (fixed) — format: YYYY/MM/DD HH:MM",
      "placeholder": "2025/12/31 23:59",
      "visible_if": "{{ section.settings.ann_1_type == 'countdown' }}"
    },
    {
      "type": "number",
      "id": "ann_1_evergreen_minutes",
      "label": "Evergreen duration (minutes)",
      "default": 720,
      "visible_if": "{{ section.settings.ann_1_type == 'countdown' }}"
    },
    {
      "type": "text",
      "id": "ann_1_button_label",
      "label": "Button label",
      "visible_if": "{{ section.settings.ann_1_type == 'countdown' }}"
    },
    {
      "type": "url",
      "id": "ann_1_button_link",
