{{ 'complementary-products.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_product = product
  if current_product == blank and section.settings.product != blank
    assign current_product = section.settings.product
  endif

  assign intent = section.settings.intent | default: 'complementary'
  assign max_products = section.settings.max_products | default: 4
  assign recommendation_limit = max_products | at_most: 10
  assign selection_mode = section.settings.selection_mode | default: 'checkbox'
  assign manual_products = section.blocks | where: 'type', 'product'
  assign use_manual = false
  if manual_products.size > 0
    assign use_manual = true
  endif

  assign heading_text = section.settings.heading
  if heading_text == blank
    if intent == 'related'
      assign heading_text = 'You might also like'
    else
      assign heading_text = 'Pairs well with'
    endif
  endif
-%}

{%- if current_product != blank -%}
<complementary-products-section
  id="complementary-products-{{ section.id }}"
  class="complementary-products{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  data-section-id="{{ section.id }}"
  data-selection-mode="{{ selection_mode }}"
  data-max-selected="{{ section.settings.max_selectable | default: 0 }}"
  {%- unless use_manual %}
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ current_product.id }}&limit={{ recommendation_limit }}&intent={{ intent }}"
  {%- endunless %}
  {%- if recommendations.performed? and recommendations.products_count == 0 and use_manual == false %}
  hidden
  {%- endif %}
>
  <div class="complementary-products__inner page-width">

    {%- comment -%}
      Heading defaults follow Shopify's UI guidance per intent:
      "You might also like" for related, "Pairs well with" for
      complementary — overridden if the merchant sets custom text.
    {%- endcomment -%}
    {%- if heading_text != blank -%}
      <h2 class="complementary-products__heading">{{ heading_text }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="complementary-products__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <complementary-products-form>
      <form data-complementary-form>
        <ul class="complementary-products__list" data-complementary-list role="list">

          {%- if use_manual -%}
            {%- comment -%} Manual override: renders immediately, no async fetch involved. {%- endcomment -%}
            {%- for block in manual_products limit: max_products -%}
              {%- assign card_product = block.settings.product -%}
              {%- if card_product != blank -%}
                {%- render 'complementary-product-card',
                  card_product: card_product,
                  selection_mode: selection_mode,
                  forloop_index: forloop.index0,
                  block: block
                -%}
              {%- endif -%}
            {%- endfor -%}

          {%- elsif recommendations.performed? -%}
            {%- comment -%}
              This branch only runs when this section file is re-rendered
              as the target of the /recommendations/products section-
              rendering request — the `recommendations` object is empty
              on a normal page load. See assets/complementary-products.js.
            {%- endcomment -%}
            {%- if recommendations.products_count > 0 -%}
              {%- for card_product in recommendations.products limit: max_products -%}
                {%- render 'complementary-product-card',
                  card_product: card_product,
                  selection_mode: selection_mode,
                  forloop_index: forloop.index0
                -%}
              {%- endfor -%}
            {%- endif -%}

          {%- else -%}
            {%- comment -%} Initial render, before the async fetch resolves. {%- endcomment -%}
            {%- for i in (1..max_products) -%}
              <li class="complementary-product-select complementary-product-select--placeholder" data-loading-placeholder aria-hidden="true"></li>
            {%- endfor -%}
          {%- endif -%}

        </ul>

        <div class="complementary-products__footer">
          <div class="complementary-products__summary">
            <span class="complementary-products__count" data-selected-count>0</span>
            <span>{{ section.settings.selected_label | default: 'selected' }}</span>
            <span class="complementary-products__total" data-selected-total></span>
          </div>
          <button
            type="submit"
            class="complementary-products__submit button"
            data-add-selected-button
            disabled
          >
            <span data-button-text>{{ section.settings.button_text | default: 'Add selected to cart' }}</span>
            <span class="complementary-products__spinner" data-loading-spinner hidden></span>
          </button>
        </div>

        <div class="complementary-products__error" data-form-error role="alert" hidden></div>
      </form>
    </complementary-products-form>

  </div>
</complementary-products-section>

<script src="{{ 'complementary-products.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        { "value": "complementary", "label": "Complementary — frequently bought together" },
        { "value": "related", "label": "Related — similar products" }
      ],
      "default": "complementary",
      "info": "Ignored when using Product override blocks below."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use Shopify's suggested heading for the recommendation type above."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product (defaults to current product on product pages)",
      "info": "Only needed if placing this section outside a product template."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products to show",
      "info": "The API returns up to 10, ranked by relevance. Shopify recommends 2-3 for complementary, up to 4 for related.",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "selection_mode",
      "label": "Selection mode",
      "options": [
        { "value": "checkbox", "label": "Multi-select (checkboxes)" },
        { "value": "radio", "label": "Single-select (radio buttons)" }
      ],
      "default": "checkbox"
    },
    {
      "type": "range",
      "id": "max_selectable",
      "label": "Max items a shopper can select at once",
      "info": "Set to 0 for no limit. Ignored in single-select mode.",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Add selected to cart"
    },
    {
      "type": "text",
      "id": "selected_label",
      "label": "Selected counter label",
      "default": "selected"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product override",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product recommendations",
      "blocks": []
    }
  ]
}
{% endschema %}
