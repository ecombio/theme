{%- comment -%}
  sections/product-information.liquid

  Rendered as one continuous vertical page instead of tabs/panels.
  A sticky jump-link bar scrolls down to each section. Each section is
  a collapsible <details>, open by default.

  UPDATE: Sections no longer use the shared sitewide .accordion /
  .accordion__item classes from accordion.css — that component is
  reserved for FAQ-style accordions (per accordion.css's own doc
  comment) and reusing it here caused class collisions when the FAQs
  section's own content (rendered via the 'specification' snippet)
  also builds FAQ accordions with those classes. Every section here
  now uses its own namespaced classes (product-information__item,
  __summary, __icon, __content), styled locally in
  product-information.css to look identical. accordion.css/js are
  still loaded because the FAQs section's inner content relies on
  them for its own Q&A accordion.

  UPDATE: Customer Reviews accordion item now respects the sitewide
  reviews_provider theme setting (falls back to Yotpo if unset), matching
  the same pattern used in snippets/star-rating.liquid.
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'product-information.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'product-information.css' | asset_url }}"></noscript>
<script src="{{ 'product-information.js' | asset_url }}" defer></script>
{{ 'accordion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'accordion.js' | asset_url }}" defer></script>

{%- liquid
  assign has_description = false
  if product.description != blank
    assign has_description = true
  endif

  assign tech_spec = product.metafields.custom.technical_specification.value

  assign has_specifications = false
  assign has_size_fit = false
  assign has_geometry = false
  assign has_faqs = false
  if tech_spec.specifications.value != blank
    assign has_specifications = true
  endif
  if tech_spec.size_fit.value != blank
    assign has_size_fit = true
  endif
  if tech_spec.geometry.value != blank
    assign has_geometry = true
  endif
  if tech_spec.faqs.value != blank
    assign has_faqs = true
  endif

  assign shipping_page = pages['shipping-policy']
  assign refund_page   = pages['refund-policy']
  assign warranty_page = pages['warranty']

  assign has_shipping = false
  assign has_refund   = false
  assign has_warranty = false
  if shipping_page.content != blank
    assign has_shipping = true
  endif
  if refund_page.content != blank
    assign has_refund = true
  endif
  if warranty_page.content != blank
    assign has_warranty = true
  endif

  assign policy = product.metafields.custom.product_policy.value

  assign has_custom_shipping = false
  assign has_custom_refund   = false
  assign has_custom_warranty = false
  if policy.shipping_policy.value != blank
    assign has_custom_shipping = true
  endif
  if policy.returns_refunds.value != blank
    assign has_custom_refund = true
  endif
  if policy.warranty_policy.value != blank
    assign has_custom_warranty = true
  endif

  assign show_shipping = false
  assign show_refund   = false
  assign show_warranty = false
  if has_custom_shipping or has_shipping or shop.shipping_policy.body != blank
    assign show_shipping = true
  endif
  if has_custom_refund or has_refund or shop.refund_policy.body != blank
    assign show_refund = true
  endif
  if has_custom_warranty or has_warranty
    assign show_warranty = true
  endif
-%}

<div
  {% render 'section-width', section: section, extra_class: 'product-information' %}
  id="ProductInformation-{{ section.id }}"
  data-product-information
>

  {%- comment -%} Sticky jump links {%- endcomment -%}
  <nav class="product-information__jumplinks" data-jumplinks aria-label="Jump to product information">
    <ul>
      {%- if has_description -%}
        <li><a href="#description-{{ section.id }}" data-jumplink="description-{{ section.id }}">Description</a></li>
      {%- endif -%}
      {%- if has_specifications -%}
        <li><a href="#specifications-{{ section.id }}" data-jumplink="specifications-{{ section.id }}">Specifications</a></li>
      {%- endif -%}
      {%- if has_size_fit -%}
        <li><a href="#size_fit-{{ section.id }}" data-jumplink="size_fit-{{ section.id }}">Size &amp; Fit</a></li>
      {%- endif -%}
      {%- if has_geometry -%}
        <li><a href="#geometry-{{ section.id }}" data-jumplink="geometry-{{ section.id }}">Geometry</a></li>
      {%- endif -%}
      {%- if has_faqs -%}
        <li><a href="#faqs-{{ section.id }}" data-jumplink="faqs-{{ section.id }}">FAQs</a></li>
      {%- endif -%}
      {%- if show_shipping -%}
        <li><a href="#shipping-{{ section.id }}" data-jumplink="shipping-{{ section.id }}">Shipping Policy</a></li>
      {%- endif -%}
      {%- if show_refund -%}
        <li><a href="#refund-{{ section.id }}" data-jumplink="refund-{{ section.id }}">Refund &amp; Return Policy</a></li>
      {%- endif -%}
      {%- if show_warranty -%}
        <li><a href="#warranty-{{ section.id }}" data-jumplink="warranty-{{ section.id }}">Warranty</a></li>
      {%- endif -%}
    </ul>
  </nav>

  {%- comment -%} Sections — each a collapsible <details>, open by default. Namespaced classes, NOT the shared .accordion component. {%- endcomment -%}
  <div class="product-information__sections" data-sections>

    {%- if has_description -%}
      <details class="product-information__item product-information__section" id="description-{{ section.id }}" data-section="description-{{ section.id }}" open>
        <summary class="product-information__summary">
          <h2 class="product-information__heading">Description</h2>
          <span class="product-information__icon"></span>
        </summary>
        <div class="product-information__content">
          {% render 'description', product: product %}
        </div>
      </details>
    {%- endif -%}

    {%- if has_specifications -%}
      <details class="product-information__item product-information__section" id="specifications-{{ section.id }}" data-section="specifications-{{ section.id }}" open>
        <summary class="product-information__summary">
          <h2 class="product-information__heading">Specifications</h2>
          <span class="product-information__icon"></span>
        </summary>
        <div class="product-information__content">
          {% render 'specification', field: tech_spec.specifications %}
        </div>
      </details>
    {%- endif -%}

    {%- if has_size_fit -%}
      <details class="product-information__item product-information__section" id="size_fit-{{ section.id }}" data-section="size_fit-{{ section.id }}" open>
        <summary class="product-information__summary">
          <h2 class="product-information__heading">Size &amp; Fit</h2>
          <span class="product-information__icon"></span>
        </summary>
        <div class="product-information__content">
          {% render 'specification', field: tech_spec.size_fit %}
        </div>
      </details>
    {%- endif -%}

    {%- if has_geometry -%}
      <details class="product-information__item product-information__section" id="geometry-{{ section.id }}" data-section="geometry-{{ section.id }}" open>
        <summary class="product-information__summary">
          <h2 class="product-information__heading">Geometry</h2>
          <span class="product-information__icon"></span>
        </summary>
        <div class="product-information__content">
          {% render 'specification', field: tech_spec.geometry %}
        </div>
      </details>
    {%- endif -%}

    {%- if has_faqs -%}
      <details class="product-information__item product-information__section" id="faqs-{{ section.id }}" data-section="faqs-{{ section.id }}" open>
        <summary class="product-information__summary">
          <h2 class="product-information__heading">FAQs</h2>
          <span class="product-information__icon"></span>
        </summary>
        <div class="product-information__content">
          {%- comment -%} The 'specification' snippet renders each Q&A here as its own .accordion / .accordion__item — that's the FAQ use case accordion.css is meant for. {%- endcomment -%}
          {% render 'specification', field: tech_spec.faqs %}
        </div>
      </details>
    {%- endif -%}

    {%- if show_shipping -%}
      <details class="product-information__item product-information__section" id="shipping-{{ section.id }}" data-section="shipping-{{ section.id }}" open>
        <summary class="product-information__summary">
          <h2 class="product-information__heading">Shipping Policy</h2>
          <span class="product-information__icon"></span>
        </summary>
        <div class="product-information__content">
          {%- if has_custom_shipping -%}
            {{ policy.shipping_policy | metafield_tag }}
          {%- elsif has_shipping -%}
            {{ shipping_page.content }}
          {%- else -%}
            {{ shop.shipping_policy.body }}
          {%- endif -%}
        </div>
      </details>
    {%- endif -%}

    {%- if show_refund -%}
      <details class="product-information__item product-information__section" id="refund-{{ section.id }}" data-section="refund-{{ section.id }}" open>
        <summary class="product-information__summary">
          <h2 class="product-information__heading">Refund &amp; Return Policy</h2>
          <span class="product-information__icon"></span>
        </summary>
        <div class="product-information__content">
          {%- if has_custom_refund -%}
            {{ policy.returns_refunds | metafield_tag }}
          {%- elsif has_refund -%}
            {{ refund_page.content }}
          {%- else -%}
            {{ shop.refund_policy.body }}
          {%- endif -%}
        </div>
      </details>
    {%- endif -%}

    {%- if show_warranty -%}
      <details class="product-information__item product-information__section" id="warranty-{{ section.id }}" data-section="warranty-{{ section.id }}" open>
        <summary class="product-information__summary">
          <h2 class="product-information__heading">Warranty</h2>
          <span class="product-information__icon"></span>
        </summary>
        <div class="product-information__content">
          {%- if has_custom_warranty -%}
            {{ policy.warranty_policy | metafield_tag }}
          {%- elsif has_warranty -%}
            {{ warranty_page.content }}
          {%- else -%}
            <p>Please contact us for warranty information.</p>
          {%- endif -%}
        </div>
      </details>
    {%- endif -%}

  </div>

</div>

{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Product information"
    }
  ]
}
{% endschema %}