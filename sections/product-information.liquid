{%- comment -%}
  sections/product-information.liquid

  UPDATE: Technical Specification metaobject fields (Specifications,
  Size & Fit, Geometry, FAQs) are now individual top-level tabs,
  each rendering its own Page reference's content — no longer a
  nested accordion under a single "Specifications" tab.
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'product-information.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'product-information.css' | asset_url }}"></noscript>
<script src="{{ 'product-information.js' | asset_url }}" defer></script>

{%- liquid
  assign has_description = false
  if product.description != blank
    assign has_description = true
  endif

  assign tech_spec = product.metafields.custom.technical_specification.value

  assign has_specifications = false
  assign has_size_fit = false
  assign has_geometry = false
  assign has_faqs = false
  if tech_spec.specifications.value != blank
    assign has_specifications = true
  endif
  if tech_spec.size_fit.value != blank
    assign has_size_fit = true
  endif
  if tech_spec.geometry.value != blank
    assign has_geometry = true
  endif
  if tech_spec.faqs.value != blank
    assign has_faqs = true
  endif

  assign shipping_page = pages['shipping-policy']
  assign refund_page   = pages['refund-policy']
  assign warranty_page = pages['warranty']

  assign has_shipping = false
  assign has_refund   = false
  assign has_warranty = false
  if shipping_page.content != blank
    assign has_shipping = true
  endif
  if refund_page.content != blank
    assign has_refund = true
  endif
  if warranty_page.content != blank
    assign has_warranty = true
  endif

  assign policy = product.metafields.custom.product_policy.value

  assign has_custom_shipping = false
  assign has_custom_refund   = false
  assign has_custom_warranty = false
  if policy.shipping_policy.value != blank
    assign has_custom_shipping = true
  endif
  if policy.returns_refunds.value != blank
    assign has_custom_refund = true
  endif
  if policy.warranty_policy.value != blank
    assign has_custom_warranty = true
  endif

  assign show_shipping = false
  assign show_refund   = false
  assign show_warranty = false
  if has_custom_shipping or has_shipping or shop.shipping_policy.body != blank
    assign show_shipping = true
  endif
  if has_custom_refund or has_refund or shop.refund_policy.body != blank
    assign show_refund = true
  endif
  if has_custom_warranty or has_warranty
    assign show_warranty = true
  endif

  assign active_tab = 'reviews'
  if has_description
    assign active_tab = 'description'
  elsif has_specifications
    assign active_tab = 'specifications'
  elsif has_size_fit
    assign active_tab = 'size_fit'
  elsif has_geometry
    assign active_tab = 'geometry'
  elsif has_faqs
    assign active_tab = 'faqs'
  elsif show_shipping
    assign active_tab = 'shipping'
  elsif show_refund
    assign active_tab = 'refund'
  elsif show_warranty
    assign active_tab = 'warranty'
  endif

  assign description_selected    = false
  assign specifications_selected = false
  assign size_fit_selected       = false
  assign geometry_selected       = false
  assign faqs_selected           = false
  assign shipping_selected       = false
  assign refund_selected         = false
  assign warranty_selected       = false
  assign reviews_selected        = false

  case active_tab
    when 'description'
      assign description_selected = true
    when 'specifications'
      assign specifications_selected = true
    when 'size_fit'
      assign size_fit_selected = true
    when 'geometry'
      assign geometry_selected = true
    when 'faqs'
      assign faqs_selected = true
    when 'shipping'
      assign shipping_selected = true
    when 'refund'
      assign refund_selected = true
    when 'warranty'
      assign warranty_selected = true
    when 'reviews'
      assign reviews_selected = true
  endcase
-%}

{%- if has_description -%}
  <span id="description" class="product-information__anchor" aria-hidden="true"></span>
{%- endif -%}
{%- if has_specifications -%}
  <span id="specifications" class="product-information__anchor" aria-hidden="true"></span>
{%- endif -%}
{%- if has_size_fit -%}
  <span id="size_fit" class="product-information__anchor" aria-hidden="true"></span>
{%- endif -%}
{%- if has_geometry -%}
  <span id="geometry" class="product-information__anchor" aria-hidden="true"></span>
{%- endif -%}
{%- if has_faqs -%}
  <span id="faqs" class="product-information__anchor" aria-hidden="true"></span>
{%- endif -%}
{%- if show_shipping -%}
  <span id="shipping" class="product-information__anchor" aria-hidden="true"></span>
{%- endif -%}
{%- if show_refund -%}
  <span id="refund" class="product-information__anchor" aria-hidden="true"></span>
{%- endif -%}
{%- if show_warranty -%}
  <span id="warranty" class="product-information__anchor" aria-hidden="true"></span>
{%- endif -%}
<span id="reviews" class="product-information__anchor" aria-hidden="true"></span>

<div
  {% render 'section-width', section: section, extra_class: 'product-information' %}
  id="ProductInformation-{{ section.id }}"
  data-product-information
>

  <div class="product-information__nav" role="tablist" aria-label="Product information">

    {%- if has_description -%}
      <a
        href="#description"
        class="product-information__tab{% if active_tab == 'description' %} is-active{% endif %}"
        id="tab-description-{{ section.id }}"
        role="tab"
        aria-selected="{{ description_selected }}"
        aria-controls="panel-description-{{ section.id }}"
        data-tab-target="description"
      >
        Description
      </a>
    {%- endif -%}

    {%- if has_specifications -%}
      <a
        href="#specifications"
        class="product-information__tab{% if active_tab == 'specifications' %} is-active{% endif %}"
        id="tab-specifications-{{ section.id }}"
        role="tab"
        aria-selected="{{ specifications_selected }}"
        aria-controls="panel-specifications-{{ section.id }}"
        data-tab-target="specifications"
      >
        Specifications
      </a>
    {%- endif -%}

    {%- if has_size_fit -%}
      <a
        href="#size_fit"
        class="product-information__tab{% if active_tab == 'size_fit' %} is-active{% endif %}"
        id="tab-size_fit-{{ section.id }}"
        role="tab"
        aria-selected="{{ size_fit_selected }}"
        aria-controls="panel-size_fit-{{ section.id }}"
        data-tab-target="size_fit"
      >
        Size &amp; Fit
      </a>
    {%- endif -%}

    {%- if has_geometry -%}
      <a
        href="#geometry"
        class="product-information__tab{% if active_tab == 'geometry' %} is-active{% endif %}"
        id="tab-geometry-{{ section.id }}"
        role="tab"
        aria-selected="{{ geometry_selected }}"
        aria-controls="panel-geometry-{{ section.id }}"
        data-tab-target="geometry"
      >
        Geometry
      </a>
    {%- endif -%}

    {%- if has_faqs -%}
      <a
        href="#faqs"
        class="product-information__tab{% if active_tab == 'faqs' %} is-active{% endif %}"
        id="tab-faqs-{{ section.id }}"
        role="tab"
        aria-selected="{{ faqs_selected }}"
        aria-controls="panel-faqs-{{ section.id }}"
        data-tab-target="faqs"
      >
        FAQs
      </a>
    {%- endif -%}

    {%- if show_shipping -%}
      <a
        href="#shipping"
        class="product-information__tab{% if active_tab == 'shipping' %} is-active{% endif %}"
        id="tab-shipping-{{ section.id }}"
        role="tab"
        aria-selected="{{ shipping_selected }}"
        aria-controls="panel-shipping-{{ section.id }}"
        data-tab-target="shipping"
      >
        Shipping Policy
      </a>
    {%- endif -%}

    {%- if show_refund -%}
      <a
        href="#refund"
        class="product-information__tab{% if active_tab == 'refund' %} is-active{% endif %}"
        id="tab-refund-{{ section.id }}"
        role="tab"
        aria-selected="{{ refund_selected }}"
        aria-controls="panel-refund-{{ section.id }}"
        data-tab-target="refund"
      >
        Refund &amp; Return Policy
      </a>
    {%- endif -%}

    {%- if show_warranty -%}
      <a
        href="#warranty"
        class="product-information__tab{% if active_tab == 'warranty' %} is-active{% endif %}"
        id="tab-warranty-{{ section.id }}"
        role="tab"
        aria-selected="{{ warranty_selected }}"
        aria-controls="panel-warranty-{{ section.id }}"
        data-tab-target="warranty"
      >
        Warranty
      </a>
    {%- endif -%}

    <a
      href="#reviews"
      class="product-information__tab{% if active_tab == 'reviews' %} is-active{% endif %}"
      id="tab-reviews-{{ section.id }}"
      role="tab"
      aria-selected="{{ reviews_selected }}"
      aria-controls="panel-reviews-{{ section.id }}"
      data-tab-target="reviews"
    >
      Customer Reviews
    </a>

  </div>

  <div class="product-information__panels">

    {%- if has_description -%}
      <div
        class="product-information__panel"
        id="panel-description-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="tab-description-{{ section.id }}"
        data-tab-panel="description"
        {% unless active_tab == 'description' %}hidden{% endunless %}
      >
        {% render 'description', product: product %}
      </div>
    {%- endif -%}

    {%- if has_specifications -%}
      <div
        class="product-information__panel"
        id="panel-specifications-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="tab-specifications-{{ section.id }}"
        data-tab-panel="specifications"
        {% unless active_tab == 'specifications' %}hidden{% endunless %}
      >
        {% render 'specification', field: tech_spec.specifications %}
      </div>
    {%- endif -%}

    {%- if has_size_fit -%}
      <div
        class="product-information__panel"
        id="panel-size_fit-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="tab-size_fit-{{ section.id }}"
        data-tab-panel="size_fit"
        {% unless active_tab == 'size_fit' %}hidden{% endunless %}
      >
        {% render 'specification', field: tech_spec.size_fit %}
      </div>
    {%- endif -%}

    {%- if has_geometry -%}
      <div
        class="product-information__panel"
        id="panel-geometry-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="tab-geometry-{{ section.id }}"
        data-tab-panel="geometry"
        {% unless active_tab == 'geometry' %}hidden{% endunless %}
      >
        {% render 'specification', field: tech_spec.geometry %}
      </div>
    {%- endif -%}

    {%- if has_faqs -%}
      <div
        class="product-information__panel"
        id="panel-faqs-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="tab-faqs-{{ section.id }}"
        data-tab-panel="faqs"
        {% unless active_tab == 'faqs' %}hidden{% endunless %}
      >
        {% render 'specification', field: tech_spec.faqs %}
      </div>
    {%- endif -%}

    {%- if show_shipping -%}
      <div
        class="product-information__panel"
        id="panel-shipping-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="tab-shipping-{{ section.id }}"
        data-tab-panel="shipping"
        {% unless active_tab == 'shipping' %}hidden{% endunless %}
      >
        {%- if has_custom_shipping -%}
          {{ policy.shipping_policy | metafield_tag }}
        {%- elsif has_shipping -%}
          {{ shipping_page.content }}
        {%- else -%}
          {{ shop.shipping_policy.body }}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_refund -%}
      <div
        class="product-information__panel"
        id="panel-refund-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="tab-refund-{{ section.id }}"
        data-tab-panel="refund"
        {% unless active_tab == 'refund' %}hidden{% endunless %}
      >
        {%- if has_custom_refund -%}
          {{ policy.returns_refunds | metafield_tag }}
        {%- elsif has_refund -%}
          {{ refund_page.content }}
        {%- else -%}
          {{ shop.refund_policy.body }}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_warranty -%}
      <div
        class="product-information__panel"
        id="panel-warranty-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="tab-warranty-{{ section.id }}"
        data-tab-panel="warranty"
        {% unless active_tab == 'warranty' %}hidden{% endunless %}
      >
        {%- if has_custom_warranty -%}
          {{ policy.warranty_policy | metafield_tag }}
        {%- elsif has_warranty -%}
          {{ warranty_page.content }}
        {%- else -%}
          <p>Please contact us for warranty information.</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="product-information__panel"
      id="panel-reviews-{{ section.id }}"
      role="tabpanel"
      aria-labelledby="tab-reviews-{{ section.id }}"
      data-tab-panel="reviews"
      {% unless active_tab == 'reviews' %}hidden{% endunless %}
    >
      {%- render 'yotpo-widgets', widget_type: 'yotpo_review_widget', product: product -%}
    </div>

  </div>

</div>

{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Product information"
    }
  ]
}
{% endschema %}