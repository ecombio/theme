{%- comment -%}
  sections/feature-highlights.liquid
  ============================================
  Image-only carousel for feature callouts: image (with any label
  baked into the uploaded image itself), heading, and short
  description below each slot. No video, no lightbox — fully
  independent of the video-section/video-card/video-modal files.

  Files involved:
    - assets/feature-highlights.css → carousel shell + card visuals
    - assets/feature-highlights.js  → carousel arrow/scroll behavior only
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'feature-highlights.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>
  <link rel="stylesheet" href="{{ 'feature-highlights.css' | asset_url }}">
</noscript>
<script src="{{ 'feature-highlights.js' | asset_url }}" defer></script>

<div
  {% render 'section-width', section: section, extra_class: 'feature-highlights' %}
  id="FeatureHighlights-{{ section.id }}"
  data-feature-highlights
>

  {%- if section.settings.heading != blank -%}
    <div class="feature-highlights__header">
      <h2 class="feature-highlights__heading">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="feature-highlights__carousel" data-feature-carousel>

      <button
        type="button"
        class="feature-highlights__arrow feature-highlights__arrow--prev"
        data-feature-prev
        aria-label="Previous features"
        aria-controls="FeatureTrack-{{ section.id }}"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div
        class="feature-highlights__track"
        id="FeatureTrack-{{ section.id }}"
        data-feature-track
        role="list"
      >
        {%- for block in section.blocks -%}
          <div
            class="feature-highlights__item"
            id="Feature-{{ block.id }}"
            data-feature-item
            role="listitem"
            {{ block.shopify_attributes }}
          >
            <div class="feature-highlights__frame">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    class: 'feature-highlights__image',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 80vw',
                    widths: '400,600,800,1000'
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'feature-highlights__image feature-highlights__image--placeholder' }}
              {%- endif -%}
            </div>

            {%- if block.settings.heading != blank -%}
              <h3 class="feature-highlights__item-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="feature-highlights__item-description">{{ block.settings.description }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <button
        type="button"
        class="feature-highlights__arrow feature-highlights__arrow--next"
        data-feature-next
        aria-label="Next features"
        aria-controls="FeatureTrack-{{ section.id }}"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Feature Highlights",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Technical Specifications"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Any label/text shown on the image should be baked into the uploaded image itself."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Highlights",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
