{%- comment -%}
  sections/related-products.liquid

  Collection-based related products carousel.
  Data source: collection.metafields.custom.related_products.value
  (list.product_reference metafield on Collection).

  Card markup/behavior is fully owned by snippets/product-card.liquid —
  this section only supplies the carousel shell + layout, and passes
  through show_quickview / show_compare / show_eta as section settings
  so merchants can toggle those features per-instance without touching
  the snippet.

  Asset ownership: both product-card.js AND product-card.css are
  loaded globally via theme.liquid. Do NOT add a stylesheet_tag for
  product-card.css here — a previous version of this section loaded
  it a second time locally, which was redundant with the global load.
  If product-card.css is ever changed back to a section-scoped asset,
  reinstate an explicit load here (following the pattern
  collection-products.liquid uses) — but check theme.liquid first.

  SECTION LAYOUT — uses the SHARED global width classes from base.css
  (.shopify-section > .default-width / .full-width / .custom-width),
  same pattern as sections/example-width-section.liquid. Do NOT
  reintroduce section-scoped width/padding CSS here (an earlier
  version duplicated those rules under related-products__* with a
  different default max-width and incorrectly padded full-width,
  which drifted out of sync with the shared rules).
    - Inner div: class="section" with
      style="padding-block: var(--section-spacing);" controls
      vertical spacing above/below the section content (heading +
      carousel), exactly like the reference example.
      --section-spacing is the theme's existing global vertical-rhythm
      variable; this section does not override or fight it.
    - Previous version of this file was missing that inner ".section"
      wrapper entirely, which is what caused the visible whitespace gap
      between heading and cards — vertical spacing had nowhere correct
      to come from, so it was patched after the fact with !important
      margin resets. That patch has been removed; this version follows
      the reference structure directly instead of overriding it.
{%- endcomment -%}

{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'default-width'
  else
    assign width_class = width_type
  endif

  assign products = collection.metafields.custom.related_products.value
  assign show_quickview = section.settings.show_quickview
  assign show_compare = section.settings.show_compare
  assign show_eta = section.settings.show_eta
-%}

{% if products != blank %}
  <div
    class="{{ width_class }}"
    id="related-products-{{ section.id }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >
    <div class="section" style="padding-block: var(--section-spacing);">
      {% if section.settings.heading != blank %}
        <h2 class="related-products__title">{{ section.settings.heading }}</h2>
      {% endif %}

      <div class="related-products" data-related-products data-section-id="{{ section.id }}">
        <div class="related-products__track" data-related-products-track tabindex="0">
          {% for product in products %}
            <div class="related-products__slide">
              {% render 'product-card',
                product: product,
                show_quickview: show_quickview,
                show_compare: show_compare,
                show_eta: show_eta
              %}
            </div>
          {% endfor %}
        </div>

        <button
          type="button"
          class="related-products__button related-products__button--prev"
          aria-label="Previous products"
          data-related-products-prev
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>

        <button
          type="button"
          class="related-products__button related-products__button--next"
          aria-label="Next products"
          data-related-products-next
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18l6-6-6-6" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <style>
    #related-products-{{ section.id }} {
      --card-gap: 16px;
      --card-width: 240px;
    }

    #related-products-{{ section.id }} .related-products__title {
      margin: 0 0 1.5rem;
      font-size: 2rem;
      line-height: 1.2;
    }

    #related-products-{{ section.id }} .related-products {
      position: relative;
    }

    #related-products-{{ section.id }} .related-products__track {
      display: flex;
      gap: var(--card-gap);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 4px;
      scrollbar-width: none;
    }
    #related-products-{{ section.id }} .related-products__track::-webkit-scrollbar {
      display: none;
    }

    #related-products-{{ section.id }} .related-products__slide {
      flex: 0 0 var(--card-width);
      scroll-snap-align: start;
    }

    #related-products-{{ section.id }} .related-products__button {
      position: absolute;
      top: 40%;
      transform: translateY(-50%);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid rgba(0,0,0,0.15);
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 2;
    }
    #related-products-{{ section.id }} .related-products__button svg {
      width: 18px;
      height: 18px;
    }
    #related-products-{{ section.id }} .related-products__button--prev { left: -8px; }
    #related-products-{{ section.id }} .related-products__button--next { right: -8px; }

    #related-products-{{ section.id }} .related-products__button:disabled {
      opacity: 0.3;
      cursor: default;
    }

    @media (max-width: 749px) {
      #related-products-{{ section.id }} .related-products__button { display: none; }
    }
  </style>

  <script>
    (function () {
      var root = document.querySelector('[data-related-products][data-section-id="{{ section.id }}"]');
      if (!root) return;

      var track = root.querySelector('[data-related-products-track]');
      var prevBtn = root.querySelector('[data-related-products-prev]');
      var nextBtn = root.querySelector('[data-related-products-next]');

      function scrollByCard(direction) {
        var card = track.querySelector('.related-products__slide');
        if (!card) return;
        var gap = parseFloat(getComputedStyle(root).getPropertyValue('--card-gap')) || 16;
        var distance = card.getBoundingClientRect().width + gap;
        track.scrollBy({ left: direction * distance, behavior: 'smooth' });
      }

      function updateButtons() {
        var maxScroll = track.scrollWidth - track.clientWidth - 1;
        prevBtn.disabled = track.scrollLeft <= 0;
        nextBtn.disabled = track.scrollLeft >= maxScroll;
      }

      prevBtn.addEventListener('click', function () { scrollByCard(-1); });
      nextBtn.addEventListener('click', function () { scrollByCard(1); });
      track.addEventListener('scroll', updateButtons, { passive: true });
      window.addEventListener('resize', updateButtons);

      // Re-sync wishlist/compare state on cards rendered into this
      // dynamically-scrollable track (product-card.js listens for this).
      document.dispatchEvent(new CustomEvent('productcard:injected'));

      updateButtons();
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Products"
    },
    {
      "type": "header",
      "content": "Product card features"
    },
    {
      "type": "checkbox",
      "id": "show_quickview",
      "label": "Show quick view",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show compare",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_eta",
      "label": "Show delivery estimate",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}