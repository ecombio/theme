{%- comment -%}
  sections/related-products.liquid

  Related products grid. Capped to 4 products max, laid out as a
  responsive grid — NOT a scrolling carousel. Breakpoints mirror
  .product-feed__grid in assets/main-collection.css (4 cols desktop
  → 3 tablet → 2 mobile → 1 small mobile), capped at a maximum of
  4 columns since there are never more than 4 cards.

  Data source: collection.metafields.custom.related_products.value
  (list.product_reference metafield on Collection).

  Card markup/behavior is fully owned by snippets/product-card.liquid —
  this section only supplies the grid shell + layout, and passes
  through show_quickview / show_compare / show_eta as section settings
  so merchants can toggle those features per-instance without touching
  the snippet.

  Asset ownership: both product-card.js AND product-card.css are
  loaded globally via theme.liquid. Do NOT add a stylesheet_tag for
  product-card.css here.

  SECTION LAYOUT — two-tier width system matching
  assets/main-collection.css's .collection-page:
    - padding-inline is ALWAYS applied via --section-padding
    - default/custom-width additionally cap max-width
    - full-width only relaxes max-width to none; it does NOT remove
      padding (this section nests inside the two-column collection
      layout, so true edge-to-edge bleed would collide with the
      sidebar/gutter — see main-collection.css comments).
{%- endcomment -%}

{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_modifier = 'related-products__default-width'
  elsif width_type == 'full-width'
    assign width_modifier = 'related-products__full-width'
  else
    assign width_modifier = 'related-products__custom-width'
  endif

  assign products = collection.metafields.custom.related_products.value | slice: 0, 4
  assign show_quickview = section.settings.show_quickview
  assign show_compare = section.settings.show_compare
  assign show_eta = section.settings.show_eta
-%}

{% if products != blank %}
  <div
    class="related-products__page {{ width_modifier }}"
    id="related-products-{{ section.id }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >
    <div class="section" style="padding-block: var(--section-spacing);">
      {% if section.settings.heading != blank %}
        <h2 class="related-products__title">{{ section.settings.heading }}</h2>
      {% endif %}

      <div class="related-products">
        {% for product in products %}
          <div class="related-products__item">
            {% render 'product-card',
              product: product,
              show_quickview: show_quickview,
              show_compare: show_compare,
              show_eta: show_eta
            %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <style>
    #related-products-{{ section.id }}.related-products__page {
      margin-inline: auto;
      padding-inline: var(--section-padding, 24px);
    }
    #related-products-{{ section.id }}.related-products__default-width { max-width: 1184px; }
    #related-products-{{ section.id }}.related-products__full-width    { max-width: none; }
    #related-products-{{ section.id }}.related-products__custom-width  { max-width: var(--custom-width, 80rem); }

    #related-products-{{ section.id }} .related-products__title {
      margin: 0 0 1.5rem;
      font-size: 2rem;
      line-height: 1.2;
    }

    /* ---------- Responsive grid — mirrors .product-feed__grid in
       main-collection.css, capped at 4 since there are never more
       than 4 cards here. ---------- */
    #related-products-{{ section.id }} .related-products {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }

    @media (max-width: 1024px) {
      #related-products-{{ section.id }} .related-products {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (max-width: 768px) {
      #related-products-{{ section.id }} .related-products {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }
    }

    @media (max-width: 480px) {
      #related-products-{{ section.id }} .related-products {
        grid-template-columns: repeat(1, 1fr);
        gap: 0.75rem;
      }
    }
  </style>

  <script>
    // Re-sync wishlist/compare state on cards rendered into this
    // section (product-card.js listens for this on injected cards).
    document.dispatchEvent(new CustomEvent('productcard:injected'));
  </script>
{% endif %}

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Products"
    },
    {
      "type": "header",
      "content": "Product card features"
    },
    {
      "type": "checkbox",
      "id": "show_quickview",
      "label": "Show quick view",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show compare",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_eta",
      "label": "Show delivery estimate",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}