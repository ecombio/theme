{%- comment -%}
  Blog Category / Tag Feed
  - Place this section on your Blog template (templates/blog.json).
  - Shopify natively filters `blog.articles` by tag when the URL is
    /blogs/{blog-handle}/tagged/{tag-handle} (your electric-scooters example),
    so no custom filtering logic is required: this section just needs to
    render whatever `blog.articles` currently is, plus a tag nav to move
    between categories.
  - Card markup/styling lives in snippets/article-card.liquid and
    assets/article-card.css — this section only owns layout (grid,
    tag nav, heading, pagination).
{%- endcomment -%}

{{ 'article-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_tag = current_tags.first
  assign per_page = section.settings.articles_per_page
  assign eager_count = section.settings.columns_desktop
-%}

<div class="cat-feed" id="cat-feed-{{ section.id }}">
  <div class="cat-feed__container page-width">

    {%- if section.settings.heading != blank -%}
      <div class="cat-feed__header">
        <h2 class="cat-feed__heading">
          {%- if current_tag -%}
            {{ section.settings.heading }}: <span class="cat-feed__heading-tag">{{ current_tag }}</span>
          {%- else -%}
            {{ section.settings.heading }}
          {%- endif -%}
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p class="cat-feed__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_tag_nav and blog.all_tags.size > 0 -%}
      <nav class="cat-feed__tags-nav" aria-label="Filter articles by category">
        <a
          href="{{ blog.url }}"
          class="cat-feed__tag-pill{% unless current_tag %} cat-feed__tag-pill--active{% endunless %}"
        >
          All
        </a>
        {%- for tag in blog.all_tags -%}
          <a
            href="{{ blog.url }}/tagged/{{ tag | handle }}"
            class="cat-feed__tag-pill{% if current_tag == tag %} cat-feed__tag-pill--active{% endif %}"
          >
            {{ tag }}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- paginate blog.articles by per_page -%}
      {%- if blog.articles.size > 0 -%}
        <div
          class="cat-feed__grid"
          style="--cat-feed-columns: {{ section.settings.columns_desktop }};"
        >
          {%- for article in blog.articles -%}
            {%- liquid
              if forloop.index0 < eager_count and paginate.current_page == 1
                assign card_loading = 'eager'
              else
                assign card_loading = 'lazy'
              endif
            -%}
            {%- render 'article-cards', article: article, loading: card_loading -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="cat-feed__pagination">
            {%- render 'paginations', paginate: paginate -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="cat-feed__empty">
          <p>
            {%- if current_tag -%}
              No articles found tagged “{{ current_tag }}” yet.
            {%- else -%}
              No articles have been published yet.
            {%- endif -%}
          </p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</div>

<style>
  #cat-feed-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #cat-feed-{{ section.id }} .cat-feed__header {
    text-align: center;
    margin-bottom: 2rem;
  }

  #cat-feed-{{ section.id }} .cat-feed__heading {
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }

  #cat-feed-{{ section.id }} .cat-feed__heading-tag {
    text-transform: capitalize;
    color: var(--color-accent, #d97706);
  }

  #cat-feed-{{ section.id }} .cat-feed__subheading {
    color: rgba(0, 0, 0, 0.6);
    margin: 0;
  }

  #cat-feed-{{ section.id }} .cat-feed__tags-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  #cat-feed-{{ section.id }} .cat-feed__tag-pill {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    font-size: 0.85rem;
    text-decoration: none;
    color: inherit;
    text-transform: capitalize;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  #cat-feed-{{ section.id }} .cat-feed__tag-pill:hover {
    border-color: rgba(0, 0, 0, 0.35);
  }

  #cat-feed-{{ section.id }} .cat-feed__tag-pill--active {
    background-color: #111;
    border-color: #111;
    color: #fff;
  }

  #cat-feed-{{ section.id }} .cat-feed__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
  }

  @media screen and (min-width: 750px) {
    #cat-feed-{{ section.id }} .cat-feed__grid {
      grid-template-columns: repeat(var(--cat-feed-columns, 3), 1fr);
    }
  }

  #cat-feed-{{ section.id }} .cat-feed__pagination {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
  }

  #cat-feed-{{ section.id }} .cat-feed__empty {
    text-align: center;
    padding: 3rem 1rem;
    color: rgba(0, 0, 0, 0.6);
  }
</style>

{% schema %}
{
  "name": "Blog category feed",
  "tag": "section",
  "class": "section-blog-category-feed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the blog"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Guides, reviews and news"
    },
    {
      "type": "checkbox",
      "id": "show_tag_nav",
      "label": "Show category (tag) navigation",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Blog category feed"
    }
  ]
}
{% endschema %}
