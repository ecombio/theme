{{ 'product-bundle.css' | asset_url | stylesheet_tag }}

<div class="product-bundle__grid">
  {%- for item in product.metafields.custom.product_bundles.value -%}
    {%- render 'product-card', product: item -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Product bundle",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Product bundle"
    }
  ]
}
{% endschema %}