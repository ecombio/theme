{% comment %}
  Header Menu Bar
  File: snippets/header-menu.liquid

  Renders the desktop nav bar (.menu-bar), built from this section's
  blocks (single-link, link-list, mega-menu, menu-item, highlight,
  flyout, @app).
  Hidden below 1024px via CSS — mobile/tablet use the separate drawer
  in snippets/header-hamburger.liquid instead.

  Loads its own CSS (header-menu.css) plus the CSS/JS for each block
  type that can appear in this bar, but only when that block type is
  actually present in section.blocks — so a store with no mega-menu
  or menu-item block never pays for that CSS/JS.

  mega-menu.js is shared by both mega-menu and menu-item blocks: both
  use the same data-mega-menu / data-mega-menu-trigger / data-mega-
  menu-panel attributes, so one script drives open/close and panel
  positioning for either block type. It's loaded if either is present.

  Also loads header-menu.js, which toggles .has-scroll-left /
  .has-scroll-right on the <nav> based on scroll position, so
  header-menu.css can fade the .menu-bar__edge-fade overlays in/out
  (the left/right "shadow" effect on a horizontally-scrollable menu bar
  when there are more links than fit in the available width).

  Params:
    blocks — section.blocks from sections/main-header.liquid
{% endcomment %}

{{ 'header-menu.css' | asset_url | stylesheet_tag }}
{{ 'highlight.css'   | asset_url | stylesheet_tag }}

{%- liquid
  assign has_mega_menu = false
  assign has_menu_item = false
  for block in blocks
    if block.type == 'mega-menu'
      assign has_mega_menu = true
    endif
    if block.type == 'menu-item'
      assign has_menu_item = true
    endif
  endfor

  assign needs_mega_menu_js = false
  if has_mega_menu or has_menu_item
    assign needs_mega_menu_js = true
  endif
-%}

{%- if has_mega_menu -%}
  {{ 'mega-menu.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if has_menu_item -%}
  {{ 'menu-item.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if blocks.size > 0 -%}
  <nav class="menu-bar" id="main-header-menu-bar" aria-label="Primary navigation">
    <div class="menu-bar__edge-fade menu-bar__edge-fade--left" aria-hidden="true"></div>
    <div class="menu-bar__edge-fade menu-bar__edge-fade--right" aria-hidden="true"></div>

    <div class="menu-bar__container page-width--header">
      <ul class="menu-bar__list">
        {%- for block in blocks -%}
          {%- case block.type -%}
            {%- when 'single-link' -%}
              {%- render 'single-link', block: block -%}

            {%- when 'highlight' -%}
              {%- render 'highlight', block: block -%}

            {%- when 'mega-menu' -%}
              {%- render 'mega-menu', block: block -%}

            {%- when 'menu-item' -%}
              {%- render 'menu-item', block: block -%}

          {%- endcase -%}
        {%- endfor -%}
      </ul>
    </div>
  </nav>

  <script src="{{ 'header-menu.js' | asset_url }}" defer></script>
  {%- if needs_mega_menu_js -%}
    <script src="{{ 'mega-menu.js' | asset_url }}" defer></script>
  {%- endif -%}
{%- endif -%}