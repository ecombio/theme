{%- comment -%} sections/main-collection.liquid {%- endcomment -%}
{{ 'main-collection.css' | asset_url | stylesheet_tag }}

{%- comment -%} Section width/padding applies to the whole section (hero, feed, and after-items) via the outer collection-page wrapper below. {%- endcomment -%}

{%- liquid
  assign active_tab = request.query_parameters['tab'] | default: 'products'
  unless active_tab == 'products' or active_tab == 'articles'
    assign active_tab = 'products'
  endunless

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'collection-page__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'collection-page__custom-width'
  else
    assign width_class = 'collection-page__custom-width'
  endif
-%}

<div class="main-collection" id="main-collection">

  <div
    class="collection-page {{ width_class }}"
    data-collection-page
    data-active-tab="{{ active_tab }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >

    <div class="collection-hero" id="collection-hero">
      <h1 class="collection-title">{{ collection.title }}</h1>

      {%- if collection.description != blank -%}
        <div class="collection-description rte">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>

    <section class="collection-section">

      <div class="collection-toolbar" id="collection-toolbar" role="navigation" aria-label="Collection navigation">

        {%- if section.settings.show_filters -%}
          <button
            class="collection-toolbar__filter-toggle"
            type="button"
            aria-expanded="true"
            aria-controls="collection-filter"
            aria-label="Toggle filters"
            data-filter-toggle
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 4h12M4 8h8M6 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Filters
          </button>
        {%- endif -%}

        <div class="tab-switcher" role="tablist" aria-label="Collection view">
          <button
            class="tab-switcher__tab{% if active_tab == 'products' %} tab-switcher__tab--active{% endif %}"
            role="tab"
            type="button"
            aria-selected="{% if active_tab == 'products' %}true{% else %}false{% endif %}"
            aria-controls="panel-products"
            id="tab-products"
            data-tab="products"
            tabindex="{% if active_tab == 'products' %}0{% else %}-1{% endif %}"
          >{{ section.settings.tab_products_label | default: 'Products' }}</button>

          <button
            class="tab-switcher__tab{% if active_tab == 'articles' %} tab-switcher__tab--active{% endif %}"
            role="tab"
            type="button"
            aria-selected="{% if active_tab == 'articles' %}true{% else %}false{% endif %}"
            aria-controls="panel-articles"
            id="tab-articles"
            data-tab="articles"
            tabindex="{% if active_tab == 'articles' %}0{% else %}-1{% endif %}"
          >{{ section.settings.tab_articles_label | default: 'Articles' }}</button>
        </div>

      </div>

      {%- if section.settings.show_filters or section.settings.show_sort -%}
        <div class="collection-mobile-bar" aria-label="Collection controls" role="toolbar">

          {%- if section.settings.show_filters -%}
            <button
              class="collection-mobile-bar__btn"
              type="button"
              aria-expanded="false"
              aria-controls="collection-filter"
              aria-label="Toggle filters"
              data-filter-toggle
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 4h12M4 8h8M6 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              Filters
            </button>
          {%- endif -%}

          {%- if section.settings.show_sort -%}
            <button
              class="collection-mobile-bar__btn"
              type="button"
              aria-expanded="false"
              aria-label="Sort products"
              data-mobile-sort-toggle
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 4h8M2 8h6M2 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 3v10M9.5 10.5L12 13l2.5-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Sort
            </button>
          {%- endif -%}

        </div>
      {%- endif -%}

      <div class="collection-body">

        {%- if section.settings.show_filters -%}
          <aside
            class="collection-filter"
            id="collection-filter"
            aria-label="Product filters"
          >

            {%- if section.settings.show_sort -%}
              <div class="collection-filter__sort">
                <label for="SortBy">Sort</label>
                <select id="SortBy" data-sort>
                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.value }}"
                      {%- if option.value == collection.sort_by %} selected{%- endif %}
                    >{{ option.name }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}

            <form method="get" action="{{ collection.url }}" id="FilterForm">

              {%- for filter in collection.filters -%}
                <details
                  class="collection-filter__group"
                  open
                >
                  <summary class="collection-filter__group-label">
                    {{ filter.label }}
                    {%- if filter.active_values.size > 0 -%}
                      <span class="collection-filter__group-badge">{{ filter.active_values.size }}</span>
                    {%- endif -%}
                  </summary>

                  <div class="collection-filter__group-body">
                    {%- case filter.type -%}
                      {%- when 'list' -%}
                        {%- for value in filter.values -%}
                          <label class="collection-filter__option
                            {%- if value.active %} collection-filter__option--active{%- endif %}
                            {%- if value.count == 0 and value.active == false %} collection-filter__option--disabled{%- endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {%- if value.active %} checked{%- endif %}
                              {%- if value.count == 0 and value.active == false %} disabled{%- endif %}
                            >
                            {{ value.label }} <span>({{ value.count }})</span>
                          </label>
                        {%- endfor -%}

                      {%- when 'price_range' -%}
                        <div class="collection-filter__price">
                          <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            value="{{ filter.min_value.value | divided_by: 100.0 }}"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100.0 }}"
                            placeholder="0"
                          >
                          <span>–</span>
                          <input
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            value="{{ filter.max_value.value | divided_by: 100.0 }}"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100.0 }}"
                            placeholder="{{ filter.range_max | divided_by: 100.0 }}"
                          >
                        </div>
                    {%- endcase -%}
                  </div>
                </details>
              {%- endfor -%}

              {%- assign active_count = 0 -%}
              {%- for filter in collection.filters -%}
                {%- assign active_count = active_count | plus: filter.active_values.size -%}
              {%- endfor -%}

              {%- if active_count > 0 -%}
                <div class="collection-filter__active">
                  {%- for filter in collection.filters -%}
                    {%- for value in filter.active_values -%}
                      <a href="{{ value.url_to_remove }}" class="collection-filter__pill">
                        {{ value.label }} &times;
                      </a>
                    {%- endfor -%}
                  {%- endfor -%}
                  <a href="{{ collection.url }}" class="collection-filter__pill collection-filter__pill--clear">Clear all</a>
                </div>
              {%- endif -%}

              <button type="submit" class="collection-filter__submit">Apply</button>

            </form>

          </aside>
        {%- endif -%}

        <div class="collection-body__feed">

          <div class="collection-feed" id="collection-feed" data-collection-feed>

            <div
              id="panel-products"
              class="collection-feed__panel"
              role="tabpanel"
              aria-labelledby="tab-products"
              data-panel="products"
              {%- if active_tab != 'products' %} hidden{%- endif %}
            >
              {{ 'product-card.css' | asset_url | stylesheet_tag }}
              {{ 'sub-collection.css' | asset_url | stylesheet_tag }}
              {{ 'promo-banner.css' | asset_url | stylesheet_tag }}
              {{ 'promo-carousel.css' | asset_url | stylesheet_tag }}

              {%- liquid
                assign banner_blocks   = section.blocks | where: 'type', 'promo_banner'
                assign carousel_blocks = section.blocks | where: 'type', 'promo_carousel'
              -%}

              {%- paginate collection.products by section.settings.products_per_page -%}

                <div id="product-feed" class="product-feed" style="--columns: {{ section.settings.columns | default: 4 }};">

                  {%- render 'sub-collection', collection: collection -%}

                  <div class="product-feed__grid">

                    {%- for product in collection.products -%}

                      {%- for banner in banner_blocks -%}
                        {%- assign banner_position = banner.settings.position | default: 0 -%}
                        {%- if banner_position > 0 and banner_position == forloop.parentloop.index -%}
                          {%- render 'promo-banner', block: banner -%}
                        {%- endif -%}
                      {%- endfor -%}

                      {%- for carousel in carousel_blocks -%}
                        {%- assign carousel_position = carousel.settings.position | default: 0 -%}
                        {%- if carousel_position > 0 and carousel_position == forloop.parentloop.index -%}
                          {%- render 'promo-carousel', block: carousel -%}
                        {%- endif -%}
                      {%- endfor -%}

                      {%- render 'product-card', product: product -%}

                    {%- else -%}
                      <p class="collection-empty">No products found.</p>
                    {%- endfor -%}

                    {%- assign product_count = collection.products.size -%}

                    {%- for banner in banner_blocks -%}
                      {%- assign banner_position = banner.settings.position | default: 0 -%}
                      {%- if banner_position > product_count and banner_position > 0 -%}
                        {%- render 'promo-banner', block: banner -%}
                      {%- endif -%}
                    {%- endfor -%}

                    {%- for carousel in carousel_blocks -%}
                      {%- assign carousel_position = carousel.settings.position | default: 0 -%}
                      {%- if carousel_position > product_count and carousel_position > 0 -%}
                        {%- render 'promo-carousel', block: carousel -%}
                      {%- endif -%}
                    {%- endfor -%}

                  </div>
                </div>

                {%- if paginate.pages > 1 -%}
                  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
                    {%- if paginate.previous -%}
                      <a href="{{ paginate.previous.url }}&tab=products" class="pagination__link">&larr; {{ 'general.pagination.previous' | t }}</a>
                    {%- endif -%}
                    {%- for part in paginate.parts -%}
                      {%- if part.is_link -%}
                        <a href="{{ part.url }}&tab=products" class="pagination__link">{{ part.title }}</a>
                      {%- else -%}
                        <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if paginate.next -%}
                      <a href="{{ paginate.next.url }}&tab=products" class="pagination__link">{{ 'general.pagination.next' | t }} &rarr;</a>
                    {%- endif -%}
                  </nav>
                {%- endif -%}

              {%- endpaginate -%}
            </div>

            <div
              id="panel-articles"
              class="collection-feed__panel"
              role="tabpanel"
              aria-labelledby="tab-articles"
              data-panel="articles"
              {%- if active_tab != 'articles' %} hidden{%- endif %}
            >
              {{ 'article-card.css' | asset_url | stylesheet_tag }}

              {%- assign articles = collection.metafields.custom.posts.value -%}

              {%- if articles != blank -%}
                <div id="article-feed" class="article-feed">
                  {%- for article in articles -%}
                    {%- render 'article-card', article: article -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>

          </div>
        </div>

      </div>

    </section>

    {%- comment -%} after-items: read the metafield definition itself (not just .value) so we can branch on its type {%- endcomment -%}
    {%- assign after_items_field = collection.metafields.custom.after_item_lists -%}

    {%- if after_items_field.value != blank -%}
      <div class="after-items rte">
        {%- if after_items_field.type contains 'list' -%}
          {%- comment -%} List-type metafield (e.g. list.page_reference) — .value is an array, so loop and read .content on each item {%- endcomment -%}
          {%- for after_page in after_items_field.value -%}
            {{ after_page.content }}
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Single-reference metafield — .value is one object, read .content directly {%- endcomment -%}
          {{ after_items_field.value.content }}
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>

  <div class="collection-mobile-backdrop" aria-hidden="true"></div>

</div>

<script src="{{ 'main-collection.js' | asset_url }}" defer></script>
<script src="{{ 'promo-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main collection",
  "tag": "section",
  "class": "section-collection",
  "settings": [
    {
      "type": "text",
      "id": "tab_products_label",
      "label": "Products tab label",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "tab_articles_label",
      "label": "Articles tab label",
      "default": "Articles"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Sub-collections"
    },
    {
      "type": "select",
      "id": "sub_collection_shape",
      "label": "Sub-collection image shape",
      "options": [
        { "value": "square", "label": "Square (rounded corners)" },
        { "value": "circle", "label": "Circle" }
      ],
      "default": "square"
    },
    {
      "type": "paragraph",
      "content": "Add sub-collection blocks below. If a collection has no image, a default placeholder icon is shown automatically — or set a custom image per block."
    },
    {
      "type": "header",
      "content": "In-feed banners"
    },
    {
      "type": "paragraph",
      "content": "Add 'In-feed banner' blocks below to place promotional banners inside the product grid. Each banner has its own position number and size — set both per block."
    },
    {
      "type": "header",
      "content": "Promo carousels"
    },
    {
      "type": "paragraph",
      "content": "Add a 'Promo carousel' block to insert a product carousel into the grid. Set its collection directly on the block."
    },
    {
      "type": "header",
      "content": "Articles"
    },
    {
      "type": "paragraph",
      "content": "Articles shown here come from the collection's 'custom.posts' metafield. Manage which articles appear by editing that metafield on each collection."
    }
  ],
  "blocks": [
    {
      "type": "sub_collection",
      "name": "Sub-collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title",
          "info": "Leave blank to use the collection's title"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image",
          "info": "Leave blank to use the collection's featured image. If neither is set, a default placeholder is shown."
        }
      ]
    },
    {
      "type": "promo_banner",
      "name": "Promo Banner",
      "settings": [
        {
          "type": "number",
          "id": "position",
          "label": "Position in product grid",
          "info": "Banner appears before the Nth product on the current page. E.g. 5 inserts it right before the 5th product. A number larger than the total product count places it at the end. Leave blank or 0 to hide."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Image (mobile)",
          "info": "Optional. Falls back to the desktop image if not set."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Makes the entire banner clickable"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Content alignment",
          "info": "Aligns the heading, subheading, and button together",
          "options": [
            { "value": "left",   "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right",  "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image overlay darkness",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 20
        },
        {
          "type": "header",
          "content": "Size"
        },
        {
          "type": "range",
          "id": "column_span",
          "label": "Width (columns spanned)",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 2,
          "info": "Capped automatically on smaller screens so it never exceeds the live column count"
        },
        {
          "type": "range",
          "id": "row_span",
          "label": "Height (rows spanned)",
          "min": 1,
          "max": 3,
          "step": 1,
          "default": 1
        }
      ]
    },
    {
      "type": "promo_carousel",
      "name": "Promo carousel",
      "settings": [
        {
          "type": "number",
          "id": "position",
          "label": "Position in product grid",
          "info": "Carousel appears before the Nth product on this page. A number larger than the total product count places it at the end. Leave blank or 0 to hide."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "header",
          "content": "Products"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "products_limit",
          "label": "Products to show",
          "min": 4,
          "max": 24,
          "step": 1,
          "default": 12
        },
        {
          "type": "range",
          "id": "cards_per_row_desktop",
          "label": "Cards per row (desktop)",
          "min": 2,
          "max": 5,
          "step": 1,
          "default": 3
        },
        {
          "type": "range",
          "id": "cards_per_row_mobile",
          "label": "Cards per row (mobile)",
          "min": 1,
          "max": 3,
          "step": 1,
          "default": 2
        },
        {
          "type": "checkbox",
          "id": "show_arrows",
          "label": "Show arrows",
          "default": true
        },
        {
          "type": "select",
          "id": "arrow_position",
          "label": "Arrow position",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "side", "label": "Side" }
          ],
          "default": "bottom"
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "label": "Autoplay",
          "default": false
        },
        {
          "type": "range",
          "id": "autoplay_interval",
          "label": "Autoplay interval (seconds)",
          "min": 2,
          "max": 10,
          "step": 1,
          "default": 4
        },
        {
          "type": "header",
          "content": "Banner"
        },
        {
          "type": "checkbox",
          "id": "show_banner",
          "label": "Show side banner",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "Banner image"
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "Banner link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main collection",
      "blocks": []
    }
  ]
}
{% endschema %}