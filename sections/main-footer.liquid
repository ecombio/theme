<!-- Payment + Social Icons -->
<div class="main-footer__icons">
  
  <!-- Dynamic Payment Icons -->
  <div class="main-footer__payments">
    {%- unless shop.enabled_payment_types == empty -%}
      <span class="visually-hidden">Accepted payment methods</span>
      
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'payment-icon' }}
      {%- endfor -%}
    {%- endunless -%}
  </div>

  <!-- Social Icons (keep as-is or improve later) -->
  <div class="main-footer__socials">
    {% if section.settings.social_x != blank %}
      <a href="{{ section.settings.social_x }}" target="_blank" aria-label="X">
        <img src="{{ 'icon-x.svg' | asset_url }}" alt="">
      </a>
    {% endif %}
    {% if section.settings.social_tiktok != blank %}
      <a href="{{ section.settings.social_tiktok }}" target="_blank" aria-label="TikTok">
        <img src="{{ 'icon-tiktok.svg' | asset_url }}" alt="">
      </a>
    {% endif %}
    {% if section.settings.social_youtube != blank %}
      <a href="{{ section.settings.social_youtube }}" target="_blank" aria-label="YouTube">
        <img src="{{ 'icon-youtube.svg' | asset_url }}" alt="">
      </a>
    {% endif %}
    {% if section.settings.social_instagram != blank %}
      <a href="{{ section.settings.social_instagram }}" target="_blank" aria-label="Instagram">
        <img src="{{ 'icon-instagram.svg' | asset_url }}" alt="">
      </a>
    {% endif %}
    {% if section.settings.social_facebook != blank %}
      <a href="{{ section.settings.social_facebook }}" target="_blank" aria-label="Facebook">
        <img src="{{ 'icon-facebook.svg' | asset_url }}" alt="">
      </a>
    {% endif %}
  </div>

</div>