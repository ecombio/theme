{% comment %}
sections/main-footer.liquid
ScooterBio — Brand + Utility + Conversion footer

Structure:
1. Lead-capture / trust bar (email signup)
2. 4-column footer menu: Help & Policies | ScooterBio | Shop/Explore | Connect
   - Each column is a <details>/<summary> so mobile gets a free,
     JS-free accordion. Desktop CSS forces columns open/static.
3. Trust strip — dynamic payment icons via payment_type_svg_tag
4. Bottom row — copyright, policy links, contact info

Note: this section uses its own `.footer-width` container (defined in
main-footer.css) which intentionally mirrors the header's container
values (max-width: 1184px; margin: 0 auto; padding: 0 24px, dropping
to 0 12px under 640px) so footer content lines up edge-to-edge with
the header above it. Do not swap this for `.page-width--footer` or
any other container class without checking its values match.
{% endcomment %}

{{ 'main-footer.css' | asset_url | stylesheet_tag }}

<footer class="main-footer" data-section-id="{{ section.id }}" data-section-type="main-footer">
  <div class="footer-width">

    <!-- 1. Lead-capture / trust bar -->
    <div class="footer-signup">
      <div class="footer-signup__copy">
        <p class="footer-signup__heading">{{ section.settings.signup_heading | default: 'Ride smarter. Get product drops and maintenance tips.' }}</p>
      </div>

      {% form 'customer', class: 'footer-signup__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="FooterEmail-{{ section.id }}" class="visually-hidden">Email address</label>
        <input
          type="email"
          name="contact[email]"
          id="FooterEmail-{{ section.id }}"
          class="footer-signup__input"
          placeholder="Your email"
          autocomplete="email"
          required
        >
        <button type="submit" class="footer-signup__submit">
          {{ section.settings.signup_cta | default: 'Join the crew' }}
        </button>

        {% if form.posted_successfully? %}
          <p class="footer-signup__message footer-signup__message--success" role="status">
            You're in — welcome to the crew.
          </p>
        {% elsif form.errors %}
          <p class="footer-signup__message footer-signup__message--error" role="alert">
            {{ form.errors.messages.first }}
          </p>
        {% endif %}
      {% endform %}
    </div>

    <!-- 2. Footer menu columns -->
    <div class="main-footer__menu">
      <div class="footer-menu__columns">

        <!-- Help & Policies -->
        {% if section.settings.help_menu != blank %}
          {% assign help_menu = section.settings.help_menu %}
          {% if help_menu.links.size > 0 %}
            <details class="footer-menu__column" open>
              <summary class="footer-menu__heading">Help &amp; Policies</summary>
              <div class="footer-menu__column-inner">
                {% for link in help_menu.links %}
                  <a href="{{ link.url }}" class="footer-menu__link">{{ link.title }}</a>
                {% endfor %}
              </div>
            </details>
          {% endif %}
        {% endif %}

        <!-- ScooterBio (about / story / sustainability) -->
        {% if section.settings.about_menu != blank %}
          {% assign about_menu = section.settings.about_menu %}
          {% if about_menu.links.size > 0 %}
            <details class="footer-menu__column" open>
              <summary class="footer-menu__heading">ScooterBio</summary>
              <div class="footer-menu__column-inner">
                {% for link in about_menu.links %}
                  <a href="{{ link.url }}" class="footer-menu__link">{{ link.title }}</a>
                {% endfor %}
              </div>
            </details>
          {% endif %}
        {% endif %}

        <!-- Shop / Explore (existing nested menu setting) -->
        {% if section.settings.menu != blank %}
          {% assign footer_menu = section.settings.menu %}
          {% if footer_menu.links.size > 0 %}
            <details class="footer-menu__column" open>
              <summary class="footer-menu__heading">
                {{ section.settings.menu_heading | default: 'Shop & Explore' }}
              </summary>
              <div class="footer-menu__column-inner">
                {% for column in footer_menu.links %}
                  {% for section_item in column.links %}
                    {% if section_item.links.size > 0 %}
                      {% if section.settings.show_section_titles %}
                        <div class="footer-menu__section-title">{{ section_item.title }}</div>
                      {% endif %}
                      {% for link in section_item.links %}
                        <a href="{{ link.url }}" class="footer-menu__link">{{ link.title }}</a>
                      {% endfor %}
                    {% else %}
                      <a href="{{ section_item.url }}" class="footer-menu__link">{{ section_item.title }}</a>
                    {% endif %}
                  {% endfor %}
                {% endfor %}
              </div>
            </details>
          {% endif %}
        {% endif %}

        <!-- Connect (social + contact) -->
        <details class="footer-menu__column" open>
          <summary class="footer-menu__heading">Connect</summary>
          <div class="footer-menu__column-inner">

            {% if section.settings.contact_email != blank %}
              <a href="mailto:{{ section.settings.contact_email }}" class="footer-menu__link">
                {{ section.settings.contact_email }}
              </a>
            {% endif %}

            {% if section.settings.contact_phone != blank %}
              <a href="tel:{{ section.settings.contact_phone }}" class="footer-menu__link">
                {{ section.settings.contact_phone }}
              </a>
            {% endif %}

            {% if section.settings.support_hours != blank %}
              <p class="footer-menu__support-hours">{{ section.settings.support_hours }}</p>
            {% endif %}

            <div class="main-footer__socials">
              {% if section.settings.social_x != blank %}
                <a href="{{ section.settings.social_x }}" target="_blank" rel="noopener" aria-label="ScooterBio on X">
                  <img src="{{ 'icon-x.svg' | asset_url }}" alt="" loading="lazy" width="20" height="20">
                </a>
              {% endif %}
              {% if section.settings.social_tiktok != blank %}
                <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="ScooterBio on TikTok">
                  <img src="{{ 'icon-tiktok.svg' | asset_url }}" alt="" loading="lazy" width="20" height="20">
                </a>
              {% endif %}
              {% if section.settings.social_youtube != blank %}
                <a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener" aria-label="ScooterBio on YouTube">
                  <img src="{{ 'icon-youtube.svg' | asset_url }}" alt="" loading="lazy" width="20" height="20">
                </a>
              {% endif %}
              {% if section.settings.social_instagram != blank %}
                <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="ScooterBio on Instagram">
                  <img src="{{ 'icon-instagram.svg' | asset_url }}" alt="" loading="lazy" width="20" height="20">
                </a>
              {% endif %}
              {% if section.settings.social_facebook != blank %}
                <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" aria-label="ScooterBio on Facebook">
                  <img src="{{ 'icon-facebook.svg' | asset_url }}" alt="" loading="lazy" width="20" height="20">
                </a>
              {% endif %}
            </div>
          </div>
        </details>

      </div>
    </div>

    <!-- Main footer content slot -->
    <div class="main-footer__content">
      <!-- Reserved for future content -->
    </div>

    <!-- 3. Trust strip -->
    <div class="main-footer__trust">
      <div class="main-footer__payments">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
        {% endfor %}
      </div>
      <p class="main-footer__trust-line">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
        Secure checkout
      </p>
    </div>

    <!-- 4. Bottom row: copyright + policies + contact -->
    <div class="main-footer__bottom">
      <div class="main-footer__bottom-inner">
        <div class="main-footer__copyright">
          <p>{{ section.settings.copyright_text }}</p>
        </div>

        <ul class="main-footer__policies">
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          <li><a href="/policies/refund-policy">Refund Policy</a></li>
          <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
        </ul>

        {% if section.settings.contact_email != blank or section.settings.contact_phone != blank %}
          <div class="main-footer__contact">
            {% if section.settings.contact_email != blank %}
              <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
            {% endif %}
            {% if section.settings.contact_phone != blank %}
              <span aria-hidden="true">·</span>
              <a href="tel:{{ section.settings.contact_phone }}">{{ section.settings.contact_phone }}</a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Main footer",
  "settings": [
    {
      "type": "header",
      "content": "Lead capture bar"
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Signup heading",
      "default": "Ride smarter. Get product drops and maintenance tips."
    },
    {
      "type": "text",
      "id": "signup_cta",
      "label": "Signup button text",
      "default": "Join the crew"
    },
    {
      "type": "header",
      "content": "Footer Menus"
    },
    {
      "type": "link_list",
      "id": "help_menu",
      "label": "Help & Policies menu"
    },
    {
      "type": "link_list",
      "id": "about_menu",
      "label": "ScooterBio menu",
      "info": "About, our story, sustainability & repair, etc."
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Shop/Explore menu heading",
      "default": "Shop & Explore"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Shop/Explore menu",
      "info": "Select a nested menu for the footer"
    },
    {
      "type": "checkbox",
      "id": "show_section_titles",
      "label": "Show section titles",
      "default": true,
      "info": "Display Level 2 titles inside the Shop/Explore menu"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Support email",
      "default": "support@scooterbio.com"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Support phone / WhatsApp"
    },
    {
      "type": "text",
      "id": "support_hours",
      "label": "Support hours",
      "default": "Mon–Fri, 9am–6pm PT"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "© 2026 ScooterBio. All rights reserved."
    },
    {
      "type": "header",
      "content": "Social Media Links"
    },
    {
      "type": "url",
      "id": "social_x",
      "label": "X (Twitter)"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook"
    }
  ],
  "presets": [
    {
      "name": "Main footer"
    }
  ]
}
{% endschema %}