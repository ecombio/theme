{{ 'main-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_width = section.settings.section_width
  if section_width == blank
    assign width_class = 'main-footer--default-width'
  elsif section_width == 'full-width'
    assign width_class = 'main-footer--full-width'
  else
    assign width_class = 'main-footer--custom-width'
  endif
-%}

<footer class="main-footer {{ width_class }}"
        data-section-id="{{ section.id }}"
        data-section-type="main-footer"
        style="
          --section-padding: {{ section.settings.section_padding }}px;
          {%- if section_width == 'custom-width' %}
            --custom-width: {{ section.settings.custom_width }}rem;
          {%- endif %}
        ">
  <div class="footer-width">

    {% if section.settings.menu != blank %}
      {% assign footer_menu = section.settings.menu %}

      {% if footer_menu.links.size > 0 %}
        <div class="main-footer__menu">
          {%- if section.settings.menu_heading != blank -%}
            <h3 class="footer-menu__heading footer-menu__heading--top">
              {{ section.settings.menu_heading }}
            </h3>
          {%- endif %}

          <div class="footer-menu__columns footer-menu__columns--{{ section.settings.column_layout }}">
            {% for column in footer_menu.links %}
              {% if column.links.size > 0 %}
                <div class="footer-menu__column">
                  <h3 class="footer-menu__heading">{{ column.title }}</h3>

                  {% for section_item in column.links %}
                    {% if section_item.links.size > 0 %}
                      {% if section.settings.show_section_titles %}
                        <div class="footer-menu__section-title">{{ section_item.title }}</div>
                      {% endif %}

                      {% for link in section_item.links %}
                        <a href="{{ link.url }}" class="footer-menu__link">{{ link.title }}</a>
                      {% endfor %}

                    {% else %}
                      <a href="{{ section_item.url }}" class="footer-menu__link">{{ section_item.title }}</a>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endif %}

    <div class="main-footer__content"></div>

    <div class="main-footer__bottom">

      <div class="main-footer__icons">
        <div class="main-footer__payments">
          <img src="{{ 'icon-visa.svg' | asset_url }}" alt="Visa">
          <img src="{{ 'icon-mastercard.svg' | asset_url }}" alt="Mastercard">
          <img src="{{ 'icon-paypal.svg' | asset_url }}" alt="PayPal">
          <img src="{{ 'icon-applepay.svg' | asset_url }}" alt="Apple Pay">
          <img src="{{ 'icon-googlepay.svg' | asset_url }}" alt="Google Pay">
          <img src="{{ 'icon-amazonpay.svg' | asset_url }}" alt="Amazon Pay">          
          <img src="{{ 'icon-amex.svg' | asset_url }}" alt="American Express">
          <img src="{{ 'icon-discover.svg' | asset_url }}" alt="Discover">
        </div>

        <div class="main-footer__socials">
          {% if section.settings.social_x != blank %}
            <a href="{{ section.settings.social_x }}" target="_blank">
              <img src="{{ 'icon-x.svg' | asset_url }}" alt="X">
            </a>
          {% endif %}
          {% if section.settings.social_tiktok != blank %}
            <a href="{{ section.settings.social_tiktok }}" target="_blank">
              <img src="{{ 'tiktok.svg' | asset_url }}" alt="TikTok">
            </a>
          {% endif %}
          {% if section.settings.social_youtube != blank %}
            <a href="{{ section.settings.social_youtube }}" target="_blank">
              <img src="{{ 'icon-youtube.svg' | asset_url }}" alt="YouTube">
            </a>
          {% endif %}
          {% if section.settings.social_instagram != blank %}
            <a href="{{ section.settings.social_instagram }}" target="_blank">
              <img src="{{ 'icon-instagram.svg' | asset_url }}" alt="Instagram">
            </a>
          {% endif %}
          {% if section.settings.social_facebook != blank %}
            <a href="{{ section.settings.social_facebook }}" target="_blank">
              <img src="{{ 'icon-facebook.svg' | asset_url }}" alt="Facebook">
            </a>
          {% endif %}
        </div>
      </div>

      <div class="main-footer__bottom-inner">
        <div class="main-footer__copyright">
          <p>{{ section.settings.copyright_text }}</p>
        </div>

        <ul class="main-footer__policies">
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          <li><a href="/policies/refund-policy">Refund Policy</a></li>
          <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
        </ul>
      </div>

    </div>
  </div>
</footer>

<script src="{{ 'main-footer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main footer",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": "",
      "info": "Defaults to Default width so the footer lines up with the header above it. Changing this independently of the header's own Section width setting will break that alignment."
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24,
      "info": "Applies at tablet and desktop widths. Mobile (< 640px) keeps its own fixed, tighter padding regardless of this setting. Defaults to 24px to match the header's default."
    },
    {
      "type": "header",
      "content": "Footer Menu"
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Menu heading (optional)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Select a nested menu for the footer"
    },
    {
      "type": "select",
      "id": "column_layout",
      "label": "Menu columns",
      "info": "Choose 5 columns if your footer menu has a fifth top-level link list",
      "options": [
        { "value": "4", "label": "4 columns" },
        { "value": "5", "label": "5 columns" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_section_titles",
      "label": "Show section titles",
      "default": true,
      "info": "Display Level 2 titles inside the menu"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "© 2026 ECombio. All rights reserved."
    },
    {
      "type": "header",
      "content": "Social Media Links"
    },
    {
      "type": "url",
      "id": "social_x",
      "label": "X (Twitter)"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook"
    }
  ],
  "presets": [
    {
      "name": "Main footer"
    }
  ]
}
{% endschema %}