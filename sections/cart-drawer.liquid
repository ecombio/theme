{%- comment -%}
  sections/cart-drawer.liquid

  Cart drawer shell. Handles layout and delegates every region to a
  snippet, so each piece (header, shipping bar, empty state, item row,
  footer, loading overlay, recommendation rails) can be edited or
  tested on its own.

  Assets to load in your theme.liquid (in this order):
    {{ 'cart-drawer.css'          | asset_url | stylesheet_tag }}
    {{ 'cart-recommendations.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'cart-drawer.js'          | asset_url }}" defer></script>
    <script src="{{ 'cart-recommendations.js' | asset_url }}" defer></script>

  Schema settings:
    show_free_shipping_bar → free shipping progress bar toggle
    free_shipping_minimum  → threshold amount (store's primary currency)
    show_related            → "You may also like" rail
    show_complementary       → "Frequently bought together" rail
    related_label            → heading text for the related rail
    complementary_label      → heading text for the complementary rail
    rec_limit                 → how many cards to show per rail (2–6)

  Snippets used:
    snippets/cart-drawer-header.liquid       — title, count, close button
    snippets/cart-drawer-shipping-bar.liquid — free shipping progress bar
    snippets/cart-drawer-empty.liquid        — empty-cart state
    snippets/cart-drawer-item.liquid         — one <li> per cart line item
    snippets/cart-drawer-footer.liquid       — subtotal, discounts, CTAs
    snippets/cart-drawer-loading.liquid      — update-in-progress overlay
    snippets/cart-recommendations.liquid     — related/complementary rails
                                                (pre-existing, unchanged)

  Changelog:
    2026-07-25 — Split the single-file shell into per-region snippets
                 (header/empty/item/footer/loading). No markup, classes,
                 data attributes, or schema settings changed from the
                 original single-file version — that pass was a
                 structural refactor only.
    2026-07-25 — Added the free shipping progress bar (documented Hyper
                 theme feature: cart note / shipping calculator / free
                 shipping goal / cart recommendation). See
                 snippets/cart-drawer-shipping-bar.liquid for its known
                 currency-conversion limitation. Bar is only rendered
                 when the cart has items, matching the reference
                 screenshot placement (between header and item list).
{%- endcomment -%}

{%- liquid
  assign show_free_shipping_bar = section.settings.show_free_shipping_bar
  assign free_shipping_minimum  = section.settings.free_shipping_minimum | default: 0
  assign minimum_cents          = free_shipping_minimum | times: 100

  assign show_related        = section.settings.show_related
  assign show_complementary  = section.settings.show_complementary
  assign related_label       = section.settings.related_label       | default: 'You may also like'
  assign complementary_label = section.settings.complementary_label | default: 'Frequently bought together'
  assign rec_limit           = section.settings.rec_limit           | default: 4
-%}

<div
  id="ecombio-cart-drawer"
  class="ecombio-cart-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Shopping cart"
  aria-hidden="true"
  hidden
  data-show-related="{{ show_related }}"
  data-show-complementary="{{ show_complementary }}"
  data-rec-limit="{{ rec_limit }}"
>

  {%- comment -%} Backdrop {%- endcomment -%}
  <div
    class="ecombio-cart-drawer__backdrop"
    data-ecombio-cart-close
    tabindex="-1"
    aria-hidden="true"
  ></div>

  {%- comment -%} Drawer panel {%- endcomment -%}
  <div class="ecombio-cart-drawer__inner">

    {%- render 'cart-drawer-header' -%}

    {%- if show_free_shipping_bar and cart.item_count > 0 -%}
      {%- render 'cart-drawer-shipping-bar', minimum_cents: minimum_cents -%}
    {%- endif -%}

    {%- comment -%} ── Body ── {%- endcomment -%}
    <div class="ecombio-cart-drawer__body" data-ecombio-cart-body>

      {%- if cart.item_count == 0 -%}

        {%- render 'cart-drawer-empty' -%}

      {%- else -%}

        {%- comment -%} ── Cart items ── {%- endcomment -%}
        <ul class="ecombio-cart-drawer__items" role="list" aria-label="Cart items">
          {%- for item in cart.items -%}
            {%- render 'cart-drawer-item', item: item -%}
          {%- endfor -%}
        </ul>

        {%- render 'cart-recommendations',
              show_related: show_related,
              show_complementary: show_complementary,
              related_label: related_label,
              complementary_label: complementary_label
        -%}

      {%- endif -%}

    </div>

    {%- render 'cart-drawer-footer' -%}

    {%- render 'cart-drawer-loading' -%}

  </div>
</div>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    {
      "type": "header",
      "content": "Free Shipping Goal"
    },
    {
      "type": "checkbox",
      "id": "show_free_shipping_bar",
      "label": "Show free shipping progress bar",
      "default": true
    },
    {
      "type": "number",
      "id": "free_shipping_minimum",
      "label": "Free shipping minimum amount",
      "info": "In your store's primary currency. Make sure you've also set up a free shipping rate at this threshold in Shopify admin.",
      "default": 500
    },
    {
      "type": "header",
      "content": "Product Recommendations"
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show \"You may also like\"",
      "info": "Powered by Shopify's recommendation engine. Works out of the box — no configuration needed.",
      "default": true
    },
    {
      "type": "text",
      "id": "related_label",
      "label": "\"You may also like\" heading",
      "default": "You may also like"
    },
    {
      "type": "checkbox",
      "id": "show_complementary",
      "label": "Show \"Frequently bought together\"",
      "info": "Requires the Shopify Search & Discovery app. You must also configure complementary products per product in your Admin.",
      "default": false
    },
    {
      "type": "text",
      "id": "complementary_label",
      "label": "\"Frequently bought together\" heading",
      "default": "Frequently bought together"
    },
    {
      "type": "range",
      "id": "rec_limit",
      "label": "Products to show per rail",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}