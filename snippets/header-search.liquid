{%- comment -%}
  snippets/header-search.liquid

  CHANGED — added a static "Ask AI" row, rendered only when
  variant == 'overlay' (sfx == 'overlay' below), placed between the
  search form and the results panel. This is the one reliable spot for
  it: header-search.js only ever rewrites .header-search__panel's
  innerHTML (trending pills / recent searches / live results), so
  putting Ask AI as a sibling here means it's never at the mercy of
  that re-render and always sits in the same place relative to the
  input, regardless of what's currently showing below it.

  Points to routes.search_url by default since there's no assistant
  endpoint wired up yet — replace the href with a real one, or delete
  the whole {%- if sfx == 'overlay' -%} block below if you don't want
  this feature at all.

  DISABLED (this pass) — Ask AI is turned off until further notice.
  The block below is now wrapped in {% comment %}...{% endcomment %}
  rather than deleted, so it's a one-step re-enable: just remove the
  {% comment %} / {% endcomment %} wrapper around it to bring it back.

  FIX — window.HS_TRENDING was only ever emitted inside the
  {%- if show_typewriter -%} block, but it's not just typewriter
  input: header-search.js's _showEmpty() also reads it (alongside
  recent searches) to build the trending-pills panel shown when the
  input is empty/focused. Since enable_typewriter defaults to false
  in the section schema, most stores never emitted this script at
  all — so window.HS_TRENDING stayed undefined, buildEmptyState()
  returned '' for a visitor with no recent searches yet, and
  _showEmpty() immediately closed the panel instead of opening it.
  That reproduced on every variant (mobile/overlay/inline bar); it
  was just most visible on the always-on-screen inline bar.
  Fixed by always emitting window.HS_TRENDING once predictive search
  is enabled, and gating only the typewriter-specific timing options
  (window.HS_TYPEWRITER_OPTS) behind show_typewriter — the animation
  settings are typewriter-only, but the term list itself is used
  regardless of whether the animation is on.
{%- endcomment -%}

{%- liquid
  assign predictive = true
  if enable_predictive_search == false
    assign predictive = false
  endif
  assign sfx = variant | default: 'desktop'
  assign show_typewriter = true
  if enable_typewriter == false
    assign show_typewriter = false
  endif
-%}

{{- 'header-search.css' | asset_url | stylesheet_tag -}}

{%- if predictive -%}
  <script src="{{ 'header-search.js' | asset_url }}" defer="defer"></script>
  <script>
    window.HS_TRENDING = window.HS_TRENDING || [
      {%- if trending_terms != blank -%}
        {%- assign _terms = trending_terms | split: '||' -%}
        {%- for t in _terms -%}
          {{- t | json -}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        "electric scooters","electric bikes","electric skateboards","electric cargo bikes",
        "electric city bikes","electric fat bikes","electric folding bikes","electric mountain bikes",
        "commuter electric scooters","off-road electric scooters","performance electric scooters","youth electric scooters"
      {%- endif -%}
    ];
    {%- if show_typewriter -%}
    window.HS_TYPEWRITER_OPTS = window.HS_TYPEWRITER_OPTS || {
      typeSpeed: {{ typewriter_type_speed | default: 70 }},
      holdMs: {{ typewriter_hold_ms | default: 3200 }}
    };
    {%- endif -%}
  </script>
{%- endif -%}

<div class="header-search header-search--{{ sfx }}{% unless predictive %} header-search--basic{% endunless %}"
     data-search-root
     {%- if predictive %}
     data-predictive
     data-predictive-search-url="{{ routes.predictive_search_url }}"
     data-search-url="{{ routes.search_url }}"
     {%- endif %}
     {%- if show_typewriter %} data-typewriter-enabled{% endif %}>

  <form action="{{ routes.search_url }}" method="get" role="search"
        class="header-search__form"
        id="HeaderSearchForm-{{ sfx }}"
        autocomplete="off">

    <input type="hidden" name="type" value="product">
    <label class="visually-hidden" for="HeaderSearch-{{ sfx }}">Search</label>

    <input type="search" name="q"
           id="HeaderSearch-{{ sfx }}"
           class="header-search__input"
           data-search-input
           placeholder="What are you looking for?"
           value="{{ search.terms | escape }}"
           autocorrect="off" autocapitalize="off" spellcheck="false"
           {%- if predictive %}
           role="combobox"
           aria-expanded="false"
           aria-owns="HeaderSearchResults-{{ sfx }}"
           aria-controls="HeaderSearchResults-{{ sfx }}"
           aria-haspopup="listbox"
           aria-autocomplete="list"
           {%- endif %}>

    <span class="header-search__typewriter" data-search-typewriter aria-hidden="true"></span>

    <button type="button" class="header-search__clear" data-search-clear hidden aria-label="Clear search">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <button type="button" class="header-search__voice" data-search-voice hidden aria-label="Search by voice">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
        <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
        <line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/>
      </svg>
    </button>

    <button type="submit" class="header-search__submit" aria-label="Search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </button>

  </form>

  {%- comment -%}
    ASK AI — DISABLED until further notice. Wrapped rather than
    deleted so it can be turned back on later by removing this
    {% comment %}/{% endcomment %} wrapper (and the matching one
    just below, right before {%- endif -%}). Do not delete the
    block itself unless you're sure you won't want it back.

  {%- if sfx == 'overlay' -%}
    <div class="main-header__search-overlay-ask-wrap">
      <a href="{{ routes.search_url }}" class="main-header__search-overlay-ask">
        <span class="main-header__search-overlay-ask-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2l1.5 4.5L18 8l-4.5 1.5L12 14l-1.5-4.5L6 8l4.5-1.5L12 2z"/>
            <path d="M19 15l.75 2.25L22 18l-2.25.75L19 21l-.75-2.25L16 18l2.25-.75L19 15z"/>
          </svg>
        </span>
        <span class="main-header__search-overlay-ask-label">Ask AI</span>
      </a>
    </div>
  {%- endif -%}
  {%- endcomment -%}

  {%- if predictive -%}
    <div class="header-search__panel"
         id="HeaderSearchResults-{{ sfx }}"
         data-search-results
         role="listbox"
         aria-label="Search suggestions"
         tabindex="-1"
         hidden></div>
    <span class="visually-hidden" role="status" aria-live="polite" data-search-status></span>
  {%- endif -%}

</div>