{%- comment -%}
  snippets/featured-highlights.liquid
  ============================================
  Renders a product's curated "Featured Highlights" carousel, sourced
  from custom.featured_highlights (list.metaobject_reference ->
  featured_highlight). Replaces the old sections/feature-highlights.liquid
  merchant-block version — content now lives on the product as data,
  not as section blocks tied to a specific template instance.

  Metaobject "Featured highlight" fields expected:
    - image       -> Image field type (NOT generic File field)
    - heading     -> Single line text
    - description -> Rich text

  Title priority (highest wins):
    1. `title` param passed into the render tag
    2. product.metafields.custom.featured_highlights_title (optional — add this
       metafield definition only if you want a per-product title in the admin)
    3. Hardcoded default below ("Featured Highlights")

  Usage:
    {% render 'featured-highlights', product: product %}
    {% render 'featured-highlights', product: product, title: 'Tech Specs' %}
{%- endcomment -%}

{%- liquid
  assign highlights = product.metafields.custom.featured_highlights.value
  assign section_title = title | default: product.metafields.custom.featured_highlights_title.value | default: 'Featured Highlights'
-%}

{%- if highlights != blank -%}
  <link rel="stylesheet" href="{{ 'feature-highlights.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="{{ 'feature-highlights.css' | asset_url }}">
  </noscript>
  <script src="{{ 'feature-highlights.js' | asset_url }}" defer></script>

  <div class="feature-highlights" id="FeaturedHighlights-{{ product.id }}" data-feature-highlights>
    {%- if section_title != blank -%}
      <div class="feature-highlights__header">
        <h2 class="feature-highlights__heading">{{ section_title }}</h2>
      </div>
    {%- endif -%}

    <div class="feature-highlights__carousel" data-feature-carousel>

      <button
        type="button"
        class="feature-highlights__arrow feature-highlights__arrow--prev"
        data-feature-prev
        aria-label="Previous features"
        aria-controls="FeaturedTrack-{{ product.id }}"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="feature-highlights__track" id="FeaturedTrack-{{ product.id }}" data-feature-track role="list">
        {%- for highlight in highlights -%}
          <div class="feature-highlights__item" id="FeaturedHighlight-{{ highlight.id }}" data-feature-item role="listitem">
            <div class="feature-highlights__frame">
              {%- if highlight.image != blank -%}
                {{
                  highlight.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    class: 'feature-highlights__image',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 80vw',
                    widths: '400,600,800,1000'
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'feature-highlights__image feature-highlights__image--placeholder' }}
              {%- endif -%}
            </div>

            {%- if highlight.heading != blank -%}
              <h3 class="feature-highlights__item-heading">{{ highlight.heading }}</h3>
            {%- endif -%}

            {%- if highlight.description != blank -%}
              <div class="feature-highlights__item-description">{{ highlight.description | metafield_tag }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <button
        type="button"
        class="feature-highlights__arrow feature-highlights__arrow--next"
        data-feature-next
        aria-label="Next features"
        aria-controls="FeaturedTrack-{{ product.id }}"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

    </div>
  </div>
{%- endif -%}