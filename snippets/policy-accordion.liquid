{%- comment -%}
  Snippet: policy-accordion.liquid
  Renders Shipping / Returns & Refunds / Warranty policies (rich text)
  from a "Product Policy" metaobject as toggleable accordion dropdowns.

  Usage: {% render 'policy-accordion', product: product %}
{%- endcomment -%}

{%- assign policy = product.metafields.custom.product_policy.value -%}

{%- if policy != blank -%}
  <div class="policy-accordion">

    {%- if policy.shipping_policy != blank -%}
      <details class="policy-accordion__item">
        <summary class="policy-accordion__trigger">
          <span>Shipping Policy</span>
          <span class="policy-accordion__icon" aria-hidden="true"></span>
        </summary>
        <div class="policy-accordion__content rte">
          {{ policy.shipping_policy | metafield_tag }}
        </div>
      </details>
    {%- endif -%}

    {%- if policy.returns_refunds != blank -%}
      <details class="policy-accordion__item">
        <summary class="policy-accordion__trigger">
          <span>Refund Policy</span>
          <span class="policy-accordion__icon" aria-hidden="true"></span>
        </summary>
        <div class="policy-accordion__content rte">
          {{ policy.returns_refunds | metafield_tag }}
        </div>
      </details>
    {%- endif -%}

    {%- if policy.warranty_policy != blank -%}
      <details class="policy-accordion__item">
        <summary class="policy-accordion__trigger">
          <span>Warranty Policy</span>
          <span class="policy-accordion__icon" aria-hidden="true"></span>
        </summary>
        <div class="policy-accordion__content rte">
          {{ policy.warranty_policy | metafield_tag }}
        </div>
      </details>
    {%- endif -%}

  </div>
{%- endif -%}

{% stylesheet %}
  .policy-accordion {
    border-top: 1px solid rgba(0,0,0,0.1);
    max-width: 100%;
  }
  .policy-accordion__item {
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }
  .policy-accordion__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0.25rem;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }
  .policy-accordion__trigger::-webkit-details-marker {
    display: none;
  }
  .policy-accordion__icon {
    position: relative;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }
  .policy-accordion__icon::before,
  .policy-accordion__icon::after {
    content: '';
    position: absolute;
    background: currentColor;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.2s ease;
  }
  .policy-accordion__icon::before {
    width: 12px;
    height: 2px;
  }
  .policy-accordion__icon::after {
    width: 2px;
    height: 12px;
  }
  details[open] .policy-accordion__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }
  .policy-accordion__content {
    padding: 0 0.25rem 1.25rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .policy-accordion__content.rte p {
    margin: 0 0 0.75em;
  }
  .policy-accordion__content.rte p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}