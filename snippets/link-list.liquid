{% comment %}
  Link List - Header Menu
  File: snippets/link-list.liquid

  Renders a top-level nav link that opens a compact dropdown panel
  built from a link_list: top-level links render as the dropdown's
  rows, and any child links (a second nesting level) render as an
  indented sub-list beneath their parent row.

  Unlike mega-menu.liquid, this is NOT full-width — it's a narrow,
  left-aligned dropdown sized to its content (same idea as the
  flyout block's "compact" panel_style). It still uses position:fixed
  rather than sitting absolutely inside .menu-bar__container, for the
  same reason mega-menu does: that container has overflow-x:auto for
  horizontal scrolling on crowded menu bars, which would clip an
  absolutely-positioned dropdown. assets/link-list.js positions the
  panel's `top`/`left` against the trigger's own live position on
  open/resize/scroll (not the header's bottom edge like mega-menu,
  since this panel hangs directly under its own link, not the full
  header width).

  Desktop (≥1024px) only — see assets/link-list.css.

  Params:
    block — the link-list block from section.blocks
{% endcomment %}

{%- liquid
  assign menu = block.settings.menu
  assign link = block.settings.link
  assign panel_id = 'LinkListPanel-' | append: block.id

  if link == blank and menu != blank and menu.links.size > 0
    assign link = menu.links.first.url
  endif

  assign has_links = false
  if menu != blank and menu.links.size > 0
    assign has_links = true
  endif
-%}

<li class="menu-bar__item{% if has_links %} menu-bar__item--link-list{% endif %}" {% if has_links %}data-link-list{% endif %} {{ block.shopify_attributes }}>
  <a
    href="{{ link | default: '#' }}"
    class="menu-bar__link{% if has_links %} menu-bar__link--link-list{% endif %}"
    {%- if has_links %}
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="{{ panel_id }}"
    data-link-list-trigger
    {% endif -%}
  >
    {%- if block.settings.icon != blank -%}
      <span class="menu-bar__icon">{%- render 'menu-icon', icon: block.settings.icon -%}</span>
    {%- endif -%}
    {{ block.settings.label | default: 'Link list' }}
    {%- if has_links -%}
      <svg class="icon-caret-down" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    {%- endif -%}
  </a>

  {%- if has_links -%}
    <div class="link-list__panel" id="{{ panel_id }}" data-link-list-panel>
      <ul class="link-list__list">
        {%- for top_link in menu.links -%}
          <li class="link-list__item{% if top_link.links.size > 0 %} link-list__item--has-sub{% endif %}">
            <a href="{{ top_link.url }}" class="link-list__link">{{ top_link.title }}</a>
            {%- if top_link.links.size > 0 -%}
              <ul class="link-list__sublist">
                {%- for sub_link in top_link.links -%}
                  <li><a href="{{ sub_link.url }}" class="link-list__sublink">{{ sub_link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</li>