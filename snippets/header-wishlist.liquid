{% comment %}
  File: snippets/header-wishlist.liquid

  Self-contained: loads its own header-wishlist.css and
  header-wishlist.js below. Does not rely on classes from
  header-account.css or header-cart.css, so this snippet can be
  dropped into the header (or anywhere else) on its own.

  Renders: a link to the wishlist page with a heart icon and an
  item-count badge. The badge reads the 'shopify_wishlist' key from
  localStorage — same key/entry format ({ id, handle }) written by
  product-card.js and read by main-wishlist.js.

  No parameters required.
{% endcomment %}
{{ 'header-wishlist.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header-wishlist.js' | asset_url }}" defer></script>

<a
  href="{{ pages.wishlist.url | default: '/pages/wishlist' }}"
  class="header-wishlist__link"
  aria-label="View wishlist"
  data-wishlist-link
>
  <span class="header-wishlist__icon-wrap">
    <svg class="header-wishlist__icon" width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
    </svg>
    <span class="header-wishlist__badge header-wishlist__badge--hidden" data-wishlist-count aria-hidden="true">0</span>
  </span>
  <span class="header-wishlist__label">Wishlist</span>
</a>