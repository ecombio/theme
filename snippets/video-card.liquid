{%- comment -%}
  snippets/video-card.liquid
  ============================================
  Renders one carousel slot: thumbnail + play trigger only. Clicking
  the trigger no longer reveals inline media in this slot — instead
  assets/video-card.js dispatches a 'video-card:play' event carrying
  this block's video data, and snippets/video-modal.liquid (via
  assets/video-modal.js) is what actually plays it, in a shared
  lightbox.

  EXPECTED PARAMS (all required):
    block            — a section block with settings: video,
                        video_url, thumbnail, caption, products
    placeholder_name — placeholder_svg_tag name to use when there's
                        no thumbnail, no uploaded video, or no preview
                        image
    show_caption     — boolean, whether to render the caption <p>
    cta_style        — 'overlay' | 'icon_button' | 'text_button' |
                        'card_outside' (section.settings.cta_style).
                        Ignored when the block has no tagged products.

  SHOPPABLE PRODUCTS: if block.settings.products has any tagged
  products, the tagged product data is serialized into a sibling
  <script type="application/json"> tag. assets/video-card.js reads
  that JSON on click and includes it in the 'video-card:play' event
  detail, so assets/video-modal.js can render a product shelf inside
  the shared lightbox — no extra network request needed when the
  video opens.

  cta_style controls what shows on the card itself, on top of that:
    overlay / icon_button / text_button — a badge rendered inside the
      play trigger, on top of the video thumbnail. Clicking it (like
      clicking anywhere on the frame) plays the video and opens the
      modal shelf. icon_button/text_button show a bag icon + tagged-
      product count; overlay instead shows the first tagged product's
      image, title, and price (see video-card__shop-badge--overlay).
    card_outside — no on-video badge. Instead a persistent list of
      snippets/thumbnail.liquid cards is rendered under the frame.
      Their "Add to cart" buttons are self-wired by assets/
      thumbnail.js, so shopping doesn't require opening the video.

  Usage:
    {% render 'video-card', block: block, placeholder_name: 'lifestyle-1', show_caption: true, cta_style: 'overlay' %}
{%- endcomment -%}
{%- liquid
  assign has_native_video = false
  assign has_external_video = false
  if block.settings.video != blank
    assign has_native_video = true
  elsif block.settings.video_url != blank
    assign has_external_video = true
  endif

  assign has_thumbnail = false
  if block.settings.thumbnail != blank
    assign has_thumbnail = true
  endif

  assign tagged_products = block.settings.products
  assign product_count = 0
  if tagged_products != blank
    assign product_count = tagged_products.size
  endif

  assign cta_style = cta_style | default: 'overlay'
  assign show_on_frame_badge = false
  if product_count > 0 and cta_style != 'card_outside'
    assign show_on_frame_badge = true
  endif

  assign badge_label = ''
  if product_count == 1
    assign badge_label = '1 product'
  elsif product_count > 1
    assign badge_label = product_count | append: ' products'
  endif

  assign first_product = tagged_products.first
  assign first_variant = first_product.selected_or_first_available_variant
-%}
<div class="video-card" id="VideoCard-{{ block.id }}" data-video-card>
  <div class="video-card__frame">

    <button
      type="button"
      class="video-card__play-trigger"
      data-video-card-trigger
      aria-label="Play video{% if block.settings.caption != blank %}: {{ block.settings.caption | escape }}{% endif %}{% if product_count > 0 %} — {{ badge_label }} tagged{% endif %}"
      aria-haspopup="dialog"
      data-video-caption="{{ block.settings.caption | escape }}"
      {%- if product_count > 0 %}
        data-video-has-products
      {%- endif %}
      {%- if has_native_video %}
        data-video-type="native"
        data-video-src="{{ block.settings.video.sources.last.url }}"
      {%- elsif has_external_video %}
        data-video-type="external"
        data-provider="{{ block.settings.video_url.type }}"
        data-video-id="{{ block.settings.video_url.id }}"
      {%- else %}
        disabled
      {%- endif %}
    >
      {%- if has_thumbnail -%}
        {{
          block.settings.thumbnail
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            class: 'video-card__thumbnail',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 80vw',
            widths: '400,600,800,1000'
        }}
      {%- elsif has_native_video and block.settings.video.preview_image -%}
        {{
          block.settings.video.preview_image
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            class: 'video-card__thumbnail',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 80vw',
            widths: '400,600,800,1000'
        }}
      {%- else -%}
        {{ placeholder_name | default: 'lifestyle-1' | placeholder_svg_tag: 'video-card__thumbnail video-card__thumbnail--placeholder' }}
      {%- endif -%}

      <span class="video-card__play-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26" focusable="false">
          <path d="M8 5v14l11-7z" fill="currentColor"/>
        </svg>
      </span>

      {%- if show_on_frame_badge -%}
        {%- case cta_style -%}
          {%- when 'icon_button' -%}
            <span class="video-card__shop-badge video-card__shop-badge--icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" focusable="false">
                <path d="M6 7h12l-1 12.5a1.5 1.5 0 0 1-1.5 1.5h-8a1.5 1.5 0 0 1-1.5-1.5L6 7Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                <path d="M9 7V5.5a3 3 0 0 1 6 0V7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </span>
          {%- when 'text_button' -%}
            <span class="video-card__shop-badge video-card__shop-badge--text" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" focusable="false">
                <path d="M6 7h12l-1 12.5a1.5 1.5 0 0 1-1.5 1.5h-8a1.5 1.5 0 0 1-1.5-1.5L6 7Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                <path d="M9 7V5.5a3 3 0 0 1 6 0V7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
              Shop now
            </span>
          {%- else -%}
            <span class="video-card__shop-badge video-card__shop-badge--overlay" aria-hidden="true">
              {%- if first_product.featured_image -%}
                {{
                  first_product.featured_image
                  | image_url: width: 100
                  | image_tag: loading: 'lazy', class: 'video-card__shop-badge-image', alt: ''
                }}
              {%- endif -%}
              <span class="video-card__shop-badge-info">
                <span class="video-card__shop-badge-title">{{ first_product.title }}</span>
                <span class="video-card__shop-badge-price">{{ first_variant.price | money }}</span>
              </span>
            </span>
        {%- endcase -%}
      {%- endif -%}
    </button>

  </div>

  {%- if product_count > 0 and cta_style == 'card_outside' -%}
    <ul class="video-card__products" data-video-card-products>
      {%- for product in tagged_products -%}
        <li class="video-card__product">
          {%- render 'thumbnail', product: product -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if product_count > 0 -%}
    <script type="application/json" data-video-products>
      [
        {%- for product in tagged_products -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          {
            "id": {{ product.id | json }},
            "title": {{ product.title | json }},
            "price": {{ variant.price | money | json }},
            "url": {{ product.url | json }},
            "image": {{ product.featured_image | image_url: width: 200 | json }},
            "variantId": {{ variant.id | json }},
            "available": {{ variant.available | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>
  {%- endif -%}

  {%- if show_caption and block.settings.caption != blank -%}
    <p class="video-card__caption">{{ block.settings.caption }}</p>
  {%- endif -%}
</div>