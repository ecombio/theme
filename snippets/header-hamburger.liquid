{% comment %}
  Header Hamburger + Mobile Nav Drawer
  File: snippets/header-hamburger.liquid

  Encapsulates every hamburger-related piece of the header in one place:
    1. The sticky-header hamburger (desktop only, ≥1024px) — appears once
       the header has scrolled into sticky mode and re-expands .menu-bar,
       which auto-collapses while sticky.
    2. The tablet/mobile hamburger — opens the mobile nav drawer below.
    3. The mobile nav drawer itself, including its dimmed backdrop, an
       explicit close (X) button, and a 3-level nested accordion menu
       (top level -> children -> grandchildren), unrolled as explicit
       loops rather than a recursive snippet.

  Params:
    mobile_menu   — link_list object; powers the mobile drawer's links
    enable_sticky — bool; whether to render the sticky hamburger at all
{% endcomment %}

{{ 'header-hamburger.css' | asset_url | stylesheet_tag }}

{%- if enable_sticky -%}
  <button class="main-header-sticky__hamburger"
          type="button"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="main-header-menu-bar">
    <span></span>
    <span></span>
    <span></span>
  </button>
{%- endif -%}

<button class="main-header__hamburger"
        id="main-header-nav-toggle"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="main-header-mobile-nav">
  <span class="main-header__hamburger-line"></span>
  <span class="main-header__hamburger-line"></span>
  <span class="main-header__hamburger-line"></span>
</button>

<nav class="main-header__mobile-nav"
     id="main-header-mobile-nav"
     aria-label="Mobile navigation"
     aria-hidden="true"
     hidden>

  <div class="main-header__mobile-nav-header">
    <button class="main-header__mobile-nav-close"
            id="main-header-mobile-nav-close"
            type="button"
            aria-label="Close navigation">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  {%- comment -%} LEVEL 1 (top-level menu items) {%- endcomment -%}
  <ul class="main-header__mobile-nav-list main-header__mobile-nav-list--l0">
    {%- for link_l1 in mobile_menu.links -%}
      {%- assign id_l1 = 'mnav-' | append: forloop.index -%}
      <li class="main-header__mobile-nav-item">
        {%- if link_l1.links.size > 0 -%}
          <button type="button" class="main-header__mobile-nav-toggle"
                  id="{{ id_l1 }}-toggle" aria-expanded="false"
                  aria-controls="{{ id_l1 }}-sub">
            <span class="main-header__mobile-nav-toggle-label">{{ link_l1.title }}</span>
            <svg class="main-header__mobile-nav-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 6 15 12 9 18"></polyline>
            </svg>
          </button>

          {%- comment -%} LEVEL 2 (children of link_l1) {%- endcomment -%}
          <div class="main-header__mobile-nav-sub" id="{{ id_l1 }}-sub" hidden>
            <ul class="main-header__mobile-nav-list main-header__mobile-nav-list--l1">
              {%- for link_l2 in link_l1.links -%}
                {%- assign id_l2 = id_l1 | append: '-' | append: forloop.index -%}
                <li class="main-header__mobile-nav-item">
                  {%- if link_l2.links.size > 0 -%}
                    <button type="button" class="main-header__mobile-nav-toggle"
                            id="{{ id_l2 }}-toggle" aria-expanded="false"
                            aria-controls="{{ id_l2 }}-sub">
                      <span class="main-header__mobile-nav-toggle-label">{{ link_l2.title }}</span>
                      <svg class="main-header__mobile-nav-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="9 6 15 12 9 18"></polyline>
                      </svg>
                    </button>

                    {%- comment -%} LEVEL 3 (children of link_l2 — leaf items) {%- endcomment -%}
                    <div class="main-header__mobile-nav-sub" id="{{ id_l2 }}-sub" hidden>
                      <ul class="main-header__mobile-nav-list main-header__mobile-nav-list--l2">
                        {%- for link_l3 in link_l2.links -%}
                          <li class="main-header__mobile-nav-item">
                            <a class="main-header__mobile-nav-link main-header__mobile-nav-link--l2"
                               href="{{ link_l3.url }}"
                               {%- if link_l3.active %} aria-current="page"{% endif %}>
                              {{ link_l3.title }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- else -%}
                    <a class="main-header__mobile-nav-link main-header__mobile-nav-link--l1"
                       href="{{ link_l2.url }}"
                       {%- if link_l2.active %} aria-current="page"{% endif %}>
                      {{ link_l2.title }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- else -%}
          <a class="main-header__mobile-nav-link main-header__mobile-nav-link--l0"
             href="{{ link_l1.url }}"
             {%- if link_l1.active %} aria-current="page"{% endif %}>
            {{ link_l1.title }}
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>

</nav>

<script src="{{ 'header-hamburger.js' | asset_url }}" defer></script>