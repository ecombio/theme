{% comment %}
  Header Hamburger + Mobile Nav Drawer
  File: snippets/header-hamburger.liquid

  Encapsulates every hamburger-related piece of the header in one place:
    1. The sticky-header hamburger (desktop only, ≥1024px) — appears once
       the header has scrolled into sticky mode and re-expands .menu-bar,
       which auto-collapses while sticky.
    2. The tablet/mobile hamburger — opens the mobile nav drawer below.
    3. The mobile nav drawer itself, including its dimmed backdrop, an
       explicit close (X) button, and a 3-level nested accordion menu
       (top level -> children -> grandchildren), unrolled as explicit
       loops rather than a recursive snippet.

  MOBILE NAV SOURCE: the drawer renders from the SAME `blocks` the
  desktop .menu-bar uses (see snippets/header-menu.liquid), not a
  separate `mobile_menu` link_list setting. There is exactly one nav
  data source for the whole header. Each block becomes one top-level
  (L0) drawer item:
    - single-link             -> plain link, no accordion
    - highlight                -> plain link, no accordion, but WITH the
                                  same icon + three-star treatment as the
                                  desktop menu bar's highlighted link
                                  (see snippets/highlight.liquid and
                                  assets/highlight.css). Split out from
                                  single-link into its own `when` branch
                                  since it needs this extra markup.
    - link-list / mega-menu /
      flyout                  -> accordion trigger; block.settings.menu
                                  (a link_list) supplies L1 children and,
                                  where present, L2 grandchildren
    - @app                    -> skipped here. App block markup is custom
                                  per-app on desktop and can't be generically
                                  turned into an accordion, so it simply
                                  doesn't appear in the mobile drawer.
  Class names/IDs elsewhere in this file are unchanged, so
  header-hamburger.css and header-hamburger.js need no edits for this
  change — only the highlight branch's own markup grew a few tags.

  Params:
    blocks                   — section.blocks from sections/main-header.liquid
    enable_sticky             — bool; whether to render the sticky hamburger at all
    drawer_style               — 'compact' (280px, dimmed backdrop) or 'full-width'
                                  (fills the screen, no backdrop). Default: 'compact'.
    enable_predictive_search   — bool; passed through to the mobile search field
                                  rendered inside the drawer. Default: true.
{% endcomment %}

{%- liquid
  assign drawer_style = drawer_style | default: 'compact'
  assign enable_predictive_search = enable_predictive_search | default: true
-%}

{{ 'header-hamburger.css' | asset_url | stylesheet_tag }}

{%- if enable_sticky -%}
  <button class="main-header-sticky__hamburger"
          type="button"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="main-header-menu-bar">
    <span></span>
    <span></span>
    <span></span>
  </button>
{%- endif -%}

<button class="main-header__hamburger"
        id="main-header-nav-toggle"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="main-header-mobile-nav">
  <span class="main-header__hamburger-line"></span>
  <span class="main-header__hamburger-line"></span>
  <span class="main-header__hamburger-line"></span>
</button>

<nav class="main-header__mobile-nav main-header__mobile-nav--{{ drawer_style }}"
     id="main-header-mobile-nav"
     aria-label="Mobile navigation"
     aria-hidden="true"
     hidden>

  <div class="main-header__mobile-nav-header">
    <button class="main-header__mobile-nav-close"
            id="main-header-mobile-nav-close"
            type="button"
            aria-label="Close navigation">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="main-header__mobile-nav-content">

    <div class="main-header__mobile-nav-search">
      {%- render 'header-search', enable_predictive_search: enable_predictive_search, variant: 'mobile' -%}
    </div>

    {%- comment -%} LEVEL 0 (one item per section block — same blocks header-menu.liquid renders on desktop) {%- endcomment -%}
    <ul class="main-header__mobile-nav-list main-header__mobile-nav-list--l0">
    {%- for block in blocks -%}
      {%- liquid
        assign id_l1 = 'mnav-' | append: forloop.index
        assign block_label = block.settings.label
        assign block_link = block.settings.link
        assign block_menu = block.settings.menu
        assign li_class = 'main-header__mobile-nav-item'
        if block.type == 'highlight'
          assign li_class = li_class | append: ' main-header__mobile-nav-item--highlight'
        endif
      -%}

      {%- case block.type -%}

        {%- comment -%} Plain link — no accordion, no highlight treatment {%- endcomment -%}
        {%- when 'single-link' -%}
          <li class="{{ li_class }}">
            <a class="main-header__mobile-nav-link main-header__mobile-nav-link--l0"
               href="{{ block_link | default: '#' }}">
              {{ block_label }}
            </a>
          </li>

        {%- comment -%} Highlight link — same icon + three-star treatment as the desktop menu bar's highlighted link (snippets/highlight.liquid) {%- endcomment -%}
        {%- when 'highlight' -%}
          <li class="{{ li_class }}">
            <a class="main-header__mobile-nav-link main-header__mobile-nav-link--l0 main-header__mobile-nav-link--highlight"
               href="{{ block_link | default: '#' }}">
              {%- if block.settings.icon != blank -%}
                <span class="main-header__mobile-nav-icon">{%- render 'menu-icon', icon: block.settings.icon -%}</span>
              {%- endif -%}
              <span class="reversed-link">{{ block_label }}</span>
              <svg class="star star-1" width="10" height="10" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/></svg>
              <svg class="star star-2" width="10" height="10" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/></svg>
              <svg class="star star-3" width="10" height="10" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0L7.854 4.146L12 6L7.854 7.854L6 12L4.146 7.854L0 6L4.146 4.146L6 0Z" fill="currentColor"/></svg>
            </a>
          </li>

        {%- comment -%} Blocks with a nested menu — accordion trigger + L1/L2 {%- endcomment -%}
        {%- when 'link-list', 'mega-menu', 'flyout' -%}
          <li class="{{ li_class }}">
            {%- if block_menu.links.size > 0 -%}
              <button type="button" class="main-header__mobile-nav-toggle"
                      id="{{ id_l1 }}-toggle" aria-expanded="false"
                      aria-controls="{{ id_l1 }}-sub">
                <span class="main-header__mobile-nav-toggle-label">{{ block_label }}</span>
                <svg class="main-header__mobile-nav-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="9 6 15 12 9 18"></polyline>
                </svg>
              </button>

              {%- comment -%} LEVEL 1 (children of this block's menu) {%- endcomment -%}
              <div class="main-header__mobile-nav-sub" id="{{ id_l1 }}-sub" hidden>
                <ul class="main-header__mobile-nav-list main-header__mobile-nav-list--l1">
                  {%- for link_l2 in block_menu.links -%}
                    {%- assign id_l2 = id_l1 | append: '-' | append: forloop.index -%}
                    <li class="main-header__mobile-nav-item">
                      {%- if link_l2.links.size > 0 -%}
                        <button type="button" class="main-header__mobile-nav-toggle"
                                id="{{ id_l2 }}-toggle" aria-expanded="false"
                                aria-controls="{{ id_l2 }}-sub">
                          <span class="main-header__mobile-nav-toggle-label">{{ link_l2.title }}</span>
                          <svg class="main-header__mobile-nav-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 6 15 12 9 18"></polyline>
                          </svg>
                        </button>

                        {%- comment -%} LEVEL 2 (grandchildren — leaf items) {%- endcomment -%}
                        <div class="main-header__mobile-nav-sub" id="{{ id_l2 }}-sub" hidden>
                          <ul class="main-header__mobile-nav-list main-header__mobile-nav-list--l2">
                            {%- for link_l3 in link_l2.links -%}
                              <li class="main-header__mobile-nav-item">
                                <a class="main-header__mobile-nav-link main-header__mobile-nav-link--l2"
                                   href="{{ link_l3.url }}"
                                   {%- if link_l3.active %} aria-current="page"{% endif %}>
                                  {{ link_l3.title }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- else -%}
                        <a class="main-header__mobile-nav-link main-header__mobile-nav-link--l1"
                           href="{{ link_l2.url }}"
                           {%- if link_l2.active %} aria-current="page"{% endif %}>
                          {{ link_l2.title }}
                        </a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- else -%}
              {%- comment -%} No menu configured for this block yet — fall back to a plain link so it's never a dead accordion trigger {%- endcomment -%}
              <a class="main-header__mobile-nav-link main-header__mobile-nav-link--l0"
                 href="{{ block_link | default: '#' }}">
                {{ block_label }}
              </a>
            {%- endif -%}
          </li>

        {%- comment -%} @app blocks render custom desktop-only markup per app; skipped in the mobile drawer {%- endcomment -%}
        {%- when '@app' -%}

      {%- endcase -%}
    {%- endfor -%}
    </ul>

  </div>

</nav>

<script src="{{ 'header-hamburger.js' | asset_url }}" defer></script>