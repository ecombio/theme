{%- comment -%}
  snippets/search-feed.liquid

  Search version of collection-feed.liquid — repurposed for global search results.
  Reuses the exact same HTML structure, classes, IDs, and most logic so
  collection-feed.js + all the card/promo CSS/JS continue to work without changes.

  Key differences from collection version:
  - Accepts `search` instead of `collection`
  - Products come from `search.results | where: 'object_type', 'product'`
  - Articles come from `search.results | where: 'object_type', 'article'`
  - No collection.metafields.custom.posts — articles are live search results
  - Sub-collections render is kept but will be empty on search pages (safe)
  - Pagination only on products panel (matches original behavior)
  - Same position-based promo banner/carousel insertion logic

  Talks to search-toolbar.liquid the same way (via ?tab= param + collection:tabchange event)
{%- endcomment -%}

{{ 'collection-feed.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'sub-collection.css' | asset_url | stylesheet_tag }}
{{ 'promo-banner.css' | asset_url | stylesheet_tag }}
{{ 'promo-carousel.css' | asset_url | stylesheet_tag }}
{{ 'article-card.css' | asset_url | stylesheet_tag }}

<div class="collection-feed" id="collection-feed" data-collection-feed>

  <!-- PRODUCTS PANEL -->
  <div
    id="panel-products"
    class="collection-feed__panel"
    role="tabpanel"
    aria-labelledby="tab-products"
    data-panel="products"
    {%- if active_tab != 'products' %} hidden{%- endif %}
  >
    {%- liquid
      assign banner_blocks   = section.blocks | where: 'type', 'promo_banner'
      assign carousel_blocks = section.blocks | where: 'type', 'promo_carousel'
      assign product_results = search.results | where: 'object_type', 'product'
    -%}

    {%- paginate product_results by section.settings.products_per_page -%}

      <div id="product-feed" class="product-feed" style="--columns: {{ section.settings.columns | default: 4 }};">

        {%- comment -%} Sub-collections are collection-specific; safe to leave here (renders nothing on search) {%- endcomment -%}
        {%- render 'sub-collection', collection: collection -%}

        <div class="product-feed__grid">

          {%- for result in product_results -%}

            {%- comment -%} Insert promo banners at exact positions {%- endcomment -%}
            {%- for banner in banner_blocks -%}
              {%- assign banner_position = banner.settings.position | default: 0 -%}
              {%- if banner_position > 0 and banner_position == forloop.parentloop.index -%}
                {%- render 'promo-banner', block: banner -%}
              {%- endif -%}
            {%- endfor -%}

            {%- comment -%} Insert promo carousels at exact positions {%- endcomment -%}
            {%- for carousel in carousel_blocks -%}
              {%- assign carousel_position = carousel.settings.position | default: 0 -%}
              {%- if carousel_position > 0 and carousel_position == forloop.parentloop.index -%}
                {%- render 'promo-carousel', block: carousel -%}
              {%- endif -%}
            {%- endfor -%}

            {%- render 'product-card', product: result -%}

          {%- else -%}
            <p class="collection-empty">No products found for your search.</p>
          {%- endfor -%}

          {%- assign product_count = product_results.size -%}

          {%- comment -%} Banners/carousels positioned after the last product {%- endcomment -%}
          {%- for banner in banner_blocks -%}
            {%- assign banner_position = banner.settings.position | default: 0 -%}
            {%- if banner_position > product_count and banner_position > 0 -%}
              {%- render 'promo-banner', block: banner -%}
            {%- endif -%}
          {%- endfor -%}

          {%- for carousel in carousel_blocks -%}
            {%- assign carousel_position = carousel.settings.position | default: 0 -%}
            {%- if carousel_position > product_count and carousel_position > 0 -%}
              {%- render 'promo-carousel', block: carousel -%}
            {%- endif -%}
          {%- endfor -%}

        </div>
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}&tab=products" class="pagination__link">&larr; {{ 'general.pagination.previous' | t }}</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}&tab=products" class="pagination__link">{{ part.title }}</a>
            {%- else -%}
              <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}&tab=products" class="pagination__link">{{ 'general.pagination.next' | t }} &rarr;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}

    {%- endpaginate -%}
  </div>

  <!-- ARTICLES PANEL -->
  <div
    id="panel-articles"
    class="collection-feed__panel"
    role="tabpanel"
    aria-labelledby="tab-articles"
    data-panel="articles"
    {%- if active_tab != 'articles' %} hidden{%- endif %}
  >
    {%- assign article_results = search.results | where: 'object_type', 'article' -%}

    {%- if article_results != blank -%}
      <div id="article-feed" class="article-feed">
        {%- for result in article_results -%}
          {%- render 'article-card', article: result -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="collection-empty">No articles found for your search.</p>
    {%- endif -%}
  </div>

</div>

<script src="{{ 'promo-carousel.js' | asset_url }}" defer></script>
<script src="{{ 'collection-feed.js' | asset_url }}" defer></script>