{%- comment -%}
  snippets/search-feed.liquid

  Search version of collection-feed.liquid

  IMPORTANT FIX: Shopify does NOT allow {% paginate %} on a filtered array (search.results | where ...).
  This version solves it properly:

  - We paginate the RAW search.results (the only thing paginate accepts)
  - Inside products panel we use a manual counter (visual_index) that only counts product results
  - Promo banners & carousels are still inserted at the exact visual position the merchant set
  - Articles panel shows all matching articles with no pagination (same behavior as your original collection articles)

  Everything else (IDs, classes, JS, CSS, CustomEvents) is untouched so your existing assets keep working.
{%- endcomment -%}

{{ 'collection-feed.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'sub-collection.css' | asset_url | stylesheet_tag }}
{{ 'promo-banner.css' | asset_url | stylesheet_tag }}
{{ 'promo-carousel.css' | asset_url | stylesheet_tag }}
{{ 'article-card.css' | asset_url | stylesheet_tag }}

<div class="collection-feed" id="collection-feed" data-collection-feed>

  <!-- PRODUCTS PANEL -->
  <div
    id="panel-products"
    class="collection-feed__panel"
    role="tabpanel"
    aria-labelledby="tab-products"
    data-panel="products"
    {%- if active_tab != 'products' %} hidden{%- endif %}
  >
    {%- liquid
      assign banner_blocks   = section.blocks | where: 'type', 'promo_banner'
      assign carousel_blocks = section.blocks | where: 'type', 'promo_carousel'
    -%}

    {%- paginate search.results by section.settings.products_per_page -%}

      <div id="product-feed" class="product-feed" style="--columns: {{ section.settings.columns | default: 4 }};">

        {%- comment -%} Sub-collections are collection-specific — this line is safe on search pages {%- endcomment -%}
        {%- render 'sub-collection', collection: collection -%}

        <div class="product-feed__grid">
          {%- assign visual_index = 0 -%}

          {%- for result in paginate.items -%}
            {%- if result.object_type == 'product' -%}
              {%- assign visual_index = visual_index | plus: 1 -%}

              {%- comment -%} Insert promo banners before the Nth *product* {%- endcomment -%}
              {%- for banner in banner_blocks -%}
                {%- assign banner_position = banner.settings.position | default: 0 -%}
                {%- if banner_position > 0 and banner_position == visual_index -%}
                  {%- render 'promo-banner', block: banner -%}
                {%- endif -%}
              {%- endfor -%}

              {%- comment -%} Insert promo carousels before the Nth *product* {%- endcomment -%}
              {%- for carousel in carousel_blocks -%}
                {%- assign carousel_position = carousel.settings.position | default: 0 -%}
                {%- if carousel_position > 0 and carousel_position == visual_index -%}
                  {%- render 'promo-carousel', block: carousel -%}
                {%- endif -%}
              {%- endfor -%}

              {%- render 'product-card', product: result -%}

            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Banners/carousels placed after the last product on this page {%- endcomment -%}
          {%- for banner in banner_blocks -%}
            {%- assign banner_position = banner.settings.position | default: 0 -%}
            {%- if banner_position > visual_index and banner_position > 0 -%}
              {%- render 'promo-banner', block: banner -%}
            {%- endif -%}
          {%- endfor -%}

          {%- for carousel in carousel_blocks -%}
            {%- assign carousel_position = carousel.settings.position | default: 0 -%}
            {%- if carousel_position > visual_index and carousel_position > 0 -%}
              {%- render 'promo-carousel', block: carousel -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if visual_index == 0 -%}
            <p class="collection-empty">No products found for your search.</p>
          {%- endif -%}

        </div>
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}&tab=products" class="pagination__link">&larr; {{ 'general.pagination.previous' | t }}</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}&tab=products" class="pagination__link">{{ part.title }}</a>
            {%- else -%}
              <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}&tab=products" class="pagination__link">{{ 'general.pagination.next' | t }} &rarr;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}

    {%- endpaginate -%}
  </div>

  <!-- ARTICLES PANEL (no pagination to match your original collection articles behavior) -->
  <div
    id="panel-articles"
    class="collection-feed__panel"
    role="tabpanel"
    aria-labelledby="tab-articles"
    data-panel="articles"
    {%- if active_tab != 'articles' %} hidden{%- endif %}
  >
    {%- assign article_results = search.results | where: 'object_type', 'article' -%}

    {%- if article_results != blank -%}
      <div id="article-feed" class="article-feed">
        {%- for result in article_results -%}
          {%- render 'article-card', article: result -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="collection-empty">No articles found for your search.</p>
    {%- endif -%}
  </div>

</div>

<script src="{{ 'promo-carousel.js' | asset_url }}" defer></script>
<script src="{{ 'collection-feed.js' | asset_url }}" defer></script>