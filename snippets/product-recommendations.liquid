{% comment %}
  ╔══════════════════════════════════════════════════════════╗
  ║  snippets/product-recommendations.liquid                 ║
  ║  Mode: Shopify AI — /recommendations/products.json       ║
  ║  Cards: snippets/product-card.liquid                     ║
  ║         via sections/product-card-single.liquid          ║
  ║                                                            ║
  ║  Converted from sections/product-recommendations.liquid   ║
  ║  so it can be rendered directly inside main-product.liquid║
  ║  as a full-width sibling of .product-layout, instead of   ║
  ║  being trapped inside the narrow .product-col--right      ║
  ║  column.                                                  ║
  ║                                                            ║
  ║  Snippets can't carry a {% schema %} block, so the         ║
  ║  settings that used to live in the theme editor are now   ║
  ║  render parameters below (with defaults matching the old  ║
  ║  schema defaults). Pass overrides from the render call in ║
  ║  main-product.liquid if needed.                           ║
  ║                                                            ║
  ║  Section layout (width/padding) follows the same pattern  ║
  ║  as sections/example-width-section.liquid — local vars     ║
  ║  only, never reads --page-margin / --page-width.           ║
  ╚══════════════════════════════════════════════════════════╝

  Parameters (all optional):
    heading            -- string, default 'You May Also Like'
    products_to_show    -- number, default 4
    section_width        -- '', 'full-width', or 'custom-width', default ''
    custom_width         -- number (rem), default 80
    section_padding      -- number (px), default 28
    columns_desktop      -- number, default 4
    columns_mobile       -- number, default 2
    card_gap             -- number (px), default 16
    color_scheme         -- 'light' | 'gray' | 'dark' | 'accent', default 'light'
    padding_top          -- number (px), default 48
    padding_bottom       -- number (px), default 48
{% endcomment %}

{% render 'pr-card-styles' %}

<style>
  /* Scoped width utility classes — see example-width-section.liquid.
     No global width utility classes exist in this theme yet, so these
     are namespaced to this section (BEM-style) rather than shared. */
  #pr-recs-{{ product.id }}.pr-recommendations__default-width {
    max-width: var(--page-width, 120rem);
    margin-inline: auto;
    padding-inline: var(--section-padding);
  }
  #pr-recs-{{ product.id }}.pr-recommendations__full-width {
    max-width: none;
    padding-inline: var(--section-padding);
  }
  #pr-recs-{{ product.id }}.pr-recommendations__custom-width {
    max-width: var(--custom-width);
    margin-inline: auto;
    padding-inline: var(--section-padding);
  }
</style>

{%- liquid
  assign rec_heading   = heading | default: 'You May Also Like'
  assign rec_limit     = products_to_show | default: 4
  assign cols_d        = columns_desktop | default: 4
  assign cols_m        = columns_mobile | default: 2
  assign gap           = card_gap | default: 16
  assign pad_top       = padding_top | default: 48
  assign pad_bottom    = padding_bottom | default: 48
  assign cs            = color_scheme | default: 'light'
  assign rec_section_padding = section_padding | default: 28
  assign rec_custom_width    = custom_width | default: 80
  assign rec_width_type      = section_width | default: ''

  if rec_width_type == blank
    assign width_class = 'pr-recommendations__default-width'
  else
    assign width_class = 'pr-recommendations__' | append: rec_width_type
  endif
-%}

<section
  class="pr-section cs-{{ cs }} {{ width_class }}"
  id="pr-recs-{{ product.id }}"
  style="
    --pr-cols: {{ cols_d }};
    --pr-cols-mob: {{ cols_m }};
    --pr-gap: {{ gap }}px;
    --pr-pad-top: {{ pad_top }}px;
    --pr-pad-bottom: {{ pad_bottom }}px;
    --section-padding: {{ rec_section_padding }}px;
    {%- if rec_width_type == 'custom-width' %}
      --custom-width: {{ rec_custom_width }}rem;
    {%- endif %}
  "
  aria-label="{{ rec_heading | escape }}"
  hidden
>
  <div class="pr-inner">
    <div class="pr-header">
      <h2 class="pr-heading">{{ rec_heading }}</h2>
    </div>
    <div class="pr-grid" id="pr-recs-grid-{{ product.id }}"></div>
  </div>
</section>

<script>
(function () {
  const section   = document.getElementById('pr-recs-{{ product.id }}');
  const grid      = document.getElementById('pr-recs-grid-{{ product.id }}');
  const productId = {{ product.id | json }};
  const limit     = {{ rec_limit | json }};

  if (!grid || !productId) return;

  // 1. Fetch Shopify AI recommendations to get product handles
  fetch(`/recommendations/products.json?product_id=${productId}&limit=${limit}&intent=related`)
    .then(r => r.json())
    .then(({ products }) => {
      if (!products || products.length === 0) return;

      // 2. For each handle, fetch a server-rendered product-card via sections API
      return Promise.all(
        products.slice(0, limit).map(p =>
          fetch(`/products/${p.handle}?sections=product-card-single`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          })
            .then(r => r.ok ? r.json() : null)
            .catch(() => null)
        )
      );
    })
    .then(results => {
      if (!results) return;

      const cards = results
        .filter(Boolean)
        .map(data => data['product-card-single'])
        .filter(Boolean);

      if (cards.length === 0) return;

      grid.innerHTML = cards.join('');
      section.removeAttribute('hidden');

      // Re-sync wishlist + compare state for injected cards
      document.dispatchEvent(new CustomEvent('productcard:injected', { bubbles: true }));
    })
    .catch(() => {
      // Silently fail — section stays hidden
    });
})();
</script>