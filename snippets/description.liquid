{%- comment -%}
  snippets/description.liquid
  Renders product.description and loads the product-videos / product-video
  CSS + JS that the pasted-in video carousel HTML (added via the native
  rich text editor) depends on.

  Usage:
    {% render 'description', product: product %}
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'product-videos.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'product-videos.css' | asset_url }}"></noscript>
<link rel="stylesheet" href="{{ 'product-video.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'product-video.css' | asset_url }}"></noscript>
<script src="{{ 'product-videos.js' | asset_url }}" defer></script>
<script src="{{ 'product-video.js' | asset_url }}" defer></script>

{{ product.description }}