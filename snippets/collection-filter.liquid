{%- comment -%}
  snippets/collection-filter.liquid
  Self-contained filter sidebar. Owns its own markup, styles, and JS.
  Rendered into the left column of the collection two-column shell —
  and, as of the main-search integration, into the same slot on
  sections/main-search.liquid.

  Expects section.settings:
    show_sort   {Boolean}
    show_filters {Boolean}

  CONTEXT (collection vs. search):
    This snippet originally assumed it only ever runs on the collection
    template and read straight from the global `collection` object. It's
    now rendered from two templates, so it branches on `template.name`:
      - collection: unchanged behavior, still backed by `collection.*`.
      - search: backed by `search.*` instead. Two knock-on differences,
        both scoped to the `is_search` branches below:
          1. `search` has no `sort_options` array (unlike `collection`),
             so a fixed fallback list of Shopify's supported search
             sort values is used instead.
          2. FilterForm posts via plain GET, which replaces the entire
             querystring — on search that would silently drop `q` (and
             the results-type tab param main-search.liquid maintains),
             so hidden inputs re-assert them. Collection has no
             equivalent param to preserve, so this is a no-op there.

  Communicates outward via events:
    No direct DOM coupling to product-feed or collection.liquid.
    collection-filter.js dispatches no custom events currently —
    filter changes trigger a full page navigation via form submit
    or sort select change, both handled within collection-filter.js.

  JS hook attributes:
    [data-filter-toggle]  — toolbar buttons (outside this snippet)
                            target id="collection-filter"
    [data-sort]           — sort <select>
    FilterForm            — filter <form>
{%- endcomment -%}

{{ 'collection-filter.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign is_search = false
  if template.name == 'search'
    assign is_search = true
  endif

  if is_search
    assign filter_source = search
    assign filter_url    = routes.search_url
  else
    assign filter_source = collection
    assign filter_url    = collection.url
  endif
-%}

{%- if section.settings.show_filters -%}
  <aside
    class="collection-filter"
    id="collection-filter"
    aria-label="Product filters"
  >

    {%- comment -%} Close button injected by collection-filter.js on mobile {%- endcomment -%}

    {%- if section.settings.show_sort -%}
      <div class="collection-filter__sort">
        <label for="SortBy">Sort</label>
        <select id="SortBy" data-sort>
          {%- if is_search -%}
            {%- comment -%}
              search has no .sort_options; these are Shopify's documented
              valid values for search.sort_by.
            {%- endcomment -%}
            <option value="relevance" {% if filter_source.sort_by == 'relevance' %}selected{% endif %}>Relevance</option>
            <option value="best-selling" {% if filter_source.sort_by == 'best-selling' %}selected{% endif %}>Best selling</option>
            <option value="price-ascending" {% if filter_source.sort_by == 'price-ascending' %}selected{% endif %}>Price: low to high</option>
            <option value="price-descending" {% if filter_source.sort_by == 'price-descending' %}selected{% endif %}>Price: high to low</option>
          {%- else -%}
            {%- for option in collection.sort_options -%}
              <option
                value="{{ option.value }}"
                {%- if option.value == collection.sort_by %} selected{%- endif %}
              >{{ option.name }}</option>
            {%- endfor -%}
          {%- endif -%}
        </select>
      </div>
    {%- endif -%}

    <form method="get" action="{{ filter_url }}" id="FilterForm">

      {%- if is_search -%}
        {%- comment -%}
          Native GET form submission replaces the whole querystring, so
          without these the filter form would drop the search term and
          the products/pages/articles tab main-search.liquid tracks.
        {%- endcomment -%}
        <input type="hidden" name="q" value="{{ search.terms | escape }}">
        {%- assign current_result_type = request.query_parameters['type'] | default: 'all' -%}
        {%- unless current_result_type == 'all' -%}
          <input type="hidden" name="type" value="{{ current_result_type }}">
        {%- endunless -%}
      {%- endif -%}

      {%- for filter in filter_source.filters -%}
        <details
          class="collection-filter__group"
          {%- if filter.active_values.size > 0 %} open{%- endif %}
        >
          <summary class="collection-filter__group-label">
            {{ filter.label }}
            {%- if filter.active_values.size > 0 -%}
              <span class="collection-filter__group-badge">{{ filter.active_values.size }}</span>
            {%- endif -%}
          </summary>

          <div class="collection-filter__group-body">
            {%- case filter.type -%}
              {%- when 'list' -%}
                {%- for value in filter.values -%}
                  <label class="collection-filter__option
                    {%- if value.active %} collection-filter__option--active{%- endif %}
                    {%- if value.count == 0 and value.active == false %} collection-filter__option--disabled{%- endif %}">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {%- if value.active %} checked{%- endif %}
                      {%- if value.count == 0 and value.active == false %} disabled{%- endif %}
                    >
                    {{ value.label }} <span>({{ value.count }})</span>
                  </label>
                {%- endfor -%}

              {%- when 'price_range' -%}
                <div class="collection-filter__price">
                  <input
                    type="number"
                    name="{{ filter.min_value.param_name }}"
                    value="{{ filter.min_value.value | divided_by: 100.0 }}"
                    min="0"
                    max="{{ filter.range_max | divided_by: 100.0 }}"
                    placeholder="0"
                  >
                  <span>–</span>
                  <input
                    type="number"
                    name="{{ filter.max_value.param_name }}"
                    value="{{ filter.max_value.value | divided_by: 100.0 }}"
                    min="0"
                    max="{{ filter.range_max | divided_by: 100.0 }}"
                    placeholder="{{ filter.range_max | divided_by: 100.0 }}"
                  >
                </div>
            {%- endcase -%}
          </div>
        </details>
      {%- endfor -%}

      {%- comment -%} Active filter pills {%- endcomment -%}
      {%- assign active_count = 0 -%}
      {%- for filter in filter_source.filters -%}
        {%- assign active_count = active_count | plus: filter.active_values.size -%}
      {%- endfor -%}

      {%- if active_count > 0 -%}
        <div class="collection-filter__active">
          {%- for filter in filter_source.filters -%}
            {%- for value in filter.active_values -%}
              <a href="{{ value.url_to_remove }}" class="collection-filter__pill">
                {{ value.label }} &times;
              </a>
            {%- endfor -%}
          {%- endfor -%}
          {%- if is_search -%}
            <a href="{{ routes.search_url }}?q={{ search.terms | url_encode }}" class="collection-filter__pill collection-filter__pill--clear">Clear all</a>
          {%- else -%}
            <a href="{{ collection.url }}" class="collection-filter__pill collection-filter__pill--clear">Clear all</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <button type="submit" class="collection-filter__submit">Apply</button>

    </form>

  </aside>
{%- endif -%}