{% comment %}
  Mega Menu menu-bar item — dropdown panel with link columns, and an
  optional "trending products" rail pulled from the first collection
  link found anywhere in the attached menu (top level or one level deep).
  File: snippets/mega-menu.liquid
  Loads: assets/mega-menu.css + assets/mega-menu.js (via header-menu.liquid)

  Params:
    block — a block of type 'mega-menu' from section.blocks
{% endcomment %}

{%- liquid
  assign panel_id = 'mega-menu-panel-' | append: block.id
  assign trigger_url = block.settings.link
  if trigger_url == blank and block.settings.menu.links.size > 0
    assign trigger_url = block.settings.menu.links.first.url
  endif

  assign trending_collection = null
  if block.settings.show_products
    for link in block.settings.menu.links
      if link.type == 'collection_link' and trending_collection == null
        assign trending_collection = link.object
      endif
      if trending_collection == null
        for child in link.links
          if child.type == 'collection_link' and trending_collection == null
            assign trending_collection = child.object
          endif
        endfor
      endif
    endfor
  endif
-%}

<li class="menu-bar__item mega-menu" {{ block.shopify_attributes }}>
  <button type="button"
          class="menu-bar__link mega-menu__trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="{{ panel_id }}"
          data-mega-menu-trigger>
    {%- if block.settings.icon != blank -%}
      {%- render 'menu-icon', icon: block.settings.icon -%}
    {%- endif -%}
    <span>{{ block.settings.label }}</span>
    <span class="mega-menu__caret" aria-hidden="true"></span>
  </button>

  <div class="mega-menu__panel" id="{{ panel_id }}" data-mega-menu-panel hidden>
    <div class="mega-menu__panel-inner page-width--header">
      {%- if trigger_url != blank -%}
        <a href="{{ trigger_url }}" class="mega-menu__view-all">Shop all {{ block.settings.label | downcase }}</a>
      {%- endif -%}
      <div class="mega-menu__columns">
        {%- for link in block.settings.menu.links -%}
          <div class="mega-menu__column">
            <a href="{{ link.url }}" class="mega-menu__column-title">{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <ul class="mega-menu__column-list" role="list">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if trending_collection != null -%}
        <div class="mega-menu__products">
          <p class="mega-menu__products-heading">Trending in {{ trending_collection.title }}</p>
          <div class="mega-menu__products-grid">
            {%- for product in trending_collection.products limit: 3 -%}
              <a href="{{ product.url }}" class="mega-menu__product">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 300 }}"
                       alt="{{ product.featured_image.alt | escape }}"
                       width="150" height="150" loading="lazy">
                {%- endif -%}
                <span class="mega-menu__product-title">{{ product.title }}</span>
                <span class="mega-menu__product-price">{{ product.price | money }}</span>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</li>