{%- comment -%}
  snippets/blog-posts.liquid

  Converted from the standalone sections/blog-posts.liquid section
  (same filename, moved to snippets/) so it can be rendered inside
  sections/custom-articles.liquid alongside the blog menu.

  Always pulls from blogs['articles'] (i.e. /blogs/articles).
  Renders each article using snippets/article-card.liquid (which pulls
  in its own article-card.css).

  Required params (passed in via {% render %} since render scope is
  isolated — this snippet cannot reach `section` on its own):
    heading           - string
    custom_tags       - string, comma-separated (raw display text)
    limit             - number, articles per page
    columns           - number, desktop grid columns
    section_width     - '', 'full-width', or 'custom-width'
    custom_width      - number (rem), only used when section_width == 'custom-width'
    section_padding   - number (px)
    section_id        - unique id string, used for CSS scoping (pass section.id)

  TAGS (custom_tags param):
  A comma-separated "Tags" string drives two things at once. Type
  tags in whatever readable form you want displayed (e.g. "Electric
  Scooters") — the raw typed text is used ONLY for the visible pill
  label:

  1. Pills — the URL slug and the active-state check both use
     `tag | handle` (lowercases, replaces spaces/special chars with
     hyphens), matching this store's actual article tag format
     (e.g. "electric-scooters"). So "Electric Scooters" displays as
     typed but links to /tagged/electric-scooters and correctly
     detects the active pill.
  2. Card rendering — the article grid is filtered down to only
     articles whose native article.tags contains the same handleized
     slug (not the raw display text). If custom_tags is blank, all
     articles show as before (no filtering).

  This assumes real article tags in admin are stored in the
  hyphenated/lowercased handle form. If a store instead tags articles
  with natural casing/spacing (e.g. "Electric Scooters" verbatim as
  the actual tag), this matching would need to compare against the
  raw text instead of the handleized slug — flag if that's the case.

  PAGINATION CAVEAT:
  {% paginate %} slices target_blog.articles by `limit` BEFORE this
  filter runs. That means a page of `limit` articles may render fewer
  than `limit` cards if some articles on that page don't match any
  custom_tags value — the page-count math (paginate.pages, prev/next)
  reflects the full unfiltered article count, not the filtered
  visible count. Acceptable for now per current scope, but flagging
  since it means the last page (or any page) can look sparse or even
  empty despite paginate.pages saying there's more.
{%- endcomment -%}

{{ 'article-card.css' | asset_url | stylesheet_tag }}
{{ 'blog-posts.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign target_blog = blogs['articles']
  if section_width == blank
    assign width_class = 'default-width'
  else
    assign width_class = section_width
  endif
  assign custom_tags_list = custom_tags | split: ','
-%}

<div
  class="{{ width_class }}"
  style="
    --section-padding: {{ section_padding }}px;
    {%- if section_width == 'custom-width' %}
      --custom-width: {{ custom_width }}rem;
    {%- endif %}
  "
>
  <div class="blog-posts-section section-{{ section_id }}" style="padding-block: var(--section-spacing);">

    {% if heading != blank %}
      <div class="blog-posts__header">
        <h2 class="blog-posts__title">{{ heading }}</h2>
      </div>
    {% endif %}

    {% if custom_tags_list.size > 0 %}
      <div class="blog-posts__tags">
        <a href="{{ target_blog.url }}" class="blog-posts__tag-pill {% if target_blog.current_tags.size == 0 %}is-active{% endif %}">
          All
        </a>
        {% for tag in custom_tags_list %}
          {%- assign tag = tag | strip -%}
          {%- assign tag_slug = tag | handle -%}
          <a href="{{ target_blog.url }}/tagged/{{ tag_slug }}"
             class="blog-posts__tag-pill {% if target_blog.current_tags contains tag_slug %}is-active{% endif %}">
            {{ tag }}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% paginate target_blog.articles by limit %}
      {% if target_blog.articles.size > 0 %}
        <div class="blog-posts__grid" style="--blog-posts-columns: {{ columns }};">
          {%- assign visible_index = 0 -%}
          {% for article in target_blog.articles %}
            {%- liquid
              assign show_article = false
              if custom_tags_list.size == 0
                assign show_article = true
              else
                for tag in custom_tags_list
                  assign trimmed_tag = tag | strip | handle
                  if article.tags contains trimmed_tag
                    assign show_article = true
                  endif
                endfor
              endif
            -%}

            {% if show_article %}
              {%- assign visible_index = visible_index | plus: 1 -%}
              {% comment %} Eager-load the first row so LCP isn't hurt by lazy-loading above-the-fold images {% endcomment %}
              {% assign loading = 'lazy' %}
              {% if visible_index <= columns %}
                {% assign loading = 'eager' %}
              {% endif %}

              {% render 'article-card', article: article, loading: loading %}
            {% endif %}
          {% endfor %}
        </div>

        {% if custom_tags_list.size > 0 and visible_index == 0 %}
          <p class="blog-posts__empty">No articles match the selected tags on this page.</p>
        {% endif %}

        {% if paginate.pages > 1 %}
          <nav class="blog-posts__pagination" role="navigation" aria-label="Pagination">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="blog-posts__page-link blog-posts__page-link--prev">
                ← Previous
              </a>
            {% endif %}

            <ul class="blog-posts__page-list">
              {% for part in paginate.parts %}
                <li>
                  {% if part.is_link %}
                    <a href="{{ part.url }}" class="blog-posts__page-link">{{ part.title }}</a>
                  {% else %}
                    {% if part.title == paginate.current_page %}
                      <span class="blog-posts__page-link is-active" aria-current="page">{{ part.title }}</span>
                    {% else %}
                      <span class="blog-posts__page-link blog-posts__page-link--gap">{{ part.title }}</span>
                    {% endif %}
                  {% endif %}
                </li>
              {% endfor %}
            </ul>

            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="blog-posts__page-link blog-posts__page-link--next">
                Next →
              </a>
            {% endif %}
          </nav>
        {% endif %}
      {% else %}
        <p class="blog-posts__empty">No articles to show yet.</p>
      {% endif %}
    {% endpaginate %}

  </div>
</div>