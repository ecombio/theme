{%- comment -%}
  snippets/blog-menu.liquid

  Self-contained: loads its own stylesheet (assets/blog-menu.css) and
  its own script (assets/blog-menu.js) — same pattern blog-posts.liquid
  uses for article-card.css / blog-posts.css.

  Previously this snippet had its structural + color CSS inlined in a
  {%- style -%} block, ID-scoped per section.id so multiple instances
  wouldn't collide. That's no longer necessary: structural rules moved
  to assets/blog-menu.css as plain classes (an element's own state
  classes — .is-stuck, .is-open — only ever affect that element, so no
  cross-instance leakage), and the only genuinely per-instance data
  (the 4 color settings) is now set directly as inline custom
  properties on <nav> itself, which is naturally scoped without an ID
  hook.

  blog-menu.js and blog-menu-sticky.js are now merged into one
  assets/blog-menu.js (see that file's header for why).

  Required params (passed in via {% render %} since render scope is
  isolated — this snippet cannot reach `section` on its own):
    heading             - string, optional label before nav items
    mobile_label        - string, mobile toggle button label
    sticky              - boolean
    background_color    - string (hex)
    text_color          - string (hex)
    accent_color        - string (hex)
    border_color        - string (hex)
    blocks              - the block list (pass section.blocks) — only
                           'single_link' and 'link_list' block types
                           are rendered here
    section_id          - unique id string (pass section.id) — still
                           used for the toggle/list aria-controls pair,
                           not for CSS scoping anymore
{%- endcomment -%}

{{ 'blog-menu.css' | asset_url | stylesheet_tag }}

<nav
  class="blog-menu{% if sticky %} blog-menu--sticky{% endif %}"
  data-blog-menu
  aria-label="{{ heading | default: 'Blog navigation' | escape }}"
  style="
    --blog-menu-bg: {{ background_color | default: '#ffffff' }};
    --blog-menu-text: {{ text_color | default: '#1a1a1a' }};
    --blog-menu-accent: {{ accent_color | default: '#1a1a1a' }};
    --blog-menu-border: {{ border_color | default: '#e5e5e5' }};
  "
>
  <div class="blog-menu__inner page-width">

    {%- if heading != blank -%}
      <div class="blog-menu__heading">{{ heading | escape }}</div>
    {%- endif -%}

    {%- if blocks.size > 0 -%}
      <button
        type="button"
        class="blog-menu__toggle"
        data-blog-menu-toggle
        aria-expanded="false"
        aria-controls="blog-menu-list-{{ section_id }}"
      >
        <span class="blog-menu__toggle-label">{{ mobile_label | default: 'Menu' | escape }}</span>
        <span class="blog-menu__toggle-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>

      <ul class="blog-menu__list" id="blog-menu-list-{{ section_id }}" data-blog-menu-list>
        {%- for block in blocks -%}

          {%- case block.type -%}

            {%- when 'single_link' -%}
              <li class="blog-menu__item blog-menu__item--single" {{ block.shopify_attributes }}>
                {%- if block.settings.url != blank -%}
                  <a
                    href="{{ block.settings.url }}"
                    class="blog-menu__link"
                    {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
                  >
                    {{ block.settings.label | default: 'Link' | escape }}
                  </a>
                {%- else -%}
                  <span class="blog-menu__link blog-menu__link--disabled">
                    {{ block.settings.label | default: 'Link' | escape }}
                  </span>
                {%- endif -%}
              </li>

            {%- when 'link_list' -%}
              {%- assign menu_handle = block.settings.menu -%}
              {%- assign menu = linklists[menu_handle] -%}
              <li class="blog-menu__item blog-menu__item--list{% if menu.links.size == 0 %} blog-menu__item--empty{% endif %}" {{ block.shopify_attributes }}>
                <button
                  type="button"
                  class="blog-menu__link blog-menu__link--parent"
                  data-blog-menu-dropdown-toggle
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {{ block.settings.label | default: menu.title | default: 'More' | escape }}
                  <span class="blog-menu__caret" aria-hidden="true"></span>
                </button>

                {%- if menu != blank and menu.links.size > 0 -%}
                  <ul class="blog-menu__dropdown" data-blog-menu-dropdown>
                    {%- for link in menu.links -%}
                      <li class="blog-menu__dropdown-item">
                        <a
                          href="{{ link.url }}"
                          class="blog-menu__dropdown-link{% if link.active %} blog-menu__dropdown-link--active{% endif %}"
                        >
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>

          {%- endcase -%}

        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</nav>

<script src="{{ 'blog-menu.js' | asset_url }}" defer="defer"></script>