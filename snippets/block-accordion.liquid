{% comment %}
  snippets/block-accordion.liquid
  ------------------------------------------------------------
  Renders one `accordion_block` metaobject entry from an
  article's custom.content_blocks list.

  Usage:
    {% render 'block-accordion', block: block %}

  Expected fields on the metaobject:
    heading — single line text
    items   — list of `accordion_item` metaobject references, each with:
                question — single line text
                answer   — rich text

  Behavior: panels open independently (any number can be open at
  once). To switch to single-open behavior instead, change
  data-accordion-mode below to "single" and update accordion.js
  to close sibling panels on open.
{% endcomment %}

{%- liquid
  assign heading = block.fields.heading.value
  assign items = block.fields.items.value
-%}

{%- if items.size > 0 -%}
  <div class="content-block content-block--accordion">
    {%- if heading != blank -%}
      <h2>{{ heading }}</h2>
    {%- endif -%}

    <div class="accordion" data-accordion data-accordion-mode="independent">
      {%- for item in items -%}
        {%- assign panel_id = 'accordion-panel-' | append: block.id | append: '-' | append: forloop.index -%}
        <div class="accordion-item">
          <button
            type="button"
            class="accordion-item__trigger"
            aria-expanded="false"
            aria-controls="{{ panel_id }}"
          >
            <span>{{ item.fields.question.value }}</span>
            <span class="accordion-item__icon" aria-hidden="true"></span>
          </button>
          <div class="accordion-item__panel" id="{{ panel_id }}" hidden>
            {{ item.fields.answer.value }}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
