{%- doc -%}
  Renders a single, shared lightbox/modal used to play any video-card's
  video. video-card.js dispatches a "video-card:play" custom event with
  the video's type/id/url in `detail`, plus productHTML if the block has
  a product selected. video-modal.js listens for it, builds the video
  embed, optionally clones the product markup into the product pane, and
  toggles the modal between single (video only) and split (video +
  product) layouts via the [data-layout] attribute.
{%- enddoc -%}

<div class="video-modal" data-video-modal data-orientation="landscape" data-layout="single" hidden>
  <div class="video-modal__overlay" data-video-modal-close></div>

  <div class="video-modal__inner" role="dialog" aria-modal="true" aria-label="Video player">
    <button type="button" class="video-modal__close" data-video-modal-close aria-label="Close video">
      <svg viewBox="0 0 24 24" width="22" height="22" focusable="false" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <div class="video-modal__media">
      <div class="video-modal__content" data-video-modal-content></div>
    </div>

    <div class="video-modal__product" data-video-modal-product hidden></div>
  </div>
</div>