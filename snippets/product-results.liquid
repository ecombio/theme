{%- comment -%}
  snippets/product-results.liquid
  ------------------------------------------------------------------
  Paginated grid of product search results. Reuses the shared
  product-card snippet so cards stay in sync with the rest of the
  theme (collection pages, related products, etc.).

  Expects:
    - search_terms  (string)  the current search query
    - section        (object)  parent section, for settings:
                                columns, results_per_page, and for
                                section.blocks (promo_banner /
                                promo_carousel)

  BANNER/CAROUSEL SUPPORT (2026-07): restored here. The section's
  promo_banner / promo_carousel blocks are products-tab-only content
  (see main-search.liquid's schema paragraphs under "In-feed banners"
  / "Promo carousels"), so this snippet reads section.blocks directly
  -- same as it always has access to `section` for settings -- rather
  than main-search.liquid pre-filtering blocks and passing them down
  as extra params. absolute_index uses paginate.current_offset, not
  forloop.index alone, so a block positioned at e.g. slot 20 renders
  once overall instead of on every page.

  OBJECT_TYPE FIX (2026-07): search.results is only actually scoped
  to products when the request that generated the page carries
  `type=product`. This snippet used to trust that unconditionally and
  render EVERY item in search.results through 'product-card' -- fine
  when the tab links/pagination links (which always append &type=
  product) drive the request, but not when a shopper lands here from
  a generic header search box that doesn't set `type=`, in which case
  search.results comes back with a mix of products/articles/pages and
  this loop was rendering article/page objects through product-card
  (wrong titles, fake "Add to cart" buttons on blog posts, etc). Now
  filters defensively by result.object_type regardless of how the
  request got here, and tracks rendered_count separately from
  forloop's own count since forloop doesn't know about items this
  loop skips -- the old `{%- else -%}` on the for loop only fires for
  a truly empty search.results, not for "nothing here was a product."
{%- endcomment -%}

{%- comment -%}
  product-card.css, promo-banner.css, and promo-carousel.css are NOT
  loaded here -- per the asset ownership rule documented in
  product-card.liquid, snippets don't load their own assets. They're
  loaded by the parent section (main-search.liquid).
{%- endcomment -%}

{%- liquid
  assign banner_blocks = section.blocks | where: 'type', 'promo_banner'
  assign carousel_blocks = section.blocks | where: 'type', 'promo_carousel'
-%}

{%- paginate search.results by section.settings.results_per_page -%}

  <div
    id="search-results-grid"
    class="search-results-grid"
    style="--columns: {{ section.settings.columns | default: 4 }};"
  >
    {%- assign rendered_count = 0 -%}
    {%- for result in search.results -%}
      {%- if result.object_type != 'product' -%}
        {%- continue -%}
      {%- endif -%}

      {%- assign rendered_count = rendered_count | plus: 1 -%}
      {%- assign absolute_index = paginate.current_offset | plus: forloop.index -%}

      {%- for banner in banner_blocks -%}
        {%- assign banner_position = banner.settings.position | default: 0 -%}
        {%- if banner_position > 0 and banner_position == absolute_index -%}
          {%- render 'promo-banner', block: banner -%}
        {%- endif -%}
      {%- endfor -%}

      {%- for carousel in carousel_blocks -%}
        {%- assign carousel_position = carousel.settings.position | default: 0 -%}
        {%- if carousel_position > 0 and carousel_position == absolute_index -%}
          {%- render 'promo-carousel', block: carousel -%}
        {%- endif -%}
      {%- endfor -%}

      {%- render 'product-card', product: result -%}

    {%- endfor -%}

    {%- if rendered_count == 0 -%}
      <p class="search-empty">No products found for &ldquo;{{ search_terms }}&rdquo;.</p>
    {%- endif -%}

    {%- unless paginate.next -%}
      {%- for banner in banner_blocks -%}
        {%- assign banner_position = banner.settings.position | default: 0 -%}
        {%- if banner_position > paginate.items and banner_position > 0 -%}
          {%- render 'promo-banner', block: banner -%}
        {%- endif -%}
      {%- endfor -%}
      {%- for carousel in carousel_blocks -%}
        {%- assign carousel_position = carousel.settings.position | default: 0 -%}
        {%- if carousel_position > paginate.items and carousel_position > 0 -%}
          {%- render 'promo-carousel', block: carousel -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endunless -%}
  </div>

  {%- if paginate.pages > 1 -%}
    <nav class="pagination" aria-label="Pagination">
      {%- if paginate.previous -%}
        <a href="{{ paginate.previous.url }}&type=product" class="pagination__link">&larr; Previous</a>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{{ part.url }}&type=product" class="pagination__link">{{ part.title }}</a>
        {%- else -%}
          <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}&type=product" class="pagination__link">Next &rarr;</a>
      {%- endif -%}
    </nav>
  {%- endif -%}

{%- endpaginate -%}