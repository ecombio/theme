{%- comment -%}
  snippets/article-results.liquid
  ------------------------------------------------------------------
  Paginated grid of article search results. Reuses the shared
  article-card snippet so cards stay in sync with the blog templates.

  Expects:
    - search_terms  (string)  the current search query
    - section        (object)  parent section, for settings:
                                results_per_page

  Pagination nav is shared with product-results.liquid via
  search-pagination.liquid (2026-07) — see that snippet for the
  &type= param contract.
{%- endcomment -%}

{%- comment -%}
  article-card.css is NOT loaded here — snippets don't load their own
  assets (same ownership rule as product-card.liquid). It's loaded by
  the parent section (main-search.liquid).
{%- endcomment -%}

{%- paginate search.results by section.settings.results_per_page -%}

  <div id="search-articles-grid" class="article-feed">
    {%- for result in search.results -%}
      {%- render 'article-card', article: result -%}
    {%- else -%}
      <p class="search-empty">No articles found for &ldquo;{{ search_terms }}&rdquo;.</p>
    {%- endfor -%}
  </div>

  {%- render 'search-pagination', paginate: paginate, type: 'article' -%}

{%- endpaginate -%}