{%- comment -%}
  snippets/article-results.liquid
  ------------------------------------------------------------------
  Paginated grid of article search results. Reuses the shared
  article-card snippet so cards stay in sync with the blog templates.

  Expects:
    - search_terms  (string)  the current search query
    - section        (object)  parent section, for settings:
                                results_per_page

  OBJECT_TYPE FIX (2026-07): mirrors the fix in product-results.liquid.
  search.results is only scoped to articles when the request carries
  `type=article` -- requests that reach /search without a `type` param
  (e.g. the generic header search box) return a mix of products,
  articles, and pages, and this loop used to render every one of them
  through 'article-card' unconditionally. Now filters by
  result.object_type, and tracks rendered_count separately from
  forloop's own count since the old `{%- else -%}` on the for loop
  only fires when search.results is truly empty, not when it's
  nonempty but contains zero articles.
{%- endcomment -%}

{%- comment -%}
  article-card.css is NOT loaded here — snippets don't load their own
  assets (same ownership rule as product-card.liquid). It's loaded by
  the parent section (main-search.liquid).
{%- endcomment -%}

{%- paginate search.results by section.settings.results_per_page -%}

  <div id="search-articles-grid" class="article-feed">
    {%- assign rendered_count = 0 -%}
    {%- for result in search.results -%}
      {%- if result.object_type != 'article' -%}
        {%- continue -%}
      {%- endif -%}
      {%- assign rendered_count = rendered_count | plus: 1 -%}
      {%- render 'article-card', article: result -%}
    {%- endfor -%}

    {%- if rendered_count == 0 -%}
      <p class="search-empty">No articles found for &ldquo;{{ search_terms }}&rdquo;.</p>
    {%- endif -%}
  </div>

  {%- if paginate.pages > 1 -%}
    <nav class="pagination" aria-label="Pagination">
      {%- if paginate.previous -%}
        <a href="{{ paginate.previous.url }}&type=article" class="pagination__link">&larr; Previous</a>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{{ part.url }}&type=article" class="pagination__link">{{ part.title }}</a>
        {%- else -%}
          <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}&type=article" class="pagination__link">Next &rarr;</a>
      {%- endif -%}
    </nav>
  {%- endif -%}

{%- endpaginate -%}