{%- comment -%}
  snippets/search-results.liquid
  ------------------------------------------------------------------
  Renders the two result panels (tabpanels). The Products/Articles
  tab switcher itself lives in search-toolbar.liquid (the ids
  referenced by aria-labelledby below — tab-products / tab-articles —
  are defined there); this snippet used to render its own duplicate
  copy of that tab switcher, which produced two conflicting sets of
  the same DOM ids on the page. Removed in favor of a single tab
  switcher owned by the toolbar.

  Product and article result rendering (formerly snippets/
  product-results.liquid and snippets/article-results.liquid) are
  now inlined directly below, each still isolated inside its own
  {%- paginate -%} loop so the two result sets don't interfere with
  each other.

  In-feed promo_banner / promo_carousel blocks (products panel only,
  matching main-collection.liquid's behavior — Shopify search doesn't
  facet/merchandise article results the same way, so blocks aren't
  offered on that tab) are positioned using an ABSOLUTE index across
  the whole result set:

    absolute_index = paginate.current_offset + forloop.index

  rather than forloop.parentloop.index alone. forloop.parentloop.index
  resets to 1 on every page, so comparing a block's `position` setting
  against it directly would render that block once per page instead of
  once at the intended spot in the overall result set — the same bug
  found in main-collection.liquid's original banner/carousel loop.
  Same reasoning applies to the "position beyond the end" case: it's
  gated on `paginate.next` being absent, so the "append at the end"
  fallback only fires on the last page.

  Expects:
    - search_terms  (string)  the current search query, e.g. search.terms
    - active_type    (string)  'product' or 'article'
    - section        (object)  the parent section, for settings:
                                columns, results_per_page, and blocks
{%- endcomment -%}
{%- comment -%}
  search-results.css now also contains the rules formerly in
  product-results.css and article-results.css, merged in since both
  snippets are inlined into this file — one stylesheet_tag covers all
  three. product-card.css / article-card.css are still NOT loaded
  here — per the asset ownership rule documented in product-card.
  liquid, card snippets don't load their own assets; that stays the
  parent section's (main-search.liquid) job. Note article-results.
  liquid previously broke that rule itself by loading article-card.css
  directly — preserved as its own load below to avoid changing
  behavior, but worth cleaning up as a follow-up. promo-banner.css /
  promo-carousel.css are likewise owned and loaded by main-search.
  liquid, not here.
{%- endcomment -%}
{{ 'search-results.css' | asset_url | stylesheet_tag }}
{{ 'article-card.css' | asset_url | stylesheet_tag }}

<div class="search-feed" id="search-feed" data-search-feed>

  <div
    id="panel-products"
    class="search-feed__panel"
    role="tabpanel"
    aria-labelledby="tab-products"
    data-panel="product"
    {%- if active_type != 'product' %} hidden{%- endif %}
  >
    {%- if active_type == 'product' -%}

      {%- comment -%} snippet: product-results (formerly snippets/product-results.liquid) {%- endcomment -%}
      <div id="product-results" class="product-results">

        {%- liquid
          assign banner_blocks   = section.blocks | where: 'type', 'promo_banner'
          assign carousel_blocks = section.blocks | where: 'type', 'promo_carousel'
        -%}

        {%- paginate search.results by section.settings.results_per_page -%}

          <div
            id="search-results-grid"
            class="search-results-grid"
            style="--columns: {{ section.settings.columns | default: 4 }};"
          >
            {%- for result in search.results -%}

              {%- assign absolute_index = paginate.current_offset | plus: forloop.index -%}

              {%- for banner in banner_blocks -%}
                {%- assign banner_position = banner.settings.position | default: 0 -%}
                {%- if banner_position > 0 and banner_position == absolute_index -%}
                  {%- render 'promo-banner', block: banner -%}
                {%- endif -%}
              {%- endfor -%}

              {%- for carousel in carousel_blocks -%}
                {%- assign carousel_position = carousel.settings.position | default: 0 -%}
                {%- if carousel_position > 0 and carousel_position == absolute_index -%}
                  {%- render 'promo-carousel', block: carousel -%}
                {%- endif -%}
              {%- endfor -%}

              {%- render 'product-card', product: result -%}

            {%- else -%}
              <p class="search-empty">No products found for &ldquo;{{ search_terms }}&rdquo;.</p>
            {%- endfor -%}

            {%- comment -%}
              "Position beyond the result count" = "put it at the end".
              Only render on the last page (no paginate.next), or this
              would append the block once per page instead of once,
              overall.
            {%- endcomment -%}
            {%- unless paginate.next -%}
              {%- for banner in banner_blocks -%}
                {%- assign banner_position = banner.settings.position | default: 0 -%}
                {%- if banner_position > 0 and banner_position > paginate.items -%}
                  {%- render 'promo-banner', block: banner -%}
                {%- endif -%}
              {%- endfor -%}

              {%- for carousel in carousel_blocks -%}
                {%- assign carousel_position = carousel.settings.position | default: 0 -%}
                {%- if carousel_position > 0 and carousel_position > paginate.items -%}
                  {%- render 'promo-carousel', block: carousel -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endunless -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="Pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}&type=product" class="pagination__link">&larr; Previous</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}&type=product" class="pagination__link">{{ part.title }}</a>
                {%- else -%}
                  <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}&type=product" class="pagination__link">Next &rarr;</a>
              {%- endif -%}
            </nav>
          {%- endif -%}

        {%- endpaginate -%}

      </div>
      {%- comment -%} /snippet: product-results {%- endcomment -%}

    {%- endif -%}
  </div>

  <div
    id="panel-articles"
    class="search-feed__panel"
    role="tabpanel"
    aria-labelledby="tab-articles"
    data-panel="article"
    {%- if active_type != 'article' %} hidden{%- endif %}
  >
    {%- if active_type == 'article' -%}

      {%- comment -%} snippet: article-results (formerly snippets/article-results.liquid) {%- endcomment -%}
      <div id="article-results" class="article-results">

        {%- paginate search.results by section.settings.results_per_page -%}

          <div id="search-articles-grid" class="article-feed">
            {%- for result in search.results -%}
              {%- render 'article-card', article: result -%}
            {%- else -%}
              <p class="search-empty">No articles found for &ldquo;{{ search_terms }}&rdquo;.</p>
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="Pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}&type=article" class="pagination__link">&larr; Previous</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}&type=article" class="pagination__link">{{ part.title }}</a>
                {%- else -%}
                  <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}&type=article" class="pagination__link">Next &rarr;</a>
              {%- endif -%}
            </nav>
          {%- endif -%}

        {%- endpaginate -%}

      </div>
      {%- comment -%} /snippet: article-results {%- endcomment -%}

    {%- endif -%}
  </div>

</div>