{%- comment -%}
  snippets/search-results.liquid
  ------------------------------------------------------------------
  Renders the two result panels (tabpanels) AND the per-type result
  rendering (grid, cards, pagination) directly — product-results.liquid
  and article-results.liquid were merged in here (2026-07) since each
  was only ever rendered from this one call site.

  The Products/Articles tab switcher itself lives in
  search-toolbar.liquid (the ids referenced by aria-labelledby below —
  tab-products / tab-articles — are defined there); this snippet used
  to render its own duplicate copy of that tab switcher, which
  produced two conflicting sets of the same DOM ids on the page.
  Removed in favor of a single tab switcher owned by the toolbar.

  Expects:
    - search_terms  (string)  the current search query, e.g. search.terms
    - active_type    (string)  'product' or 'article'
    - section        (object)  the parent section, for settings:
                                columns, results_per_page, and for
                                section.blocks (promo_banner /
                                promo_carousel — products panel only)

  data-panel FIX (2026-07): these values must match main-collection.js's
  activateTab(key), which is fed key = tab.dataset.tab — i.e. the
  PLURAL "products" / "articles" from the tab switcher's data-tab
  attributes, not the singular active_type param this snippet
  receives. They were previously "product" / "article" (singular),
  which meant `p.dataset.panel === key` never matched either panel,
  so main-collection.js's activateTab() hid BOTH panels on every tab
  click instead of showing the clicked one. Kept in sync with
  data-tab in main-search.liquid.

  ASSET OWNERSHIP: product-card.css, article-card.css, promo-banner.css,
  and promo-carousel.css are NOT loaded here — snippets/sections don't
  load their own assets in this theme. They're loaded by the parent
  section (main-search.liquid).

  BANNER/CAROUSEL SUPPORT (2026-07, carried over from product-results.liquid):
  the section's promo_banner / promo_carousel blocks are products-tab-only
  content (see main-search.liquid's schema paragraphs under "In-feed
  banners" / "Promo carousels"), so this reads section.blocks directly.
  absolute_index uses paginate.current_offset, not forloop.index alone,
  so a block positioned at e.g. slot 20 renders once overall instead of
  on every page.
{%- endcomment -%}
{{ 'search-results.css' | asset_url | stylesheet_tag }}
{{ 'promo-banner.css' | asset_url | stylesheet_tag }}
{{ 'promo-carousel.css' | asset_url | stylesheet_tag }}

<div class="search-feed" id="search-feed" data-search-feed>

  <div
    id="panel-products"
    class="search-feed__panel"
    role="tabpanel"
    aria-labelledby="tab-products"
    data-panel="products"
    {%- if active_type != 'product' %} hidden{%- endif %}
  >
    {%- if active_type == 'product' -%}
      {%- liquid
        assign banner_blocks = section.blocks | where: 'type', 'promo_banner'
        assign carousel_blocks = section.blocks | where: 'type', 'promo_carousel'
      -%}

      {%- paginate search.results by section.settings.results_per_page -%}

        <div
          id="search-results-grid"
          class="search-results-grid"
          style="--columns: {{ section.settings.columns | default: 4 }};"
        >
          {%- for result in search.results -%}
            {%- assign absolute_index = paginate.current_offset | plus: forloop.index -%}

            {%- for banner in banner_blocks -%}
              {%- assign banner_position = banner.settings.position | default: 0 -%}
              {%- if banner_position > 0 and banner_position == absolute_index -%}
                {%- render 'promo-banner', block: banner -%}
              {%- endif -%}
            {%- endfor -%}

            {%- for carousel in carousel_blocks -%}
              {%- assign carousel_position = carousel.settings.position | default: 0 -%}
              {%- if carousel_position > 0 and carousel_position == absolute_index -%}
                {%- render 'promo-carousel', block: carousel -%}
              {%- endif -%}
            {%- endfor -%}

            {%- render 'product-card', product: result -%}

          {%- else -%}
            <p class="search-empty">No products found for &ldquo;{{ search_terms }}&rdquo;.</p>
          {%- endfor -%}

          {%- unless paginate.next -%}
            {%- for banner in banner_blocks -%}
              {%- assign banner_position = banner.settings.position | default: 0 -%}
              {%- if banner_position > paginate.items and banner_position > 0 -%}
                {%- render 'promo-banner', block: banner -%}
              {%- endif -%}
            {%- endfor -%}
            {%- for carousel in carousel_blocks -%}
              {%- assign carousel_position = carousel.settings.position | default: 0 -%}
              {%- if carousel_position > paginate.items and carousel_position > 0 -%}
                {%- render 'promo-carousel', block: carousel -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endunless -%}
        </div>

        {%- render 'search-pagination', paginate: paginate, type: 'product' -%}

      {%- endpaginate -%}
    {%- endif -%}
  </div>

  <div
    id="panel-articles"
    class="search-feed__panel"
    role="tabpanel"
    aria-labelledby="tab-articles"
    data-panel="articles"
    {%- if active_type != 'article' %} hidden{%- endif %}
  >
    {%- if active_type == 'article' -%}
      {%- paginate search.results by section.settings.results_per_page -%}

        <div id="search-articles-grid" class="article-feed">
          {%- for result in search.results -%}
            {%- render 'article-card', article: result -%}
          {%- else -%}
            <p class="search-empty">No articles found for &ldquo;{{ search_terms }}&rdquo;.</p>
          {%- endfor -%}
        </div>

        {%- render 'search-pagination', paginate: paginate, type: 'article' -%}

      {%- endpaginate -%}
    {%- endif -%}
  </div>

</div>