{%- liquid
  assign policies = product.metafields.custom.policies.value

  assign has_custom_shipping = policies.fields.shipping_policy != blank
  assign has_custom_refund   = policies.fields.returns_refunds != blank
  assign has_custom_warranty = policies.fields.warranty_policy != blank

  assign shipping_page = pages['shipping-policy']
  assign refund_page   = pages['refund-policy']
  assign warranty_page = pages['warranty']

  assign show_shipping = has_custom_shipping or shipping_page.content != blank or shop.shipping_policy.body != blank
  assign show_refund   = has_custom_refund or refund_page.content != blank or shop.refund_policy.body != blank
  assign show_warranty = has_custom_warranty or warranty_page.content != blank
-%}

<div class="pd-wrap">
  {%- if product.description != blank -%}
    <div class="pd-row"><button class="pd-trigger" type="button" id="PdTriggerDescription"><span>Description</span></button></div>
  {%- endif -%}

  {%- if show_shipping -%}
    <div class="pd-row"><button class="pd-trigger" type="button" id="PdTriggerShipping"><span>Shipping Policy</span></button></div>
  {%- endif -%}

  {%- if show_refund -%}
    <div class="pd-row"><button class="pd-trigger" type="button" id="PdTriggerRefund"><span>Refund &amp; Return Policy</span></button></div>
  {%- endif -%}

  {%- if show_warranty -%}
    <div class="pd-row"><button class="pd-trigger" type="button" id="PdTriggerWarranty"><span>Warranty</span></button></div>
  {%- endif -%}
</div>

<div class="pd-overlay" id="PdOverlay"></div>

{%- if product.description != blank -%}
<div class="pd-panel" id="PdPanelDescription">
  <div class="pd-panel__header"><h2>Description</h2></div>
  <div class="pd-panel__body">{{ product.description }}</div>
</div>
{%- endif -%}

{%- if show_shipping -%}
<div class="pd-panel" id="PdPanelShipping">
  <div class="pd-panel__header"><h2>Shipping Policy</h2></div>
  <div class="pd-panel__body">
    {%- if has_custom_shipping -%}
      {{ policies.fields.shipping_policy | metafield_tag }}
    {%- elsif shipping_page.content != blank -%}
      {{ shipping_page.content }}
    {%- else -%}
      {{ shop.shipping_policy.body }}
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{%- if show_refund -%}
<div class="pd-panel" id="PdPanelRefund">
  <div class="pd-panel__header"><h2>Refund &amp; Return Policy</h2></div>
  <div class="pd-panel__body">
    {%- if has_custom_refund -%}
      {{ policies.fields.returns_refunds | metafield_tag }}
    {%- elsif refund_page.content != blank -%}
      {{ refund_page.content }}
    {%- else -%}
      {{ shop.refund_policy.body }}
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{%- if show_warranty -%}
<div class="pd-panel" id="PdPanelWarranty">
  <div class="pd-panel__header"><h2>Warranty</h2></div>
  <div class="pd-panel__body">
    {%- if has_custom_warranty -%}
      {{ policies.fields.warranty_policy | metafield_tag }}
    {%- elsif warranty_page.content != blank -%}
      {{ warranty_page.content }}
    {%- else -%}
      <p>Contact us for warranty info.</p>
    {%- endif -%}
  </div>
</div>
{%- endif -%}