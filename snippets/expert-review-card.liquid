{%- comment -%}
  snippets/expert-review-card.liquid
  ============================================
  Renders one review card for sections/expert-reviews.liquid.

  ⚠️ BEST-EFFORT REWRITE — I don't have your original
  expert-review-card.liquid, video-card.js, or video-modal.liquid/js.
  This markup is inferred from the section's own comments (a
  play-trigger dispatching 'video-card:play', picked up by
  video-modal.js). Please check data-video-card-trigger's attributes
  against what those two JS files actually read before shipping —
  I did not copy this from your real files.

  `review` is a metaobject entry (type: expert_reviews), not a section
  block, so fields are read as review.<field_key>.value instead of
  block.settings.<field_key>.
{%- endcomment -%}

{%- liquid
  assign review_video = review.video.value
  assign review_url = review.video_url.value
  assign thumbnail = review.thumbnail.value
  assign title = review.title.value
  assign view_count = review.view_count.value
  assign source_icon = review.source_icon.value
  assign source_name = review.source_name.value

  assign video_type = blank
  assign video_id = blank

  if review_video != blank
    assign video_type = 'hosted'
    assign video_id = review_video.id
  elsif review_url != blank
    if review_url contains 'youtube.com' or review_url contains 'youtu.be'
      assign video_type = 'youtube'
      if review_url contains 'v='
        assign video_id = review_url | split: 'v=' | last | split: '&' | first
      else
        assign video_id = review_url | split: '/' | last | split: '?' | first
      endif
    elsif review_url contains 'vimeo.com'
      assign video_type = 'vimeo'
      assign video_id = review_url | split: '/' | last | split: '?' | first
    endif
  endif
-%}

<div class="expert-review-card">

  <button
    type="button"
    class="expert-review-card__trigger"
    data-video-card-trigger
    data-video-type="{{ video_type }}"
    data-video-id="{{ video_id }}"
    aria-label="Play {{ title | default: 'review video' | escape }}"
  >
    {%- if thumbnail != blank -%}
      <img
        src="{{ thumbnail | image_url: width: 640 }}"
        srcset="{{ thumbnail | image_url: width: 640 }} 640w, {{ thumbnail | image_url: width: 960 }} 960w"
        alt="{{ thumbnail.alt | default: title | escape }}"
        width="{{ thumbnail.width }}"
        height="{{ thumbnail.height }}"
        loading="lazy"
      >
    {%- elsif review_video.preview_image != blank -%}
      <img
        src="{{ review_video.preview_image | image_url: width: 640 }}"
        alt="{{ title | escape }}"
        width="{{ review_video.preview_image.width }}"
        height="{{ review_video.preview_image.height }}"
        loading="lazy"
      >
    {%- endif -%}
    <span class="expert-review-card__play-icon" aria-hidden="true">▶</span>
  </button>

  <div class="expert-review-card__meta">
    {%- if title != blank -%}
      <p class="expert-review-card__title">{{ title }}</p>
    {%- endif -%}

    <div class="expert-review-card__source">
      {%- if source_icon != blank -%}
        <img
          class="expert-review-card__source-icon"
          src="{{ source_icon | image_url: width: 40 }}"
          alt=""
          width="20"
          height="20"
          loading="lazy"
        >
      {%- endif -%}
      {%- if source_name != blank -%}
        <span class="expert-review-card__source-name">{{ source_name }}</span>
      {%- endif -%}
      {%- if view_count != blank -%}
        <span class="expert-review-card__view-count">{{ view_count }}</span>
      {%- endif -%}
    </div>
  </div>

</div>
